                                            Text { text: (source.active ? "● " : "○ ") + source.name; color: source.active ? Theme.accent : Theme.ink; font-size: Theme.font(12); font-weight: 600; overflow: elide; }
                                            Text { text: source.subtitle; color: Theme.muted; font-size: Theme.font(10); overflow: elide; }
                                            Text { text: source.active ? ((root.chinese ? "当前数据源" : "Active") + (source.status != "" ? " · " + source.status : "")) : source.status; color: source.status-kind == 3 ? Theme.warning : (source.status-kind == 1 ? Theme.accent : Theme.dim); font-size: Theme.font(10); overflow: elide; }
