    // Unified library manager with local and server settings; shown by
    // library-visible. Local libraries precede server profiles; row 0 is default.
    // sm-selected -1 is a new, unsaved server.
    in property <[SourceRow]> sm-sources: [{ kind: 0, active: true }];
    in-out property <int> sm-selected: 0;
    // Server pages: 0 连接与库信息, 1 服务器音效库, 2 缓存与导出 (试听/性能 lives on page 2).
    in-out property <int> sm-page: 0;
    in-out property <bool> sm-confirm-delete: false;
    in property <string> sm-local-path: "";
    in property <int> sm-local-count: 1;
    in property <bool> sm-local-default: true;
    in property <string> sm-local-description: "";
