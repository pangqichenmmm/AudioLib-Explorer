            MenuItem { title: (root.chinese ? "移除选择记录（保留 WAV）…" : "Remove selected records (keep WAV)…") + root.removal-suffix; enabled: root.menu-ready && root.checked-count > 0 && root.removal-allowed; activated => { root.library-action(11); } }
            MenuItem { title: (root.chinese ? "移除当前目录（保留 WAV）…" : "Remove current folder (keep WAV)…") + root.removal-suffix; enabled: root.menu-ready && root.selected-folder-path != "" && root.removal-allowed; activated => { root.folder-action-requested(root.selected-folder-path, 1); } }
        }
    }
global-menu-view := ContextMenuArea { x: 0px; y: 0px; width: 0px; height: 0px;
        Menu { title: root.chinese ? "视图" : "View"; enabled: root.menu-ready;
            MenuItem { title: root.chinese ? "搜索" : "Search"; enabled: root.menu-ready; activated => { studio-search-input.focus(); } }
            MenuItem { title: root.chinese ? "显示素材目录" : "Show library sidebar"; enabled: root.menu-ready; checkable: true; checked <=> root.sidebar-visible; }
            MenuItem { title: root.chinese ? "显示侧栏（筛选 / 详情）" : "Show side panel (filters / details)"; enabled: root.menu-ready; checkable: true; checked <=> root.inspector-visible; }
            MenuItem { title: root.chinese ? "显示筛选" : "Show filters"; enabled: root.menu-ready; activated => { root.filters-visible = true; root.inspector-visible = true; } }
            MenuItem { title: root.chinese ? "显示声音详情" : "Show sound details"; enabled: root.menu-ready; activated => { root.show-details-page(); } }
            MenuItem { title: root.chinese ? "重置筛选" : "Reset filters"; enabled: root.menu-ready; activated => { root.reset-filters(); } }
            MenuSeparator { }
            MenuItem { title: root.chinese ? "全部声音" : "All sounds"; enabled: root.menu-ready; activated => { root.library-sidebar-page = 0; root.favorites-only = false; root.all-library-requested(); } }
            MenuItem { title: root.chinese ? "我的收藏" : "Favorites"; enabled: root.menu-ready; activated => { root.library-sidebar-page = 1; root.favorites-category = 0; root.favorites-only = true; root.all-library-requested(); } }
            // Column headers sort; modification time has no column, so it is chosen here.
            Menu { title: (root.chinese ? "排序：" : "Sort: ") + root.sort-label;
                MenuItem { title: root.chinese ? "修改时间（新 → 旧）" : "Modified (newest first)"; enabled: root.menu-ready; activated => { root.sort-index = 6; root.sort-descending = true; root.filter-requested(); root.table-layout-changed(); } }
                MenuItem { title: root.chinese ? "修改时间（旧 → 新）" : "Modified (oldest first)"; enabled: root.menu-ready; activated => { root.sort-index = 6; root.sort-descending = false; root.filter-requested(); root.table-layout-changed(); } }
                MenuSeparator { }
                MenuItem { title: root.chinese ? "默认排序" : "Default order"; enabled: root.menu-ready && root.sort-index != 0; activated => { root.sort-table(0); } }
            }
            MenuSeparator { }
            MenuItem { title: root.chinese ? "外观设置…" : "Appearance settings…"; enabled: root.menu-ready; activated => { root.settings-page = 1; root.settings-visible = true; } }
            MenuItem { title: root.chinese ? "Switch to English" : "切换到中文"; enabled: root.menu-ready; activated => { root.chinese = !root.chinese; root.language-requested(root.chinese); } }
        }
    }
global-menu-library := ContextMenuArea { x: 0px; y: 0px; width: 0px; height: 0px;
        Menu { title: root.chinese ? "音效库" : "Library"; enabled: root.menu-ready;
            MenuItem { title: root.chinese ? "音效库管理…" : "Manage sound library…"; enabled: root.menu-ready; activated => { root.open-library(0); } }
            MenuItem { title: root.chinese ? "查看缺失文件 / 修复引用" : "Missing files / repair references"; enabled: root.menu-ready; activated => { root.show-missing-files(); } }
            // Not an everyday choice, so it lives here rather than in the list header; the
            // title names the current choice and the list footer flags a non-default one.
            Menu { title: (root.chinese ? "显示文件：" : "Show files: ") + root.visibility-labels[root.visibility-index];
                MenuItem { title: root.visibility-labels[0]; enabled: root.menu-ready; activated => { root.visibility-index = 0; root.filter-requested(); } }
                MenuItem { title: root.visibility-labels[1]; enabled: root.menu-ready; activated => { root.visibility-index = 1; root.filter-requested(); } }
                MenuItem { title: root.visibility-labels[2]; enabled: root.menu-ready; activated => { root.visibility-index = 2; root.filter-requested(); } }
            }
            MenuSeparator { }
            MenuItem { title: root.chinese ? "扫描历史…" : "Scan history…"; enabled: root.menu-ready; activated => { root.open-history(0); } }
            MenuItem { title: root.chinese ? "最近播放…" : "Recent playback…"; enabled: root.menu-ready; activated => { root.open-history(1); } }
        }
    }
global-menu-scan := ContextMenuArea { x: 0px; y: 0px; width: 0px; height: 0px;
        Menu { title: root.chinese ? "扫描" : "Scan"; enabled: root.menu-ready;
            MenuItem { title: (root.chinese ? "增量扫描文件夹…" : "Incremental folder scan…") + root.ro-suffix; enabled: root.menu-ready && !root.scanning && !root.remote-mode; activated => { root.prepare-scan(0, ""); } }
            MenuItem { title: (root.chinese ? "全量扫描文件夹…" : "Full folder rescan…") + root.ro-suffix; enabled: root.menu-ready && !root.scanning && !root.remote-mode; activated => { root.prepare-scan(1, ""); } }
            MenuSeparator { }
            MenuItem { title: (root.chinese ? "增量扫描当前目录" : "Incremental scan of current folder") + root.ro-suffix; enabled: root.menu-ready && !root.scanning && root.selected-folder-path != "" && !root.remote-mode; activated => { root.prepare-scan(0, root.selected-folder-path); } }
            MenuItem { title: (root.chinese ? "全量扫描当前目录" : "Full rescan of current folder") + root.ro-suffix; enabled: root.menu-ready && !root.scanning && root.selected-folder-path != "" && !root.remote-mode; activated => { root.prepare-scan(1, root.selected-folder-path); } }
            MenuSeparator { }
            MenuItem { title: root.scan-paused ? (root.chinese ? "继续扫描" : "Resume scan") : (root.chinese ? "暂停扫描" : "Pause scan"); enabled: root.menu-ready && root.scan-controllable && !root.scan-validating; activated => { root.scan-pause-requested(); } }
            MenuItem { title: root.chinese ? "取消当前扫描" : "Cancel current scan"; enabled: root.menu-ready && root.scan-controllable; activated => { root.scan-cancel-requested(); } }
            MenuItem { title: root.chinese ? "刷新素材库" : "Refresh library"; enabled: root.menu-ready; activated => { root.refresh-requested(); } }
        }
    }
global-menu-playback := ContextMenuArea { x: 0px; y: 0px; width: 0px; height: 0px;
        Menu { title: root.chinese ? "播放" : "Playback"; enabled: root.menu-ready;
            MenuItem { title: root.chinese ? "单击播放" : "Single-click play"; enabled: root.menu-ready; checkable: true; checked: root.audition-play-on-single-click; activated => { root.audition-play-on-single-click = !root.audition-play-on-single-click; root.single-click-play-requested(root.audition-play-on-single-click); } }
            MenuSeparator { }
            MenuItem { title: root.chinese ? "试听所选文件" : "Audition selected file"; enabled: root.menu-ready && root.has-selection && !root.selected-missing; activated => { root.file-action-requested(root.selected-id, 0); } }
            MenuItem { title: root.chinese ? "播放" : "Play"; enabled: root.menu-ready && root.audio-ready && !root.selected-missing; activated => { root.start-requested(); } }
            MenuItem { title: root.chinese ? "暂停" : "Pause"; enabled: root.menu-ready && root.playing; activated => { root.pause-requested(); } }
            MenuItem { title: root.chinese ? "停止" : "Stop"; enabled: root.menu-ready && (root.audio-ready || root.play-duration > 0); activated => { root.stop-requested(); } }
            MenuSeparator { }
            MenuItem { title: root.chinese ? "音频输出设置…" : "Audio output settings…"; enabled: root.menu-ready; activated => { root.settings-page = 0; root.output-settings-requested(); root.settings-visible = true; } }
            MenuItem { title: root.chinese ? "Spectral Peaks 设置…" : "Spectral Peaks settings…"; enabled: root.menu-ready; activated => { root.peaks-visible = true; } }
        }
    }
global-menu-help := ContextMenuArea { x: 0px; y: 0px; width: 0px; height: 0px;
        Menu { title: root.chinese ? "帮助" : "Help"; enabled: root.menu-ready;
            MenuItem { title: root.chinese ? "快捷键与基本操作…" : "Shortcuts and basics…"; enabled: root.menu-ready; activated => { root.help-visible = true; } }
            MenuItem { title: root.chinese ? "关于 AudioLib Explorer" : "About AudioLib Explorer"; enabled: root.menu-ready; activated => { root.about-visible = true; } }
        }
    }
main-scroll := ScrollView {
    visible: !Theme.modern-style;
    width: parent.width; height: parent.height;
    viewport-width: max(self.visible-width, main-layout.min-width);
    viewport-height: max(self.visible-height, main-layout.min-height);
    main-layout := VerticalLayout {
        width: main-scroll.viewport-width; height: main-scroll.viewport-height;
        padding: 16px * Theme.ui-scale;
        // The compact view reserves the original directory/details height even
        // after adding the document tab row, so extracted source fields stay visible.
        padding-top: (root.short-layout ? 10px : 16px) * Theme.ui-scale;
        padding-bottom: (root.short-layout ? 10px : 16px) * Theme.ui-scale;
        spacing: (root.short-layout ? 6px : 10px) * Theme.ui-scale;
        HorizontalLayout { height: (root.short-layout ? 34px : 42px) * Theme.ui-scale; spacing: 12px * Theme.ui-scale;
            Rectangle { width: 34px * Theme.ui-scale; height: 34px * Theme.ui-scale; border-radius: 9px * Theme.ui-scale; background: Theme.selected;
                HorizontalLayout { padding: 8px * Theme.ui-scale; spacing: 3px * Theme.ui-scale;
                    Rectangle { width: 3px * Theme.ui-scale; height: 10px * Theme.ui-scale; y: 4px * Theme.ui-scale; background: Theme.accent; border-radius: 1px; }
                    Rectangle { width: 3px * Theme.ui-scale; height: 18px * Theme.ui-scale; background: Theme.accent; border-radius: 1px; }
                    Rectangle { width: 3px * Theme.ui-scale; height: 12px * Theme.ui-scale; y: 3px * Theme.ui-scale; background: Theme.accent; border-radius: 1px; }
                }
            }
            Text { text: "AudioLib Explorer"; color: Theme.ink; font-size: Theme.font(18); font-weight: 600; vertical-alignment: center; }
            Label { text: root.chinese ? "声音工作台" : "SOUND WORKSPACE"; font-size: Theme.font(10); }
            Rectangle { horizontal-stretch: 1; }
            Rectangle { max-width: 470px * Theme.ui-scale; min-width: 60px * Theme.ui-scale;
                accessible-role: button; accessible-label: root.data-source-label; accessible-enabled: root.menu-ready;
                accessible-action-default => { if root.menu-ready { root.open-data-source(); } }
                border-width: source-label-focus.has-focus ? 1px : 0px; border-color: Theme.accent;
                source-label-focus := FocusScope { enabled: root.menu-ready; key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.open-data-source(); return accept; } reject } }
                Text { width: 100%; text: root.data-source-label; color: root.remote-mode ? Theme.accent : Theme.dim; font-size: Theme.font(11); vertical-alignment: center; horizontal-alignment: right; overflow: elide; }
                TouchArea { mouse-cursor: pointer; clicked => { if root.menu-ready { root.open-data-source(); } } }
            }
            Label { text: root.library-summary; font-size: Theme.font(11); }
            Action { width: 112px * Theme.ui-scale; height: 32px * Theme.ui-scale; primary: true; enabled: root.menu-ready && !root.scanning && !root.remote-mode; label: root.chinese ? "+  添加文件夹" : "+  Add folder"; clicked => { root.prepare-scan(0, ""); } }
            Action { width: 120px * Theme.ui-scale; height: 32px * Theme.ui-scale; enabled: root.menu-ready; label: root.chinese ? "管理音效库" : "Manage library"; clicked => { root.open-library(0); } }
        }
        if root.remote-mode && root.remote-notice != "": Rectangle { height: 34px * Theme.ui-scale; background: Theme.panel; border-radius: 6px * Theme.ui-scale; border-width: 1px; border-color: root.remote-notice-kind == 1 ? Theme.accent : Theme.warning;
            HorizontalLayout { padding-left: 10px * Theme.ui-scale; padding-right: 2px * Theme.ui-scale; padding-top: 2px * Theme.ui-scale; padding-bottom: 2px * Theme.ui-scale; spacing: 8px * Theme.ui-scale;
                Text { horizontal-stretch: 1; min-width: 0px; text: root.remote-notice; color: root.remote-notice-kind == 1 ? Theme.accent : Theme.warning; font-size: Theme.font(11); vertical-alignment: center; overflow: elide; }
                if root.remote-notice-kind != 0: Action { width: 96px * Theme.ui-scale; primary: root.remote-notice-kind == 1; enabled: root.menu-ready && !root.ds-syncing; label: root.remote-notice-kind == 1 ? (root.ds-sync-paused ? (root.chinese ? "继续同步" : "Continue") : (root.chinese ? "同步" : "Sync")) : root.remote-notice-kind == 3 ? (root.chinese ? "设置…" : "Settings…") : (root.chinese ? "立即重试" : "Retry now"); clicked => { root.remote-notice-action(); } }
                Action { width: 30px * Theme.ui-scale; subtle: true; label: "×"; accessible-label: root.chinese ? "关闭提示" : "Dismiss notice"; clicked => { root.remote-notice-dismissed(); } }
            }
        }
        if root.scanning: Rectangle { height: 76px * Theme.ui-scale; background: Theme.panel; border-radius: 7px * Theme.ui-scale; border-width: 1px; border-color: Theme.accent;
            HorizontalLayout { padding: 10px * Theme.ui-scale; spacing: 12px * Theme.ui-scale;
                VerticalLayout { horizontal-stretch: 1; min-width: 0px; spacing: 4px * Theme.ui-scale;
                    Text { text: root.scan-summary; color: Theme.accent; font-size: Theme.font(12); wrap: word-wrap; overflow: elide; }
                    Text { height: 18px * Theme.ui-scale; text: root.scan-current-path; color: Theme.muted; font-size: Theme.font(10); overflow: elide; }
                }
                Action { width: 112px * Theme.ui-scale; height: 32px * Theme.ui-scale; enabled: root.scan-controllable && !root.scan-validating && !root.background-blocked; label: root.scan-paused ? (root.chinese ? "继续扫描" : "Resume scan") : (root.chinese ? "暂停扫描" : "Pause scan"); clicked => { root.scan-pause-requested(); } }
                Action { width: 112px * Theme.ui-scale; height: 32px * Theme.ui-scale; enabled: root.scan-controllable && !root.background-blocked; label: root.scan-cancelling ? (root.chinese ? "正在取消…" : "Cancelling…") : (root.chinese ? "取消扫描" : "Cancel scan"); clicked => { root.scan-cancel-requested(); } }
            }
        }
        // Document tabs own the entire search workspace below, including its directory tree.
        task-tabs-bar := Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; height: (root.short-layout ? 34px : 38px) * Theme.ui-scale; background: Theme.trough; border-radius: 7px * Theme.ui-scale;
            changed width => { root.update-task-tabs-overflow(); }
            accessible-role: tab-list; accessible-label: root.chinese ? "搜索任务" : "Search tasks";
            HorizontalLayout { padding-left: 4px * Theme.ui-scale; padding-right: 4px * Theme.ui-scale; padding-top: 2px * Theme.ui-scale; spacing: 3px * Theme.ui-scale;
                if root.task-tabs-overflow: Action { width: 36px * Theme.ui-scale; subtle: true; label: "‹";
                    action-label: root.chinese ? "向左翻页搜索任务" : "Scroll search tasks left";
                    enabled: !root.background-blocked && root.task-tabs-x < -1px;
                    clicked => { root.scroll-task-tabs(-1); }
                }
                task-tabs-scroll := ScrollView { horizontal-stretch: 1; min-width: 0px; viewport-height: (root.short-layout ? 32px : 36px) * Theme.ui-scale;
                    viewport-width: root.task-tabs-content-width;
                    HorizontalLayout { spacing: 3px * Theme.ui-scale; alignment: start;
                        for task in root.search-tasks: SearchTaskTab {
                            width: root.task-tab-width; name: task.name; active: task.active;
                            tooltip-width: min(560px * Theme.ui-scale, root.width - 40px * Theme.ui-scale);
                            keywords: task.keywords; folder: task.folder; summary: task.summary; searched: task.searched;
                            favorite: task.favorite; modified: task.modified; chinese: root.chinese; compact: root.short-layout; enabled: !root.background-blocked; editable: !root.search-workspace-read-only;
                            selected => { root.search-task-selected(task.id); }
                            closed => { root.search-task-closed(task.id); }
                            rename-requested => { root.begin-search-task-rename(task.id, task.name, false); }
                            context-requested(position) => {
                                root.context-search-task = task;
                                search-task-menu.show({x: position.x - search-task-menu.absolute-position.x, y: position.y - search-task-menu.absolute-position.y});
                            }
                        }
                    }
                }
                if root.task-tabs-overflow: Action { width: 36px * Theme.ui-scale; subtle: true; label: "›";
                    action-label: root.chinese ? "向右翻页搜索任务" : "Scroll search tasks right";
                    enabled: !root.background-blocked && root.task-tabs-x > min(0px, root.task-tabs-visible-width - root.task-tabs-content-width) + 1px;
                    clicked => { root.scroll-task-tabs(1); }
                }
                Action { width: 36px * Theme.ui-scale; height: (root.short-layout ? 30px : 32px) * Theme.ui-scale; subtle: true;
                    label: "+"; action-label: root.chinese ? "新建搜索任务" : "New search task";
                    enabled: !root.background-blocked && !root.search-workspace-read-only && root.search-tasks.length < root.max-search-tasks;
                    clicked => { root.search-task-created(); }
                    Tooltip { text: @markdown("\{root.search-tasks.length}/\{root.max-search-tasks}"); }
                }
            }
        }
        if root.search-workspace-error != "": Rectangle {
            vertical-stretch: 0; min-height: 34px * Theme.ui-scale;
            background: Theme.danger-surface; border-width: 1px; border-color: Theme.warning; border-radius: 6px * Theme.ui-scale;
            VerticalLayout { padding: 8px * Theme.ui-scale;
                Text { text: root.search-workspace-error; color: Theme.warning; font-size: Theme.font(11); wrap: word-wrap; }
            }
        }
        Rectangle { height: (root.short-layout ? 44px : 48px) * Theme.ui-scale; background: Theme.panel; border-radius: 7px * Theme.ui-scale; border-width: 1px; border-color: Theme.border;
            HorizontalLayout { padding: 7px * Theme.ui-scale; spacing: 10px * Theme.ui-scale;
                Image { width: 23px * Theme.ui-scale; source: @image-url("../assets/search.svg"); colorize: Theme.accent; image-fit: contain; }
                search-input := LineEdit { horizontal-stretch: 1; enabled: !root.background-blocked; text <=> root.query;
                    placeholder-text: root.chinese ? "搜索声音、标签和源文件 Metadata…" : "Search sounds, tags and source Metadata…";
                    edited => { root.search-requested(false); }
                    accepted => { root.search-requested(true); }
                }
                if root.query != "": Action { width: 48px * Theme.ui-scale; label: root.chinese ? "清空" : "Clear"; clicked => { root.query = ""; root.search-requested(true); search-input.focus(); } }
                Label { width: 42px * Theme.ui-scale; text: "Ctrl F"; horizontal-alignment: center; font-size: Theme.font(10); }
                Action { width: 76px * Theme.ui-scale; primary: true; label: root.searching ? (root.chinese ? "搜索中" : "Searching") : (root.chinese ? "搜索" : "Search"); clicked => { root.search-requested(true); } }
            }
        }
        workspace := HorizontalLayout { vertical-stretch: 1; min-height: results-column.min-height; spacing: 0px;
            library-sidebar := Rectangle { width: root.sidebar-width; background: Theme.panel; border-radius: 7px * Theme.ui-scale; border-width: 1px; border-color: Theme.border; clip: true;
                VerticalLayout { padding: 12px * Theme.ui-scale; padding-top: (root.short-layout ? 8px : 12px) * Theme.ui-scale; padding-bottom: (root.short-layout ? 8px : 12px) * Theme.ui-scale; spacing: (root.short-layout ? 4px : 8px) * Theme.ui-scale;
                    Rectangle { height: 32px * Theme.ui-scale; background: Theme.trough; border-radius: 8px * Theme.ui-scale;
                        accessible-role: tab-list; accessible-label: root.chinese ? "素材库页面" : "Library pages";
                        HorizontalLayout { padding: 3px * Theme.ui-scale; spacing: 3px * Theme.ui-scale;
                            SegmentTab { horizontal-stretch: 1; preferred-width: 0px; icon: @image-url("icons/folder.svg"); label: root.chinese ? "目录" : "Folders"; action-label: root.chinese ? "目录页" : "Folders page"; active: root.library-sidebar-page == 0; clicked => { if !root.background-blocked { root.library-sidebar-page = 0; if root.favorites-only { root.favorites-only = false; root.filter-requested(); } } } }
                            SegmentTab { horizontal-stretch: 1; preferred-width: 0px; icon: @image-url("icons/star.svg"); label: root.chinese ? "收藏" : "Favorites"; action-label: root.chinese ? "收藏页" : "Favorites page"; active: root.library-sidebar-page == 1; clicked => { if !root.background-blocked { root.library-sidebar-page = 1; if root.favorites-category == 0 { root.favorites-only = true; root.all-library-requested(); } } } }
                        }
                    }
                    if root.library-sidebar-page == 0: Action { height: 32px * Theme.ui-scale; active: root.selected-folder-path == "" && root.album-filter == "" && root.album-filter-id == "" && !root.album-filter-unavailable && !root.favorites-only; enabled: !root.background-blocked; label: root.chinese ? "全部声音" : "All sounds"; clicked => { root.favorites-only = false; root.all-library-requested(); } }
                    if root.library-sidebar-page == 1: VerticalLayout { spacing: 5px * Theme.ui-scale;
                        Action { height: 30px * Theme.ui-scale; active: root.favorites-category == 0; enabled: !root.background-blocked; label: root.chinese ? "单个音频" : "Audio files"; action-label: root.chinese ? "音频收藏分类" : "Audio favorites category"; clicked => { root.favorites-category = 0; root.favorites-only = true; root.all-library-requested(); } }
                        Action { height: 30px * Theme.ui-scale; active: root.favorites-category == 1; enabled: !root.background-blocked; label: root.chinese ? "搜索任务" : "Search tasks"; action-label: root.chinese ? "搜索任务收藏分类" : "Search task favorites category"; clicked => { root.favorites-category = 1; } }
                    }
                    if root.library-sidebar-page == 1 && root.favorites-category == 0: Label { height: 54px * Theme.ui-scale; text: root.chinese ? "收藏的音频显示在声音列表中。" : "Favorite audio files appear in the sound list."; wrap: word-wrap; }
                    if root.library-sidebar-page == 1 && root.favorites-category == 1: ScrollView { vertical-stretch: 1; min-height: 0px; viewport-width: self.visible-width;
                        VerticalLayout { padding: 0px; spacing: 5px * Theme.ui-scale; alignment: start;
                            if root.saved-search-tasks.length == 0: Label { height: 70px * Theme.ui-scale; text: root.chinese ? "点击声音列表右上角的 ☆ 收藏当前搜索任务，之后可在这里重新打开。" : "Star the current search above the sound list to reopen it here later."; wrap: word-wrap; }
                            for saved in root.saved-search-tasks: Rectangle { height: 58px * Theme.ui-scale; border-radius: 5px * Theme.ui-scale; background: saved-hit.has-hover ? Theme.hover : Theme.raised;
                                accessible-role: button; accessible-label: (root.chinese ? "打开搜索任务收藏：" : "Open saved search: ") + saved.name; accessible-enabled: !root.background-blocked && !root.search-workspace-read-only;
                                accessible-action-default => { if !root.background-blocked && !root.search-workspace-read-only { root.saved-search-opened(saved.id); } }
                                forward-focus: saved-focus; border-width: saved-focus.has-focus ? 1px : 0px; border-color: Theme.accent;
                                saved-focus := FocusScope { enabled: !root.background-blocked && !root.search-workspace-read-only; focus-on-click: false; key-pressed(event) => {
                                    if event.text == " " || event.text == Key.Return { root.saved-search-opened(saved.id); return accept; }
                                    if event.text == Key.F2 { root.begin-search-task-rename(saved.id, saved.name, true); return accept; }
                                    reject
                                } }
                                VerticalLayout { padding: 8px * Theme.ui-scale; padding-right: 34px * Theme.ui-scale; spacing: 3px * Theme.ui-scale;
                                    Text { text: saved.name; color: Theme.ink; font-size: Theme.font(12); overflow: elide; }
                                    Text { text: saved.summary; color: Theme.muted; font-size: Theme.font(10); overflow: elide; }
                                }
                                saved-hit := TouchArea { width: parent.width - 32px * Theme.ui-scale; enabled: !root.background-blocked && !root.search-workspace-read-only; mouse-cursor: pointer; clicked => { root.saved-search-opened(saved.id); } }
                                Action { width: 28px * Theme.ui-scale; height: 28px * Theme.ui-scale; x: parent.width - self.width - 3px * Theme.ui-scale; y: 5px * Theme.ui-scale; subtle: true;
                                    label: "..."; action-label: (root.chinese ? "管理搜索任务收藏：" : "Manage saved search: ") + saved.name; enabled: !root.background-blocked && !root.search-workspace-read-only;
                                    clicked => {
                                        root.context-saved-search = saved;
                                        saved-search-menu.show({x: self.absolute-position.x - saved-search-menu.absolute-position.x, y: self.absolute-position.y + self.height - saved-search-menu.absolute-position.y});
                                    }
                                }
                            }
                        }
                    }
                    if root.library-sidebar-page == 1 && root.favorites-category == 0: Rectangle { vertical-stretch: 1; }
                    directory-sections := Rectangle {
                        visible: root.library-sidebar-page == 0;
                        vertical-stretch: root.library-sidebar-page == 0 ? 1 : 0;
                        min-height: root.library-sidebar-page == 0 ? self.fixed-height + (root.folders-section-expanded ? 68px * Theme.ui-scale : 0px) + (self.libraries-expanded ? 60px * Theme.ui-scale : 0px) : 0px;
                        max-height: root.library-sidebar-page == 0 ? 100000px : 0px;
                        private property <bool> has-libraries: root.albums.length > 0;
                        private property <bool> libraries-expanded: self.has-libraries && root.libraries-section-expanded;
                        private property <bool> both-expanded: root.folders-section-expanded && self.libraries-expanded;
                        private property <length> header-height: 24px * Theme.ui-scale;
                        private property <length> list-gap: 4px * Theme.ui-scale;
                        private property <length> divider-height: self.both-expanded ? 12px * Theme.ui-scale : (self.has-libraries ? 8px * Theme.ui-scale : 0px);
                        private property <length> fixed-height: self.header-height * (self.has-libraries ? 2 : 1) + (root.folders-section-expanded ? self.list-gap : 0px) + (self.libraries-expanded ? self.list-gap : 0px) + self.divider-height;
                        private property <length> list-budget: max(0px, self.height - self.fixed-height);
                        private property <length> folder-height: !root.folders-section-expanded ? 0px : !self.libraries-expanded ? self.list-budget : clamp(self.list-budget * clamp(root.folders-section-ratio, 0.1, 0.9), 68px * Theme.ui-scale, max(68px * Theme.ui-scale, self.list-budget - 60px * Theme.ui-scale));
                        SidebarSectionHeader {
                            x: 0px; y: 0px;
                            width: parent.width; height: directory-sections.header-height;
                            label: root.chinese ? "文件夹" : "FOLDERS"; suffix: "WAV / BWF";
                            action-label: root.chinese ? "文件夹分区" : "Folders section";
                            expanded: root.folders-section-expanded; enabled: !root.background-blocked;
                            toggled => { root.folders-section-expanded = !root.folders-section-expanded; root.pane-layout-changed(); }
                        }
                        // Keep two directory rows usable while the album list shares a short sidebar.
                        folder-focus := FocusScope {
                            x: 0px; y: directory-sections.header-height + (root.folders-section-expanded ? directory-sections.list-gap : 0px);
                            width: parent.width; height: directory-sections.folder-height;
                            visible: root.folders-section-expanded; enabled: !root.background-blocked && root.library-sidebar-page == 0 && root.folders-section-expanded;
                            key-pressed(event) => {
                                let index = clamp(root.selected-folder, 0, root.folders.length - 1);
                                if root.folders.length == 0 { return reject; }
                                if event.text == Key.DownArrow || event.text == Key.UpArrow {
                                    root.folder-requested(clamp(index + (event.text == Key.DownArrow ? 1 : -1), 0, root.folders.length - 1)); return accept;
                                }
                                if event.text == Key.LeftArrow {
                                    if root.folders[index].expanded { root.folder-toggle-requested(index); } return accept;
                                }
                                if event.text == Key.RightArrow {
                                    if root.folders[index].has-children && !root.folders[index].expanded { root.folder-toggle-requested(index); }
                                    else if root.folders[index].expanded && index + 1 < root.folders.length { root.folder-requested(index + 1); } return accept;
                                }
                                if event.text == Key.Return || event.text == " " { root.folder-requested(index); return accept; }
                                if event.text == Key.Home { root.folder-requested(0); return accept; }
                                if event.text == Key.End { root.folder-requested(root.folders.length - 1); return accept; }
                                reject
                            }
                        folder-list := ListView { viewport-width: self.visible-width; accessible-role: list; accessible-label: root.chinese ? "音效文件夹" : "Sound folders";
                            for folder[index] in root.folders: Rectangle { height: 34px * Theme.ui-scale; border-radius: 4px * Theme.ui-scale; accessible-role: list-item; accessible-label: (root.chinese ? "文件夹：" : "Folder: ") + folder.name;
                                border-width: folder-focus.has-focus && root.selected-folder == index ? 1px : 0px; border-color: Theme.accent;
                                // Fluent overlays a fixed 14px scrollbar (not affected by Theme.ui-scale); the 18px * ui-scale padding reserves its track plus a gap and never shrinks below that at scale >= 1.0.
                                background: root.selected-folder == index ? Theme.selected : (folder-hit.has-hover ? Theme.raised : transparent);
                                HorizontalLayout { spacing: 4px * Theme.ui-scale; padding-right: 18px * Theme.ui-scale;
                                    // Keep a readable name and count even in a narrow, deep folder tree.
                                    folder-indent := Rectangle { width: clamp(folder.depth * 10px * Theme.ui-scale, 0px, max(0px, parent.width - max(28px * Theme.ui-scale, folder-count.preferred-width) - 18px * Theme.ui-scale - 17px * Theme.ui-scale - 12px * Theme.ui-scale - 40px * Theme.ui-scale)); }
                                    Rectangle { width: 17px * Theme.ui-scale;
                                        Text { text: folder.has-children ? (folder.expanded ? "−" : "+") : "·"; color: Theme.dim; vertical-alignment: center; horizontal-alignment: center; }
                                        TouchArea { mouse-cursor: pointer; clicked => { folder-focus.focus(); root.folder-toggle-requested(index); } }
                                    }
                                    Text { horizontal-stretch: 1; min-width: 0px; text: folder.name; color: Theme.ink; overflow: elide; vertical-alignment: center; font-size: Theme.font(11); }
                                    folder-count := Label { min-width: 28px * Theme.ui-scale; horizontal-stretch: 0; text: folder.count; horizontal-alignment: right; }
                                }
                                folder-hit := TouchArea { x: folder-indent.width + 22px * Theme.ui-scale; width: max(0px, parent.width - 18px * Theme.ui-scale - self.x); mouse-cursor: pointer;
                                    clicked => { folder-focus.focus(); root.folder-requested(index); }
                                    double-clicked => { if folder.has-children { folder-focus.focus(); root.folder-toggle-requested(index); } }
                                    pointer-event(event) => { if event.button == PointerEventButton.right && event.kind == PointerEventKind.down { root.show-folder-menu(folder, {x: self.absolute-position.x + self.mouse-x, y: self.absolute-position.y + self.mouse-y}); } }
                                }
                            }
                        }
                        }
                        if directory-sections.both-expanded: SidebarSectionDivider {
                            width: parent.width; height: directory-sections.divider-height;
                            y: folder-focus.y + folder-focus.height;
                            pane-height: directory-sections.folder-height; enabled: !root.background-blocked;
                            label: root.chinese ? "调整文件夹和音效库高度" : "Resize folder and library heights";
                            help: root.chinese ? "拖动调整文件夹和音效库高度；上下方向键微调" : "Drag to resize folder and library heights; Up/Down keys adjust height";
                            resized(height) => { root.folders-section-ratio = clamp(clamp(height, 68px * Theme.ui-scale, max(68px * Theme.ui-scale, directory-sections.list-budget - 60px * Theme.ui-scale)) / max(1px, directory-sections.list-budget), 0.1, 0.9); }
                            finished => { root.pane-layout-changed(); }
                        }
                        // Library/album groups declared by the files themselves. Clicking one
                        // filters the results; clicking the active one clears the filter.
                        libraries-header := SidebarSectionHeader {
                            visible: directory-sections.has-libraries;
                            width: parent.width; height: directory-sections.has-libraries ? directory-sections.header-height : 0px;
                            y: folder-focus.y + folder-focus.height + directory-sections.divider-height;
                            label: root.chinese ? "音效库" : "LIBRARIES";
                            action-label: root.chinese ? "音效库分区" : "Libraries section";
                            expanded: root.libraries-section-expanded; enabled: !root.background-blocked && directory-sections.has-libraries;
                            toggled => { root.libraries-section-expanded = !root.libraries-section-expanded; root.pane-layout-changed(); }
                        }
                        album-list := ListView {
                            x: 0px; y: libraries-header.y + libraries-header.height + (directory-sections.libraries-expanded ? directory-sections.list-gap : 0px);
                            width: parent.width; height: directory-sections.libraries-expanded ? directory-sections.list-budget - directory-sections.folder-height : 0px;
                            visible: directory-sections.libraries-expanded;
                            viewport-width: self.visible-width; accessible-role: list;
                            for album[index] in root.albums: Rectangle { height: 30px * Theme.ui-scale; border-radius: 4px * Theme.ui-scale;
                                background: !root.album-filter-unavailable && root.album-filter-id == album.id ? Theme.selected : (album-hit.has-hover ? Theme.raised : transparent);
                                HorizontalLayout { spacing: 6px * Theme.ui-scale; padding-right: 18px * Theme.ui-scale; alignment: start;
                                    Image { visible: root.artwork-enabled; width: 20px * Theme.ui-scale; height: 20px * Theme.ui-scale; image-fit: cover; source: album.cover; }
                                    Text { horizontal-stretch: 1; min-width: 0px; text: album.name; color: Theme.ink; overflow: elide; vertical-alignment: center; font-size: Theme.font(11); }
                                    Label { min-width: 34px * Theme.ui-scale; text: album.count; horizontal-alignment: right; }
                                }
                                album-hit := TouchArea { enabled: !root.background-blocked; mouse-cursor: pointer; clicked => { root.album-selected(album.id); } }
                            }
                        }
                    }
                    if root.library-sidebar-page == 0: Label { height: (root.short-layout ? 24px : 34px) * Theme.ui-scale; text: root.chinese ? "双击展开/折叠 · 右键管理" : "Double-click to toggle · Right-click to manage"; wrap: word-wrap; font-size: Theme.font(10); }
                }
            }
            PaneDivider {
                pane-width: root.sidebar-width; enabled: !root.background-blocked;
                label: root.chinese ? "调整素材库侧栏宽度" : "Resize library sidebar";
                resized(width) => { root.sidebar-preferred-width = clamp(width, 170px * Theme.ui-scale, min(480px * Theme.ui-scale, root.sidebar-budget - (root.inspector-visible ? root.inspector-width : 0px))); }
                finished => { root.pane-layout-changed(); }
            }
            results-column := VerticalLayout { horizontal-stretch: 1; min-width: 520px * Theme.ui-scale; spacing: 6px * Theme.ui-scale;
                HorizontalLayout { height: 32px * Theme.ui-scale; spacing: 6px * Theme.ui-scale;
                    if root.checked-count <= 1: Text { horizontal-stretch: 1; min-width: 0px; overflow: elide; text: root.favorites-only ? (root.chinese ? "我的收藏" : "Favorites") : (root.chinese ? "声音列表" : "Sounds"); color: Theme.ink; font-size: Theme.font(14); font-weight: 600; vertical-alignment: center; }
                    if root.checked-count > 1: selection-actions := Action {
                        width: 108px * Theme.ui-scale; active: true; dropdown: true;
                        label: root.checked-count + (root.chinese ? " 条已选" : " selected");
                        clicked => { selection-menu.show({x: self.absolute-position.x, y: self.absolute-position.y + self.height}); }
                    }
                    if root.checked-count > 1 && root.wide-layout: Action { width: 86px * Theme.ui-scale; enabled: !root.background-blocked && !root.remote-writes-blocked && !root.metadata-writes-blocked; label: root.chinese ? "批量标注" : "Batch edit"; clicked => { root.open-batch(); } }
                    if root.checked-count > 1 && root.wide-layout: Action { width: 64px * Theme.ui-scale; subtle: true; enabled: !root.background-blocked && root.removal-allowed; label: root.chinese ? "移除" : "Remove"; clicked => { root.library-action(11); } }
                    if root.checked-count > 1: Rectangle { horizontal-stretch: 1; }
                    // File status lives in the Library menu and sorting in the table headers;
                    // The current task favorite shares the filter/details icon treatment.
                    Rectangle { y: (parent.height - self.height) / 2; height: 30px * Theme.ui-scale; background: Theme.trough; border-radius: 7px * Theme.ui-scale; border-width: 1px; border-color: Theme.border;
                        accessible-role: none;
                        HorizontalLayout { padding: 2px * Theme.ui-scale; spacing: 2px * Theme.ui-scale;
                            if root.search-tasks.length > root.active-search-task-index: IconSegment {
                                private property <SearchTaskRow> task: root.search-tasks[root.active-search-task-index];
                                icon: self.task.favorite ? @image-url("icons/task-star-filled.svg") : @image-url("icons/task-star.svg");
                                label: (self.task.favorite ? (root.chinese ? "取消搜索任务收藏：" : "Unfavorite search task: ") : (root.chinese ? "收藏搜索任务：" : "Favorite search task: ")) + self.task.name + (self.task.modified ? (root.chinese ? "（条件已修改，右键收藏可更新）" : " (changed; update from saved search menu)") : "");
                                active: self.task.favorite;
                                enabled: !root.background-blocked && !root.search-workspace-read-only;
                                clicked => { root.search-task-favorite-toggled(self.task.id); }
                            }
                            IconSegment { icon: @image-url("icons/filter.svg"); label: root.chinese ? "筛选" : "Filters"; active: root.inspector-visible && root.filters-visible; count: root.filter-count; clicked => { root.show-sidebar-page(true); } }
                            IconSegment { icon: @image-url("icons/details.svg"); label: root.chinese ? "详情" : "Details"; active: root.inspector-visible && !root.filters-visible; clicked => { root.show-sidebar-page(false); } }
                        }
                    }
                }
                if root.crumbs.length > 0: HorizontalLayout { height: 30px * Theme.ui-scale; spacing: 4px * Theme.ui-scale;
                    Action { width: 64px * Theme.ui-scale; subtle: true; label: root.chinese ? "素材库" : "Library"; clicked => { root.all-library-requested(); } }
                    // Deep hierarchies remain navigable without forcing the window wider.
                    ScrollView { horizontal-stretch: 1; viewport-height: 30px * Theme.ui-scale;
                        HorizontalLayout { spacing: 4px * Theme.ui-scale;
                            for crumb[index] in root.crumbs: HorizontalLayout {
                                Label { width: 10px * Theme.ui-scale; text: "›"; horizontal-alignment: center; }
                                Action { subtle: true; label: crumb.name; width: 110px * Theme.ui-scale; clicked => { root.crumb-requested(index); } }
                            }
                        }
                    }
                }
                // Above 1.0, keeps the sound list usable; the main view scrolls for the rest. At 1.0 the
                // compact 1080x700 layout keeps fitting without scrolling; filters live in the sidebar.
                results-panel := Rectangle { vertical-stretch: 1; min-height: root.results-panel-min-height; clip: true; border-width: 1px; border-color: Theme.border; border-radius: 7px * Theme.ui-scale; background: Theme.panel;
                    VerticalLayout { spacing: 0px;
                        Rectangle { height: 33px * Theme.ui-scale; background: Theme.raised; clip: true;
                            // Both empty and populated results share the header's horizontal position.
                            Rectangle { x: root.table-viewport-x; width: root.table-content-size; height: parent.height;
                                if root.list-waveforms-visible: table-wave-header := Text {
                                    x: 8px * Theme.ui-scale; width: root.table-wave-size - 16px * Theme.ui-scale; height: parent.height;
                                    text: root.chinese ? "波形" : "WAVE"; font-size: Theme.font(10); color: Theme.dim;
                                    overflow: elide; vertical-alignment: center;
                                    accessible-role: text; accessible-label: root.chinese ? "波形" : "Waveform";
                                }
                                table-name-header := TableHeader {
                                    x: root.table-wave-size; width: root.table-name-size - 8px * Theme.ui-scale; height: parent.height;
                                    label: root.chinese ? "文件名" : "NAME";
                                    action-label: root.chinese ? "按文件名排序" : "Sort by filename";
                                    help: root.chinese ? "按文件名排序；再次点击切换升序 / 降序" : "Sort by filename; click again to reverse ascending / descending";
                                    active: root.sort-index == 1; descending: root.sort-descending; enabled: !root.background-blocked;
                                    clicked => { root.sort-table(1); } context-requested(position) => { root.show-table-menu(position); }
                                }
                                table-duration-header := TableHeader {
                                    x: root.table-wave-size + root.table-name-size; width: root.table-duration-size - 8px * Theme.ui-scale; height: parent.height;
                                    label: root.chinese ? "时长" : "TIME";
                                    action-label: root.chinese ? "按时长排序" : "Sort by duration";
                                    help: root.chinese ? "按时长排序；再次点击切换升序 / 降序" : "Sort by duration; click again to reverse ascending / descending";
                                    active: root.sort-index == 2; descending: root.sort-descending; enabled: !root.background-blocked;
                                    clicked => { root.sort-table(2); } context-requested(position) => { root.show-table-menu(position); }
                                }
                                table-format-header := TableHeader {
                                    x: root.table-wave-size + root.table-name-size + root.table-duration-size; width: root.table-format-size - 8px * Theme.ui-scale; height: parent.height;
                                    label: root.chinese ? "格式" : "FORMAT";
                                    action-label: root.chinese ? "按采样率排序" : "Sort by sample rate";
                                    help: root.chinese ? "按采样率排序；再次点击切换升序 / 降序" : "Sort by sample rate; click again to reverse ascending / descending";
                                    active: root.sort-index == 3; descending: root.sort-descending; enabled: !root.background-blocked;
                                    clicked => { root.sort-table(3); } context-requested(position) => { root.show-table-menu(position); }
                                }
                                table-channels-header := TableHeader {
                                    x: root.table-wave-size + root.table-name-size + root.table-duration-size + root.table-format-size; width: root.table-channels-size - 8px * Theme.ui-scale; height: parent.height;
                                    label: root.chinese ? "声道" : "CH";
                                    action-label: root.chinese ? "按声道排序" : "Sort by channels";
                                    help: root.chinese ? "按声道数排序；再次点击切换升序 / 降序" : "Sort by channel count; click again to reverse ascending / descending";
                                    active: root.sort-index == 4; descending: root.sort-descending; enabled: !root.background-blocked;
                                    clicked => { root.sort-table(4); } context-requested(position) => { root.show-table-menu(position); }
                                }
                                table-tags-header := TableHeader {
                                    x: root.table-wave-size + root.table-name-size + root.table-duration-size + root.table-format-size + root.table-channels-size; width: root.table-tags-size - 8px * Theme.ui-scale; height: parent.height;
                                    label: root.chinese ? "标签" : "TAGS";
                                    action-label: root.chinese ? "按标签排序" : "Sort by tags";
                                    help: root.chinese ? "按素材库标签排序，空白时使用源标签；再次点击切换升序 / 降序" : "Sort by library tags, using source tags when empty; click again to reverse ascending / descending";
                                    active: root.sort-index == 5; descending: root.sort-descending; enabled: !root.background-blocked;
                                    clicked => { root.sort-table(5); } context-requested(position) => { root.show-table-menu(position); }
                                }
                                // Informational column: albums are filtered from the sidebar.
                                Text {
                                    x: root.table-wave-size + root.table-name-size + root.table-duration-size + root.table-format-size + root.table-channels-size + root.table-tags-size + 12px * Theme.ui-scale;
                                    width: root.table-album-size - 24px * Theme.ui-scale; height: parent.height;
                                    text: root.chinese ? "专辑" : "ALBUM"; color: Theme.dim; vertical-alignment: center;
                                    font-size: Theme.font(10); overflow: elide;
                                }
                                table-name-divider := TableDivider {
                                    x: root.table-wave-size + root.table-name-size - 8px * Theme.ui-scale; height: parent.height; column-width: root.table-name-size;
                                    label: root.chinese ? "调整文件名列宽" : "Resize Filename column"; help: root.table-resize-help; enabled: !root.background-blocked;
                                    resized(width) => { root.resize-table-column(1, width); } finished => { root.table-layout-changed(); }
                                    reset => { root.table-name-width = 360; root.table-layout-changed(); }
                                }
                                table-duration-divider := TableDivider {
                                    x: root.table-wave-size + root.table-name-size + root.table-duration-size - 8px * Theme.ui-scale; height: parent.height; column-width: root.table-duration-size;
                                    label: root.chinese ? "调整时长列宽" : "Resize Duration column"; help: root.table-resize-help; enabled: !root.background-blocked;
                                    resized(width) => { root.resize-table-column(2, width); } finished => { root.table-layout-changed(); }
                                    reset => { root.table-duration-width = 80; root.table-layout-changed(); }
                                }
                                table-format-divider := TableDivider {
                                    x: root.table-wave-size + root.table-name-size + root.table-duration-size + root.table-format-size - 8px * Theme.ui-scale; height: parent.height; column-width: root.table-format-size;
                                    label: root.chinese ? "调整格式列宽" : "Resize Format column"; help: root.table-resize-help; enabled: !root.background-blocked;
                                    resized(width) => { root.resize-table-column(3, width); } finished => { root.table-layout-changed(); }
                                    reset => { root.table-format-width = 100; root.table-layout-changed(); }
                                }
                                table-channels-divider := TableDivider {
                                    x: root.table-wave-size + root.table-name-size + root.table-duration-size + root.table-format-size + root.table-channels-size - 8px * Theme.ui-scale; height: parent.height; column-width: root.table-channels-size;
                                    label: root.chinese ? "调整声道列宽" : "Resize Channels column"; help: root.table-resize-help; enabled: !root.background-blocked;
                                    resized(width) => { root.resize-table-column(4, width); } finished => { root.table-layout-changed(); }
                                    reset => { root.table-channels-width = 64; root.table-layout-changed(); }
                                }
                                table-tags-divider := TableDivider {
                                    x: root.table-columns-size - 8px * Theme.ui-scale; height: parent.height; column-width: root.table-tags-size;
                                    label: root.chinese ? "调整标签列宽" : "Resize Tags column"; help: root.table-resize-help; enabled: !root.background-blocked;
                                    resized(width) => { root.resize-table-column(5, width); } finished => { root.table-layout-changed(); }
                                    reset => { root.table-tags-width = 160; root.table-layout-changed(); }
                                }
                            }
                        }
                        results-focus := FocusScope { vertical-stretch: 1; min-height: 0px; focus-on-click: false;
                            key-pressed(event) => {
                                if event.text == Key.DownArrow || event.text == Key.UpArrow {
                                    let step = event.text == Key.DownArrow ? 1 : -1;
                                    if event.modifiers.shift && root.rows.length > 0 {
                                        root.user-row-clicked(clamp(root.selected-row + step, 0, root.rows.length - 1), event.modifiers.control, true, false);
                                    } else { root.user-selection-step(step); }
                                    return accept;
                                }
                                if event.text == Key.PageUp || event.text == Key.PageDown {
                                    if event.modifiers.control {
                                        if event.text == Key.PageUp && root.can-previous { root.page-requested(-1); }
                                        if event.text == Key.PageDown && root.can-next { root.page-requested(1); }
                                    } else if root.rows.length > 0 {
                                        let step = max(1, floor(result-list.visible-height / root.classic-result-row-height));
                                        root.user-row-clicked(clamp(root.selected-row + (event.text == Key.PageDown ? step : -step), 0, root.rows.length - 1), event.modifiers.control, event.modifiers.shift, false);
                                    }
                                    return accept;
                                }
                                if (event.text == Key.Home || event.text == Key.End) && root.rows.length > 0 {
                                    root.user-row-clicked(event.text == Key.Home ? 0 : root.rows.length - 1, event.modifiers.control, event.modifiers.shift, false); return accept;
                                }
                                if event.text == " " && root.audio-ready { root.play-requested(); return accept; }
                                if event.text == Key.Return && root.selected-row >= 0 { root.audition-requested(root.selected-row); return accept; }
                                if (event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift)) && root.selected-row >= 0 {
                                    root.show-file-menu(root.rows[root.selected-row], {x: self.absolute-position.x + 80px * Theme.ui-scale, y: self.absolute-position.y + 40px * Theme.ui-scale}); return accept;
                                }
                                reject
                            }
                            // Keep the delegate directly under ListView for virtualization.
                            result-list := ListView {
                                visible: !root.table-empty;
                                viewport-width: root.table-content-size;
                                viewport-x: root.table-viewport-x;
                                // A newly populated repeater measures its width after becoming
                                // visible. Ignore its temporary empty-range clamp until then.
                                changed viewport-x => { if !Theme.modern-style { if !root.table-empty && abs(self.viewport-width - root.table-content-size) < 1px { root.table-viewport-x = self.viewport-x; } } }
                                changed viewport-y => { if !Theme.modern-style { root.track-result-scroll(); } }
                                scrolled => {
                                    root.cancel-workbench-switch();
                                    // Real input takes over from a pending programmatic restore.
                                    if root.task-viewport-pending {
                                        root.result-scroll-epoch += 1;
                                        root.task-viewport-pending = false;
                                        root.task-restoring = false;
                                    }
                                    root.result-user-scrolling = true;
                                    result-scroll-timer.running = true;
                                    result-scroll-timer.restart();
                                }
                                changed visible-height => { if !Theme.modern-style { root.report-result-window(); } }
                                changed viewport-width => { if !Theme.modern-style { if !root.table-empty && abs(self.viewport-width - root.table-content-size) < 1px { root.sync-table-viewport(); } } }
                                // Fixed child layout widths let ListView measure its horizontal scroll extent.
                                for row[index] in root.rows: Rectangle { width: root.table-content-size; height: root.classic-result-row-height; accessible-role: list-item; accessible-label: row.name;
                                    background: row.checked ? (root.selected-row == index ? Theme.selected : Theme.checked) : (result-hit.has-hover ? Theme.hover : (Math.mod(index, 2) == 0 ? Theme.alternate : Theme.panel));
                                    Rectangle { x: 0px; y: 0px; height: parent.height; width: 3px * Theme.ui-scale; background: root.selected-row == index ? Theme.accent : row.marker; }
                                    HorizontalLayout { alignment: start; padding-left: 12px * Theme.ui-scale; padding-right: 12px * Theme.ui-scale; spacing: 24px * Theme.ui-scale;
                                        if root.list-waveforms-visible: table-wave-cell := Rectangle { width: root.table-wave-size - 24px * Theme.ui-scale;
                                            accessible-role: none;
                                            // Placeholder until loaded; no Waveform is a fainter short bar.
                                            if row.wave-state == 0 || row.wave-state == 3: Rectangle {
                                                width: row.wave-state == 0 ? parent.width : parent.width * 0.4; height: 4px * Theme.ui-scale; border-radius: 2px * Theme.ui-scale;
                                                background: Theme.border; opacity: row.wave-state == 0 ? 1 : 0.5;
                                            }
                                            // Empty file: a plain grey centre line.
                                            if row.wave-state == 2: Rectangle {
                                                width: parent.width; height: 1px; background: Theme.dim; opacity: 0.6;
                                            }
                                            // Plain grey min/max bars, rendered at the window scale (pixel-exact).
                                            if row.wave-state == 1: Image {
                                                width: parent.width; height: parent.height - 4px * Theme.ui-scale;
                                                source: row.wave; image-fit: fill; image-rendering: pixelated;
                                            }
                                            // Root offline: the stale copy dimmed under a warning tint.
                                            if row.wave-state == 4: Rectangle {
                                                width: parent.width; height: parent.height - 4px * Theme.ui-scale; border-radius: 2px * Theme.ui-scale;
                                                background: Theme.warning.with-alpha(0.12);
                                                Rectangle { width: parent.width; height: 1px; background: Theme.warning; opacity: 0.5; }
                                                Image {
                                                    width: parent.width; height: parent.height;
                                                    source: row.wave; image-fit: fill; image-rendering: smooth; opacity: 0.45;
                                                }
                                            }
                                        }
                                        table-name-cell := Text { width: root.table-name-size - 24px * Theme.ui-scale; text: (row.missing ? (root.chinese ? "[缺失] " : "[Missing] ") : "") + row.name; color: row.missing ? Theme.warning : Theme.ink; font-size: Theme.list-font-size; overflow: elide; vertical-alignment: center; }
                                        table-duration-cell := Text { width: root.table-duration-size - 24px * Theme.ui-scale; text: row.duration; color: Theme.ink; horizontal-alignment: right; vertical-alignment: center; font-size: Theme.list-font(11); overflow: elide; }
                                        table-format-cell := Text { width: root.table-format-size - 24px * Theme.ui-scale; text: row.format; color: Theme.dim; vertical-alignment: center; font-size: Theme.list-font(10); overflow: elide; }
                                        table-channels-cell := Text { width: root.table-channels-size - 24px * Theme.ui-scale; text: row.channels; color: Theme.dim; vertical-alignment: center; font-size: Theme.list-font(11); overflow: elide; }
                                        table-tags-cell := Text { width: root.table-tags-size - 24px * Theme.ui-scale; text: row.tags; color: Theme.dim; vertical-alignment: center; overflow: elide; font-size: Theme.list-font(10); }
                                        table-album-cell := Text { width: root.table-album-size - 24px * Theme.ui-scale; text: row.album; color: Theme.dim; vertical-alignment: center; overflow: elide; font-size: Theme.list-font(10); }
                                    }
                                    result-hit := TouchArea { mouse-cursor: pointer;
                                        property <bool> toggle-selection;
                                        property <bool> range-selection;
                                        // One drag-out request per press, after a small movement threshold.
                                        property <bool> drag-sent;
                                        moved => {
                                            if self.pressed && !self.drag-sent && !row.missing && !self.toggle-selection && !self.range-selection && (abs(self.mouse-x - self.pressed-x) > 6px * Theme.ui-scale || abs(self.mouse-y - self.pressed-y) > 6px * Theme.ui-scale) {
                                                self.drag-sent = true;
                                                root.drag-out-requested(row.id);
                                            }
                                        }
                                        clicked => {
                                            results-focus.focus();
                                            root.user-row-clicked(index, self.toggle-selection, self.range-selection, root.audition-play-on-single-click && !row.missing && !self.toggle-selection && !self.range-selection && !self.drag-sent);
                                        }
                                        // Slint also emits clicked on the second release. In single-click
                                        // mode that click already owns playback, so do not request it again.
                                        double-clicked => { if !root.audition-play-on-single-click && !row.missing && !self.toggle-selection && !self.range-selection && !self.drag-sent { root.selected-row = index; root.audition-requested(index); } }
                                        pointer-event(event) => {
                                            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                                self.toggle-selection = event.modifiers.control;
                                                self.range-selection = event.modifiers.shift;
                                                self.drag-sent = false;
                                            }
                                            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down { results-focus.focus(); root.show-file-menu(row, {x: self.absolute-position.x + self.mouse-x, y: self.absolute-position.y + self.mouse-y}); }
                                        }
                                    }
                                }
                            }
                            // Slint 1.17's empty ListView repeater resets its viewport width to
                            // the visible width. A separate viewport preserves the real column
                            // extent without adding a synthetic AudioRow to the result model.
                            empty-result-list := ScrollView {
                                visible: root.table-empty;
                                viewport-width: root.table-content-size;
                                viewport-height: self.visible-height;
                                viewport-x: root.table-viewport-x;
                                changed viewport-x => { if !Theme.modern-style { if root.table-empty { root.table-viewport-x = self.viewport-x; } } }
                                Rectangle { width: root.table-content-size; height: empty-result-list.visible-height; }
                            }
                            if root.rows.length == 0: VerticalLayout { padding: 24px * Theme.ui-scale; alignment: center; spacing: 12px * Theme.ui-scale;
                                Text { text: root.searching ? (root.chinese ? "正在搜索…" : "Searching…") : (root.chinese ? "这里还没有声音" : "No sounds in this view"); color: Theme.ink; horizontal-alignment: center; font-size: Theme.font(18); }
                                Label { text: root.visibility-index == 1 ? (root.chinese ? "当前仅显示缺失文件，没有匹配的记录。" : "No matching missing files. Only missing records are shown.") : root.query != "" || root.filter-count > 0 || root.favorites-only || root.selected-folder-path != "" ? (root.chinese ? "当前搜索、目录或筛选没有匹配的声音。" : "No sounds match the current search, folder or filters.") : (root.chinese ? "音效库中还没有声音。添加 WAV 文件夹开始使用。" : "Your library has no sounds yet. Add a WAV folder to get started."); horizontal-alignment: center; wrap: word-wrap; }
                                Action { width: 140px * Theme.ui-scale; label: root.chinese ? "清除搜索和筛选" : "Clear search & filters"; clicked => { root.query = ""; root.favorites-only = false; root.reset-filters(); root.all-library-requested(); } }
                            }
                        }
                        Rectangle { height: 34px * Theme.ui-scale; background: Theme.raised;
                            HorizontalLayout { padding-left: 10px * Theme.ui-scale; padding-right: 5px * Theme.ui-scale; spacing: 5px * Theme.ui-scale;
                                Action { width: 96px * Theme.ui-scale; subtle: true; enabled: root.rows.length > 0; label: root.chinese ? "选择已加载" : "Select loaded"; clicked => { root.check-page-requested(true); } }
                                CheckBox { width: root.chinese ? 104px * Theme.ui-scale : 142px * Theme.ui-scale; enabled: !root.background-blocked; surface: Theme.raised; text: root.chinese ? "单击播放" : "Single-click play"; checked <=> root.audition-play-on-single-click; toggled => { root.single-click-play-requested(self.checked); } }
                                table-columns-action := Action {
                                    width: root.chinese ? 54px * Theme.ui-scale : 78px * Theme.ui-scale; subtle: true; dropdown: true; enabled: !root.background-blocked;
                                    label: root.chinese ? "列" : "Columns";
                                    action-label: root.chinese ? "列宽、波形与排序设置" : "Column widths, Waveforms and sorting";
                                    clicked => { root.show-table-menu({x: self.absolute-position.x, y: self.absolute-position.y + self.height}); }
                                }
                                if root.visibility-index != 0: ScopeHint {
                                    y: (parent.height - self.height) / 2; enabled: !root.background-blocked;
                                    label: root.visibility-index == 1 ? (root.chinese ? "仅缺失文件" : "Missing only") : (root.chinese ? "含缺失文件" : "Incl. missing");
                                    action-label: root.chinese ? "恢复显示存在的文件" : "Show present files";
                                    clicked => { root.visibility-index = 0; root.filter-requested(); }
                                }
                                if root.sort-index == 6: ScopeHint {
                                    y: (parent.height - self.height) / 2; enabled: !root.background-blocked;
                                    label: (root.chinese ? "按修改时间" : "By modified") + (root.sort-descending ? " ↓" : " ↑");
                                    action-label: root.chinese ? "恢复默认排序" : "Restore default order";
                                    clicked => { root.sort-table(0); }
                                }
                                Label { horizontal-stretch: 1; min-width: 0px; text: root.result-summary; overflow: elide; font-size: Theme.font(10); }
                                Action { width: 30px * Theme.ui-scale; enabled: root.can-previous && !root.searching; label: "‹"; clicked => { root.page-requested(-1); } }
                                Label { width: 72px * Theme.ui-scale; text: root.page-label; horizontal-alignment: center; }
                                Action { width: 30px * Theme.ui-scale; enabled: root.can-next && !root.searching; label: "›"; clicked => { root.page-requested(1); } }
                            }
                        }
                    }
                }
            }
            if root.inspector-visible: PaneDivider {
                pane-width: root.inspector-width; reverse: true; enabled: !root.background-blocked;
                label: root.chinese ? "调整声音详情宽度" : "Resize sound details";
                resized(width) => { root.inspector-preferred-width = clamp(width, 240px * Theme.ui-scale, min(600px * Theme.ui-scale, root.sidebar-budget - root.sidebar-width)); }
                finished => { root.pane-layout-changed(); }
            }
            if root.inspector-visible: details-sidebar := Rectangle { width: root.inspector-width; background: Theme.panel; border-radius: 7px * Theme.ui-scale; border-width: 1px; border-color: Theme.border; clip: true;
                VerticalLayout { padding: 10px * Theme.ui-scale; spacing: 8px * Theme.ui-scale;
                    // The page switch: a recessed track with the selected page raised. Closing
                    // the sidebar is the list header switch (or Ctrl+I); per-sound actions such
                    // as the favorite live in the details content, not on this level.
                    Rectangle { height: root.short-layout ? 30px * Theme.ui-scale : 34px * Theme.ui-scale; background: Theme.trough; border-radius: 8px * Theme.ui-scale;
                        accessible-role: tab-list; accessible-label: root.chinese ? "侧栏页面" : "Side panel pages";
                        HorizontalLayout { padding: 3px * Theme.ui-scale; spacing: 3px * Theme.ui-scale;
                            SegmentTab { horizontal-stretch: 1; preferred-width: 0px; icon: @image-url("icons/filter.svg"); active: root.filters-visible; count: root.filter-count; label: root.chinese ? "筛选" : "Filters"; action-label: root.chinese ? "筛选页" : "Filters page"; clicked => { root.filters-visible = true; } }
                            SegmentTab { horizontal-stretch: 1; preferred-width: 0px; icon: @image-url("icons/details.svg"); active: !root.filters-visible; label: root.chinese ? "详情" : "Details"; action-label: root.chinese ? "声音详情页" : "Sound details page"; clicked => { root.filters-visible = false; } }
                        }
                    }
                    // Form rows: one label column, controls aligned to its right edge.
                    if root.filters-visible: filters-scroll := ScrollView { vertical-stretch: 1; min-height: 0px; viewport-width: self.visible-width; viewport-y: root.task-filter-viewport-y; changed viewport-y => { if !Theme.modern-style { root.task-filter-viewport-y = self.viewport-y; } }
                        property <int> restore-revision: root.task-sidebar-restore-revision;
                        changed restore-revision => { if !Theme.modern-style { self.viewport-y = clamp(root.task-filter-viewport-y, min(0px, self.visible-height - self.viewport-height), 0px); } }
                        VerticalLayout { spacing: 14px * Theme.ui-scale; padding-right: 4px * Theme.ui-scale; alignment: start;
                            VerticalLayout { spacing: 6px * Theme.ui-scale;
                                Label { height: 16px * Theme.ui-scale; text: root.chinese ? "格式" : "FORMAT"; font-size: Theme.font(10); }
                                HorizontalLayout { spacing: 8px * Theme.ui-scale;
                                    Label { width: root.filter-label-width; text: root.chinese ? "采样率" : "Sample rate"; }
                                    ComboBox { horizontal-stretch: 1; min-width: 0px; model: root.chinese ? ["全部", "44.1 kHz", "48 kHz", "88.2 kHz", "96 kHz", "192 kHz"] : ["Any", "44.1 kHz", "48 kHz", "88.2 kHz", "96 kHz", "192 kHz"]; current-index <=> root.sample-filter; selected => { root.filter-requested(); } }
                                }
                                HorizontalLayout { spacing: 8px * Theme.ui-scale;
                                    Label { width: root.filter-label-width; text: root.chinese ? "位深" : "Bit depth"; }
                                    ComboBox { horizontal-stretch: 1; min-width: 0px; model: root.chinese ? ["全部", "16 bit", "24 bit", "32 bit"] : ["Any", "16 bit", "24 bit", "32 bit"]; current-index <=> root.bit-filter; selected => { root.filter-requested(); } }
                                }
                                HorizontalLayout { spacing: 8px * Theme.ui-scale;
                                    Label { width: root.filter-label-width; text: root.chinese ? "声道" : "Channels"; }
                                    ComboBox { horizontal-stretch: 1; min-width: 0px; model: root.chinese ? ["全部", "单声道", "立体声", "4 声道", "6 声道", "8 声道"] : ["Any", "Mono", "Stereo", "4 channels", "6 channels", "8 channels"]; current-index <=> root.channel-filter; selected => { root.filter-requested(); } }
                                }
                                HorizontalLayout { spacing: 8px * Theme.ui-scale;
                                    Label { width: root.filter-label-width; text: root.chinese ? "时长（秒）" : "Seconds"; }
                                    LineEdit { horizontal-stretch: 1; min-width: 0px; input-label: root.chinese ? "最短时长（秒）" : "Minimum duration (seconds)"; text <=> root.duration-min; placeholder-text: root.chinese ? "最短" : "Min"; accepted => { root.apply-filters(); } }
                                    Label { text: "–"; }
                                    LineEdit { horizontal-stretch: 1; min-width: 0px; input-label: root.chinese ? "最长时长（秒）" : "Maximum duration (seconds)"; text <=> root.duration-max; placeholder-text: root.chinese ? "最长" : "Max"; accepted => { root.apply-filters(); } }
                                }
                            }
                            Rectangle { height: 1px; background: Theme.border; }
                            VerticalLayout { spacing: 6px * Theme.ui-scale;
                                Label { height: 16px * Theme.ui-scale; text: root.chinese ? "标注" : "ANNOTATIONS"; font-size: Theme.font(10); }
                                HorizontalLayout { spacing: 8px * Theme.ui-scale;
                                    // Top-aligned with the tag field rather than the whole block.
                                    Label { width: root.filter-label-width; height: 32px * Theme.ui-scale; text: root.chinese ? "标签" : "Tags"; }
                                    VerticalLayout { horizontal-stretch: 1; spacing: 6px * Theme.ui-scale;
                                        FocusScope {
                                            focus-on-click: false;
                                            focus-on-tab-navigation: false;
                                            // Spans the chip column; Rust wraps chips to this width.
                                            init => { if !Theme.modern-style { root.tag-chip-area-width = self.width; } }
                                            changed width => { if !Theme.modern-style { root.tag-chip-area-width = self.width; } }
                                            property <int> restore-revision: root.task-sidebar-restore-revision;
                                            changed restore-revision => { if !Theme.modern-style { root.tag-chip-area-width = self.width; } }
                                            capture-key-pressed(event) => {
                                                if event.text == Key.Backspace && root.tag-draft == "" && root.tag-term-count > 0 {
                                                    root.tag-term-removed(-1);
                                                    return accept;
                                                }
                                                reject
                                            }
                                            HorizontalLayout { padding: 0px;
                                                tag-input := LineEdit {
                                                    min-width: 0px; text <=> root.tag-draft;
                                                    input-label: root.chinese ? "标签筛选：+ 包含，- 排除，回车添加" : "Tag filter: + include, - exclude, Enter adds";
                                                    placeholder-text: root.chinese ? "+包含 -排除，回车添加" : "+include -exclude, Enter adds";
                                                    accepted => { root.apply-filters(); }
                                                }
                                            }
                                        }
                                        if root.tag-chip-rows.length > 0: VerticalLayout { spacing: root.tag-chip-spacing;
                                            accessible-role: list;
                                            accessible-label: root.chinese ? "标签筛选条件" : "Tag filter terms";
                                            for row in root.tag-chip-rows: HorizontalLayout { spacing: root.tag-chip-spacing; alignment: start;
                                                for chip in row.chips: TagChipView {
                                                    text: chip.text; exclude: chip.exclude; chinese: root.chinese; enabled: !root.background-blocked;
                                                    toggle => { root.tag-term-toggled(chip.index); }
                                                    remove => { root.tag-term-removed(chip.index); }
                                                }
                                            }
                                        }
                                        CheckBox { height: 24px * Theme.ui-scale; text: root.chinese ? "有标签" : "Tagged only"; checked <=> root.tagged-only; toggled => { root.filter-requested(); } }
                                    }
                                }
                                HorizontalLayout { spacing: 8px * Theme.ui-scale;
                                    Label { width: root.filter-label-width; text: root.chinese ? "颜色" : "Color"; }
                                    Rectangle { width: 22px * Theme.ui-scale; height: 22px * Theme.ui-scale; y: (parent.height - self.height) / 2;
                                        border-radius: 4px * Theme.ui-scale; border-width: 1px;
                                        border-color: root.color-filter != "" && !root.color-filter-valid ? Theme.warning : Theme.strong-border;
                                        background: root.color-filter-valid ? root.color-filter-swatch : transparent;
                                    }
                                    LineEdit { horizontal-stretch: 1; min-width: 0px; input-label: root.chinese ? "颜色 #RRGGBB" : "Color #RRGGBB"; text <=> root.color-filter; placeholder-text: "#RRGGBB"; accepted => { root.apply-filters(); } }
                                }
                            }
                        }
                    }
                    if root.filters-visible: HorizontalLayout { height: 30px * Theme.ui-scale; spacing: 6px * Theme.ui-scale;
                        Rectangle { horizontal-stretch: 1; }
                        Action { width: 58px * Theme.ui-scale; label: root.chinese ? "重置" : "Reset"; clicked => { root.reset-filters(); } }
                        Action { width: 64px * Theme.ui-scale; primary: true; label: root.chinese ? "应用" : "Apply"; clicked => { root.apply-filters(); } }
                    }
                    if !root.filters-visible && !root.has-selection: VerticalLayout { spacing: 6px * Theme.ui-scale; padding-top: 12px * Theme.ui-scale;
                        Text { text: root.chinese ? "选择一个声音" : "Select a sound"; color: Theme.ink; font-size: Theme.font(14); }
                        Text { text: root.chinese ? "在列表中选择文件，查看信息或编辑标注。" : "Select a file to inspect its details and edit annotations."; color: Theme.dim; font-size: Theme.font(11); wrap: word-wrap; }
                        Rectangle { vertical-stretch: 1; }
                    }
                    if !root.filters-visible && root.has-selection: inspector-scroll := ScrollView { vertical-stretch: 1; min-height: 0px; viewport-width: self.visible-width; viewport-y: root.task-inspector-viewport-y; changed viewport-y => { if !Theme.modern-style { root.task-inspector-viewport-y = self.viewport-y; } }
                        property <int> restore-revision: root.task-sidebar-restore-revision;
                        changed restore-revision => { if !Theme.modern-style { self.viewport-y = clamp(root.task-inspector-viewport-y, min(0px, self.visible-height - self.viewport-height), 0px); } }
                        property <string> displayed-id: root.selected-id;
                        changed displayed-id => { if !Theme.modern-style { if !root.task-restoring { self.viewport-y = 0px; } } }
                        VerticalLayout { spacing: root.short-layout ? 4px * Theme.ui-scale : 7px * Theme.ui-scale; padding-right: 4px * Theme.ui-scale; alignment: start;
                            // The favorite belongs to this sound, so it sits beside its name.
                            HorizontalLayout { spacing: 6px * Theme.ui-scale;
                                Text { horizontal-stretch: 1; min-width: 0px; height: root.short-layout ? 22px * Theme.ui-scale : 40px * Theme.ui-scale; text: root.selected-name; color: Theme.ink; font-size: Theme.font(13); font-weight: 600; wrap: word-wrap; overflow: elide; }
                                // Sized to the compact name row so short windows lose no detail space.
                                ChipButton {
                                    width: 24px * Theme.ui-scale; height: 22px * Theme.ui-scale; border-radius: 11px * Theme.ui-scale;
                                    enabled: !root.background-blocked && !root.remote-writes-blocked && !root.metadata-writes-blocked;
                                    glyph: root.edit-favorite ? "★" : "☆"; glyph-color: root.edit-favorite ? Theme.accent : Theme.dim;
                                    label: root.edit-favorite ? (root.chinese ? "取消收藏" : "Remove from favorites") : (root.chinese ? "收藏" : "Add to favorites");
                                    clicked => { root.edit-favorite = !root.edit-favorite; root.metadata-dirty = true; root.metadata-edited(); }
                                }
                            }
                            Label { height: root.short-layout ? 16px * Theme.ui-scale : 28px * Theme.ui-scale; text: root.selected-format; color: Theme.accent; wrap: word-wrap; overflow: elide; font-size: Theme.font(10); }
                            // The file's own Library/album, as declared by the pack (Boom-style).
                            if root.selected-album != "": VerticalLayout { spacing: 4px * Theme.ui-scale;
                                Label { height: 16px * Theme.ui-scale; text: root.chinese ? "音效库" : "LIBRARY"; font-size: Theme.font(10); }
                                Text { text: root.selected-album; color: Theme.ink; font-size: Theme.font(11); wrap: word-wrap; overflow: elide; }
                            }
                            // Embedded cover; hidden while the file declares none.
                            Image {
                                visible: root.artwork-enabled && root.album-cover-ready;
                                horizontal-stretch: 1;
                                min-width: 0px;
                                height: root.artwork-enabled && root.album-cover-ready ? 160px * Theme.ui-scale : 0px;
                                image-fit: contain;
                                source: root.album-cover;
                            }
                            if root.selected-missing: VerticalLayout { spacing: 6px * Theme.ui-scale;
                                Text { text: root.chinese ? "原位置找不到此文件。选择移动或改名后的 WAV，保留已有标注。" : "File missing at its original location. Locate the moved or renamed WAV to keep its annotations."; color: Theme.warning; font-size: Theme.font(11); wrap: word-wrap; }
                                Action { height: 32px * Theme.ui-scale; primary: true; enabled: !root.closing && !root.library-busy; label: root.chinese ? "选择新位置，修复引用…" : "Locate file and repair…"; clicked => { root.file-action-requested(root.selected-id, 20); } }
                            }
                            Rectangle { height: 1px; background: Theme.border; }
                            if root.selected-description != "": VerticalLayout { spacing: 4px * Theme.ui-scale;
                                Label { height: 16px * Theme.ui-scale; text: root.chinese ? "描述" : "DESCRIPTION"; font-size: Theme.font(10); }
                                source-description := TextEdit {
                                    height: root.short-layout ? 56px * Theme.ui-scale : 96px * Theme.ui-scale;
                                    accessible-label: root.chinese ? "源文件描述" : "Source description";
                                    read-only: true; text: root.selected-description;
                                    property <string> displayed-id: root.selected-id;
                                    changed displayed-id => { if !Theme.modern-style {
                                        self.set-selection-offsets(0, 0);
                                        self.viewport-x = 0px;
                                        self.viewport-y = 0px;
                                    } }
                                }
                            }
                            if root.selected-source-tags != "": VerticalLayout { spacing: 4px * Theme.ui-scale;
                                Label { height: 16px * Theme.ui-scale; text: root.chinese ? "提取的标签" : "EXTRACTED TAGS"; font-size: Theme.font(10); }
                                source-tags := SourceTags { height: root.short-layout ? 44px * Theme.ui-scale : 64px * Theme.ui-scale; label: root.chinese ? "提取的标签" : "Extracted tags"; text: root.selected-source-tags; displayed-id: root.selected-id; }
                            }
                            Rectangle { height: 1px; background: Theme.border; }
                            HorizontalLayout { height: 30px * Theme.ui-scale; spacing: 8px * Theme.ui-scale;
                                Label { width: 34px * Theme.ui-scale; text: root.chinese ? "标签" : "Tags"; }
                                LineEdit { min-width: 0px; input-label: root.chinese ? "标签 · 逗号分隔" : "Tags, comma separated"; enabled: !root.background-blocked && !root.remote-writes-blocked && !root.metadata-writes-blocked; text <=> root.edit-tags; placeholder-text: root.chinese ? "标签，用逗号分隔" : "Tags, comma separated"; edited => { root.metadata-dirty = true; root.metadata-edited(); } }
                            }
                            Action { height: 30px * Theme.ui-scale; subtle: true; active: root.notes-visible; label: (root.notes-visible ? "−  " : "+  ") + (root.chinese ? "备注" : "Notes") + (root.edit-notes == "" ? "" : " ·"); clicked => { root.notes-visible = !root.notes-visible; } }
                            if root.notes-visible: TextEdit { height: 62px * Theme.ui-scale; accessible-label: root.chinese ? "备注" : "Notes"; enabled: !root.background-blocked && !root.remote-writes-blocked && !root.metadata-writes-blocked; text <=> root.edit-notes; edited => { root.metadata-dirty = true; root.metadata-edited(); } }
                            Label { height: 16px * Theme.ui-scale; text: root.chinese ? "文件路径" : "FILE PATH"; font-size: Theme.font(10); }
                            ScrollView { height: root.short-layout ? 36px * Theme.ui-scale : 48px * Theme.ui-scale; viewport-width: self.visible-width;
                                VerticalLayout { padding: 0px; alignment: start;
                                    TextInput { accessible-label: root.chinese ? "文件路径" : "File path"; read-only: true; single-line: false; wrap: char-wrap; font-size: Theme.font(10); color: Theme.dim; selection-background-color: Theme.accent; selection-foreground-color: Theme.on-accent; text: root.selected-path; }
                                }
                            }
                            Action { height: 30px * Theme.ui-scale; subtle: true; active: root.source-metadata-visible; label: (root.source-metadata-visible ? "−  " : "+  ") + (root.chinese ? "原始 Metadata（含 SMED）" : "Source Metadata / SMED"); clicked => { root.source-metadata-visible = !root.source-metadata-visible; } }
                            if root.source-metadata-visible: TextEdit { height: root.short-layout ? 100px * Theme.ui-scale : 160px * Theme.ui-scale; font-size: Theme.font(10); accessible-label: root.chinese ? "源文件 Metadata" : "Source Metadata"; read-only: true; text: root.selected-attributes == "" || root.selected-attributes == "{}" ? (root.chinese ? "无嵌入 Metadata" : "No embedded Metadata") : root.selected-attributes; }
                        }
                    }
                    if !root.filters-visible && root.has-selection: Label { text: root.chinese ? "切换音效时自动保存 · Ctrl S 立即保存" : "Auto-saves when switching sounds · Ctrl S saves now"; wrap: word-wrap; font-size: Theme.font(10); }
                    if !root.filters-visible && root.has-selection: HorizontalLayout { height: 30px * Theme.ui-scale; spacing: 6px * Theme.ui-scale;
                        Label { horizontal-stretch: 1; text: root.metadata-dirty ? (root.chinese ? "待自动保存" : "Pending auto-save") : root.remote-mode ? (root.chinese ? "已保存到服务器" : "Saved to server") : (root.chinese ? "已保存到素材库" : "Saved to library"); color: root.metadata-dirty ? Theme.warning : Theme.dim; font-size: Theme.font(10); }
                        Action { width: 58px * Theme.ui-scale; enabled: root.metadata-dirty && !root.background-blocked; label: root.chinese ? "还原" : "Revert"; clicked => { root.restore-metadata(); } }
                        Action { width: 82px * Theme.ui-scale; primary: root.metadata-dirty; subtle: !root.metadata-dirty; enabled: root.metadata-dirty && !root.closing && !root.library-busy && !root.remote-writes-blocked && !root.metadata-writes-blocked; label: root.chinese ? "立即保存" : "Save now"; clicked => { root.save-metadata-requested(); } }
                    }
                }
            }
        }

        audition := AuditionPanel {
            active: !Theme.modern-style;
            premute-db <=> root.audition-premute-db;
            show-remaining <=> root.audition-show-remaining;
            height: (root.short-layout ? 190px : 222px) * Theme.ui-scale;
            expanded: root.audition-expanded;
            narrow: root.content-width < 1440px * Theme.ui-scale;
            waveform-mask: root.waveform-mask;
            expanded-requested(value) => {
                root.audition-expanded = value;
                root.audition-preferred-height = (value ? 260px : 88px) * Theme.ui-scale;
            }
            compact: root.short-layout; spectral: root.peak-mode == 1;
            play-on-single-click: root.audition-play-on-single-click;
            chinese: root.chinese; ready: root.audio-ready && !root.selected-missing && !root.library-busy;
            missing: root.selected-missing; busy: root.library-busy;
            state: root.playback-state; error-text: root.playback-error; buffering: root.playback-buffering;
            waveform-progress: root.waveform-progress;
            output-backend: root.output-backend; output-rate: root.output-rate; output-xruns: root.output-xruns;
            target-start: root.wave-target-start; target-end: root.wave-target-end;
            relink-enabled: !root.closing && !root.library-busy && root.has-selection;
            playing: root.playing; smooth-progress: root.playback-smooth; progress-clock: root.playback-clock; playback-rate: root.confirmed-playback-rate; waveform: root.waveform-image; waveform-ready: root.waveform-ready;
            name: root.playback-name; info: root.waveform-info; output: root.output-summary;
            position: root.play-position; duration: root.play-duration; time: root.play-time; end-time: root.play-end;
            view-start: root.view-start; view-end: root.view-end; zoom: root.wave-zoom; ruler-ticks: root.ruler-ticks;
            scroll <=> root.wave-scroll; volume-db <=> root.volume-db; volume-label: root.volume-label;
            pitch-text <=> root.pitch-text; rate-text <=> root.speed-text; mono <=> root.audition-mono; repeat <=> root.audition-repeat;
            play => { root.start-requested(); } pause => { root.pause-requested(); } stop => { root.stop-requested(); }
            seek(value) => { root.seek-requested(value); }
            seek-play(value) => { root.seek-play-requested(value); }
            transform(pitch,rate,mono,repeat) => { root.transform-requested(pitch,rate,mono,repeat); }
            volume(value) => { root.volume-db-requested(value); }
            resize(w,h) => { root.waveform-resize-requested(w,h); }
            zoom-change(factor) => { root.waveform-zoom-requested(factor); }
            zoom-at(factor,fraction) => { root.waveform-wheel-zoom-requested(factor,fraction); }
            pan(value) => { root.waveform-pan-requested(value); }
            peaks => {
                if Theme.modern-style {
                    root.audition-expanded = true;
                    root.audition-preferred-height = max(root.audition-preferred-height, 260px * Theme.ui-scale);
                }
                root.peaks-visible = true;
            }
            output-settings => { root.settings-page = 0; root.output-settings-requested(); root.settings-visible = true; }
            retry => { if root.selected-row >= 0 { root.audition-requested(root.selected-row); } else { root.start-requested(); } }
            relink => { root.file-action-requested(root.selected-id, 20); }
        }
        status-row := HorizontalLayout { height: 16px * Theme.ui-scale;
            Label { horizontal-stretch: 1; min-width: 0px; text: root.drag-preparing && root.drag-progress != "" ? root.drag-progress : root.status; overflow: elide; font-size: Theme.font(10); }
            if root.drag-preparing: Rectangle { width: 52px * Theme.ui-scale;
                accessible-role: button;
                accessible-label: root.chinese ? "取消拖出" : "Cancel drag";
                accessible-action-default => { root.drag-cancel-requested(); }
                Text { text: root.chinese ? "取消" : "Cancel"; color: Theme.accent; font-size: Theme.font(10); horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { mouse-cursor: pointer; clicked => { root.drag-cancel-requested(); } }
            }
            Label { width: 300px * Theme.ui-scale; text: root.scanning ? (root.chinese ? "正在扫描音效文件夹" : "Scanning sound folder") : "WAV / BWF"; horizontal-alignment: right; font-size: Theme.font(10); }
        }
    }
    }
    studio-main-scroll := ScrollView {
    visible: Theme.modern-style;
    width: parent.width; height: parent.height;
    viewport-width: max(self.visible-width, studio-main-layout.min-width);
    viewport-height: max(self.visible-height, studio-main-layout.min-height);
    studio-main-layout := VerticalLayout {
        width: studio-main-scroll.viewport-width; height: studio-main-scroll.viewport-height;
        padding: 4px * Theme.ui-scale;
        padding-top: 0px;
        padding-bottom: 2px * Theme.ui-scale;
        spacing: 3px * Theme.ui-scale;
        // One workbench toolbar; the operating system retains its own window controls.
        Rectangle { height: 56px * Theme.ui-scale; background: Theme.toolbar-surface;
            Image { x: 0px; y: 0px; width: parent.width; height: parent.height; source: Theme.toolbar-backdrop; image-fit: fill; accessible-role: none; }
            HorizontalLayout { padding-left: 8px * Theme.ui-scale; padding-right: 8px * Theme.ui-scale; spacing: 8px * Theme.ui-scale;
                HorizontalLayout { spacing: 10px * Theme.ui-scale; horizontal-stretch: 0;
                    Image { width: 34px * Theme.ui-scale; height: 34px * Theme.ui-scale; y: (parent.height - self.height) / 2; source: @image-url("../../../resources/icons/AudioLibExplorer.png"); image-fit: contain; accessible-role: none; }
                    Text { text: "AudioLib"; color: Theme.ink; font-size: Theme.font(20); font-weight: 500; vertical-alignment: center; }
                }
                VerticalLayout { alignment: center; horizontal-stretch: 0;
                HorizontalLayout { height: 32px * Theme.ui-scale; spacing: 0px;
                    MenuBarItem { label: root.chinese ? "文件" : "File"; enabled: root.menu-ready; clicked => { global-menu-file.show({x: self.absolute-position.x - global-menu-file.absolute-position.x, y: self.absolute-position.y + self.height - global-menu-file.absolute-position.y}); } }
                    MenuBarItem { label: root.chinese ? "编辑" : "Edit"; enabled: root.menu-ready; clicked => { global-menu-edit.show({x: self.absolute-position.x - global-menu-edit.absolute-position.x, y: self.absolute-position.y + self.height - global-menu-edit.absolute-position.y}); } }
                    MenuBarItem { label: root.chinese ? "视图" : "View"; enabled: root.menu-ready; clicked => { global-menu-view.show({x: self.absolute-position.x - global-menu-view.absolute-position.x, y: self.absolute-position.y + self.height - global-menu-view.absolute-position.y}); } }
                    MenuBarItem { label: root.chinese ? "播放" : "Playback"; enabled: root.menu-ready; clicked => { global-menu-playback.show({x: self.absolute-position.x - global-menu-playback.absolute-position.x, y: self.absolute-position.y + self.height - global-menu-playback.absolute-position.y}); } }
                    MenuBarItem { label: root.chinese ? "帮助" : "Help"; enabled: root.menu-ready; clicked => { global-menu-help.show({x: self.absolute-position.x - global-menu-help.absolute-position.x, y: self.absolute-position.y + self.height - global-menu-help.absolute-position.y}); } }
                    MenuBarItem { label: root.chinese ? "音效库" : "Library"; enabled: root.menu-ready; clicked => { global-menu-library.show({x: self.absolute-position.x - global-menu-library.absolute-position.x, y: self.absolute-position.y + self.height - global-menu-library.absolute-position.y}); } }
                    MenuBarItem { label: root.chinese ? "扫描" : "Scan"; enabled: root.menu-ready; clicked => { global-menu-scan.show({x: self.absolute-position.x - global-menu-scan.absolute-position.x, y: self.absolute-position.y + self.height - global-menu-scan.absolute-position.y}); } }
                }
                }
                Rectangle { horizontal-stretch: 1; min-width: 220px * Theme.ui-scale; height: 34px * Theme.ui-scale; y: (parent.height - self.height) / 2;
                    background: Theme.panel; border-radius: 4px * Theme.ui-scale; border-width: 1px; border-color: studio-search-input.has-focus ? Theme.accent : Theme.strong-border.with-alpha(0.5);
                    HorizontalLayout { padding: 2px * Theme.ui-scale; padding-left: 10px * Theme.ui-scale; spacing: 6px * Theme.ui-scale;
                        Image { width: 17px * Theme.ui-scale; source: @image-url("../assets/search.svg"); colorize: Theme.dim; image-fit: contain; accessible-role: none; }
                        studio-search-input := LineEdit { horizontal-stretch: 1; min-width: 70px * Theme.ui-scale; enabled: !root.background-blocked; text <=> root.query;
                            placeholder-text: root.chinese ? "搜索声音、标签和 Metadata…" : "Search sounds, tags and Metadata…";
                            edited => { root.search-requested(false); }
                            accepted => { root.search-requested(true); }
                        }
                        if root.query != "": StudioAction { width: 26px * Theme.ui-scale; subtle: true; label: "×"; action-label: root.chinese ? "清空" : "Clear"; clicked => { root.query = ""; root.search-requested(true); studio-search-input.focus(); } }
                        if root.content-width >= 1280px * Theme.ui-scale: Label { width: 40px * Theme.ui-scale; text: "Ctrl F"; horizontal-alignment: center; font-size: Theme.font(10); }
                        StudioAction { width: 48px * Theme.ui-scale; subtle: true; label: root.searching ? "…" : (root.chinese ? "搜索" : "Go"); action-label: root.chinese ? "执行搜索" : "Run search"; clicked => { root.search-requested(true); } }
                    }
                }
                Rectangle { width: root.chinese ? 106px * Theme.ui-scale : 118px * Theme.ui-scale;
                    accessible-role: button; accessible-label: root.data-source-label; accessible-enabled: root.menu-ready;
                    accessible-action-default => { if root.menu-ready { root.open-data-source(); } }
                    border-width: studio-source-label-focus.has-focus ? 1px : 0px; border-color: Theme.accent;
                    studio-source-label-focus := FocusScope { enabled: root.menu-ready; focus-on-click: false; key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.open-data-source(); return accept; } reject } }
                    HorizontalLayout { spacing: 7px * Theme.ui-scale; alignment: center;
                        Rectangle { width: 7px * Theme.ui-scale; height: self.width; y: (parent.height - self.height) / 2; border-radius: self.width / 2; background: (root.remote-mode ? 2 : 0) == 3 || root.remote-writes-blocked ? Theme.warning : (!root.remote-mode || (root.remote-mode ? 2 : 0) == 2 ? Theme.accent : Theme.muted); }
                        Label { text: (root.remote-mode ? (root.chinese ? "服务器" : "Server") : (root.chinese ? "本地音效库" : "Local library")); font-size: Theme.font(11); }
                    }
                    Tooltip { text: @markdown("\{root.data-source-label}"); }
                    TouchArea { mouse-cursor: pointer; clicked => { if root.menu-ready { root.open-data-source(); } } }
                }
                StudioAction { width: 86px * Theme.ui-scale; height: 32px * Theme.ui-scale; y: (parent.height - self.height) / 2; subtle: true; enabled: root.menu-ready; label: root.chinese ? "管理音效库" : "Manage library"; clicked => { root.open-library(0); } }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
        }
        if root.remote-mode && root.remote-notice != "": Rectangle { height: 34px * Theme.ui-scale; background: Theme.panel; border-radius: 6px * Theme.ui-scale; border-width: 1px; border-color: root.remote-notice-kind == 1 ? Theme.accent : Theme.warning;
            HorizontalLayout { padding-left: 10px * Theme.ui-scale; padding-right: 2px * Theme.ui-scale; padding-top: 2px * Theme.ui-scale; padding-bottom: 2px * Theme.ui-scale; spacing: 8px * Theme.ui-scale;
                Text { horizontal-stretch: 1; min-width: 0px; text: root.remote-notice; color: root.remote-notice-kind == 1 ? Theme.accent : Theme.warning; font-size: Theme.font(11); vertical-alignment: center; overflow: elide; }
                if root.remote-notice-kind != 0: StudioAction { width: 96px * Theme.ui-scale; primary: root.remote-notice-kind == 1; enabled: root.menu-ready && !root.ds-syncing; label: root.remote-notice-kind == 1 ? (root.ds-sync-paused ? (root.chinese ? "继续同步" : "Continue") : (root.chinese ? "同步" : "Sync")) : root.remote-notice-kind == 3 ? (root.chinese ? "设置…" : "Settings…") : (root.chinese ? "立即重试" : "Retry now"); clicked => { root.remote-notice-action(); } }
                StudioAction { width: 30px * Theme.ui-scale; subtle: true; label: "×"; accessible-label: root.chinese ? "关闭提示" : "Dismiss notice"; clicked => { root.remote-notice-dismissed(); } }
            }
        }
        if root.scanning: Rectangle { height: 76px * Theme.ui-scale; background: Theme.panel; border-radius: 7px * Theme.ui-scale; border-width: 1px; border-color: Theme.accent;
            HorizontalLayout { padding: 10px * Theme.ui-scale; spacing: 12px * Theme.ui-scale;
                VerticalLayout { horizontal-stretch: 1; min-width: 0px; spacing: 4px * Theme.ui-scale;
                    Text { text: root.scan-summary; color: Theme.accent; font-size: Theme.font(12); wrap: word-wrap; overflow: elide; }
                    Text { height: 18px * Theme.ui-scale; text: root.scan-current-path; color: Theme.muted; font-size: Theme.font(10); overflow: elide; }
                }
                StudioAction { width: 112px * Theme.ui-scale; height: 32px * Theme.ui-scale; enabled: root.scan-controllable && !root.scan-validating && !root.background-blocked; label: root.scan-paused ? (root.chinese ? "继续扫描" : "Resume scan") : (root.chinese ? "暂停扫描" : "Pause scan"); clicked => { root.scan-pause-requested(); } }
                StudioAction { width: 112px * Theme.ui-scale; height: 32px * Theme.ui-scale; enabled: root.scan-controllable && !root.background-blocked; label: root.scan-cancelling ? (root.chinese ? "正在取消…" : "Cancelling…") : (root.chinese ? "取消扫描" : "Cancel scan"); clicked => { root.scan-cancel-requested(); } }
            }
        }
        // Workspace recovery remains visible above all three panes.
        if root.search-workspace-error != "": Rectangle {
            vertical-stretch: 0; min-height: 34px * Theme.ui-scale;
            background: Theme.danger-surface; border-width: 1px; border-color: Theme.warning; border-radius: 6px * Theme.ui-scale;
            VerticalLayout { padding: 8px * Theme.ui-scale;
                Text { text: root.search-workspace-error; color: Theme.warning; font-size: Theme.font(11); wrap: word-wrap; }
            }
        }
        studio-workspace := HorizontalLayout { vertical-stretch: 1; min-height: studio-results-column.min-height; spacing: 0px;
            studio-navigation-rail := Rectangle { width: 56px * Theme.ui-scale; background: Theme.rail-surface;
                Image { x: 0px; y: 0px; width: parent.width; height: parent.height; source: Theme.rail-backdrop; image-fit: fill; accessible-role: none; }
                VerticalLayout { padding: 6px * Theme.ui-scale; padding-top: 16px * Theme.ui-scale; spacing: 12px * Theme.ui-scale; alignment: start;
                    StudioIconSegment { width: 42px * Theme.ui-scale; height: 42px * Theme.ui-scale; icon: @image-url("icons/home.svg"); label: root.chinese ? "全部声音" : "All sounds"; enabled: !root.background-blocked; clicked => { root.library-sidebar-page = 0; root.favorites-only = false; root.all-library-requested(); } }
                    StudioIconSegment { width: 42px * Theme.ui-scale; height: 42px * Theme.ui-scale; icon: @image-url("icons/folder.svg"); label: root.chinese ? "显示 / 收起素材目录" : "Show / hide library sidebar"; active: root.sidebar-visible && root.library-sidebar-page == 0; enabled: !root.background-blocked; clicked => { if root.library-sidebar-page != 0 { root.sidebar-visible = true; root.library-sidebar-page = 0; } else { root.sidebar-visible = !root.sidebar-visible; } } }
                    StudioIconSegment { width: 42px * Theme.ui-scale; height: 42px * Theme.ui-scale; icon: @image-url("icons/star.svg"); label: root.chinese ? "收藏页" : "Favorites page"; active: root.library-sidebar-page == 1; enabled: !root.background-blocked; clicked => { root.sidebar-visible = true; root.library-sidebar-page = 1; root.favorites-category = 0; root.favorites-only = true; root.all-library-requested(); } }
                    StudioIconSegment { width: 42px * Theme.ui-scale; height: 42px * Theme.ui-scale; icon: @image-url("icons/history.svg"); label: root.chinese ? "最近播放" : "Recent playback"; enabled: !root.background-blocked; clicked => { root.open-history(1); } }
                    StudioIconSegment { width: 42px * Theme.ui-scale; height: 42px * Theme.ui-scale; icon: @image-url("icons/settings.svg"); label: root.chinese ? "外观设置" : "Appearance settings"; enabled: !root.background-blocked; clicked => { root.settings-page = 1; root.settings-visible = true; } }
                    Rectangle { vertical-stretch: 1; }
                }
            }
            studio-library-sidebar := Rectangle { visible: root.sidebar-visible; width: root.sidebar-width; background: Theme.library-surface; border-radius: 3px * Theme.ui-scale; clip: true;
                Image { x: 0px; y: 0px; width: parent.width; height: parent.height; source: Theme.library-backdrop; image-fit: fill; accessible-role: none; }
                VerticalLayout { padding: 12px * Theme.ui-scale; padding-top: (root.short-layout ? 8px : 12px) * Theme.ui-scale; padding-bottom: (root.short-layout ? 8px : 12px) * Theme.ui-scale; spacing: (root.short-layout ? 4px : 8px) * Theme.ui-scale;
                    HorizontalLayout { height: 32px * Theme.ui-scale; spacing: 8px * Theme.ui-scale;
                        Image { width: 18px * Theme.ui-scale; source: @image-url("icons/folder.svg"); colorize: Theme.accent; image-fit: contain; accessible-role: none; }
                        Text { text: root.chinese ? "音效库" : "Library"; color: Theme.ink; font-size: Theme.font(14); font-weight: 600; vertical-alignment: center; }
                    }
                    StudioAction { height: 34px * Theme.ui-scale; navigation: true; icon: @image-url("icons/folder.svg"); active: root.library-sidebar-page == 0 && root.selected-folder-path == "" && root.album-filter == "" && root.album-filter-id == "" && !root.album-filter-unavailable && !root.favorites-only; enabled: !root.background-blocked; label: root.chinese ? "全部声音" : "All sounds"; action-label: root.chinese ? "目录页" : "Folders page"; clicked => { root.library-sidebar-page = 0; root.favorites-only = false; root.all-library-requested(); } }
                    StudioAction { height: 34px * Theme.ui-scale; navigation: true; icon: @image-url("icons/star.svg"); active: root.library-sidebar-page == 1; enabled: !root.background-blocked; label: root.chinese ? "收藏" : "Favorites"; action-label: root.chinese ? "我的收藏" : "My favorites"; clicked => { root.library-sidebar-page = 1; root.favorites-category = 0; root.favorites-only = true; root.all-library-requested(); } }
                    StudioAction { height: 34px * Theme.ui-scale; navigation: true; subtle: true; icon: @image-url("icons/history.svg"); enabled: !root.background-blocked; label: root.chinese ? "最近使用" : "Recent playback"; clicked => { root.open-history(1); } }
                    if root.library-sidebar-page == 1: VerticalLayout { spacing: 5px * Theme.ui-scale;
                        StudioAction { height: 30px * Theme.ui-scale; navigation: true; icon: @image-url("icons/star.svg"); active: root.favorites-category == 0; enabled: !root.background-blocked; label: root.chinese ? "单个音频" : "Audio files"; action-label: root.chinese ? "音频收藏分类" : "Audio favorites category"; clicked => { root.favorites-category = 0; root.favorites-only = true; root.all-library-requested(); } }
                        StudioAction { height: 30px * Theme.ui-scale; navigation: true; icon: @image-url("icons/details.svg"); active: root.favorites-category == 1; enabled: !root.background-blocked; label: root.chinese ? "搜索任务" : "Search tasks"; action-label: root.chinese ? "搜索任务收藏分类" : "Search task favorites category"; clicked => { root.favorites-category = 1; } }
                    }
                    if root.library-sidebar-page == 1 && root.favorites-category == 0: Label { height: 54px * Theme.ui-scale; text: root.chinese ? "收藏的音频显示在声音列表中。" : "Favorite audio files appear in the sound list."; wrap: word-wrap; }
                    if root.library-sidebar-page == 1 && root.favorites-category == 1: ScrollView { vertical-stretch: 1; min-height: 0px; viewport-width: self.visible-width;
                        VerticalLayout { padding: 0px; spacing: 5px * Theme.ui-scale; alignment: start;
                            if root.saved-search-tasks.length == 0: Label { height: 70px * Theme.ui-scale; text: root.chinese ? "点击声音列表右上角的 ☆ 收藏当前搜索任务，之后可在这里重新打开。" : "Star the current search above the sound list to reopen it here later."; wrap: word-wrap; }
                            for saved in root.saved-search-tasks: Rectangle { height: 58px * Theme.ui-scale; border-radius: 5px * Theme.ui-scale; background: studio-saved-hit.has-hover ? Theme.hover : Theme.raised;
                                accessible-role: button; accessible-label: (root.chinese ? "打开搜索任务收藏：" : "Open saved search: ") + saved.name; accessible-enabled: !root.background-blocked && !root.search-workspace-read-only;
                                accessible-action-default => { if !root.background-blocked && !root.search-workspace-read-only { root.saved-search-opened(saved.id); } }
                                forward-focus: studio-saved-focus; border-width: studio-saved-focus.has-focus ? 1px : 0px; border-color: Theme.accent;
                                studio-saved-focus := FocusScope { enabled: !root.background-blocked && !root.search-workspace-read-only; focus-on-click: false; key-pressed(event) => {
                                    if event.text == " " || event.text == Key.Return { root.saved-search-opened(saved.id); return accept; }
                                    if event.text == Key.F2 { root.begin-search-task-rename(saved.id, saved.name, true); return accept; }
                                    reject
                                } }
                                VerticalLayout { padding: 8px * Theme.ui-scale; padding-right: 34px * Theme.ui-scale; spacing: 3px * Theme.ui-scale;
                                    Text { text: saved.name; color: Theme.ink; font-size: Theme.font(12); overflow: elide; }
                                    Text { text: saved.summary; color: Theme.muted; font-size: Theme.font(10); overflow: elide; }
                                }
                                studio-saved-hit := TouchArea { width: parent.width - 32px * Theme.ui-scale; enabled: !root.background-blocked && !root.search-workspace-read-only; mouse-cursor: pointer; clicked => { root.saved-search-opened(saved.id); } }
                                StudioAction { width: 28px * Theme.ui-scale; height: 28px * Theme.ui-scale; x: parent.width - self.width - 3px * Theme.ui-scale; y: 5px * Theme.ui-scale; subtle: true;
                                    label: "..."; action-label: (root.chinese ? "管理搜索任务收藏：" : "Manage saved search: ") + saved.name; enabled: !root.background-blocked && !root.search-workspace-read-only;
                                    clicked => {
                                        root.context-saved-search = saved;
                                        saved-search-menu.show({x: self.absolute-position.x - saved-search-menu.absolute-position.x, y: self.absolute-position.y + self.height - saved-search-menu.absolute-position.y});
                                    }
                                }
                            }
                        }
                    }
                    if root.library-sidebar-page == 1 && root.favorites-category == 0: Rectangle { vertical-stretch: 1; }
                    studio-directory-sections := Rectangle {
                        visible: root.library-sidebar-page == 0;
                        vertical-stretch: root.library-sidebar-page == 0 ? 1 : 0;
                        min-height: root.library-sidebar-page == 0 ? self.fixed-height + (root.folders-section-expanded ? 68px * Theme.ui-scale : 0px) + (self.libraries-expanded ? 60px * Theme.ui-scale : 0px) : 0px;
                        max-height: root.library-sidebar-page == 0 ? 100000px : 0px;
                        private property <bool> has-libraries: root.albums.length > 0;
                        private property <bool> libraries-expanded: self.has-libraries && root.libraries-section-expanded;
                        private property <bool> both-expanded: root.folders-section-expanded && self.libraries-expanded;
                        private property <length> header-height: 24px * Theme.ui-scale;
                        private property <length> list-gap: 4px * Theme.ui-scale;
                        private property <length> divider-height: self.both-expanded ? 12px * Theme.ui-scale : (self.has-libraries ? 8px * Theme.ui-scale : 0px);
                        private property <length> fixed-height: self.header-height * (self.has-libraries ? 2 : 1) + (root.folders-section-expanded ? self.list-gap : 0px) + (self.libraries-expanded ? self.list-gap : 0px) + self.divider-height;
                        private property <length> list-budget: max(0px, self.height - self.fixed-height);
                        private property <length> folder-height: !root.folders-section-expanded ? 0px : !self.libraries-expanded ? self.list-budget : clamp(self.list-budget * clamp(root.folders-section-ratio, 0.1, 0.9), 68px * Theme.ui-scale, max(68px * Theme.ui-scale, self.list-budget - 60px * Theme.ui-scale));
                        SidebarSectionHeader {
                            x: 0px; y: 0px;
                            width: parent.width; height: studio-directory-sections.header-height;
                            label: root.chinese ? "素材目录" : "FOLDERS";
                            action-label: root.chinese ? "文件夹分区" : "Folders section";
                            expanded: root.folders-section-expanded; enabled: !root.background-blocked;
                            toggled => { root.folders-section-expanded = !root.folders-section-expanded; root.pane-layout-changed(); }
                        }
                        // Keep two directory rows usable while the album list shares a short sidebar.
                        studio-folder-focus := FocusScope {
                            x: 0px; y: studio-directory-sections.header-height + (root.folders-section-expanded ? studio-directory-sections.list-gap : 0px);
                            width: parent.width; height: studio-directory-sections.folder-height;
                            visible: root.folders-section-expanded; enabled: !root.background-blocked && root.library-sidebar-page == 0 && root.folders-section-expanded;
                            key-pressed(event) => {
                                let index = clamp(root.selected-folder, 0, root.folders.length - 1);
                                if root.folders.length == 0 { return reject; }
                                if event.text == Key.DownArrow || event.text == Key.UpArrow {
                                    root.folder-requested(clamp(index + (event.text == Key.DownArrow ? 1 : -1), 0, root.folders.length - 1)); return accept;
                                }
                                if event.text == Key.LeftArrow {
                                    if root.folders[index].expanded { root.folder-toggle-requested(index); } return accept;
                                }
                                if event.text == Key.RightArrow {
                                    if root.folders[index].has-children && !root.folders[index].expanded { root.folder-toggle-requested(index); }
                                    else if root.folders[index].expanded && index + 1 < root.folders.length { root.folder-requested(index + 1); } return accept;
                                }
                                if event.text == Key.Return || event.text == " " { root.folder-requested(index); return accept; }
                                if event.text == Key.Home { root.folder-requested(0); return accept; }
                                if event.text == Key.End { root.folder-requested(root.folders.length - 1); return accept; }
                                reject
                            }
                        studio-folder-list := ListView { viewport-width: self.visible-width; accessible-role: list; accessible-label: root.chinese ? "音效文件夹" : "Sound folders";
                            for folder[index] in root.folders: Rectangle { height: 34px * Theme.ui-scale; border-radius: 4px * Theme.ui-scale; accessible-role: list-item; accessible-label: (root.chinese ? "文件夹：" : "Folder: ") + folder.name;
                                border-width: studio-folder-focus.has-focus && root.selected-folder == index ? 1px : 0px; border-color: Theme.accent;
                                // Fluent overlays a fixed 14px scrollbar (not affected by Theme.ui-scale); the 18px * ui-scale padding reserves its track plus a gap and never shrinks below that at scale >= 1.0.
                                background: root.selected-folder == index ? Theme.selected : (studio-folder-hit.has-hover ? Theme.raised : transparent);
                                if root.selected-folder == index: Rectangle { x: 0px; width: 2px * Theme.ui-scale; background: Theme.accent; }
                                Tooltip { text: @markdown("\{folder.path}"); }
                                HorizontalLayout { spacing: 4px * Theme.ui-scale; padding-right: 18px * Theme.ui-scale;
                                    // Keep a readable name and count even in a narrow, deep folder tree.
                                    studio-folder-indent := Rectangle { width: clamp(folder.depth * 10px * Theme.ui-scale, 0px, max(0px, parent.width - max(28px * Theme.ui-scale, studio-folder-count.preferred-width) - 18px * Theme.ui-scale - 17px * Theme.ui-scale - 30px * Theme.ui-scale - 40px * Theme.ui-scale)); }
                                    Rectangle { width: 17px * Theme.ui-scale;
                                        Image { visible: folder.has-children; source: folder.expanded ? @image-url("icons/sidebar-chevron-down.svg") : @image-url("icons/sidebar-chevron-right.svg"); colorize: Theme.dim; x: 5px * Theme.ui-scale; y: (parent.height - self.height) / 2; width: 7px * Theme.ui-scale; height: 7px * Theme.ui-scale; image-fit: contain; accessible-role: none; }
                                        TouchArea { mouse-cursor: pointer; clicked => { studio-folder-focus.focus(); root.folder-toggle-requested(index); } }
                                    }
                                    Image { width: 14px * Theme.ui-scale; source: @image-url("icons/folder.svg"); colorize: root.selected-folder == index ? Theme.accent : Theme.dim; image-fit: contain; accessible-role: none; }
                                    Text { horizontal-stretch: 1; min-width: 0px; text: folder.name; color: Theme.ink; overflow: elide; vertical-alignment: center; font-size: Theme.font(11); }
                                    studio-folder-count := Label { min-width: 28px * Theme.ui-scale; horizontal-stretch: 0; text: folder.count; horizontal-alignment: right; }
                                }
                                studio-folder-hit := TouchArea { x: studio-folder-indent.width + 22px * Theme.ui-scale; width: max(0px, parent.width - 18px * Theme.ui-scale - self.x); mouse-cursor: pointer;
                                    clicked => { studio-folder-focus.focus(); root.folder-requested(index); }
                                    double-clicked => { if folder.has-children { studio-folder-focus.focus(); root.folder-toggle-requested(index); } }
                                    pointer-event(event) => { if event.button == PointerEventButton.right && event.kind == PointerEventKind.down { root.show-folder-menu(folder, {x: self.absolute-position.x + self.mouse-x, y: self.absolute-position.y + self.mouse-y}); } }
                                }
                            }
                        }
                        }
                        if studio-directory-sections.both-expanded: SidebarSectionDivider {
                            width: parent.width; height: studio-directory-sections.divider-height;
                            y: studio-folder-focus.y + studio-folder-focus.height;
                            pane-height: studio-directory-sections.folder-height; enabled: !root.background-blocked;
                            label: root.chinese ? "调整文件夹和音效库高度" : "Resize folder and library heights";
                            help: root.chinese ? "拖动调整文件夹和音效库高度；上下方向键微调" : "Drag to resize folder and library heights; Up/Down keys adjust height";
                            resized(height) => { root.folders-section-ratio = clamp(clamp(height, 68px * Theme.ui-scale, max(68px * Theme.ui-scale, studio-directory-sections.list-budget - 60px * Theme.ui-scale)) / max(1px, studio-directory-sections.list-budget), 0.1, 0.9); }
                            finished => { root.pane-layout-changed(); }
                        }
                        // Library/album groups declared by the files themselves. Clicking one
                        // filters the results; clicking the active one clears the filter.
                        studio-libraries-header := SidebarSectionHeader {
                            visible: studio-directory-sections.has-libraries;
                            width: parent.width; height: studio-directory-sections.has-libraries ? studio-directory-sections.header-height : 0px;
                            y: studio-folder-focus.y + studio-folder-focus.height + studio-directory-sections.divider-height;
                            label: root.chinese ? "音效库" : "LIBRARIES";
                            action-label: root.chinese ? "音效库分区" : "Libraries section";
                            expanded: root.libraries-section-expanded; enabled: !root.background-blocked && studio-directory-sections.has-libraries;
                            toggled => { root.libraries-section-expanded = !root.libraries-section-expanded; root.pane-layout-changed(); }
                        }
                        studio-album-list := ListView {
                            x: 0px; y: studio-libraries-header.y + studio-libraries-header.height + (studio-directory-sections.libraries-expanded ? studio-directory-sections.list-gap : 0px);
                            width: parent.width; height: studio-directory-sections.libraries-expanded ? studio-directory-sections.list-budget - studio-directory-sections.folder-height : 0px;
                            visible: studio-directory-sections.libraries-expanded;
                            viewport-width: self.visible-width; accessible-role: list;
                            for album[index] in root.albums: Rectangle { height: 30px * Theme.ui-scale; border-radius: 4px * Theme.ui-scale;
                                background: !root.album-filter-unavailable && root.album-filter-id == album.id ? Theme.selected : (studio-album-hit.has-hover ? Theme.raised : transparent);
                                HorizontalLayout { spacing: 6px * Theme.ui-scale; padding-right: 18px * Theme.ui-scale; alignment: start;
                                    Image { visible: root.artwork-enabled; width: 20px * Theme.ui-scale; height: 20px * Theme.ui-scale; image-fit: cover; source: album.cover; }
                                    Text { horizontal-stretch: 1; min-width: 0px; text: album.name; color: Theme.ink; overflow: elide; vertical-alignment: center; font-size: Theme.font(11); }
                                    Label { min-width: 34px * Theme.ui-scale; text: album.count; horizontal-alignment: right; }
                                }
                                studio-album-hit := TouchArea { enabled: !root.background-blocked; mouse-cursor: pointer; clicked => { root.album-selected(album.id); } }
                            }
                        }
                    }
                    StudioAction { height: 28px * Theme.ui-scale; subtle: true; navigation: true; icon: @image-url("icons/settings.svg"); label: root.remote-mode ? (root.chinese ? "服务器音效库" : "Server library") : (root.chinese ? "本地音效库" : "Local library"); enabled: root.menu-ready; clicked => { root.open-data-source(); } }
                    Rectangle { height: 1px; background: Theme.border; }
                    Label { height: 28px * Theme.ui-scale; text: root.library-summary; color: Theme.dim; wrap: word-wrap; overflow: elide; font-size: Theme.font(10); }
                }
            }
            if root.sidebar-visible: PaneDivider {
                pane-width: root.sidebar-width; enabled: !root.background-blocked;
                label: root.chinese ? "调整素材库侧栏宽度" : "Resize library sidebar";
                resized(width) => { root.sidebar-preferred-width = clamp(width, 170px * Theme.ui-scale, min(480px * Theme.ui-scale, root.sidebar-budget - (root.inspector-visible ? root.inspector-width : 0px))); }
                finished => { root.pane-layout-changed(); }
            }
            studio-results-column := VerticalLayout { horizontal-stretch: 1; min-width: 520px * Theme.ui-scale; spacing: 2px * Theme.ui-scale;
                studio-task-tabs-bar := Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; height: 34px * Theme.ui-scale; background: Theme.table-toolbar-surface; border-radius: 0px;
                    changed width => { root.update-task-tabs-overflow(); }
                    accessible-role: tab-list; accessible-label: root.chinese ? "搜索任务" : "Search tasks";
                    HorizontalLayout { padding-left: 4px * Theme.ui-scale; padding-right: 4px * Theme.ui-scale; padding-top: 2px * Theme.ui-scale; spacing: 3px * Theme.ui-scale;
                        if root.task-tabs-overflow: StudioAction { width: 36px * Theme.ui-scale; subtle: true; label: "‹";
                            action-label: root.chinese ? "向左翻页搜索任务" : "Scroll search tasks left";
                            enabled: !root.background-blocked && root.task-tabs-x < -1px;
                            clicked => { root.scroll-task-tabs(-1); }
                        }
                        studio-task-tabs-scroll := ScrollView { horizontal-stretch: 1; min-width: 0px; viewport-height: 32px * Theme.ui-scale;
                            viewport-width: root.task-tabs-content-width;
                            HorizontalLayout { spacing: 3px * Theme.ui-scale; alignment: start;
                                for task in root.search-tasks: SearchTaskTab {
                                    width: root.task-tab-width; height: 32px * Theme.ui-scale; name: task.name; active: task.active;
                                    tooltip-width: min(560px * Theme.ui-scale, root.width - 40px * Theme.ui-scale);
                                    keywords: task.keywords; folder: task.folder; summary: task.summary; searched: task.searched;
                                    favorite: task.favorite; modified: task.modified; chinese: root.chinese; compact: root.short-layout; enabled: !root.background-blocked; editable: !root.search-workspace-read-only;
                                    selected => { root.search-task-selected(task.id); }
                                    closed => { root.search-task-closed(task.id); }
                                    rename-requested => { root.begin-search-task-rename(task.id, task.name, false); }
                                    context-requested(position) => {
                                        root.context-search-task = task;
                                        search-task-menu.show({x: position.x - search-task-menu.absolute-position.x, y: position.y - search-task-menu.absolute-position.y});
                                    }
                                }
                            }
                        }
                        if root.task-tabs-overflow: StudioAction { width: 36px * Theme.ui-scale; subtle: true; label: "›";
                            action-label: root.chinese ? "向右翻页搜索任务" : "Scroll search tasks right";
                            enabled: !root.background-blocked && root.task-tabs-x > min(0px, root.task-tabs-visible-width - root.task-tabs-content-width) + 1px;
                            clicked => { root.scroll-task-tabs(1); }
                        }
                        StudioAction { width: 36px * Theme.ui-scale; height: (root.short-layout ? 30px : 32px) * Theme.ui-scale; subtle: true;
                            label: "+"; action-label: root.chinese ? "新建搜索任务" : "New search task";
                            enabled: !root.background-blocked && !root.search-workspace-read-only && root.search-tasks.length < root.max-search-tasks;
                            clicked => { root.search-task-created(); }
                            Tooltip { text: @markdown("\{root.search-tasks.length}/\{root.max-search-tasks}"); }
                        }
                    }
                }
                Rectangle { height: 32px * Theme.ui-scale; background: Theme.table-toolbar-surface;
                    HorizontalLayout { height: 32px * Theme.ui-scale; spacing: 6px * Theme.ui-scale;
                        if root.crumbs.length > 0: HorizontalLayout { horizontal-stretch: 1; min-width: 80px * Theme.ui-scale; height: 30px * Theme.ui-scale; spacing: 4px * Theme.ui-scale;
                            StudioAction { width: 64px * Theme.ui-scale; subtle: true; label: root.chinese ? "素材库" : "Library"; clicked => { root.all-library-requested(); } }
                            // Deep hierarchies remain navigable without forcing the window wider.
                            ScrollView { horizontal-stretch: 1; viewport-height: 30px * Theme.ui-scale;
                                HorizontalLayout { spacing: 4px * Theme.ui-scale;
                                    for crumb[index] in root.crumbs: HorizontalLayout {
                                        Label { width: 10px * Theme.ui-scale; text: "›"; horizontal-alignment: center; }
                                        StudioAction { subtle: true; label: crumb.name; width: 110px * Theme.ui-scale; clicked => { root.crumb-requested(index); } }
                                    }
                                }
                            }
                        }
                        if root.checked-count <= 1 && root.crumbs.length == 0: Text { horizontal-stretch: 1; min-width: 0px; overflow: elide; text: root.favorites-only ? (root.chinese ? "我的收藏" : "Favorites") : (root.chinese ? "声音列表" : "Sounds"); color: Theme.ink; font-size: Theme.font(14); font-weight: 600; vertical-alignment: center; }
                        if root.checked-count > 1: studio-selection-actions := StudioAction {
                            width: 108px * Theme.ui-scale; active: true; dropdown: true;
                            label: root.checked-count + (root.chinese ? " 条已选" : " selected");
                            clicked => { selection-menu.show({x: self.absolute-position.x, y: self.absolute-position.y + self.height}); }
                        }
                        if root.checked-count > 1 && root.wide-layout: StudioAction { width: 86px * Theme.ui-scale; enabled: !root.background-blocked && !root.remote-writes-blocked && !root.metadata-writes-blocked; label: root.chinese ? "批量标注" : "Batch edit"; clicked => { root.open-batch(); } }
                        if root.checked-count > 1 && root.wide-layout: StudioAction { width: 64px * Theme.ui-scale; subtle: true; enabled: !root.background-blocked && root.removal-allowed; label: root.chinese ? "移除" : "Remove"; clicked => { root.library-action(11); } }
                        if root.checked-count > 1 && root.crumbs.length == 0: Rectangle { horizontal-stretch: 1; }
                        if root.checked-count <= 1: Label { width: (root.wide-layout ? 180px : 120px) * Theme.ui-scale; text: root.searching ? (root.chinese ? "正在检索…" : "Searching…") : root.result-summary; font-size: Theme.font(11); overflow: elide; }
                        studio-table-columns-action := StudioAction {
                            width: root.chinese ? 92px * Theme.ui-scale : 120px * Theme.ui-scale; subtle: true; dropdown: true; enabled: !root.background-blocked;
                            label: root.chinese ? "列 / 排序" : "Columns / Sort";
                            action-label: root.chinese ? "列宽、波形与排序设置" : "Column widths, Waveforms and sorting";
                            clicked => { root.show-table-menu({x: self.absolute-position.x, y: self.absolute-position.y + self.height}); }
                        }
                        // File status lives in the Library menu and sorting in the table headers;
                        // The current task favorite shares the filter/details icon treatment.
                        Rectangle { y: (parent.height - self.height) / 2; height: 30px * Theme.ui-scale; background: Theme.trough; border-radius: 7px * Theme.ui-scale; border-width: 1px; border-color: Theme.border;
                            accessible-role: none;
                            HorizontalLayout { padding: 2px * Theme.ui-scale; spacing: 2px * Theme.ui-scale;
                                if root.search-tasks.length > root.active-search-task-index: StudioIconSegment {
                                    private property <SearchTaskRow> task: root.search-tasks[root.active-search-task-index];
                                    icon: self.task.favorite ? @image-url("icons/task-star-filled.svg") : @image-url("icons/task-star.svg");
                                    label: (self.task.favorite ? (root.chinese ? "取消搜索任务收藏：" : "Unfavorite search task: ") : (root.chinese ? "收藏搜索任务：" : "Favorite search task: ")) + self.task.name + (self.task.modified ? (root.chinese ? "（条件已修改，右键收藏可更新）" : " (changed; update from saved search menu)") : "");
                                    active: self.task.favorite;
                                    enabled: !root.background-blocked && !root.search-workspace-read-only;
                                    clicked => { root.search-task-favorite-toggled(self.task.id); }
                                }
                                StudioIconSegment { icon: @image-url("icons/filter.svg"); show-label: root.wide-layout; label: root.chinese ? "筛选" : "Filters"; active: root.inspector-visible && root.filters-visible; count: root.filter-count; clicked => { root.show-sidebar-page(true); } }
                                StudioIconSegment { icon: @image-url("icons/details.svg"); show-label: root.wide-layout; label: root.chinese ? "详情" : "Details"; active: root.inspector-visible && !root.filters-visible; clicked => { root.show-sidebar-page(false); } }
                            }
                        }
                    }
                }
                // Above 1.0, keeps the sound list usable; the main view scrolls for the rest. At 1.0 the
                // compact 1080x700 layout keeps fitting without scrolling; filters live in the sidebar.
                studio-results-panel := Rectangle { vertical-stretch: 1; min-height: root.results-panel-min-height; clip: true; border-width: 1px; border-color: Theme.border; border-radius: 4px * Theme.ui-scale; background: Theme.table-surface;
                    VerticalLayout { spacing: 0px;
                        Rectangle { height: 32px * Theme.ui-scale; background: Theme.table-header-surface; clip: true;
                            // Both empty and populated results share the header's horizontal position.
                            Rectangle { x: root.table-viewport-x; width: root.table-content-size; height: parent.height;
                                Image { x: 10px * Theme.ui-scale; y: (parent.height - self.height) / 2; width: 16px * Theme.ui-scale; height: self.width; source: @image-url("icons/star.svg"); colorize: Theme.dim; accessible-role: none; }
                                if root.list-waveforms-visible: studio-table-wave-header := Text {
                                    x: root.table-state-size + root.table-name-size + 12px * Theme.ui-scale; width: root.table-wave-size - 24px * Theme.ui-scale; height: parent.height;
                                    text: root.chinese ? "波形" : "WAVE"; font-size: Theme.font(10); color: Theme.dim;
                                    overflow: elide; vertical-alignment: center;
                                    accessible-role: text; accessible-label: root.chinese ? "波形" : "Waveform";
                                }
                                studio-table-name-header := TableHeader {
                                    x: root.table-state-size; width: root.table-name-size - 8px * Theme.ui-scale; height: parent.height;
                                    label: root.chinese ? "文件名" : "NAME";
                                    action-label: root.chinese ? "按文件名排序" : "Sort by filename";
                                    help: root.chinese ? "按文件名排序；再次点击切换升序 / 降序" : "Sort by filename; click again to reverse ascending / descending";
                                    active: root.sort-index == 1; descending: root.sort-descending; enabled: !root.background-blocked;
                                    clicked => { root.sort-table(1); } context-requested(position) => { root.show-table-menu(position); }
                                }
                                studio-table-duration-header := TableHeader {
                                    x: root.table-state-size + root.table-wave-size + root.table-name-size; width: root.table-duration-size - 8px * Theme.ui-scale; height: parent.height;
                                    label: root.chinese ? "时长" : "TIME";
                                    action-label: root.chinese ? "按时长排序" : "Sort by duration";
                                    help: root.chinese ? "按时长排序；再次点击切换升序 / 降序" : "Sort by duration; click again to reverse ascending / descending";
                                    active: root.sort-index == 2; descending: root.sort-descending; enabled: !root.background-blocked;
                                    clicked => { root.sort-table(2); } context-requested(position) => { root.show-table-menu(position); }
                                }
                                studio-table-format-header := TableHeader {
                                    x: root.table-state-size + root.table-wave-size + root.table-name-size + root.table-duration-size; width: root.table-format-size - 8px * Theme.ui-scale; height: parent.height;
                                    label: root.chinese ? "格式" : "FORMAT";
                                    action-label: root.chinese ? "按采样率排序" : "Sort by sample rate";
                                    help: root.chinese ? "按采样率排序；再次点击切换升序 / 降序" : "Sort by sample rate; click again to reverse ascending / descending";
                                    active: root.sort-index == 3; descending: root.sort-descending; enabled: !root.background-blocked;
                                    clicked => { root.sort-table(3); } context-requested(position) => { root.show-table-menu(position); }
                                }
                                studio-table-channels-header := TableHeader {
                                    x: root.table-state-size + root.table-wave-size + root.table-name-size + root.table-duration-size + root.table-format-size; width: root.table-channels-size - 8px * Theme.ui-scale; height: parent.height;
                                    label: root.chinese ? "声道" : "CH";
                                    action-label: root.chinese ? "按声道排序" : "Sort by channels";
                                    help: root.chinese ? "按声道数排序；再次点击切换升序 / 降序" : "Sort by channel count; click again to reverse ascending / descending";
                                    active: root.sort-index == 4; descending: root.sort-descending; enabled: !root.background-blocked;
                                    clicked => { root.sort-table(4); } context-requested(position) => { root.show-table-menu(position); }
                                }
                                studio-table-tags-header := TableHeader {
                                    x: root.table-state-size + root.table-wave-size + root.table-name-size + root.table-duration-size + root.table-format-size + root.table-channels-size; width: root.table-tags-size - 8px * Theme.ui-scale; height: parent.height;
                                    label: root.chinese ? "标签" : "TAGS";
                                    action-label: root.chinese ? "按标签排序" : "Sort by tags";
                                    help: root.chinese ? "按素材库标签排序，空白时使用源标签；再次点击切换升序 / 降序" : "Sort by library tags, using source tags when empty; click again to reverse ascending / descending";
                                    active: root.sort-index == 5; descending: root.sort-descending; enabled: !root.background-blocked;
                                    clicked => { root.sort-table(5); } context-requested(position) => { root.show-table-menu(position); }
                                }
                                // Informational column: albums are filtered from the sidebar.
                                Text {
                                    x: root.table-state-size + root.table-wave-size + root.table-name-size + root.table-duration-size + root.table-format-size + root.table-channels-size + root.table-tags-size + 12px * Theme.ui-scale;
                                    width: root.table-album-size - 24px * Theme.ui-scale; height: parent.height;
                                    text: root.chinese ? "音效库" : "LIBRARY"; color: Theme.dim; vertical-alignment: center;
                                    font-size: Theme.font(10); overflow: elide;
                                }
                                studio-table-name-divider := TableDivider {
                                    x: root.table-state-size + root.table-name-size - 8px * Theme.ui-scale; height: parent.height; column-width: root.table-name-size;
                                    label: root.chinese ? "调整文件名列宽" : "Resize Filename column"; help: root.table-resize-help; enabled: !root.background-blocked;
                                    resized(width) => { root.resize-table-column(1, width); } finished => { root.table-layout-changed(); }
                                    reset => { root.table-name-width = 360; root.table-layout-changed(); }
                                }
                                studio-table-duration-divider := TableDivider {
                                    x: root.table-state-size + root.table-wave-size + root.table-name-size + root.table-duration-size - 8px * Theme.ui-scale; height: parent.height; column-width: root.table-duration-size;
                                    label: root.chinese ? "调整时长列宽" : "Resize Duration column"; help: root.table-resize-help; enabled: !root.background-blocked;
                                    resized(width) => { root.resize-table-column(2, width); } finished => { root.table-layout-changed(); }
                                    reset => { root.table-duration-width = 96; root.table-layout-changed(); }
                                }
                                studio-table-format-divider := TableDivider {
                                    x: root.table-state-size + root.table-wave-size + root.table-name-size + root.table-duration-size + root.table-format-size - 8px * Theme.ui-scale; height: parent.height; column-width: root.table-format-size;
                                    label: root.chinese ? "调整格式列宽" : "Resize Format column"; help: root.table-resize-help; enabled: !root.background-blocked;
                                    resized(width) => { root.resize-table-column(3, width); } finished => { root.table-layout-changed(); }
                                    reset => { root.table-format-width = 132; root.table-layout-changed(); }
                                }
                                studio-table-channels-divider := TableDivider {
                                    x: root.table-state-size + root.table-wave-size + root.table-name-size + root.table-duration-size + root.table-format-size + root.table-channels-size - 8px * Theme.ui-scale; height: parent.height; column-width: root.table-channels-size;
                                    label: root.chinese ? "调整声道列宽" : "Resize Channels column"; help: root.table-resize-help; enabled: !root.background-blocked;
                                    resized(width) => { root.resize-table-column(4, width); } finished => { root.table-layout-changed(); }
                                    reset => { root.table-channels-width = 64; root.table-layout-changed(); }
                                }
                                studio-table-tags-divider := TableDivider {
                                    x: root.table-columns-size - root.table-album-size - 8px * Theme.ui-scale; height: parent.height; column-width: root.table-tags-size;
                                    label: root.chinese ? "调整标签列宽" : "Resize Tags column"; help: root.table-resize-help; enabled: !root.background-blocked;
                                    resized(width) => { root.resize-table-column(5, width); } finished => { root.table-layout-changed(); }
                                    reset => { root.table-tags-width = 200; root.table-layout-changed(); }
                                }
                            }
                        }
                        studio-results-focus := FocusScope { vertical-stretch: 1; min-height: 0px; focus-on-click: false;
                            key-pressed(event) => {
                                if event.text == Key.DownArrow || event.text == Key.UpArrow {
                                    let step = event.text == Key.DownArrow ? 1 : -1;
                                    if event.modifiers.shift && root.rows.length > 0 {
                                        root.user-row-clicked(clamp(root.selected-row + step, 0, root.rows.length - 1), event.modifiers.control, true, false);

                                    } else { root.user-selection-step(step); }
                                    return accept;
                                }
                                if event.text == Key.PageUp || event.text == Key.PageDown {
                                    if event.modifiers.control && true {
                                        if event.text == Key.PageUp && root.can-previous { root.page-requested(-1); }
                                        if event.text == Key.PageDown && root.can-next { root.page-requested(1); }
                                    } else if root.rows.length > 0 {
                                        let step = max(1, floor(studio-result-list.visible-height / root.studio-result-row-height));
                                        root.user-row-clicked(clamp(root.selected-row + (event.text == Key.PageDown ? step : -step), 0, root.rows.length - 1), event.modifiers.control, event.modifiers.shift, false);

                                    }
                                    return accept;
                                }
                                if (event.text == Key.Home || event.text == Key.End) && root.rows.length > 0 {
                                    root.user-row-clicked(event.text == Key.Home ? 0 : root.rows.length - 1, event.modifiers.control, event.modifiers.shift, false);  return accept;
                                }
                                if event.text == " " && root.audio-ready { root.play-requested(); return accept; }
                                if event.text == Key.Return && root.selected-row >= 0 { root.audition-requested(root.selected-row); return accept; }
                                if (event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift)) && root.selected-row >= 0 {
                                    root.show-file-menu(root.rows[root.selected-row], {x: self.absolute-position.x + 80px * Theme.ui-scale, y: self.absolute-position.y + 40px * Theme.ui-scale}); return accept;
                                }
                                reject
                            }
                            // Keep the delegate directly under ListView for virtualization.
                            studio-result-list := ListView {
                                visible: !root.table-empty;
                                viewport-width: root.table-content-size;
                                viewport-x: root.table-viewport-x;
                                // A newly populated repeater measures its width after becoming
                                // visible. Ignore its temporary empty-range clamp until then.
                                changed viewport-x => { if Theme.modern-style { if !root.table-empty && abs(self.viewport-width - root.table-content-size) < 1px { root.table-viewport-x = self.viewport-x; } } }
                                changed viewport-y => { if Theme.modern-style { root.track-result-scroll(); } }
                                scrolled => {
                                    root.cancel-workbench-switch();
                                    // Real input takes over from a pending programmatic restore.
                                    if root.task-viewport-pending {
                                        root.result-scroll-epoch += 1;
                                        root.task-viewport-pending = false;
                                        root.task-restoring = false;
                                    }
                                    root.result-user-scrolling = true;
                                    result-scroll-timer.running = true;
                                    result-scroll-timer.restart();
                                }
                                changed visible-height => { if Theme.modern-style { root.report-result-window(); } }
                                changed viewport-width => { if Theme.modern-style { if !root.table-empty && abs(self.viewport-width - root.table-content-size) < 1px { root.sync-table-viewport(); } } }
                                // The real cell layout supplies ListView's minimum horizontal extent.
                                for row[index] in root.rows: Rectangle { width: root.table-content-size; height: root.studio-result-row-height; accessible-role: list-item; accessible-label: row.name;
                                    background: root.selected-row == index ? Theme.selected : (row.checked ? Theme.checked : (studio-result-hit.has-hover ? Theme.hover : (Math.mod(index, 2) == 0 ? Theme.table-alternate : Theme.table-surface)));
                                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border.with-alpha(0.35); }
                                    Rectangle { x: 0px; y: 0px; height: parent.height; width: 3px * Theme.ui-scale; background: root.selected-row == index ? Theme.accent : row.marker; }
                                    HorizontalLayout { alignment: start; padding-left: root.table-state-size + 12px * Theme.ui-scale; padding-right: 12px * Theme.ui-scale; spacing: 24px * Theme.ui-scale;
                                        studio-table-name-cell := Text { width: root.table-name-size - 24px * Theme.ui-scale; height: root.studio-result-row-height; text: (row.missing ? (root.chinese ? "[缺失] " : "[Missing] ") : "") + row.name; color: root.selected-row == index ? Theme.accent : (row.missing ? Theme.warning : Theme.ink); font-size: Theme.list-font-size; overflow: elide; vertical-alignment: center; }
                                        if root.list-waveforms-visible: studio-table-wave-cell := Rectangle { width: root.table-wave-size - 24px * Theme.ui-scale; height: root.studio-result-row-height;
                                            if row.wave-state == 0 || row.wave-state == 3: Rectangle { y: (parent.height - self.height) / 2; width: row.wave-state == 0 ? parent.width : parent.width * 0.4; height: 2px * Theme.ui-scale; background: Theme.strong-border; opacity: row.wave-state == 0 ? 0.7 : 0.35; }
                                            if row.wave-state == 2: Rectangle { y: parent.height / 2; width: parent.width; height: 1px; background: Theme.dim; opacity: 0.6; }
                                            if row.wave-state == 1: Image { y: 5px * Theme.ui-scale; width: parent.width; height: parent.height - 10px * Theme.ui-scale; source: row.wave; colorize: root.selected-row == index ? Theme.accent : Theme.dim; image-fit: fill; image-rendering: pixelated; }
                                            if row.wave-state == 4: Rectangle { y: 5px * Theme.ui-scale; height: parent.height - 10px * Theme.ui-scale; width: parent.width; background: Theme.warning.with-alpha(0.1); Image { width: parent.width; height: parent.height; source: row.wave; colorize: Theme.warning; image-fit: fill; opacity: 0.45; } }
                                        }
                                        studio-table-duration-cell := Text { width: root.table-duration-size - 24px * Theme.ui-scale; height: root.studio-result-row-height; text: row.duration-clock; color: root.selected-row == index ? Theme.accent : Theme.ink; vertical-alignment: center; font-family: "Consolas"; font-size: Theme.list-font(11); overflow: elide; }
                                        studio-table-format-cell := Text { width: root.table-format-size - 24px * Theme.ui-scale; height: root.studio-result-row-height; text: row.format; color: root.selected-row == index ? Theme.accent : Theme.dim; vertical-alignment: center; font-size: Theme.list-font(11); overflow: elide; }
                                        studio-table-channels-cell := Text { width: root.table-channels-size - 24px * Theme.ui-scale; height: root.studio-result-row-height; text: row.channels; color: root.selected-row == index ? Theme.accent : Theme.dim; vertical-alignment: center; font-size: Theme.list-font(11); overflow: elide; }
                                        studio-table-tags-cell := Rectangle { width: root.table-tags-size - 24px * Theme.ui-scale; height: root.studio-result-row-height; clip: true;
                                            HorizontalLayout { padding-top: 5px * Theme.ui-scale; padding-bottom: 5px * Theme.ui-scale; spacing: 4px * Theme.ui-scale; alignment: start;
                                                for tag in row.tag-preview: DisplayTag { height: parent.height; text: tag; ink: root.selected-row == index ? Theme.accent : Theme.ink; text-size: Theme.list-font(10); max-width: max(20px * Theme.ui-scale, (parent.width - 8px * Theme.ui-scale - (row.tag-extra > 0 ? 28px * Theme.ui-scale : 0px)) / max(1, row.tag-preview.length)); }
                                                if row.tag-extra > 0: Label { text: "+" + row.tag-extra; color: root.selected-row == index ? Theme.accent : Theme.dim; font-size: Theme.list-font(10); }
                                                if row.tag-preview.length == 0 && row.tags != "": DisplayTag { height: parent.height; text: row.tags; ink: root.selected-row == index ? Theme.accent : Theme.ink; text-size: Theme.list-font(10); max-width: parent.width; }
                                            }
                                            Tooltip { text: @markdown("\{row.tags}"); }
                                        }
                                        studio-table-album-cell := Text { width: root.table-album-size - 24px * Theme.ui-scale; height: root.studio-result-row-height; text: row.album; color: root.selected-row == index ? Theme.accent : Theme.dim; vertical-alignment: center; overflow: elide; font-size: Theme.list-font(11); }
                                    }
                                    Tooltip { text: @markdown("\{row.name}\n\{row.file-path}"); }

                                    studio-result-hit := TouchArea { mouse-cursor: pointer;
                                        property <bool> toggle-selection;
                                        property <bool> range-selection;
                                        // One drag-out request per press, after a small movement threshold.
                                        property <bool> drag-sent;
                                        moved => {
                                            if self.pressed && !self.drag-sent && !row.missing && !self.toggle-selection && !self.range-selection && (abs(self.mouse-x - self.pressed-x) > 6px * Theme.ui-scale || abs(self.mouse-y - self.pressed-y) > 6px * Theme.ui-scale) {
                                                self.drag-sent = true;
                                                root.drag-out-requested(row.id);
                                            }
                                        }
                                        clicked => {
                                            studio-results-focus.focus();
                                            root.user-row-clicked(index, self.toggle-selection, self.range-selection, root.audition-play-on-single-click && !row.missing && !self.toggle-selection && !self.range-selection && !self.drag-sent);
                                        }
                                        // Slint also emits clicked on the second release. In single-click
                                        // mode that click already owns playback, so do not request it again.
                                        double-clicked => { if !root.audition-play-on-single-click && !row.missing && !self.toggle-selection && !self.range-selection && !self.drag-sent { root.selected-row = index; root.audition-requested(index); } }
                                        pointer-event(event) => {
                                            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                                self.toggle-selection = event.modifiers.control;
                                                self.range-selection = event.modifiers.shift;
                                                self.drag-sent = false;
                                            }
                                            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down { studio-results-focus.focus(); root.show-file-menu(row, {x: self.absolute-position.x + self.mouse-x, y: self.absolute-position.y + self.mouse-y}); }
                                        }
                                    }
                                    StudioIconSegment { x: 2px * Theme.ui-scale; y: (parent.height - self.height) / 2; width: 30px * Theme.ui-scale; height: 28px * Theme.ui-scale;
                                        icon: row.favorite ? @image-url("icons/task-star-filled.svg") : @image-url("icons/star.svg"); active: row.favorite; highlighted: root.selected-row == index; indicator-only: true;
                                        label: (row.favorite ? (root.chinese ? "取消收藏：" : "Unfavorite: ") : (root.chinese ? "收藏：" : "Favorite: ")) + row.name;
                                        enabled: !root.background-blocked && !root.remote-writes-blocked && !root.metadata-writes-blocked;
                                        clicked => { root.file-action-requested(row.id, 5); }
                                    }
                                    if root.playback-path != "" && row.file-path == root.playback-path && (root.playing || root.playback-state == 4): StudioIconSegment { x: 32px * Theme.ui-scale; y: (parent.height - self.height) / 2; width: 30px * Theme.ui-scale; height: 28px * Theme.ui-scale;
                                        icon: root.playback-state == 4 ? @image-url("icons/pause.svg") : @image-url("icons/play.svg"); active: true; indicator-only: true;
                                        label: (root.playing ? (root.chinese ? "暂停：" : "Pause: ") : (root.chinese ? "试听：" : "Audition: ")) + row.name;
                                        accessible-description: root.playback-state == 4 ? (root.chinese ? "已暂停，单击继续试听" : "Paused; click to resume audition") : (root.chinese ? "正在播放，单击暂停" : "Playing; click to pause");
                                        enabled: !root.background-blocked && !row.missing;
                                        clicked => { if root.playing { root.pause-requested(); } else { root.user-row-clicked(index, false, false, true); } }
                                    }

                                }
                            }
                            // Slint 1.17's empty ListView repeater resets its viewport width to
                            // the visible width. A separate viewport preserves the real column
                            // extent without adding a synthetic AudioRow to the result model.
                            studio-empty-result-list := ScrollView {
                                visible: root.table-empty;
                                viewport-width: root.table-content-size;
                                viewport-height: self.visible-height;
                                viewport-x: root.table-viewport-x;
                                changed viewport-x => { if Theme.modern-style { if root.table-empty { root.table-viewport-x = self.viewport-x; } } }
                                Rectangle { width: root.table-content-size; height: studio-empty-result-list.visible-height; }
                            }
                            if root.rows.length == 0: VerticalLayout { padding: 24px * Theme.ui-scale; alignment: center; spacing: 12px * Theme.ui-scale;
                                Text { text: root.searching ? (root.chinese ? "正在搜索…" : "Searching…") : (root.chinese ? "这里还没有声音" : "No sounds in this view"); color: Theme.ink; horizontal-alignment: center; font-size: Theme.font(18); }
                                Label { text: root.visibility-index == 1 ? (root.chinese ? "当前仅显示缺失文件，没有匹配的记录。" : "No matching missing files. Only missing records are shown.") : root.query != "" || root.filter-count > 0 || root.favorites-only || root.selected-folder-path != "" ? (root.chinese ? "当前搜索、目录或筛选没有匹配的声音。" : "No sounds match the current search, folder or filters.") : (root.chinese ? "音效库中还没有声音。添加 WAV 文件夹开始使用。" : "Your library has no sounds yet. Add a WAV folder to get started."); horizontal-alignment: center; wrap: word-wrap; }
                                StudioAction { width: 140px * Theme.ui-scale; label: root.chinese ? "清除搜索和筛选" : "Clear search & filters"; clicked => { root.query = ""; root.favorites-only = false; root.reset-filters(); root.all-library-requested(); } }
                            }
                        }
                        Rectangle { height: 36px * Theme.ui-scale; background: Theme.table-footer-surface;
                            HorizontalLayout { padding-left: 10px * Theme.ui-scale; padding-right: 5px * Theme.ui-scale; spacing: 5px * Theme.ui-scale;

                                if root.visibility-index != 0: ScopeHint {
                                    y: (parent.height - self.height) / 2; enabled: !root.background-blocked;
                                    label: root.visibility-index == 1 ? (root.chinese ? "仅缺失文件" : "Missing only") : (root.chinese ? "含缺失文件" : "Incl. missing");
                                    action-label: root.chinese ? "恢复显示存在的文件" : "Show present files";
                                    clicked => { root.visibility-index = 0; root.filter-requested(); }
                                }
                                if root.sort-index == 6: ScopeHint {
                                    y: (parent.height - self.height) / 2; enabled: !root.background-blocked;
                                    label: (root.chinese ? "按修改时间" : "By modified") + (root.sort-descending ? " ↓" : " ↑");
                                    action-label: root.chinese ? "恢复默认排序" : "Restore default order";
                                    clicked => { root.sort-table(0); }
                                }
                                Label { horizontal-stretch: 0; min-width: 0px; max-width: 240px * Theme.ui-scale; text: root.result-summary; overflow: elide; font-size: Theme.font(10); }
                                studio-status-row := HorizontalLayout { horizontal-stretch: 1; min-width: 0px; spacing: 6px * Theme.ui-scale;
                                    studio-status-text := Label { horizontal-stretch: 1; min-width: 0px; text: root.drag-preparing && root.drag-progress != "" ? root.drag-progress : root.status; overflow: elide; font-size: Theme.font(10);
                                        Tooltip { text: @markdown("\{studio-status-text.text}"); }
                                    }
                                    if root.drag-preparing: StudioAction { width: 52px * Theme.ui-scale; subtle: true; label: root.chinese ? "取消" : "Cancel"; action-label: root.chinese ? "取消拖出" : "Cancel drag"; clicked => { root.drag-cancel-requested(); } }
                                }
                                if true: StudioAction { width: 30px * Theme.ui-scale; enabled: root.can-previous && !root.searching; label: "‹"; action-label: root.chinese ? "上一页搜索结果" : "Previous results page"; clicked => { root.page-requested(-1); } }
                                if true: Label { width: 72px * Theme.ui-scale; text: root.page-label; horizontal-alignment: center; }
                                if true: StudioAction { width: 30px * Theme.ui-scale; enabled: root.can-next && !root.searching; label: "›"; action-label: root.chinese ? "下一页搜索结果" : "Next results page"; clicked => { root.page-requested(1); } }
                            }
                        }
                    }
                }
            }
            if root.inspector-visible: PaneDivider {
                pane-width: root.inspector-width; reverse: true; enabled: !root.background-blocked;
                label: root.chinese ? "调整声音详情宽度" : "Resize sound details";
                resized(width) => { root.inspector-preferred-width = clamp(width, 240px * Theme.ui-scale, min(600px * Theme.ui-scale, root.sidebar-budget - root.sidebar-width)); }
                finished => { root.pane-layout-changed(); }
            }
            if root.inspector-visible: studio-details-sidebar := Rectangle { width: root.inspector-width; background: Theme.inspector-surface; border-radius: 3px * Theme.ui-scale; clip: true;
                Image { x: 0px; y: 0px; width: parent.width; height: parent.height; source: Theme.inspector-backdrop; image-fit: fill; accessible-role: none; }
                VerticalLayout { padding: 10px * Theme.ui-scale; spacing: 8px * Theme.ui-scale;
                    HorizontalLayout { height: 32px * Theme.ui-scale; spacing: 4px * Theme.ui-scale;
                        Text { horizontal-stretch: 1; min-width: 0px; text: root.filters-visible ? (root.chinese ? "筛选声音" : "Filters") : (root.chinese ? "声音详情" : "Sound details"); font-size: Theme.font(15); font-weight: 500; color: Theme.ink; vertical-alignment: center; overflow: elide; }
                        StudioIconSegment { icon: @image-url("icons/filter.svg"); active: root.filters-visible; label: root.chinese ? "筛选页" : "Filters page"; clicked => { root.filters-visible = true; } }
                        StudioIconSegment { icon: @image-url("icons/details.svg"); active: !root.filters-visible; label: root.chinese ? "声音详情页" : "Sound details page"; clicked => { root.filters-visible = false; } }
                        StudioIconSegment { icon: @image-url("icons/chevron-up.svg"); label: root.chinese ? "收起声音详情" : "Hide sound details"; clicked => { root.inspector-visible = false; } }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    // Form rows: one label column, controls aligned to its right edge.
                    if root.filters-visible: studio-filters-scroll := ScrollView { vertical-stretch: 1; min-height: 0px; viewport-width: self.visible-width; viewport-y: root.task-filter-viewport-y; changed viewport-y => { if Theme.modern-style { root.task-filter-viewport-y = self.viewport-y; } }
                        property <int> restore-revision: root.task-sidebar-restore-revision;
                        changed restore-revision => { if Theme.modern-style { self.viewport-y = clamp(root.task-filter-viewport-y, min(0px, self.visible-height - self.viewport-height), 0px); } }
                        VerticalLayout { spacing: 14px * Theme.ui-scale; padding-right: 4px * Theme.ui-scale; alignment: start;
                            VerticalLayout { spacing: 6px * Theme.ui-scale;
                                Label { height: 16px * Theme.ui-scale; text: root.chinese ? "格式" : "FORMAT"; font-size: Theme.font(10); }
                                HorizontalLayout { spacing: 8px * Theme.ui-scale;
                                    Label { width: root.filter-label-width; text: root.chinese ? "采样率" : "Sample rate"; }
                                    ComboBox { horizontal-stretch: 1; min-width: 0px; model: root.chinese ? ["全部", "44.1 kHz", "48 kHz", "88.2 kHz", "96 kHz", "192 kHz"] : ["Any", "44.1 kHz", "48 kHz", "88.2 kHz", "96 kHz", "192 kHz"]; current-index <=> root.sample-filter; selected => { root.filter-requested(); } }
                                }
                                HorizontalLayout { spacing: 8px * Theme.ui-scale;
                                    Label { width: root.filter-label-width; text: root.chinese ? "位深" : "Bit depth"; }
                                    ComboBox { horizontal-stretch: 1; min-width: 0px; model: root.chinese ? ["全部", "16 bit", "24 bit", "32 bit"] : ["Any", "16 bit", "24 bit", "32 bit"]; current-index <=> root.bit-filter; selected => { root.filter-requested(); } }
                                }
                                HorizontalLayout { spacing: 8px * Theme.ui-scale;
                                    Label { width: root.filter-label-width; text: root.chinese ? "声道" : "Channels"; }
                                    ComboBox { horizontal-stretch: 1; min-width: 0px; model: root.chinese ? ["全部", "单声道", "立体声", "4 声道", "6 声道", "8 声道"] : ["Any", "Mono", "Stereo", "4 channels", "6 channels", "8 channels"]; current-index <=> root.channel-filter; selected => { root.filter-requested(); } }
                                }
                                HorizontalLayout { spacing: 8px * Theme.ui-scale;
                                    Label { width: root.filter-label-width; text: root.chinese ? "时长（秒）" : "Seconds"; }
                                    LineEdit { horizontal-stretch: 1; min-width: 0px; input-label: root.chinese ? "最短时长（秒）" : "Minimum duration (seconds)"; text <=> root.duration-min; placeholder-text: root.chinese ? "最短" : "Min"; accepted => { root.apply-filters(); } }
                                    Label { text: "–"; }
                                    LineEdit { horizontal-stretch: 1; min-width: 0px; input-label: root.chinese ? "最长时长（秒）" : "Maximum duration (seconds)"; text <=> root.duration-max; placeholder-text: root.chinese ? "最长" : "Max"; accepted => { root.apply-filters(); } }
                                }
                            }
                            Rectangle { height: 1px; background: Theme.border; }
                            VerticalLayout { spacing: 6px * Theme.ui-scale;
                                Label { height: 16px * Theme.ui-scale; text: root.chinese ? "标注" : "ANNOTATIONS"; font-size: Theme.font(10); }
                                HorizontalLayout { spacing: 8px * Theme.ui-scale;
                                    // Top-aligned with the tag field rather than the whole block.
                                    Label { width: root.filter-label-width; height: 32px * Theme.ui-scale; text: root.chinese ? "标签" : "Tags"; }
                                    VerticalLayout { horizontal-stretch: 1; spacing: 6px * Theme.ui-scale;
                                        FocusScope {
                                            focus-on-click: false;
                                            focus-on-tab-navigation: false;
                                            // Spans the chip column; Rust wraps chips to this width.
                                            init => { if Theme.modern-style { root.tag-chip-area-width = self.width; } }
                                            changed width => { if Theme.modern-style { root.tag-chip-area-width = self.width; } }
                                            property <int> restore-revision: root.task-sidebar-restore-revision;
                                            changed restore-revision => { if Theme.modern-style { root.tag-chip-area-width = self.width; } }
                                            capture-key-pressed(event) => {
                                                if event.text == Key.Backspace && root.tag-draft == "" && root.tag-term-count > 0 {
                                                    root.tag-term-removed(-1);
                                                    return accept;
                                                }
                                                reject
                                            }
                                            HorizontalLayout { padding: 0px;
                                                studio-tag-input := LineEdit {
                                                    min-width: 0px; text <=> root.tag-draft;
                                                    input-label: root.chinese ? "标签筛选：+ 包含，- 排除，回车添加" : "Tag filter: + include, - exclude, Enter adds";
                                                    placeholder-text: root.chinese ? "+包含 -排除，回车添加" : "+include -exclude, Enter adds";
                                                    accepted => { root.apply-filters(); }
                                                }
                                            }
                                        }
                                        if root.tag-chip-rows.length > 0: VerticalLayout { spacing: root.tag-chip-spacing;
                                            accessible-role: list;
                                            accessible-label: root.chinese ? "标签筛选条件" : "Tag filter terms";
                                            for row in root.tag-chip-rows: HorizontalLayout { spacing: root.tag-chip-spacing; alignment: start;
                                                for chip in row.chips: TagChipView {
                                                    text: chip.text; exclude: chip.exclude; chinese: root.chinese; enabled: !root.background-blocked;
                                                    toggle => { root.tag-term-toggled(chip.index); }
                                                    remove => { root.tag-term-removed(chip.index); }
                                                }
                                            }
                                        }
                                        CheckBox { height: 24px * Theme.ui-scale; text: root.chinese ? "有标签" : "Tagged only"; checked <=> root.tagged-only; toggled => { root.filter-requested(); } }
                                    }
                                }
                                HorizontalLayout { spacing: 8px * Theme.ui-scale;
                                    Label { width: root.filter-label-width; text: root.chinese ? "颜色" : "Color"; }
                                    Rectangle { width: 22px * Theme.ui-scale; height: 22px * Theme.ui-scale; y: (parent.height - self.height) / 2;
                                        border-radius: 4px * Theme.ui-scale; border-width: 1px;
                                        border-color: root.color-filter != "" && !root.color-filter-valid ? Theme.warning : Theme.strong-border;
                                        background: root.color-filter-valid ? root.color-filter-swatch : transparent;
                                    }
                                    LineEdit { horizontal-stretch: 1; min-width: 0px; input-label: root.chinese ? "颜色 #RRGGBB" : "Color #RRGGBB"; text <=> root.color-filter; placeholder-text: "#RRGGBB"; accepted => { root.apply-filters(); } }
                                }
                            }
                        }
                    }
                    if root.filters-visible: HorizontalLayout { height: 30px * Theme.ui-scale; spacing: 6px * Theme.ui-scale;
                        Rectangle { horizontal-stretch: 1; }
                        StudioAction { width: 58px * Theme.ui-scale; label: root.chinese ? "重置" : "Reset"; clicked => { root.reset-filters(); } }
                        StudioAction { width: 64px * Theme.ui-scale; primary: true; label: root.chinese ? "应用" : "Apply"; clicked => { root.apply-filters(); } }
                    }
                    if !root.filters-visible && !root.has-selection: VerticalLayout { spacing: 6px * Theme.ui-scale; padding-top: 12px * Theme.ui-scale;
                        Text { text: root.chinese ? "选择一个声音" : "Select a sound"; color: Theme.ink; font-size: Theme.font(14); }
                        Text { text: root.chinese ? "在列表中选择文件，查看信息或编辑标注。" : "Select a file to inspect its details and edit annotations."; color: Theme.dim; font-size: Theme.font(11); wrap: word-wrap; }
                        Rectangle { vertical-stretch: 1; }
                    }
                    if !root.filters-visible && root.has-selection: studio-inspector-scroll := ScrollView { vertical-stretch: 1; min-height: 0px; viewport-width: self.visible-width; viewport-y: root.task-inspector-viewport-y; changed viewport-y => { if Theme.modern-style { root.task-inspector-viewport-y = self.viewport-y; } }
                        property <int> restore-revision: root.task-sidebar-restore-revision;
                        changed restore-revision => { if Theme.modern-style { self.viewport-y = clamp(root.task-inspector-viewport-y, min(0px, self.visible-height - self.viewport-height), 0px); } }
                        property <string> displayed-id: root.selected-id;
                        changed displayed-id => { if Theme.modern-style { if !root.task-restoring { self.viewport-y = 0px; } } }
                        VerticalLayout { spacing: 10px * Theme.ui-scale; padding-right: 4px * Theme.ui-scale; alignment: start;
                            if root.selected-album != "" || (root.artwork-enabled && root.album-cover-ready): HorizontalLayout { height: root.artwork-enabled && root.album-cover-ready ? 80px * Theme.ui-scale : 36px * Theme.ui-scale; spacing: 12px * Theme.ui-scale;
                                Image { visible: root.artwork-enabled && root.album-cover-ready; width: root.artwork-enabled && root.album-cover-ready ? 76px * Theme.ui-scale : 0px; height: 76px * Theme.ui-scale; image-fit: cover; source: root.album-cover; }
                                VerticalLayout { alignment: center; spacing: 5px * Theme.ui-scale;
                                    Text { text: root.selected-album; color: Theme.ink; font-size: Theme.font(15); font-weight: 500; wrap: word-wrap; overflow: elide; }
                                    Label { text: root.remote-mode ? (root.chinese ? "服务器音效库" : "Server library") : (root.chinese ? "本地音效库" : "Local library"); font-size: Theme.font(12); }
                                }
                            }
                            HorizontalLayout { spacing: 4px * Theme.ui-scale;
                                TextInput { horizontal-stretch: 1; min-width: 0px; text: root.selected-name; read-only: true; single-line: false; wrap: char-wrap; font-size: Theme.font(13); color: Theme.ink; selection-background-color: Theme.accent; selection-foreground-color: Theme.on-accent; accessible-label: root.chinese ? "完整文件名" : "Full filename"; }
                                ChipButton { width: 22px * Theme.ui-scale; height: 22px * Theme.ui-scale;
                                    enabled: !root.background-blocked && !root.remote-writes-blocked && !root.metadata-writes-blocked;
                                    glyph: root.edit-favorite ? "★" : "☆"; glyph-color: root.edit-favorite ? Theme.accent : Theme.dim;
                                    label: root.edit-favorite ? (root.chinese ? "取消收藏" : "Remove from favorites") : (root.chinese ? "收藏" : "Add to favorites");
                                    clicked => { root.edit-favorite = !root.edit-favorite; root.metadata-dirty = true; root.metadata-edited(); }
                                }
                            }
                            Rectangle { height: 1px; background: Theme.border; }
                            VerticalLayout { spacing: 1px * Theme.ui-scale;
                                DetailParameter { label: root.chinese ? "时长" : "Duration"; value: root.selected-duration; }
                                DetailParameter { label: root.chinese ? "采样率" : "Sample rate"; value: root.selected-sample-rate; }
                                DetailParameter { label: root.chinese ? "位深" : "Bit depth"; value: root.selected-bit-depth; }
                                DetailParameter { label: root.chinese ? "声道" : "Channels"; value: root.selected-channels; }
                            }
                            if root.selected-missing: VerticalLayout { spacing: 6px * Theme.ui-scale;
                                Text { text: root.chinese ? "原位置找不到此文件。选择移动或改名后的 WAV，保留已有标注。" : "File missing at its original location. Locate the moved or renamed WAV to keep its annotations."; color: Theme.warning; font-size: Theme.font(12); wrap: word-wrap; }
                                StudioAction { height: 32px * Theme.ui-scale; primary: true; enabled: !root.closing && !root.library-busy; label: root.chinese ? "选择新位置，修复引用…" : "Locate file and repair…"; clicked => { root.file-action-requested(root.selected-id, 20); } }
                            }
                            Rectangle { height: 1px; background: Theme.border; }
                            HorizontalLayout { height: 22px * Theme.ui-scale;
                                Text { horizontal-stretch: 1; text: root.chinese ? "标签" : "Tags"; color: Theme.ink; font-size: Theme.font(13); vertical-alignment: center; }
                                StudioIconSegment { icon: @image-url("icons/copy.svg"); label: root.chinese ? "复制声音标签" : "Copy sound tags"; enabled: root.selected-tag-labels.length > 0; clicked => { root.copy-text(root.selected-source-tags == "" ? root.edit-tags : root.edit-tags + (root.edit-tags == "" ? "" : ", ") + root.selected-source-tags); } }
                            }
                            studio-detail-tags := VerticalLayout { spacing: 6px * Theme.ui-scale;
                                init => { if Theme.modern-style { root.detail-tag-area-width = self.width; } }
                                changed width => { if Theme.modern-style { root.detail-tag-area-width = self.width; } }
                                property <int> restore-revision: root.task-sidebar-restore-revision;
                                changed restore-revision => { if Theme.modern-style { root.detail-tag-area-width = self.width; } }
                                for tag-row in root.selected-tag-rows: HorizontalLayout { spacing: 6px * Theme.ui-scale; alignment: start;
                                    for tag in tag-row.tags: DisplayTag { text: tag; max-width: max(1px, root.inspector-width - 44px * Theme.ui-scale); }
                                }
                                studio-source-tags := StudioSourceTags { visible: root.selected-tag-labels.length == 0 && root.selected-source-tags != ""; height: self.visible ? 48px * Theme.ui-scale : 0px; text: root.selected-source-tags; label: root.chinese ? "提取的标签" : "Extracted tags"; displayed-id: root.selected-id; }
                                if root.selected-tag-labels.length == 0 && root.selected-source-tags == "": Label { text: root.chinese ? "无标签" : "No tags"; }
                                if root.selected-tag-labels.length > 64: Label { text: "+" + (root.selected-tag-labels.length - 64) + (root.chinese ? " 个标签 · 可复制完整标签" : " tags · Copy for the complete list"); wrap: word-wrap; font-size: Theme.font(11); }
                            }
                            Rectangle { height: 1px; background: Theme.border; }
                            Text { text: root.chinese ? "描述" : "Description"; color: Theme.ink; font-size: Theme.font(13); }
                            studio-source-description := StudioSourceTags { height: root.selected-description == "" ? 0px : (root.short-layout ? 56px : 72px) * Theme.ui-scale; boxed: false; text-size: Theme.font(12); text: root.selected-description; label: root.chinese ? "源文件描述" : "Source description"; displayed-id: root.selected-id; }
                            StudioAction { height: 28px * Theme.ui-scale; subtle: true; navigation: true; active: root.annotation-editor-visible;
                                label: (root.annotation-editor-visible ? "−  " : "+  ") + (root.chinese ? "编辑标签与备注" : "Edit tags and notes");
                                action-label: root.chinese ? "编辑声音标注" : "Edit sound annotations";
                                clicked => { root.annotation-editor-visible = !root.annotation-editor-visible; }
                            }
                            if root.annotation-editor-visible: VerticalLayout { spacing: 7px * Theme.ui-scale;
                                LineEdit { min-width: 0px; input-label: root.chinese ? "标签 · 逗号分隔" : "Tags, comma separated"; enabled: !root.background-blocked && !root.remote-writes-blocked && !root.metadata-writes-blocked; text <=> root.edit-tags; placeholder-text: root.chinese ? "标签，用逗号分隔" : "Tags, comma separated"; edited => { root.metadata-dirty = true; root.metadata-edited(); } }
                                StudioAction { height: 26px * Theme.ui-scale; subtle: true; active: root.notes-visible; label: (root.notes-visible ? "−  " : "+  ") + (root.chinese ? "备注" : "Notes") + (root.edit-notes == "" ? "" : " ·"); clicked => { root.notes-visible = !root.notes-visible; } }
                                if root.notes-visible: TextEdit { height: 62px * Theme.ui-scale; accessible-label: root.chinese ? "备注" : "Notes"; enabled: !root.background-blocked && !root.remote-writes-blocked && !root.metadata-writes-blocked; text <=> root.edit-notes; edited => { root.metadata-dirty = true; root.metadata-edited(); } }
                                if root.selected-source-tags != "" && root.selected-tag-labels.length > 0: studio-source-tags-copy := StudioSourceTags { height: 48px * Theme.ui-scale; label: root.chinese ? "提取的标签" : "Extracted tags"; text: root.selected-source-tags; displayed-id: root.selected-id; }
                                StudioAction { height: 26px * Theme.ui-scale; subtle: true; active: root.source-metadata-visible; label: (root.source-metadata-visible ? "−  " : "+  ") + (root.chinese ? "原始 Metadata（含 SMED）" : "Source Metadata / SMED"); clicked => { root.source-metadata-visible = !root.source-metadata-visible; } }
                                if root.source-metadata-visible: TextEdit { height: 160px * Theme.ui-scale; font-size: Theme.font(10); accessible-label: root.chinese ? "源文件 Metadata" : "Source Metadata"; read-only: true; text: root.selected-attributes == "" || root.selected-attributes == "{}" ? (root.chinese ? "无嵌入 Metadata" : "No embedded Metadata") : root.selected-attributes; }
                                HorizontalLayout { height: 30px * Theme.ui-scale; spacing: 6px * Theme.ui-scale;
                                    StudioAction { horizontal-stretch: 1; enabled: root.metadata-dirty && !root.background-blocked; label: root.chinese ? "还原" : "Revert"; clicked => { root.restore-metadata(); } }
                                    StudioAction { horizontal-stretch: 1; primary: root.metadata-dirty; enabled: root.metadata-dirty && !root.closing && !root.library-busy && !root.remote-writes-blocked && !root.metadata-writes-blocked; label: root.chinese ? "立即保存" : "Save now"; clicked => { root.save-metadata-requested(); } }
                                }
                                Label { text: root.chinese ? "切换音效时自动保存 · Ctrl S 立即保存" : "Auto-saves when switching · Ctrl S saves now"; wrap: word-wrap; font-size: Theme.font(10); }
                            }
                            Rectangle { height: 1px; background: Theme.border; }
                            HorizontalLayout { height: 22px * Theme.ui-scale;
                                Text { horizontal-stretch: 1; text: root.chinese ? "文件位置" : "File location"; color: Theme.ink; font-size: Theme.font(13); vertical-alignment: center; }
                                StudioIconSegment { icon: @image-url("icons/copy.svg"); label: root.chinese ? "复制完整文件位置" : "Copy full file location"; clicked => { root.copy-text(root.selected-path); } }
                            }
                            TextInput { text: root.selected-path; read-only: true; single-line: false; wrap: char-wrap; font-size: Theme.font(12); color: Theme.dim; selection-background-color: Theme.accent; selection-foreground-color: Theme.on-accent; accessible-label: root.chinese ? "文件路径" : "File path"; }
                        }
                    }
                    if !root.filters-visible && root.has-selection: Label { text: root.metadata-dirty ? (root.chinese ? "标注待自动保存 · Ctrl S 保存" : "Pending auto-save · Ctrl S saves") : root.remote-mode ? (root.chinese ? "标注已保存到服务器" : "Annotations saved to server") : (root.chinese ? "标注已保存到素材库" : "Annotations saved to library"); color: root.metadata-dirty ? Theme.warning : Theme.muted; font-size: Theme.font(10); }
                    if !root.filters-visible && root.has-selection: HorizontalLayout { height: 32px * Theme.ui-scale; spacing: 7px * Theme.ui-scale;
                        StudioAction { horizontal-stretch: 1; min-width: 0px; label: root.chinese ? "在文件夹中显示" : "Reveal in folder"; enabled: !root.background-blocked && !root.remote-mode && !root.selected-missing; clicked => { root.file-action-requested(root.selected-id, 2); } }
                        ExportButton { horizontal-stretch: 1; min-width: 0px; label: root.chinese ? "导出…" : "Export…"; action-label: root.chinese ? "拖出 WAV 文件" : "Drag out WAV file"; enabled: !root.background-blocked && !root.selected-missing; file-id: root.selected-id;
                            clicked => { root.export-hint-visible = !root.export-hint-visible; }
                            drag-started(id) => { root.drag-out-requested(id); }
                            Tooltip { text: root.chinese ? @markdown("按住并拖动，将原始 WAV 导出到 DAW 或文件夹") : @markdown("Drag to export the original WAV to a DAW or folder"); }
                        }
                    }
                    if !root.filters-visible && root.has-selection && root.export-hint-visible: Label { text: root.chinese ? "按住“导出”并拖到 DAW 或文件夹。" : "Drag Export to your DAW or a folder."; wrap: word-wrap; font-size: Theme.font(11); }

                }
            }
        }
        SidebarSectionDivider {
            height: 5px * Theme.ui-scale; pane-height: -root.audition-preferred-height;
            label: root.chinese ? "调整试听播放器高度" : "Resize audition dock";
            help: root.chinese ? "向上拖动展开波形，向下拖动收起" : "Drag up to expand the waveform; drag down to compact";
            enabled: !root.background-blocked;
            resized(value) => { root.audition-preferred-height = clamp(-value, 88px * Theme.ui-scale, 360px * Theme.ui-scale); root.audition-expanded = root.audition-preferred-height > 160px * Theme.ui-scale; }
        }
        studio-audition := AuditionPanel {
            active: Theme.modern-style;
            premute-db <=> root.audition-premute-db;
            show-remaining <=> root.audition-show-remaining;
            height: root.audition-preferred-height;
            expanded: root.audition-expanded;
            narrow: root.content-width < 1440px * Theme.ui-scale;
            waveform-mask: root.waveform-mask;
            expanded-requested(value) => {
                root.audition-expanded = value;
                root.audition-preferred-height = (value ? 260px : 88px) * Theme.ui-scale;
            }
            compact: root.short-layout; spectral: root.peak-mode == 1;
            play-on-single-click: root.audition-play-on-single-click;
            chinese: root.chinese; ready: root.audio-ready && !root.selected-missing && !root.library-busy;
            missing: root.selected-missing; busy: root.library-busy;
            state: root.playback-state; error-text: root.playback-error; buffering: root.playback-buffering;
            waveform-progress: root.waveform-progress;
            output-backend: root.output-backend; output-rate: root.output-rate; output-xruns: root.output-xruns;
            target-start: root.wave-target-start; target-end: root.wave-target-end;
            relink-enabled: !root.closing && !root.library-busy && root.has-selection;
            playing: root.playing; smooth-progress: root.playback-smooth; progress-clock: root.playback-clock; playback-rate: root.confirmed-playback-rate; waveform: root.waveform-image; waveform-ready: root.waveform-ready;
            name: root.playback-name; info: root.waveform-info; output: root.output-summary;
            position: root.play-position; duration: root.play-duration; time: root.play-time; end-time: root.play-end;
            view-start: root.view-start; view-end: root.view-end; zoom: root.wave-zoom; ruler-ticks: root.ruler-ticks;
            scroll <=> root.wave-scroll; volume-db <=> root.volume-db; volume-label: root.volume-label;
            pitch-text <=> root.pitch-text; rate-text <=> root.speed-text; mono <=> root.audition-mono; repeat <=> root.audition-repeat;
            play => { root.start-requested(); } pause => { root.pause-requested(); } stop => { root.stop-requested(); }
            seek(value) => { root.seek-requested(value); }
            seek-play(value) => { root.seek-play-requested(value); }
            transform(pitch,rate,mono,repeat) => { root.transform-requested(pitch,rate,mono,repeat); }
            volume(value) => { root.volume-db-requested(value); }
            resize(w,h) => { root.waveform-resize-requested(w,h); }
            zoom-change(factor) => { root.waveform-zoom-requested(factor); }
            zoom-at(factor,fraction) => { root.waveform-wheel-zoom-requested(factor,fraction); }
            pan(value) => { root.waveform-pan-requested(value); }
            peaks => {
                if Theme.modern-style {
                    root.audition-expanded = true;
                    root.audition-preferred-height = max(root.audition-preferred-height, 260px * Theme.ui-scale);
                }
                root.peaks-visible = true;
            }
            output-settings => { root.settings-page = 0; root.output-settings-requested(); root.settings-visible = true; }
            retry => { if root.selected-row >= 0 { root.audition-requested(root.selected-row); } else { root.start-requested(); } }
            relink => { root.file-action-requested(root.selected-id, 20); }
        }
    }
    }

    }
    // Top-level focus scope also contains modal input, keeping shortcuts scoped to this window.

    search-task-menu := ContextMenuArea { x: 0px; y: 0px; width: 0px; height: 0px;
        Menu {
            MenuItem { title: root.context-search-task.name; enabled: false; }
            MenuItem { title: root.chinese ? "重命名…" : "Rename…"; enabled: !root.background-blocked && !root.search-workspace-read-only; activated => { root.begin-search-task-rename(root.context-search-task.id, root.context-search-task.name, false); } }
            MenuItem { title: root.context-search-task.favorite ? (root.chinese ? "取消任务收藏" : "Unfavorite task") : (root.chinese ? "收藏任务" : "Favorite task"); enabled: !root.background-blocked && !root.search-workspace-read-only; activated => { root.search-task-favorite-toggled(root.context-search-task.id); } }
            MenuItem { title: root.chinese ? "关闭任务" : "Close task"; enabled: !root.background-blocked && !root.search-workspace-read-only; activated => { root.search-task-closed(root.context-search-task.id); } }
        }
    }
    saved-search-menu := ContextMenuArea { x: 0px; y: 0px; width: 0px; height: 0px;
        Menu {
            MenuItem { title: root.context-saved-search.name; enabled: false; }
            MenuItem { title: root.chinese ? "打开搜索任务" : "Open search task"; enabled: !root.background-blocked && !root.search-workspace-read-only; activated => { root.saved-search-opened(root.context-saved-search.id); } }
            MenuItem { title: root.chinese ? "重命名…" : "Rename…"; enabled: !root.background-blocked && !root.search-workspace-read-only; activated => { root.begin-search-task-rename(root.context-saved-search.id, root.context-saved-search.name, true); } }
            MenuItem { title: root.chinese ? "用当前任务更新收藏" : "Update from current task"; enabled: !root.background-blocked && !root.search-workspace-read-only; activated => { root.saved-search-updated(root.context-saved-search.id); } }
            MenuSeparator { }
            MenuItem { title: root.chinese ? "删除任务收藏" : "Delete saved search"; enabled: !root.background-blocked && !root.search-workspace-read-only; activated => { root.saved-search-deleted(root.context-saved-search.id); } }
        }
    }
    table-menu := ContextMenuArea { x: 0px; y: 0px; width: 0px; height: 0px;
        Menu {
            MenuItem { title: root.chinese ? "显示波形列" : "Show Waveform column"; enabled: !root.background-blocked; checkable: true; checked <=> root.list-waveforms-enabled; }
            MenuItem { title: root.chinese ? "恢复默认列宽" : "Reset column widths"; enabled: !root.background-blocked; activated => { root.reset-table-widths(); } }
            MenuSeparator { }
            MenuItem { title: root.chinese ? "升序 ↑" : "Ascending ↑"; enabled: !root.background-blocked && root.sort-index != 0; activated => { root.sort-descending = false; root.filter-requested(); root.table-layout-changed(); } }
            MenuItem { title: root.chinese ? "降序 ↓" : "Descending ↓"; enabled: !root.background-blocked && root.sort-index != 0; activated => { root.sort-descending = true; root.filter-requested(); root.table-layout-changed(); } }
            MenuItem { title: root.chinese ? "恢复相关度排序" : "Reset to relevance sort"; enabled: !root.background-blocked; activated => { root.sort-table(0); } }
        }
    }
    selection-menu := ContextMenuArea { x: 0px; y: 0px; width: 0px; height: 0px;
        Menu {
            MenuItem { title: root.chinese ? "批量标注" : "Batch edit"; enabled: root.checked-count > 1 && !root.background-blocked && !root.remote-writes-blocked && !root.metadata-writes-blocked; activated => { root.open-batch(); } }
            MenuItem { title: root.chinese ? "清除选择" : "Clear selection"; enabled: !root.background-blocked; activated => { root.check-page-requested(false); } }
            MenuItem { title: (root.chinese ? "移除选择记录（保留 WAV）…" : "Remove selected records (keep WAV)…") + root.removal-suffix; enabled: !root.background-blocked && root.removal-allowed; activated => { root.library-action(11); } }
        }
    }
    file-menu := ContextMenuArea { x: 0px; y: 0px; width: 0px; height: 0px;
        Menu {
            MenuItem { title: root.context-file.name; enabled: false; }
            MenuSeparator { }
            MenuItem { title: root.chinese ? "试听" : "Audition"; enabled: !root.context-file.missing; activated => { root.file-action(0); } }
            MenuItem { title: root.chinese ? "查看 / 编辑 Metadata" : "View / edit Metadata"; activated => { root.show-details-page(); root.file-action(1); } }
            MenuSeparator { }
            MenuItem { title: (root.context-file.favorite ? (root.chinese ? "取消收藏" : "Remove from favorites") : (root.chinese ? "添加到收藏" : "Add to favorites")); enabled: !root.remote-writes-blocked && !root.metadata-writes-blocked; activated => { root.file-action(5); } }
            MenuSeparator { }
            MenuItem { title: (root.native-macos ? (root.chinese ? "在访达中显示" : "Reveal in Finder") : (root.chinese ? "在资源管理器中定位" : "Reveal in Explorer")) + root.ro-suffix; enabled: !root.remote-mode; activated => { root.file-action(2); } }
            MenuItem { title: root.chinese ? "复制完整路径" : "Copy full path"; activated => { root.copy-text(root.context-file.file-path); } }
            MenuItem { title: (root.chinese ? "修复文件引用…" : "Repair file reference…") + root.ro-suffix; enabled: !root.remote-mode; activated => { root.file-action(20); } }
            MenuItem { title: (root.chinese ? "从素材库移除…" : "Remove from library…") + root.removal-suffix; enabled: root.removal-allowed; activated => { root.file-action(21); } }
            MenuItem { title: root.chinese ? "复制文件名" : "Copy filename"; activated => { root.copy-text(root.context-file.name); } }
        }
    }
    folder-menu := ContextMenuArea { x: 0px; y: 0px; width: 0px; height: 0px;
        Menu {
            MenuItem { title: root.context-folder.name; enabled: false; }
            MenuSeparator { }
            MenuItem { title: (root.chinese ? "打开文件夹" : "Open in Explorer") + root.ro-suffix; enabled: !root.remote-mode; activated => { root.folder-action-requested(root.context-folder.path, 0); } }
            MenuItem { title: root.chinese ? "复制文件夹路径" : "Copy folder path"; activated => { root.copy-text(root.context-folder.path); } }
            MenuSeparator { }
            MenuItem { title: (root.chinese ? "增量扫描此文件夹…" : "Incremental scan this folder…") + root.ro-suffix; enabled: !root.scanning && !root.remote-mode; activated => { root.prepare-scan(0, root.context-folder.path); } }
            MenuItem { title: (root.chinese ? "全量扫描此文件夹…" : "Full scan this folder…") + root.ro-suffix; enabled: !root.scanning && !root.remote-mode; activated => { root.prepare-scan(1, root.context-folder.path); } }
            MenuItem { title: (root.chinese ? "从素材库移除目录…" : "Remove folder from library…") + root.removal-suffix; enabled: root.removal-allowed; activated => { root.folder-action-requested(root.context-folder.path, 1); } }
            MenuItem { title: (root.chinese ? "添加文件夹…" : "Add folder…") + root.ro-suffix; enabled: !root.scanning && !root.remote-mode; activated => { root.prepare-scan(0, ""); } }
        }
    }
    peaks-settings := PeakSettings {
        visible: root.peaks-visible; enabled: root.peaks-visible;
        chinese: root.chinese; mode <=> root.peak-mode; gain-db <=> root.peak-gain;
        opacity-value <=> root.peak-opacity; noise <=> root.peak-noise; variance <=> root.peak-variance;
        changed => { root.peak-style-requested(); } close => { root.peaks-visible = false; }
    }
    scan-dialog := FocusScope {
        visible: root.import-visible;
        enabled: root.import-visible;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        property <int> focus-index: 0;
        function focus-control(index: int, backwards: bool) {
            if root.scanning || root.scan-browse-busy || root.library-busy || root.closing { scan-cancel-action.focus(); return; }
            if index == 0 { scan-path-input.focus(); }
            else if index == 1 { scan-browse-action.focus(); }
            else if index == 2 { scan-incremental-action.focus(); }
            else if index == 3 { scan-full-action.focus(); }
            else if index == 4 { scan-cancel-action.focus(); }
            else if root.scan-path != "" { scan-start-action.focus(); }
            else if backwards { scan-cancel-action.focus(); }
            else { scan-path-input.focus(); }
        }
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.cancel-scan-dialog(); return accept; }
            if event.text == Key.Tab || event.text == Key.Backtab {
                self.focus-control(Math.mod(self.focus-index + (event.modifiers.shift || event.text == Key.Backtab ? 5 : 1), 6), event.modifiers.shift || event.text == Key.Backtab);
                return accept;
            }
            reject
        }
        key-pressed(event) => { if event.text == Key.Tab || event.text == Key.Backtab { return reject; } accept }
        key-released(event) => { accept }
        Rectangle { background: Theme.overlay;
        TouchArea { }
        Rectangle { width: 650px * Theme.ui-scale; height: 490px * Theme.ui-scale; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; background: Theme.panel; border-radius: 12px * Theme.ui-scale; border-width: 1px; border-color: Theme.border;
            VerticalLayout { padding: 26px * Theme.ui-scale; spacing: 12px * Theme.ui-scale;
                Text { text: root.chinese ? "扫描音效文件夹" : "Scan a sound folder"; color: Theme.ink; font-size: Theme.font(22); font-weight: 600; }
                Label { height: 32px * Theme.ui-scale; text: root.chinese ? "选择文件夹，或粘贴本地 / 网络路径。包含其所有子文件夹中的 WAV / BWF。" : "Choose a folder or paste a local / network path. Includes WAV / BWF in all its subfolders."; wrap: word-wrap; }
                HorizontalLayout { height: 36px * Theme.ui-scale; spacing: 8px * Theme.ui-scale;
                    scan-path-input := LineEdit { horizontal-stretch: 1; input-label: root.chinese ? "音效文件夹路径" : "Sound folder path"; enabled: !root.scan-browse-busy && !root.scanning && !root.library-busy && !root.closing; text <=> root.scan-path; placeholder-text: root.chinese ? "例如 D:\\Sound Library" : "e.g. D:\\Sound Library"; changed has-focus => { if self.has-focus { scan-dialog.focus-index = 0; } } edited => { root.scan-error = ""; } accepted => { if root.scan-path != "" && !root.scanning && !root.scan-browse-busy && !root.library-busy && !root.closing { root.scan-requested(root.scan-path); } } }
                    scan-browse-action := Action { width: 146px * Theme.ui-scale; enabled: !root.scan-browse-busy && !root.scanning && !root.library-busy && !root.closing; changed has-focus => { if self.has-focus { scan-dialog.focus-index = 1; } } label: root.scan-browse-busy ? (root.chinese ? "正在选择…" : "Choosing…") : (root.chinese ? "选择文件夹…" : "Browse folders…"); clicked => { root.scan-browse-requested(); } }
                }
                HorizontalLayout { height: 36px * Theme.ui-scale; spacing: 8px * Theme.ui-scale;
                    scan-incremental-action := Action { horizontal-stretch: 1; active: root.scan-mode == 0; enabled: !root.scan-browse-busy && !root.scanning && !root.library-busy && !root.closing; changed has-focus => { if self.has-focus { scan-dialog.focus-index = 2; } } label: root.chinese ? "增量扫描 · 日常更新" : "Incremental · daily update"; clicked => { root.scan-mode = 0; } }
                    scan-full-action := Action { horizontal-stretch: 1; active: root.scan-mode == 1; enabled: !root.scan-browse-busy && !root.scanning && !root.library-busy && !root.closing; changed has-focus => { if self.has-focus { scan-dialog.focus-index = 3; } } label: root.chinese ? "全量扫描 · 重新检查" : "Full scan · recheck folder"; clicked => { root.scan-mode = 1; } }
                }
                Rectangle { height: 86px * Theme.ui-scale; background: Theme.raised; border-radius: 6px * Theme.ui-scale;
                    Text { x: 12px * Theme.ui-scale; y: 10px * Theme.ui-scale; width: parent.width - 24px * Theme.ui-scale; height: parent.height - 20px * Theme.ui-scale; text: root.scan-mode == 0 ? (root.chinese ? "适合添加新音效和日常更新。\n只读取新增或已修改文件，跳过未变化文件；不检测缺失。" : "For new sounds and everyday updates.\nReads new or modified files, skips unchanged files; does not detect missing files.") : (root.chinese ? "适合文件整理后重新检查。\n重新读取所选文件夹内全部文件；扫描完整成功后标记缺失文件，保留标注。" : "For rechecking a folder after reorganizing files.\nRereads every file in this folder; a complete successful scan marks missing files and keeps annotations."); color: Theme.ink; wrap: word-wrap; font-size: Theme.font(12); }
                }
                Label { text: root.chinese ? "标签、收藏和备注都会保留。源音频文件不会被修改。" : "Tags, favorites and notes are kept. Source audio files stay unchanged."; wrap: word-wrap; font-size: Theme.font(10); }
                Text { height: 36px * Theme.ui-scale; text: root.scan-validating ? (root.chinese ? "正在检查文件夹…可取消此次扫描。" : "Checking the folder… You can cancel this scan.") : root.scan-error; color: root.scan-validating ? Theme.accent : Theme.warning; wrap: word-wrap; font-size: Theme.font(11); overflow: elide; }
                HorizontalLayout { height: 34px * Theme.ui-scale; spacing: 8px * Theme.ui-scale;
                    Rectangle { horizontal-stretch: 1; }
                    scan-cancel-action := Action { width: 80px * Theme.ui-scale; enabled: !root.scan-browse-busy && !root.library-busy && !root.closing; changed has-focus => { if self.has-focus { scan-dialog.focus-index = 4; } } label: root.chinese ? "取消" : "Cancel"; clicked => { root.cancel-scan-dialog(); } }
                    scan-start-action := Action { width: 132px * Theme.ui-scale; primary: true; enabled: !root.scanning && !root.scan-browse-busy && !root.library-busy && !root.closing && root.scan-path != ""; changed has-focus => { if self.has-focus { scan-dialog.focus-index = 5; } } label: root.scan-validating ? (root.chinese ? "正在检查…" : "Checking…") : (root.chinese ? "开始扫描" : "Start scan"); clicked => { root.scan-requested(root.scan-path); } }
                }
            }
        }
        }
    }
    task-rename-dialog := FocusScope {
        visible: root.search-task-rename-visible; enabled: root.search-task-rename-visible;
        focus-on-click: false; focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.search-task-rename-visible = false; return accept; }
            if (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) && task-rename-input.has-focus {
                task-rename-save.focus(); return accept;
            }
            if event.text == Key.Tab && !event.modifiers.shift && task-rename-save.has-focus { task-rename-input.focus(); return accept; }
            reject
        }
        key-pressed(event) => { if event.text == Key.Tab || event.text == Key.Backtab { return reject; } accept }
        key-released(event) => { accept }
        Rectangle { background: Theme.overlay;
            TouchArea { }
            Rectangle { width: min(450px * Theme.ui-scale, parent.width - 28px); height: 190px * Theme.ui-scale; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; background: Theme.panel; border-radius: 10px * Theme.ui-scale; border-width: 1px; border-color: Theme.strong-border;
                VerticalLayout { padding: 22px * Theme.ui-scale; spacing: 14px * Theme.ui-scale;
                    Text { text: root.search-task-rename-saved ? (root.chinese ? "重命名搜索任务收藏" : "Rename saved search") : (root.chinese ? "重命名搜索任务" : "Rename search task"); color: Theme.ink; font-size: Theme.font(18); font-weight: 600; }
                    task-rename-input := LineEdit { enabled: !root.search-workspace-read-only; text <=> root.search-task-rename-name; input-label: root.chinese ? "搜索任务名称" : "Search task name"; accepted => { root.finish-search-task-rename(); } }
                    HorizontalLayout { height: 32px * Theme.ui-scale; spacing: 8px * Theme.ui-scale;
                        Rectangle { horizontal-stretch: 1; }
                        Action { width: 76px * Theme.ui-scale; label: root.chinese ? "取消" : "Cancel"; clicked => { root.search-task-rename-visible = false; } }
                        task-rename-save := Action { width: 76px * Theme.ui-scale; primary: true; enabled: !root.search-workspace-read-only && root.search-task-rename-name != ""; label: root.chinese ? "保存名称" : "Save name"; clicked => { root.finish-search-task-rename(); } }
                    }
                }
            }
        }
    }
    settings-dialog := FocusScope {
        visible: root.settings-visible; enabled: root.settings-visible;
        focus-on-click: false; focus-on-tab-navigation: false;
        property <bool> reverse-wrap: false;
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.dismiss-modal(); return accept; }
            if (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) && (settings-first.has-focus || appearance-first.has-focus) {
                self.reverse-wrap = true; settings-dialog-end.focus(); self.reverse-wrap = false; return reject;
            }
            reject
        }
        key-pressed(event) => { if event.text == Key.Tab || event.text == Key.Backtab { return reject; } accept }
        key-released(event) => { accept }
        Rectangle {
        background: Theme.overlay;
        TouchArea { }
        settings-panel := Rectangle { width: min(590px * Theme.ui-scale, parent.width - 24px); height: min(560px * Theme.ui-scale, parent.height - 24px); x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; background: Theme.panel; border-radius: 12px * Theme.ui-scale; border-width: 1px; border-color: Theme.strong-border;
          // Scrolls when the scaled dialog is larger than the window.
          settings-scroll := ScrollView { width: parent.width; height: parent.height;
          viewport-width: max(self.visible-width, settings-layout.min-width);
          viewport-height: max(self.visible-height, settings-layout.min-height);
          settings-layout := VerticalLayout { width: settings-scroll.viewport-width; height: settings-scroll.viewport-height; padding: 26px * Theme.ui-scale; spacing: 13px * Theme.ui-scale;
            // Settings categories.
            HorizontalLayout { height: 30px * Theme.ui-scale; spacing: 8px * Theme.ui-scale;
                Action { width: 120px * Theme.ui-scale; primary: root.settings-page == 0; enabled: !root.output-applying; label: root.chinese ? "音频输出" : "Audio output"; clicked => { root.settings-page = 0; } }
                Action { width: 120px * Theme.ui-scale; primary: root.settings-page == 1; enabled: !root.output-applying; label: root.chinese ? "外观" : "Appearance"; clicked => { root.settings-page = 1; } }
                Rectangle { horizontal-stretch: 1; }
            }
            Rectangle { vertical-stretch: 1; min-height: max(audio-page.min-height, appearance-page.min-height + 46px * Theme.ui-scale); min-width: max(audio-page.min-width, appearance-page.min-width);
            appearance-page := VerticalLayout { width: parent.width; visible: root.settings-page == 1; spacing: 13px * Theme.ui-scale; alignment: start;
                Text { text: root.chinese ? "外观" : "Appearance"; color: Theme.ink; font-size: Theme.font(23); font-weight: 600; }
                Label { text: root.chinese ? "调整界面大小，更改立即生效并自动保存。" : "Adjust the interface size. Changes apply immediately and are saved."; }
                HorizontalLayout { height: 30px * Theme.ui-scale; spacing: 12px * Theme.ui-scale;
                    Label { width: 108px * Theme.ui-scale; text: root.chinese ? "界面缩放" : "Interface scale"; }
                    appearance-first := ComboBox { horizontal-stretch: 1; enabled: root.settings-page == 1; model: root.chinese ? ["自动（跟随系统）", "100%", "125%", "150%", "175%", "200%"] : ["Automatic (follow system)", "100%", "125%", "150%", "175%", "200%"]; current-index <=> root.ui-scale-index; selected => { root.ui-scale-requested(self.current-index); } }
                }
                Label { wrap: word-wrap; font-size: Theme.font(11); text: root.chinese ? "“自动”沿用系统显示缩放；百分比在此基础上再放大界面。窗口最小尺寸不变，放不下的列表可滚动。" : "Automatic uses the system display scale; a percentage enlarges the interface on top of it. The minimum window size stays the same and lists that do not fit scroll."; }
                HorizontalLayout { height: 30px * Theme.ui-scale; spacing: 12px * Theme.ui-scale;
                    Label { width: 108px * Theme.ui-scale; text: root.chinese ? "主题" : "Theme"; }
                    appearance-theme := ComboBox { horizontal-stretch: 1; enabled: root.settings-page == 1; model: root.chinese ? root.theme-names-cn : root.theme-names; current-index <=> root.theme-index; selected => { root.theme-requested(self.current-index); } }
                }
                HorizontalLayout { height: 30px * Theme.ui-scale; spacing: 12px * Theme.ui-scale;
                    Label { width: 108px * Theme.ui-scale; text: root.chinese ? "界面字号" : "Interface font"; }
                    appearance-ui-font := SpinBox { horizontal-stretch: 1; enabled: root.settings-page == 1; minimum: 10; maximum: 24; step-size: 1; value <=> root.ui-font-px; edited(value) => { root.ui-font-requested(value); } }
                    Label { width: 24px * Theme.ui-scale; text: "px"; }
                }
                HorizontalLayout { height: 30px * Theme.ui-scale; spacing: 12px * Theme.ui-scale;
                    Label { width: 108px * Theme.ui-scale; text: root.chinese ? "列表字号" : "List font"; }
