                if !root.update-supported: Label { text: root.chinese ? "请从 GitHub Releases 下载新版 Mac 客户端，关闭应用后替换。" : "Download new Mac clients from GitHub Releases. Close the app before replacing it."; wrap: word-wrap; }
                about-first := Action { height: 34px * Theme.ui-scale; primary: true; label: root.chinese ? "关闭" : "Close"; clicked => { root.about-visible = false; } }
            }
        }
    }
        about-dialog-end := FocusScope { width: 0px; height: 0px; focus-on-click: false; focus-gained(reason) => { if !about-dialog.reverse-wrap { about-first.focus(); } } }
    }
    library-dialog := FocusScope {
        visible: root.library-visible;
        enabled: root.library-visible && !root.sm-fs-visible;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        property <bool> reverse-wrap: false;
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.dismiss-modal(); return accept; }
            if root.confirmation-visible || (root.library-busy && !root.sm-local-escape) || root.closing { return accept; }
            if (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) && library-close-action.has-focus {
                self.reverse-wrap = true;
                library-tab-end.focus();
                self.reverse-wrap = false;
                // Slint's normal reverse traversal now starts at the sentinel,
                // visiting the last visible control even with maintenance open.
                return reject;
            }
            reject
        }
        key-pressed(event) => {
            if event.text == Key.Tab || event.text == Key.Backtab { return reject; }
            accept
        }
        key-released(event) => { accept }
        Rectangle { background: Theme.overlay;
        TouchArea { }
        Rectangle { width: min(root.width - 40px * Theme.ui-scale, 1080px * Theme.ui-scale); height: min(root.height - 40px * Theme.ui-scale, 720px * Theme.ui-scale); x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; background: Theme.panel; border-radius: 10px * Theme.ui-scale; border-width: 1px; border-color: Theme.border;
            VerticalLayout { padding: 20px * Theme.ui-scale; spacing: 10px * Theme.ui-scale;
