                            if root.library-visible && !root.sm-new && !root.sm-local-form && !root.sm-active: Action { width: 150px * Theme.ui-scale; primary: true; enabled: (!root.ds-applying && !root.library-busy) || (!root.sm-server && root.sm-local-escape); label: root.sm-server && root.ds-dirty ? (root.chinese ? "保存并切换" : "Save and switch") : (root.chinese ? "切换到此数据源" : "Switch to this source"); clicked => { root.sm-switch-requested(); } }
                        }
                        if root.library-visible && !root.sm-server && !root.sm-local-form: HorizontalLayout { height: 32px * Theme.ui-scale; spacing: 8px * Theme.ui-scale;
