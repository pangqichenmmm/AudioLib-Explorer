                                    if root.sm-cache-dir != "": Text { height: 14px * Theme.ui-scale; vertical-alignment: center; overflow: elide; color: Theme.dim; font-size: Theme.font(10); text: root.sm-cache-dir; }
                                }
                                Action { width: 140px * Theme.ui-scale; height: 30px * Theme.ui-scale; vertical-stretch: 0; enabled: root.sm-cache-available; label: root.chinese ? "打开镜像目录" : "Open mirror folder"; clicked => { root.sm-open-cache-requested(); } }
                            }
                            Label { vertical-stretch: 0; wrap: word-wrap; font-size: Theme.font(11); color: Theme.muted; text: root.chinese ? "自动清理：切换镜像后清理旧快照；过期临时文件自动回收。保留当前镜像、续传文件、恢复备份和手动备份。" : "Automatic cleanup removes old snapshots after a swap and reclaims stale temporary files. Keeps the current mirror, resumable downloads, recovery backups and manual backups."; }
                            HorizontalLayout { height: 28px * Theme.ui-scale; spacing: 8px * Theme.ui-scale;
                                if root.sm-active: Action { width: 110px * Theme.ui-scale; enabled: !root.ds-syncing && !root.ds-applying && root.remote-mode && !root.library-busy; label: root.ds-sync-pending ? (root.chinese ? "继续同步" : "Continue sync") : root.ds-syncing ? (root.chinese ? "同步中…" : "Syncing…") : (root.chinese ? "立即同步" : "Sync now"); clicked => { root.data-source-sync-requested(); } }
                                if root.sm-active && root.ds-syncing: Action { width: 110px * Theme.ui-scale; enabled: root.ds-sync-can-pause && !root.ds-sync-pausing && !root.closing; label: root.ds-sync-pausing ? (root.chinese ? "正在暂停…" : "Pausing…") : (root.chinese ? "暂停同步" : "Pause sync"); clicked => { root.data-source-sync-pause-requested(); } }
                                if root.sm-active && root.ds-sync-pending && !root.ds-syncing: Action { width: 130px * Theme.ui-scale; enabled: !root.ds-applying && !root.library-busy && !root.closing; label: root.chinese ? "重新下载" : "Restart download"; clicked => { root.data-source-sync-restart-requested(); } }
                                if root.sm-active && (root.ds-syncing || root.ds-sync-pending): Rectangle { width: 80px * Theme.ui-scale; height: 6px * Theme.ui-scale; y: (parent.height - self.height) / 2; background: Theme.border; border-radius: 3px * Theme.ui-scale;
                                    Rectangle { x: root.ds-progress >= 0 ? 0px : (parent.width - self.width) * root.ds-motion; width: root.ds-progress >= 0 ? parent.width * clamp(root.ds-progress, 0, 1) : parent.width * 0.3; height: parent.height; background: Theme.accent; border-radius: 3px * Theme.ui-scale; }
                                }
                                if root.sm-active: Label { horizontal-stretch: 1; vertical-alignment: center; font-size: Theme.font(11); overflow: elide; text: root.ds-syncing && root.ds-elapsed != "" ? root.ds-sync-info + " · " + root.ds-elapsed : root.ds-sync-info; }
                                if !root.sm-active: Label { horizontal-stretch: 1; vertical-alignment: center; font-size: Theme.font(11); overflow: elide; text: root.chinese ? "切换到此数据源后，可在这里同步快照、管理波形缓存、查看历史、校验、备份和导出。" : "Switch to this source to sync, manage the Waveform cache, view history, check, back up and export here."; }
                                Action { width: 64px * Theme.ui-scale; subtle: true; active: root.sm-cache-details; label: root.sm-cache-details ? (root.chinese ? "收起" : "Less") : (root.chinese ? "详情" : "Details"); clicked => { root.sm-cache-details = !root.sm-cache-details; } }
                            }
