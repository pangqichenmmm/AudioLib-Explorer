                                                    Action { horizontal-stretch: 1; enabled: !root.artwork-busy && !root.library-busy && !root.ds-applying && !root.closing; label: root.chinese ? "清理本机封面缓存" : "Clear cover thumbnails"; clicked => { root.artwork-action-requested(1); } }
