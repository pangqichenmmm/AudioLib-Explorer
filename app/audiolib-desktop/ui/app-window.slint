            VerticalLayout { padding: 24px * Theme.ui-scale; spacing: 11px * Theme.ui-scale;
                Text { text: (root.chinese ? "批量标注 · " : "Batch annotations · ") + root.checked-count; color: Theme.ink; font-size: Theme.font(22); }
                Label { text: root.chinese ? "仅应用选择的字段。所有记录在一个事务中更新。" : "Only enabled fields are applied. All records update in one transaction."; }
