                                        Text { x: 8px * Theme.ui-scale; height: parent.height; vertical-alignment: center; text: root.chinese ? "＋ 新服务器（未保存）" : "+ New server (unsaved)"; color: Theme.ink; font-size: Theme.font(12); }
                                    }
                                }
                            }
                        }
