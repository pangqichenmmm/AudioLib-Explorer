                                    for source[index] in root.sm-sources: Rectangle { height: 58px * Theme.ui-scale; border-radius: 5px * Theme.ui-scale; background: root.sm-selected == index ? Theme.selected : (source-hit.has-hover ? Theme.hover : transparent);
