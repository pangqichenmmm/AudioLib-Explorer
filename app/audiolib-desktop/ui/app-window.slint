                            Label { text: root.chinese ? "秒（0 = 关闭）" : "seconds (0 = off)"; }
                            CheckBox { horizontal-stretch: 1; enabled: !root.ds-applying && !root.library-busy && root.sm-pending-select == -2; text: root.chinese ? "有新版本时自动同步" : "Sync automatically when updated"; checked <=> root.ds-auto-sync; toggled => { root.shared-sync-dirty = true; } }
                            Action { width: root.chinese ? 110px * Theme.ui-scale : 140px * Theme.ui-scale; primary: root.shared-sync-dirty; enabled: root.shared-sync-dirty && !root.ds-applying && !root.library-busy && root.sm-pending-select == -2; label: root.chinese ? "保存同步设置" : "Save sync settings"; clicked => { root.shared-sync-save-requested(); } }
                        }
                        if root.shared-sync-close-pending: HorizontalLayout { height: 30px * Theme.ui-scale; spacing: 8px * Theme.ui-scale;
                            Label { horizontal-stretch: 1; text: root.chinese ? "全局同步设置尚未保存。" : "Shared synchronization settings have unsaved changes."; color: Theme.warning; }
                            Action { width: 110px * Theme.ui-scale; label: root.chinese ? "放弃同步修改" : "Discard sync edits"; clicked => { root.shared-sync-dirty = false; root.shared-sync-close-pending = false; root.close-library-manager(); } }
