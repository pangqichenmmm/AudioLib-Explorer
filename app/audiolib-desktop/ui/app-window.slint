        key-pressed(event) => { if event.text == Key.Tab || event.text == Key.Backtab { return reject; } accept }
        key-released(event) => { accept }
        Rectangle { background: Theme.overlay;
            TouchArea { }
            Rectangle { width: min(740px * Theme.ui-scale, parent.width - 32px * Theme.ui-scale); height: min(640px * Theme.ui-scale, parent.height - 32px * Theme.ui-scale); x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; background: Theme.panel; border-radius: 12px * Theme.ui-scale; border-width: 1px; border-color: Theme.border;
                VerticalLayout { padding: 20px * Theme.ui-scale; spacing: 8px * Theme.ui-scale;
                    Text { text: root.chinese ? "反馈问题与诊断日志" : "Bug report and diagnostics"; color: Theme.ink; font-size: Theme.font(22); font-weight: 600; }
                    Label { height: 36px * Theme.ui-scale; wrap: word-wrap; text: root.chinese ? "1. 开启 Debug → 关闭此窗口并复现 → 2. 返回生成报告 → 3. 检查并提交。开关仅在本次运行有效。" : "1. Enable Debug, close this panel and reproduce → 2. Generate a report → 3. Review and submit. Capture lasts for this run only."; }
                    HorizontalLayout { height: 32px * Theme.ui-scale; spacing: 10px * Theme.ui-scale;
                        debug-first := Action { width: 190px * Theme.ui-scale; enabled: !root.debug-busy; active: root.debug-enabled; label: root.debug-enabled ? (root.chinese ? "Debug 已开启 · 停止记录" : "Debug on · stop capture") : (root.chinese ? "开启 Debug 记录" : "Enable Debug capture"); clicked => { root.debug-mode-requested(!root.debug-enabled); } }
                        Label { horizontal-stretch: 1; wrap: word-wrap; text: root.chinese ? "仅记录脱敏状态；不自动上传普通日志。" : "Captures safe state fields; raw logs are not uploaded."; }
                    }
                    LineEdit { height: 32px * Theme.ui-scale; enabled: !root.debug-busy; input-label: root.chinese ? "问题标题" : "Issue title"; text <=> root.debug-title; placeholder-text: root.chinese ? "例如：播放后搜索结果丢失" : "e.g. Search results disappear after playback"; edited => { root.debug-report = ""; root.debug-issue-url = ""; } }
                    Label { text: root.chinese ? "复现步骤、预期行为和实际行为（会公开到 GitHub，请勿填写凭据或私密路径）" : "Steps, expected and actual behavior (public on GitHub; omit credentials and private paths)"; wrap: word-wrap; }
                    TextEdit { height: 64px * Theme.ui-scale; enabled: !root.debug-busy; accessible-label: root.chinese ? "复现步骤" : "Reproduction steps"; text <=> root.debug-steps; edited => { root.debug-report = ""; root.debug-issue-url = ""; } }
                    HorizontalLayout { height: 32px * Theme.ui-scale; spacing: 8px * Theme.ui-scale;
                        Action { width: 170px * Theme.ui-scale; enabled: !root.debug-busy; label: root.debug-busy ? (root.chinese ? "正在生成…" : "Generating…") : (root.chinese ? "生成并保存脱敏报告" : "Generate and save report"); clicked => { root.debug-action-requested(0); } }
                        Action { width: 126px * Theme.ui-scale; label: root.chinese ? "打开日志目录" : "Open log folder"; clicked => { root.debug-action-requested(2); } }
                        Label { horizontal-stretch: 1; text: root.debug-enabled ? (root.chinese ? "正在记录" : "Capturing") : (root.chinese ? "Debug 已关闭" : "Debug off"); color: root.debug-enabled ? Theme.accent : Theme.dim; }
                    }
                    TextEdit { vertical-stretch: 1; min-height: 70px * Theme.ui-scale; accessible-label: root.chinese ? "脱敏报告预览" : "Diagnostic report preview"; read-only: true; font-size: Theme.font(11); text: root.debug-report; }
                    Label { height: 40px * Theme.ui-scale; wrap: word-wrap; text: root.debug-feedback == "" ? (root.chinese ? "报告不包含数据库、WAV、搜索原文或服务器凭据。GitHub 页面需登录并最后点击创建 Issue。" : "No database, WAV, search text or server credentials are included. Sign in on GitHub and click Create issue to submit.") : root.debug-feedback; }
                    HorizontalLayout { height: 34px * Theme.ui-scale; spacing: 8px * Theme.ui-scale;
                        Action { width: 120px * Theme.ui-scale; enabled: root.debug-report != "" && !root.debug-busy; label: root.chinese ? "复制完整报告" : "Copy full report"; clicked => { root.copy-text(root.debug-report); } }
                        Rectangle { horizontal-stretch: 1; }
                        debug-close-action := Action { width: 84px * Theme.ui-scale; label: root.chinese ? "关闭" : "Close"; clicked => { root.debug-visible = false; } }
                        Action { width: 180px * Theme.ui-scale; primary: true; enabled: root.debug-report != "" && root.debug-issue-url != "" && !root.debug-busy; label: root.chinese ? "在 GitHub 提交问题…" : "Open GitHub issue…"; clicked => { root.copy-text(root.debug-report); root.debug-action-requested(1); } }
                    }
                }
            }
        }
            debug-tab-end := FocusScope { width: 0px; height: 0px; focus-on-click: false; focus-gained(reason) => { if !debug-dialog.reverse-wrap { debug-first.focus(); } } }
