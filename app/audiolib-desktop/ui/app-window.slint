                                                    Action { horizontal-stretch: 1; enabled: !root.library-busy && !root.scanning; label: root.chinese ? "增量扫描…" : "Incremental scan…"; clicked => { root.prepare-scan(0, root.local-scan-target-path); } }
                                                    Action { horizontal-stretch: 1; enabled: !root.library-busy && !root.scanning; label: root.chinese ? "全量扫描…" : "Full scan…"; clicked => { root.prepare-scan(1, root.local-scan-target-path); } }
