                        Action { height: 30px * Theme.ui-scale; enabled: !root.ds-applying && !root.library-busy && root.sm-pending-select == -2; label: root.chinese ? "＋ 添加源" : "+ Add source"; clicked => { root.sm-add-choice = !root.sm-add-choice; } }
                        if root.sm-add-choice: VerticalLayout { spacing: 4px * Theme.ui-scale;
                            Action { height: 30px * Theme.ui-scale; label: root.chinese ? "本地音效库路径…" : "Local library path…"; clicked => { root.sm-select-row(-4); } }
                            Action { height: 30px * Theme.ui-scale; label: root.chinese ? "服务器音效库…" : "Server library…"; clicked => { root.sm-select-row(-1); } }
                        }
                        if !root.sm-new && !root.sm-local-form && (root.sm-server || !root.sm-local-default) && !root.sm-confirm-delete: Action { height: 30px * Theme.ui-scale; enabled: !root.ds-applying && !root.library-busy && !root.sm-active; label: root.sm-server ? (root.chinese ? "删除此服务器配置…" : "Delete this server profile…") : (root.chinese ? "移除此本地音效库…" : "Remove this local library…"); clicked => { root.sm-confirm-delete = true; } }
                        if !root.sm-new && !root.sm-local-form && (root.sm-server || !root.sm-local-default) && root.sm-active && !root.sm-confirm-delete: Label { wrap: word-wrap; font-size: Theme.font(10); color: Theme.muted; text: root.chinese ? "当前数据源不能移除，请先切换到其他数据源。" : "Switch to another source before removing the active source."; }
                        if !root.sm-server && !root.sm-local-form && root.sm-local-default: Label { wrap: word-wrap; font-size: Theme.font(10); color: Theme.muted; text: root.chinese ? "default 为默认音效库，无法移除。" : "The default library cannot be removed."; }
