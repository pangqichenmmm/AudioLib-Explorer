    changed scanning => { if root.import-visible { root.schedule-modal-focus(); } }
    changed library-busy => { if !root.library-busy && (root.import-visible || root.library-visible || root.confirmation-visible) { root.schedule-modal-focus(); } }
    function schedule-modal-focus() {
        modal-focus-timer.running = true;
        modal-focus-timer.restart();
    }
    // Menu dismissal restores the old input focus after its activated callback.
    // Defer once past dismissal; zero-interval timers can expire again before
    // running=false is applied, repeatedly stealing focus from modal editors.
    modal-focus-timer := Timer {
        running: false;
        interval: 1ms;
        triggered => {
            if self.running {
                self.running = false;
                root.focus-library-modal();
            }
        }
    }
    // The incoming virtual list can anchor its first jump during layout. A
    // takeover therefore repeats only the explicit selection's reveal once.
    workbench-user-reveal-timer := Timer {
        running: false; interval: 16ms;
        triggered => {
            self.running = false;
            if root.workbench-user-reveal-row == root.selected-row && root.workbench-user-reveal-row >= 0 && root.workbench-user-reveal-epoch == root.result-scroll-epoch && !root.task-restoring && !root.background-blocked {
                root.reveal-selected-row();
                root.report-result-window();
            }
            root.workbench-user-reveal-row = -1;
        }
    }
    task-viewport-timer := Timer {
        running: false; interval: 16ms;
        triggered => {
            self.running = false;
            // Stopping a native timer cannot revoke a callback already queued
            // by the event loop. Reject it before touching any current sidebar.
            if !root.task-viewport-pending || root.result-scroll-apply-epoch != root.result-scroll-epoch {
                return;
            }
            if root.result-scroll-remote != root.remote-mode {
                root.discard-other-source-result-restore();
                return;
            }
            if root.workbench-switch-pending && root.workbench-switch-epoch == root.result-scroll-epoch {
                root.task-wanted-result-y = root.workbench-switch-result-row * root.task-result-row-height;
            }
            let content-height = max(0, root.rows.length) * root.result-row-height;
            if root.task-viewport-pending && root.result-scroll-apply-epoch == root.result-scroll-epoch && root.result-scroll-remote == root.remote-mode && content-height > (Theme.modern-style ? studio-result-list.visible-height : result-list.visible-height) && (Theme.modern-style ? studio-result-list.viewport-height : result-list.viewport-height) < content-height - 1px {
                // Wait for the arriving virtual repeater to measure its range;
                // otherwise Flickable clamps a restored offset against old bounds.
                self.running = true;
                self.restart();
                return;
            }
            // A server result-list offset must not land on another source. Folder,
            // filter and inspector scrolls are not tied to that row model.
            if root.task-viewport-pending && root.result-scroll-apply-epoch == root.result-scroll-epoch && root.result-scroll-remote == root.remote-mode {
                // Pending getters must report the measured range, even while
                // the second result pass protects the fractional row anchor.
                root.task-wanted-result-y = clamp(root.task-wanted-result-y * 1px, min(0px, (Theme.modern-style ? studio-result-list.visible-height : result-list.visible-height) - content-height), 0px) / 1px;
                root.task-wanted-result-x = clamp(root.task-wanted-result-x * 1px, min(0px, (Theme.modern-style ? studio-result-list.visible-width : result-list.visible-width) - root.table-content-size), 0px) / 1px;
                if Theme.modern-style { studio-result-list.viewport-y = root.task-wanted-result-y * 1px; } else { result-list.viewport-y = root.task-wanted-result-y * 1px; }
                root.table-viewport-x = root.task-wanted-result-x * 1px;
                root.sync-table-viewport();
            }
            let workbench-restore = root.workbench-switch-pending && root.workbench-switch-epoch == root.result-scroll-epoch;
            // Ordinary task panes do not depend on the result ListView's second
            // layout pass. Apply them before real wheel input can take over.
            if !workbench-restore && !root.task-viewport-first-applied { root.apply-task-pane-viewport(); }
            if !root.task-viewport-first-applied {
                // A newly visible native ListView first anchors its virtual rows
                // to the first item. Reapply the fractional row offset after one
                // layout turn, before exposing a completed restore or prefetch.
                root.task-viewport-first-applied = true;
                self.running = true;
                self.restart();
                return;
            }
            if workbench-restore { root.apply-task-pane-viewport(); }
            if root.workbench-switch-pending {
                // A later task/library restore supersedes this presentation-only
                // request; its offsets must not be replaced by the old workbench.
                if root.workbench-switch-epoch == root.result-scroll-epoch {
                    if Theme.modern-style {
                        studio-task-tabs-scroll.viewport-x = clamp(root.workbench-switch-tabs-x, min(0px, studio-task-tabs-scroll.visible-width - studio-task-tabs-scroll.viewport-width), 0px);
                        studio-main-scroll.viewport-x = clamp(root.workbench-switch-main-x, min(0px, studio-main-scroll.visible-width - studio-main-scroll.viewport-width), 0px);
                        studio-main-scroll.viewport-y = clamp(root.workbench-switch-main-y, min(0px, studio-main-scroll.visible-height - studio-main-scroll.viewport-height), 0px);
                    } else {
                        task-tabs-scroll.viewport-x = clamp(root.workbench-switch-tabs-x, min(0px, task-tabs-scroll.visible-width - task-tabs-scroll.viewport-width), 0px);
                        main-scroll.viewport-x = clamp(root.workbench-switch-main-x, min(0px, main-scroll.visible-width - main-scroll.viewport-width), 0px);
                        main-scroll.viewport-y = clamp(root.workbench-switch-main-y, min(0px, main-scroll.visible-height - main-scroll.viewport-height), 0px);
                    }
                    if root.active-search-task-index >= 0 && root.active-search-task-index < root.search-tasks.length {
                        root.reveal-search-task(root.active-search-task-index);
                    }
                }
                root.workbench-switch-pending = false;
            }
            root.task-viewport-pending = false;
            root.task-restoring = false;
            root.report-result-window();
        }
    }
    // A deferred mode change must not discard a restore armed for the mode now showing.
    changed remote-mode => {
        if root.task-viewport-pending && root.result-scroll-remote != root.remote-mode {
            root.discard-other-source-result-restore();
        }
    }
    detail-tag-probe := Text { visible: false; text: root.detail-tag-probe-text; font-size: Theme.font(12); }
    clipboard-input := TextInput { visible: false; }
    // Measures one tag chip for the Rust row wrapping (tag-probe-width); never shown.
    tag-probe := TagChipView { visible: false; enabled: false; text: root.tag-probe-text; chinese: root.chinese; }
    init => { Palette.color-scheme = ColorScheme.dark; root.content-width = self.width - (Theme.modern-style ? 8px : 32px) * Theme.ui-scale; }
    MenuBar {
        visible: !Theme.modern-style;
        Menu { title: root.chinese ? "文件" : "File"; enabled: root.menu-ready;
            MenuItem { title: root.chinese ? "Debug 模式 · 记录诊断" : "Debug mode · capture diagnostics"; enabled: root.menu-ready && !root.debug-busy; checkable: true; checked: root.debug-enabled; activated => { root.debug-mode-requested(!root.debug-enabled); } }
            MenuItem { title: root.chinese ? "反馈问题 / 诊断报告…" : "Report a bug / diagnostics…"; enabled: root.menu-ready; activated => { root.debug-visible = true; } }
            MenuItem { title: root.chinese ? "打开日志目录" : "Open log folder"; enabled: root.menu-ready; activated => { root.debug-action-requested(2); } }
            MenuSeparator { }
            MenuItem { title: root.chinese ? "退出" : "Exit"; enabled: root.menu-ready; shortcut: @keys(Control + Q); activated => { root.exit-requested(); } }
        }
        Menu { title: root.chinese ? "编辑" : "Edit"; enabled: root.menu-ready;
            MenuItem { title: root.chinese ? "查看 / 编辑 Metadata" : "View / edit Metadata"; enabled: root.menu-ready && root.has-selection; activated => { root.show-details-page(); } }
            MenuItem { title: (root.chinese ? "保存 Metadata" : "Save Metadata"); enabled: root.menu-ready && root.has-selection && root.metadata-dirty; shortcut: @keys(Control + S); activated => { root.save-metadata-requested(); } }
            MenuItem { title: (root.chinese ? "批量标注选择记录…" : "Edit selected records…"); enabled: root.menu-ready && root.checked-count > 0; activated => { root.open-batch(); } }
            MenuSeparator { }
            MenuItem { title: root.chinese ? "选择已加载的结果" : "Check loaded results"; enabled: root.menu-ready; activated => { root.check-current-page(); } }
            MenuItem { title: root.chinese ? "清除全部选择" : "Clear selection"; enabled: root.menu-ready && root.checked-count > 0; activated => { root.check-page-requested(false); } }
            MenuItem { title: (root.edit-favorite ? (root.chinese ? "取消收藏" : "Remove from favorites") : (root.chinese ? "添加到收藏" : "Add to favorites")); enabled: root.menu-ready && root.has-selection && !root.remote-writes-blocked && !root.metadata-writes-blocked; activated => { root.file-action-requested(root.selected-id, 5); } }
            MenuSeparator { }
            MenuItem { title: root.chinese ? "复制所选文件路径" : "Copy selected file path"; enabled: root.menu-ready && root.has-selection; activated => { root.copy-text(root.selected-path); } }
            MenuItem { title: (root.native-macos ? (root.chinese ? "在访达中显示" : "Reveal in Finder") : (root.chinese ? "在资源管理器中定位" : "Reveal in Explorer")) + root.ro-suffix; enabled: root.menu-ready && root.has-selection && !root.remote-mode; activated => { root.file-action-requested(root.selected-id, 2); } }
            MenuItem { title: (root.chinese ? "修复所选文件引用…" : "Repair selected file reference…") + root.ro-suffix; enabled: root.menu-ready && root.has-selection && !root.remote-mode; activated => { root.file-action-requested(root.selected-id, 20); } }
            MenuSeparator { }
            MenuItem { title: (root.chinese ? "移除所选记录（保留 WAV）…" : "Remove selected record (keep WAV)…") + root.removal-suffix; enabled: root.menu-ready && root.has-selection && root.removal-allowed; activated => { root.file-action-requested(root.selected-id, 21); } }
            MenuItem { title: (root.chinese ? "移除选择记录（保留 WAV）…" : "Remove selected records (keep WAV)…") + root.removal-suffix; enabled: root.menu-ready && root.checked-count > 0 && root.removal-allowed; activated => { root.library-action(11); } }
            MenuItem { title: (root.chinese ? "移除当前目录（保留 WAV）…" : "Remove current folder (keep WAV)…") + root.removal-suffix; enabled: root.menu-ready && root.selected-folder-path != "" && root.removal-allowed; activated => { root.folder-action-requested(root.selected-folder-path, 1); } }
        }
        Menu { title: root.chinese ? "音效库" : "Library"; enabled: root.menu-ready;
            MenuItem { title: root.chinese ? "音效库管理…" : "Manage sound library…"; enabled: root.menu-ready; shortcut: @keys(Control + D); activated => { root.open-library(0); } }
            MenuItem { title: root.chinese ? "查看缺失文件 / 修复引用" : "Missing files / repair references"; enabled: root.menu-ready; activated => { root.show-missing-files(); } }
            // Not an everyday choice, so it lives here rather than in the list header; the
            // title names the current choice and the list footer flags a non-default one.
            Menu { title: (root.chinese ? "显示文件：" : "Show files: ") + root.visibility-labels[root.visibility-index];
                MenuItem { title: root.visibility-labels[0]; enabled: root.menu-ready; activated => { root.visibility-index = 0; root.filter-requested(); } }
                MenuItem { title: root.visibility-labels[1]; enabled: root.menu-ready; activated => { root.visibility-index = 1; root.filter-requested(); } }
                MenuItem { title: root.visibility-labels[2]; enabled: root.menu-ready; activated => { root.visibility-index = 2; root.filter-requested(); } }
            }
            MenuSeparator { }
            MenuItem { title: root.chinese ? "扫描历史…" : "Scan history…"; enabled: root.menu-ready; activated => { root.open-history(0); } }
            MenuItem { title: root.chinese ? "最近播放…" : "Recent playback…"; enabled: root.menu-ready; activated => { root.open-history(1); } }
        }
        Menu { title: root.chinese ? "扫描" : "Scan"; enabled: root.menu-ready;
            MenuItem { title: (root.chinese ? "增量扫描文件夹…" : "Incremental folder scan…") + root.ro-suffix; enabled: root.menu-ready && !root.scanning && !root.remote-mode; shortcut: @keys(Control + Shift + I); activated => { root.prepare-scan(0, ""); } }
            MenuItem { title: (root.chinese ? "全量扫描文件夹…" : "Full folder rescan…") + root.ro-suffix; enabled: root.menu-ready && !root.scanning && !root.remote-mode; activated => { root.prepare-scan(1, ""); } }
            MenuSeparator { }
            MenuItem { title: (root.chinese ? "增量扫描当前目录" : "Incremental scan of current folder") + root.ro-suffix; enabled: root.menu-ready && !root.scanning && root.selected-folder-path != "" && !root.remote-mode; activated => { root.prepare-scan(0, root.selected-folder-path); } }
            MenuItem { title: (root.chinese ? "全量扫描当前目录" : "Full rescan of current folder") + root.ro-suffix; enabled: root.menu-ready && !root.scanning && root.selected-folder-path != "" && !root.remote-mode; activated => { root.prepare-scan(1, root.selected-folder-path); } }
            MenuSeparator { }
            MenuItem { title: root.scan-paused ? (root.chinese ? "继续扫描" : "Resume scan") : (root.chinese ? "暂停扫描" : "Pause scan"); enabled: root.menu-ready && root.scan-controllable && !root.scan-validating; activated => { root.scan-pause-requested(); } }
            MenuItem { title: root.chinese ? "取消当前扫描" : "Cancel current scan"; enabled: root.menu-ready && root.scan-controllable; activated => { root.scan-cancel-requested(); } }
            MenuItem { title: root.chinese ? "刷新素材库" : "Refresh library"; enabled: root.menu-ready; shortcut: @keys(F5); activated => { root.refresh-requested(); } }
        }
        Menu { title: root.chinese ? "视图" : "View"; enabled: root.menu-ready;
            MenuItem { title: root.chinese ? "搜索" : "Search"; enabled: root.menu-ready; shortcut: @keys(Control + F); activated => { if Theme.modern-style { studio-search-input.focus(); } else { search-input.focus(); } } }
            MenuItem { title: root.chinese ? "显示侧栏（筛选 / 详情）" : "Show side panel (filters / details)"; enabled: root.menu-ready; shortcut: @keys(Control + I); checkable: true; checked <=> root.inspector-visible; }
            MenuItem { title: root.chinese ? "显示筛选" : "Show filters"; enabled: root.menu-ready; activated => { root.filters-visible = true; root.inspector-visible = true; } }
            MenuItem { title: root.chinese ? "显示声音详情" : "Show sound details"; enabled: root.menu-ready; activated => { root.show-details-page(); } }
            MenuItem { title: root.chinese ? "重置筛选" : "Reset filters"; enabled: root.menu-ready; activated => { root.reset-filters(); } }
            MenuSeparator { }
            MenuItem { title: root.chinese ? "全部声音" : "All sounds"; enabled: root.menu-ready; activated => { root.library-sidebar-page = 0; root.favorites-only = false; root.all-library-requested(); } }
            MenuItem { title: root.chinese ? "我的收藏" : "Favorites"; enabled: root.menu-ready; activated => { root.library-sidebar-page = 1; root.favorites-category = 0; root.favorites-only = true; root.all-library-requested(); } }
            // Column headers sort; modification time has no column, so it is chosen here.
            Menu { title: (root.chinese ? "排序：" : "Sort: ") + root.sort-label;
                MenuItem { title: root.chinese ? "修改时间（新 → 旧）" : "Modified (newest first)"; enabled: root.menu-ready; activated => { root.sort-index = 6; root.sort-descending = true; root.filter-requested(); root.table-layout-changed(); } }
                MenuItem { title: root.chinese ? "修改时间（旧 → 新）" : "Modified (oldest first)"; enabled: root.menu-ready; activated => { root.sort-index = 6; root.sort-descending = false; root.filter-requested(); root.table-layout-changed(); } }
                MenuSeparator { }
                MenuItem { title: root.chinese ? "默认排序" : "Default order"; enabled: root.menu-ready && root.sort-index != 0; activated => { root.sort-table(0); } }
            }
            MenuSeparator { }
            MenuItem { title: root.chinese ? "外观设置…" : "Appearance settings…"; enabled: root.menu-ready; activated => { root.settings-page = 1; root.settings-visible = true; } }
            MenuItem { title: root.chinese ? "Switch to English" : "切换到中文"; enabled: root.menu-ready; activated => { root.chinese = !root.chinese; root.language-requested(root.chinese); } }
        }
        Menu { title: root.chinese ? "播放" : "Playback"; enabled: root.menu-ready;
            MenuItem { title: root.chinese ? "试听所选文件" : "Audition selected file"; enabled: root.menu-ready && root.has-selection && !root.selected-missing; activated => { root.file-action-requested(root.selected-id, 0); } }
            MenuItem { title: root.chinese ? "播放" : "Play"; enabled: root.menu-ready && root.audio-ready && !root.selected-missing; activated => { root.start-requested(); } }
            MenuItem { title: root.chinese ? "暂停" : "Pause"; enabled: root.menu-ready && root.playing; activated => { root.pause-requested(); } }
            MenuItem { title: root.chinese ? "停止" : "Stop"; enabled: root.menu-ready && (root.audio-ready || root.play-duration > 0); activated => { root.stop-requested(); } }
            MenuSeparator { }
            MenuItem { title: root.chinese ? "音频输出设置…" : "Audio output settings…"; enabled: root.menu-ready; activated => { root.settings-page = 0; root.output-settings-requested(); root.settings-visible = true; } }
            MenuItem { title: root.chinese ? "Spectral Peaks 设置…" : "Spectral Peaks settings…"; enabled: root.menu-ready; activated => { root.peaks-visible = true; } }
        }
        Menu { title: root.chinese ? "帮助" : "Help"; enabled: root.menu-ready;
            MenuItem { title: root.chinese ? "快捷键与基本操作…" : "Shortcuts and basics…"; enabled: root.menu-ready; activated => { root.help-visible = true; } }
            MenuItem { title: root.chinese ? "关于 AudioLib Explorer" : "About AudioLib Explorer"; enabled: root.menu-ready; activated => { root.about-visible = true; } }
        }
    }
    forward-focus: shortcuts;
    shortcuts := FocusScope {
        min-width: 0px; min-height: 0px; preferred-width: 1440px * Theme.ui-scale; preferred-height: 900px * Theme.ui-scale;
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.dismiss-modal();
                return accept;
            }
            reject
        }

    // Menu popups can restore a previous editor/list focus after opening a modal.
    // Capture background keys before any editor or list processes that focus.
    background-input := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if root.help-visible {
                if event.text == Key.Escape { root.help-visible = false; }
                return accept;
            }
            if root.background-blocked {
                if event.text == Key.Escape { root.dismiss-modal(); }
                else if event.text == Key.Tab || event.text == Key.Backtab {
                    root.focus-library-modal();
                }
                return accept;
            }
            reject
        }
        capture-key-released(event) => { root.background-blocked ? accept : reject }
    // The minimum window size stays 1080x700; when a large interface scale makes the
    // layout's minimum larger than the window, the whole main view scrolls instead of
    // being cut off. At 1.0 the viewport equals the window, so nothing changes.

global-menu-file := ContextMenuArea { x: 0px; y: 0px; width: 0px; height: 0px;
        Menu { title: root.chinese ? "文件" : "File"; enabled: root.menu-ready;
