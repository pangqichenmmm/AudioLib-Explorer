                    library-close-action := Action { width: 60px * Theme.ui-scale; enabled: !root.library-busy && !root.ds-applying && !root.sm-manage-busy; label: root.chinese ? "关闭" : "Close"; clicked => { root.close-library-manager(); } }
                }
