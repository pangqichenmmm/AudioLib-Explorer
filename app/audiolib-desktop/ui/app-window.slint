    horizontal-stretch: 0;
    background: Theme.control-surface;
    border-width: 1px; border-color: Theme.border; border-radius: 4px * Theme.ui-scale;
    pill-text := Text { x: 8px * Theme.ui-scale; width: max(0px, parent.width - 16px * Theme.ui-scale); height: parent.height; text: root.text; color: root.ink; font-size: root.text-size; vertical-alignment: center; overflow: elide; }
    Tooltip { text: @markdown("\{root.text}"); }
}

component DetailParameter inherits Rectangle {
