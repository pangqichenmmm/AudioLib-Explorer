// app/audiolib-desktop/ui/app-window.slint
import { TextEdit, ComboBox, ListView, ScrollView, Palette, SpinBox } from "std-widgets.slint";

import { Theme, ThemedLineEdit as LineEdit, ThemedCheckBox as CheckBox } from "theme.slint";

import { AuditionPanel, PeakSettings, RulerTick } from "audition-panel.slint";
import { SearchTaskTab } from "search-task-tabs.slint";
// Exported so tests can exercise non-default scales; the desktop does not touch it yet.
export { Theme }
export { RulerTick }

export struct AudioRow {
    id: string,
    file-path: string,
    name: string,
    folder: string,
    duration: string,
    format: string,
    channels: string,
    tags: string,
    tag-preview: [string],
    tag-extra: int,
    duration-clock: string,
    album: string,
    favorite: bool,
    missing: bool,
    checked: bool,
    marker: color,
    // List thumbnail Waveform: 0 placeholder (not loaded), 1 `wave` thumbnail stretched
    // to the column, 2 center line (empty file), 3 no Waveform (missing/undecodable),
    // 4 root offline (server mode: a stale `wave` with the offline tint, or a placeholder).
    wave-state: int,
    wave: image,
}
export struct FolderRow { name: string, count: string, path: string, depth: int, expanded: bool, has-children: bool }
/// One declared library/album and how many present records carry it.
export struct AlbumRow { id: string, name: string, count: string, cover: image }
export struct CrumbRow { name: string }
export struct DisplayTagRow { tags: [string] }
export struct SearchTaskRow { id: string, name: string, favorite: bool, modified: bool, active: bool, keywords: [string], folder: string, summary: string, searched: bool }
export struct SavedSearchTaskRow { id: string, name: string, summary: string }
// One row of the unified window's source list: kind 0 = the local library (always row 0),
// 1 = a saved server profile. status-kind: 0 unknown, 1 ok, 3 failed.
export struct SourceRow { id: string, name: string, subtitle: string, kind: int, active: bool, status: string, status-kind: int }
// One server root on the 服务器音效库 page (GET /roots).
export struct ServerRootRow { name: string, path: string, status: string, offline: bool, scanning: bool, file-count: string, missing: string, last-scan: string, message: string }
// Top-level local folders (parent_id IS NULL): the Manage library scan-roots list.
export struct LocalScanRootRow { name: string, path: string, file-count: string, invalid: bool }
export struct RemoteFolderRow { name: string, path: string }
export struct RemoteBreadcrumbRow { name: string, path: string }
// One include/exclude filter term; `index` is its position among all terms.
export struct TagChip { text: string, exclude: bool, index: int }
// Chips that fit one line of the filter sidebar; rows are wrapped in Rust (tag_chips.rs).
export struct TagChipRow { chips: [TagChip] }

component Action inherits Rectangle {
    in property <string> label;
    in property <string> action-label: root.label;
    in property <bool> primary: false;
    in property <bool> active: false;
    in property <bool> subtle: false;
    in property <bool> dropdown: false;
    in property <bool> enabled: true;
    /// A mouse click must not claim keyboard focus, so transport keys (e.g. Space
    /// for the result list) keep working right after a click. Tabbed focus still
    /// activates the button with Space/Return.
    in property <bool> keyboard-active: true;
    out property <bool> has-focus: button-focus.has-focus;
    callback clicked;
    min-width: 36px * Theme.ui-scale;
    min-height: 30px * Theme.ui-scale;
    accessible-role: button;
    accessible-label: root.action-label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: button-focus;
    border-radius: 5px * Theme.ui-scale;
    background: root.primary ? (hit.has-hover ? Theme.accent-hover : Theme.accent) : (root.active ? Theme.selected : (hit.has-hover ? Theme.hover : (root.subtle ? transparent : Theme.raised)));
    border-width: 1px;
    border-color: button-focus.has-focus || root.active ? Theme.accent : (root.subtle ? transparent : Theme.border);
    opacity: root.enabled ? 1 : 0.42;
    Text { width: parent.width - (root.dropdown ? 18px * Theme.ui-scale : 0px); text: root.label; color: root.primary ? Theme.on-accent : Theme.ink; horizontal-alignment: center; vertical-alignment: center; font-size: Theme.font(12); }
    if root.dropdown: Image { source: @image-url("icons/chevron-down.svg"); colorize: Theme.ink; width: 10px * Theme.ui-scale; height: 6px * Theme.ui-scale; x: parent.width - 16px * Theme.ui-scale; y: (parent.height - self.height) / 2; accessible-role: none; }
    button-focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if root.keyboard-active && (event.text == " " || event.text == Key.Return) { root.clicked(); return accept; }
            reject
        }
    }
    hit := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component Label inherits Text { color: Theme.dim; font-size: Theme.font(11); vertical-alignment: center; }

// The number of active filters on a panel switch.
component CountBadge inherits Rectangle {
    in property <int> count;
    height: 15px * Theme.ui-scale;
    min-width: 15px * Theme.ui-scale;
    border-radius: 7.5px * Theme.ui-scale;
    background: Theme.accent;
    HorizontalLayout { padding-left: 4px * Theme.ui-scale; padding-right: 4px * Theme.ui-scale;
        Text { text: root.count; color: Theme.on-accent; font-size: Theme.font(9); font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    }
}

// One icon of the list header's 筛选 | 详情 switch (sits on a Theme.trough track). Lit
// (raised segment, accent icon) while its sidebar page shows, otherwise a grey icon.
component IconSegment inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active: false;
    in property <int> count: 0;
    in property <bool> enabled: true;
    callback clicked;
    // The filter count sits beside the icon in accent, visible even while the icon is grey.
    width: root.count > 0 ? 46px * Theme.ui-scale : 34px * Theme.ui-scale;
    accessible-role: button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.active;
    accessible-description: root.count > 0 ? root.count + "" : "";
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: segment-focus;
    border-radius: 5px * Theme.ui-scale;
    background: root.active ? Theme.segment : transparent;
    border-width: segment-focus.has-focus ? 1px : 0px;
    border-color: Theme.accent;
    opacity: root.enabled ? 1 : 0.42;
    HorizontalLayout { alignment: center; spacing: 3px * Theme.ui-scale;
        Image {
            y: (parent.height - self.height) / 2; width: 16px * Theme.ui-scale; height: 16px * Theme.ui-scale;
            source: root.icon; image-fit: contain; accessible-role: none;
            colorize: root.active ? Theme.accent : (segment-hit.has-hover ? Theme.ink : Theme.muted);
        }
        if root.count > 0: Text { text: root.count; color: Theme.accent; font-size: Theme.font(11); font-weight: 700; vertical-alignment: center; }
    }
    Tooltip { text: @markdown("\{root.label}"); }
    segment-focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return { root.clicked(); return accept; }
            reject
        }
    }
    segment-hit := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// One page of the sidebar's page switch (sits on a Theme.trough track): a raised capsule
// when selected, plain grey text otherwise, never a border, so it does not read as a button.
component SegmentTab inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> action-label: root.label;
    in property <bool> active: false;
    in property <int> count: 0;
    callback clicked;
    accessible-role: tab;
    accessible-label: root.action-label;
    accessible-item-selectable: true;
    accessible-item-selected: root.active;
    accessible-description: root.count > 0 ? root.count + "" : "";
    accessible-action-default => { root.clicked(); }
    forward-focus: tab-focus;
    border-radius: 6px * Theme.ui-scale;
    background: root.active ? Theme.segment : transparent;
    drop-shadow-blur: root.active ? 3px * Theme.ui-scale : 0px;
    drop-shadow-offset-y: 1px;
    drop-shadow-color: #00000070;
    border-width: tab-focus.has-focus ? 1px : 0px;
    border-color: Theme.accent;
    HorizontalLayout { alignment: center; spacing: 6px * Theme.ui-scale;
        Image {
            y: (parent.height - self.height) / 2; width: 14px * Theme.ui-scale; height: 14px * Theme.ui-scale;
            source: root.icon; image-fit: contain; accessible-role: none;
            colorize: root.active ? Theme.accent : (tab-hit.has-hover ? Theme.dim : Theme.muted);
        }
        Text { text: root.label; color: root.active ? Theme.ink : (tab-hit.has-hover ? Theme.dim : Theme.muted); font-size: Theme.font(12); font-weight: root.active ? 600 : 400; vertical-alignment: center; }
        if root.count > 0: CountBadge { y: (parent.height - self.height) / 2; count: root.count; }
    }
    tab-focus := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return { root.clicked(); return accept; }
            reject
        }
    }
    tab-hit := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A list-footer reminder of a scope chosen from a menu (file status, menu-only sort), so
// it is not forgotten; clicking it restores the default.
component ScopeHint inherits Rectangle {
    in property <string> label;
    in property <string> action-label;
    in property <bool> enabled: true;
    callback clicked;
    height: 22px * Theme.ui-scale;
    accessible-role: button;
    accessible-label: root.action-label;
    accessible-description: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    border-radius: 11px * Theme.ui-scale;
    border-width: 1px;
    border-color: Theme.warning;
    background: hint-hit.has-hover ? Theme.hover : transparent;
    opacity: root.enabled ? 1 : 0.42;
    HorizontalLayout { padding-left: 8px * Theme.ui-scale; padding-right: 7px * Theme.ui-scale; spacing: 5px * Theme.ui-scale;
        Text { text: root.label; color: Theme.warning; font-size: Theme.font(10); vertical-alignment: center; }
        Text { text: "×"; color: Theme.warning; font-size: Theme.font(11); vertical-alignment: center; }
    }
    hint-hit := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// The round sign or remove control inside a tag chip.
component ChipButton inherits Rectangle {
    in property <string> glyph;
    in property <color> glyph-color;
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked;
    width: 20px * Theme.ui-scale;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: chip-focus;
    border-radius: 10px * Theme.ui-scale;
    background: chip-hit.has-hover || chip-focus.has-focus ? Theme.hover : transparent;
    Text { text: root.glyph; color: root.glyph-color; font-size: Theme.font(13); font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    chip-focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return { root.clicked(); return accept; }
            reject
        }
    }
    chip-hit := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// An include (+, accent) or exclude (−, struck through) filter term. The sign switches
// the side and × removes the term; long terms elide inside the sidebar width.
component TagChipView inherits Rectangle {
    in property <string> text;
    in property <bool> exclude;
    in property <bool> chinese;
    in property <bool> enabled: true;
    callback toggle;
    callback remove;
    height: 24px * Theme.ui-scale;
    border-radius: 12px * Theme.ui-scale;
    border-width: 1px;
    background: root.exclude ? Theme.danger-surface : Theme.selected;
    border-color: root.exclude ? Theme.danger : Theme.accent;
    accessible-role: list-item;
    accessible-label: (root.exclude ? (root.chinese ? "排除：" : "Exclude: ") : (root.chinese ? "包含：" : "Include: ")) + root.text;
    HorizontalLayout { padding-left: 2px * Theme.ui-scale; padding-right: 2px * Theme.ui-scale; spacing: 1px * Theme.ui-scale;
        ChipButton {
            enabled: root.enabled; glyph: root.exclude ? "−" : "+"; glyph-color: root.exclude ? Theme.danger : Theme.accent;
            label: root.exclude ? (root.chinese ? "改为包含 " : "Include ") + root.text : (root.chinese ? "改为排除 " : "Exclude ") + root.text;
            clicked => { root.toggle(); }
        }
        chip-text := Text { text: root.text; color: root.exclude ? Theme.dim : Theme.ink; font-size: Theme.font(11); overflow: elide; vertical-alignment: center; }
        ChipButton {
            enabled: root.enabled; glyph: "×"; glyph-color: Theme.dim;
            label: (root.chinese ? "移除标签 " : "Remove tag ") + root.text;
            clicked => { root.remove(); }
        }
    }
    if root.exclude: Rectangle { x: chip-text.x; y: chip-text.y + chip-text.height / 2; width: chip-text.width; height: 1px; background: Theme.danger; }
}

// A remote directory is a keyboard-accessible navigation action, never a local path.
component RemoteFolderAction inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    /// A mouse click must not claim keyboard focus, so transport keys (e.g. Space
    /// for the result list) keep working right after a click. Tabbed focus still
    /// activates the picker row with Space/Return.
    in property <bool> keyboard-active: true;
    callback clicked();
    height: 36px * Theme.ui-scale;
    min-width: 180px * Theme.ui-scale;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: folder-focus;
    border-radius: 4px * Theme.ui-scale;
    background: folder-hit.has-hover || folder-focus.has-focus ? Theme.hover : transparent;
    border-width: folder-focus.has-focus ? 1px : 0px;
    border-color: Theme.accent;
    opacity: root.enabled ? 1 : 0.42;
    Rectangle { x: 12px * Theme.ui-scale; y: 12px * Theme.ui-scale; width: 7px * Theme.ui-scale; height: 4px * Theme.ui-scale; border-width: 1px; border-color: Theme.dim; border-radius: 1px; }
    Rectangle { x: 12px * Theme.ui-scale; y: 15px * Theme.ui-scale; width: 16px * Theme.ui-scale; height: 11px * Theme.ui-scale; background: Theme.panel; border-width: 1px; border-color: Theme.dim; border-radius: 2px * Theme.ui-scale; }
    Text { x: 40px * Theme.ui-scale; width: parent.width - 52px * Theme.ui-scale; height: parent.height; text: root.label; color: Theme.ink; font-size: Theme.font(12); vertical-alignment: center; overflow: elide; }
    folder-focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if root.keyboard-active && (event.text == " " || event.text == Key.Return) { root.clicked(); return accept; }
            reject
        }
    }
    folder-hit := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Source tags remain selectable while compact views avoid TextEdit's large padding.
component SourceTags inherits Rectangle {
    in property <string> text;
    in property <string> label;
    in property <string> displayed-id;
    changed displayed-id => {
        tags-input.set-selection-offsets(0, 0);
        tags-scroll.viewport-y = 0px;
    }
    background: Theme.raised;
    border-radius: 4px * Theme.ui-scale;
    border-width: 1px;
    border-color: Theme.border;
    tags-scroll := ScrollView {
        x: 6px * Theme.ui-scale; y: 2px * Theme.ui-scale; width: parent.width - 12px * Theme.ui-scale; height: parent.height - 4px * Theme.ui-scale;
        viewport-width: self.visible-width;
        VerticalLayout { padding: 0px; alignment: start;
            tags-input := TextInput {
                accessible-label: root.label;
                text: root.text; read-only: true; single-line: false; wrap: word-wrap;
                page-height: tags-scroll.visible-height;
                font-size: Theme.font(11); color: Theme.ink;
                selection-background-color: Theme.accent;
                selection-foreground-color: Theme.on-accent;
                cursor-position-changed(position) => {
                    // Keep keyboard selection visible inside the tag viewport.
                    if position.y + tags-scroll.viewport-y < 0px {
                        tags-scroll.viewport-y = min(0px, max(tags-scroll.visible-height - self.height, -position.y));
                    } else if position.y + tags-scroll.viewport-y > tags-scroll.visible-height - 20px * Theme.ui-scale {
                        tags-scroll.viewport-y = min(0px, max(tags-scroll.visible-height - self.height, tags-scroll.visible-height - position.y - 20px * Theme.ui-scale));
                    }
                }
            }
        }
    }
}

// Absolute pointer coordinates stay stable while the divider itself moves.
component PaneDivider inherits Rectangle {
    in property <length> pane-width;
    in property <bool> reverse: false;
    in property <bool> enabled: true;
    in property <string> label;
    callback resized(length);
    // Emitted once a drag or keyboard adjustment ends, to persist the layout.
    callback finished();
    private property <length> pressed-pointer-x;
    private property <length> pressed-pane-width;
    width: 12px * Theme.ui-scale;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    forward-focus: divider-focus;
    Rectangle {
        x: 5px * Theme.ui-scale; width: 2px * Theme.ui-scale; y: 10px * Theme.ui-scale; height: parent.height - 20px * Theme.ui-scale; border-radius: 1px;
        background: drag-area.pressed || divider-focus.has-focus ? Theme.accent : (drag-area.has-hover ? Theme.dim : Theme.border);
    }
    divider-focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.LeftArrow || event.text == Key.RightArrow {
                let step = event.text == Key.LeftArrow ? -16px * Theme.ui-scale : 16px * Theme.ui-scale;
                root.resized(root.pane-width + (root.reverse ? -step : step));
                root.finished();
                return accept;
            }
            reject
        }
    }
    drag-area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: ew-resize;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                divider-focus.focus();
                root.pressed-pointer-x = self.absolute-position.x + self.mouse-x;
                root.pressed-pane-width = root.pane-width;
            }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                root.finished();
            }
        }
        moved => {
            if self.pressed {
                let delta = self.absolute-position.x + self.mouse-x - root.pressed-pointer-x;
                root.resized(root.pressed-pane-width + (root.reverse ? -delta : delta));
            }
        }
    }
}

// Section headers stay reachable while their lists are collapsed.
component SidebarSectionHeader inherits Rectangle {
    in property <string> label;
    in property <string> action-label;
    in property <string> suffix;
    in property <bool> expanded: true;
    in property <bool> enabled: true;
    callback toggled();
    accessible-role: button;
    accessible-label: root.action-label;
    accessible-checkable: true;
    accessible-checked: root.expanded;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.toggled(); } }
    forward-focus: header-focus;
    border-radius: 4px * Theme.ui-scale;
    border-width: header-focus.has-focus ? 1px : 0px;
    border-color: Theme.accent;
    background: header-hit.has-hover ? Theme.hover : transparent;
    HorizontalLayout { spacing: 5px * Theme.ui-scale;
        disclosure-icon := Image { width: 12px * Theme.ui-scale; height: 12px * Theme.ui-scale; y: (parent.height - self.height) / 2;
            // The software renderer does not rotate items; select the vector direction directly.
            source: root.expanded ? @image-url("icons/sidebar-chevron-down.svg") : @image-url("icons/sidebar-chevron-right.svg");
            colorize: header-hit.has-hover || header-focus.has-focus ? Theme.ink : Theme.dim;
            accessible-role: none;
        }
        Label { horizontal-stretch: 1; text: root.label; font-size: Theme.font(10); }
        Label { text: root.suffix; font-size: Theme.font(9); color: Theme.accent; }
    }
    header-focus := FocusScope {
        enabled: root.enabled; focus-on-click: false;
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return { root.toggled(); return accept; }
            if event.text == Key.LeftArrow && root.expanded { root.toggled(); return accept; }
            if event.text == Key.RightArrow && !root.expanded { root.toggled(); return accept; }
            reject
        }
    }
    header-hit := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { header-focus.focus(); root.toggled(); } }
}

// Use absolute coordinates so the horizontal divider can move during its drag.
component SidebarSectionDivider inherits Rectangle {
    in property <length> pane-height;
    in property <string> label;
    in property <string> help;
    in property <bool> enabled: true;
    callback resized(length);
    callback finished();
    private property <length> pressed-pointer-y;
    private property <length> pressed-pane-height;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    forward-focus: divider-focus;
    Rectangle { x: 0px; width: parent.width; y: (parent.height - 1px) / 2; height: 1px;
        background: drag-area.pressed || divider-focus.has-focus ? Theme.accent : (drag-area.has-hover ? Theme.dim : Theme.border);
    }
    Rectangle { x: (parent.width - self.width) / 2; width: 24px * Theme.ui-scale; y: (parent.height - self.height) / 2; height: 3px * Theme.ui-scale; border-radius: 1.5px * Theme.ui-scale;
        background: drag-area.pressed || divider-focus.has-focus ? Theme.accent : Theme.dim;
    }
    Tooltip { text: @markdown("\{root.help}"); }
    divider-focus := FocusScope {
        enabled: root.enabled; focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.UpArrow || event.text == Key.DownArrow {
                root.resized(root.pane-height + (event.text == Key.UpArrow ? -16px * Theme.ui-scale : 16px * Theme.ui-scale));
                root.finished();
                return accept;
            }
            reject
        }
    }
    drag-area := TouchArea {
        enabled: root.enabled; mouse-cursor: ns-resize;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                divider-focus.focus();
                root.pressed-pointer-y = self.absolute-position.y + self.mouse-y;
                root.pressed-pane-height = root.pane-height;
            }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up { root.finished(); }
        }
        moved => {
            if self.pressed { root.resized(root.pressed-pane-height + self.absolute-position.y + self.mouse-y - root.pressed-pointer-y); }
        }
    }
}

// Sortable column actions keep the same keyboard behavior as ordinary actions.
component TableHeader inherits Rectangle {
    in property <string> label;
    in property <string> action-label;
    in property <string> help;
    in property <bool> active: false;
    in property <bool> descending: false;
    in property <bool> enabled: true;
    /// A mouse click must not claim keyboard focus, so transport keys (e.g. Space
    /// for the result list) keep working right after a click. Tabbed focus still
    /// activates the header with Space/Return.
    in property <bool> keyboard-active: true;
    callback clicked();
    callback context-requested(Point);
    accessible-role: button;
    accessible-label: root.action-label;
    accessible-value: root.active ? (root.descending ? "descending" : "ascending") : "";
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: header-focus;
    background: header-hit.has-hover ? Theme.hover : transparent;
    border-width: header-focus.has-focus ? 1px : 0px;
    border-color: Theme.accent;
    Text {
        x: 8px * Theme.ui-scale; width: max(0px, parent.width - (root.active ? 26px * Theme.ui-scale : 16px * Theme.ui-scale)); height: parent.height;
        text: root.label; font-size: Theme.font(10); font-weight: root.active ? 600 : 400;
        color: root.active ? Theme.ink : Theme.dim; overflow: elide; vertical-alignment: center;
    }
    if root.active: Text {
        x: parent.width - 14px * Theme.ui-scale; width: 10px * Theme.ui-scale; height: parent.height;
        text: root.descending ? "▼" : "▲"; color: Theme.accent;
        font-size: Theme.font(9); vertical-alignment: center; horizontal-alignment: center;
    }
    Tooltip { text: @markdown("\{root.help}"); }
    header-focus := FocusScope {
        enabled: root.enabled; focus-on-click: false;
        key-pressed(event) => {
            if root.keyboard-active && (event.text == " " || event.text == Key.Return) { root.clicked(); return accept; }
            if event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift) {
                root.context-requested({x: self.absolute-position.x, y: self.absolute-position.y + self.height});
                return accept;
            }
            reject
        }
    }
    header-hit := TouchArea {
        enabled: root.enabled; mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                header-focus.focus();
                root.context-requested({x: self.absolute-position.x + self.mouse-x, y: self.absolute-position.y + self.mouse-y});
            }
        }
    }
}

// Store the absolute press position because a resized column moves its divider.
// Slint reports a press within the double-click interval and 10 px of the previous
// press as a double click on its release, even after a drag; only two presses that
// did not drag may reset the column, or a click followed by a drag loses the width.
component TableDivider inherits Rectangle {
    in property <length> column-width;
    in property <string> label;
    in property <string> help;
    in property <bool> enabled: true;
    callback resized(length);
    callback finished();
    callback reset();
    private property <length> pressed-pointer-x;
    private property <length> pressed-column-width;
    private property <bool> dragged;
    private property <bool> previous-dragged;
    width: 8px * Theme.ui-scale;
    accessible-role: button;
    accessible-label: root.label;
    accessible-value: root.column-width / (1px * Theme.ui-scale) + " px"; // logical (unscaled) width, matching the stored setting
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.reset(); } }
    forward-focus: divider-focus;
    Rectangle {
        x: 3px * Theme.ui-scale; width: 1px; y: 7px * Theme.ui-scale; height: max(0px, parent.height - 14px * Theme.ui-scale);
        background: drag-area.pressed || divider-focus.has-focus ? Theme.accent : (drag-area.has-hover ? Theme.dim : Theme.border);
    }
    Tooltip { text: @markdown("\{root.label}. \{root.help}"); }
    divider-focus := FocusScope {
        enabled: root.enabled; focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.LeftArrow || event.text == Key.RightArrow {
                root.resized(root.column-width + (event.text == Key.LeftArrow ? -16px * Theme.ui-scale : 16px * Theme.ui-scale));
                root.finished();
                return accept;
            }
            if event.text == Key.Home { root.reset(); return accept; }
            reject
        }
    }
    drag-area := TouchArea {
        enabled: root.enabled; mouse-cursor: ew-resize;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                divider-focus.focus();
                root.previous-dragged = root.dragged;
                root.dragged = false;
                root.pressed-pointer-x = self.absolute-position.x + self.mouse-x;
                root.pressed-column-width = root.column-width;
            }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up && root.column-width != root.pressed-column-width { root.finished(); }
        }
        moved => {
            if self.pressed {
                let delta = self.absolute-position.x + self.mouse-x - root.pressed-pointer-x;
                if abs(delta) > 2px * Theme.ui-scale { root.dragged = true; }
                root.resized(root.pressed-column-width + delta);
            }
        }
        // Slint calls this before the release pointer event, so `dragged` is this press.
        double-clicked => { if !root.dragged && !root.previous-dragged { root.reset(); } }
    }
}

component HelpPanel inherits FocusScope {
    in property <bool> chinese;
    callback close();
    focus-on-click: false;
    focus-on-tab-navigation: false;
    init => { self.focus(); }
    capture-key-pressed(event) => {
        if event.text == Key.Tab || event.text == Key.Backtab {
            close-action.focus();
            return accept;
        }
        reject
    }
    key-pressed(event) => {
        if event.text == Key.Escape { root.close(); }
        accept
    }
    key-released(event) => { accept }
    Rectangle {
        background: Theme.overlay;
        TouchArea { }
        Rectangle { width: 640px * Theme.ui-scale; height: 470px * Theme.ui-scale; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; background: Theme.panel; border-radius: 12px * Theme.ui-scale; border-width: 1px; border-color: Theme.border;
            VerticalLayout { padding: 28px * Theme.ui-scale; spacing: 16px * Theme.ui-scale;
                Text { text: root.chinese ? "快捷键与基本操作" : "Shortcuts and basics"; color: Theme.ink; font-size: Theme.font(23); font-weight: 600; }
                Text { text: root.chinese ? "Ctrl Shift I   添加声音文件夹     ·     Ctrl D   音效库管理\nCtrl F   搜索     ·     Ctrl S   保存 Metadata\nCtrl I   显示 / 隐藏侧栏     ·     F5   刷新素材库\nCtrl Q   保存草稿并退出     ·     Esc   关闭当前面板" : "Ctrl Shift I   Add sound folder     ·     Ctrl D   Manage sound library\nCtrl F   Search     ·     Ctrl S   Save Metadata\nCtrl I   Show / hide side panel     ·     F5   Refresh library\nCtrl Q   Save drafts and exit     ·     Esc   Close current panel"; color: Theme.ink; wrap: word-wrap; }
                Text { text: root.chinese ? "新增声音：通过文件菜单添加文件夹，扫描其中的 WAV / BWF。\n批量编辑：Ctrl 单击切换选择，Shift 单击连续选择，再使用批量标注。\n移除：编辑菜单可移除所选记录、选择记录或当前目录；仅删除数据库记录及标注，磁盘上的 WAV 会保留。" : "Add sounds: use File to add a folder and scan its WAV / BWF files.\nBatch edit: Ctrl-click to toggle or Shift-click to select a range, then choose Edit selected records in Edit.\nRemove: Edit can remove the selected record, selected records or current folder. Library records and annotations are removed; WAV files remain on disk."; color: Theme.dim; wrap: word-wrap; }
                Text { text: root.chinese ? "日常更新用增量扫描；整理文件后用全量扫描检查缺失。\n修复引用：音效库 → 查看缺失文件，选中声音后在详情面板选择新位置。标签和备注会保留。\n备份与数据库维护收在音效库管理底部的“高级维护”中。" : "Use incremental scans for daily updates; full scans check missing files after reorganizing a folder.\nRepair: Library → Missing files, select a sound, then locate it in Sound details. Annotations are kept.\nBackups and database tools are under Advanced maintenance in library management."; color: Theme.dim; wrap: word-wrap; }
                close-action := Action { height: 34px * Theme.ui-scale; primary: true; label: root.chinese ? "关闭" : "Close"; clicked => { root.close(); } }
            }
        }
    }
}

component StudioAction inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> navigation: false;
    in property <string> action-label: root.label;
    in property <bool> primary: false;
    in property <bool> active: false;
    in property <bool> subtle: false;
    in property <bool> dropdown: false;
    in property <bool> enabled: true;
    /// A mouse click must not claim keyboard focus, so transport keys (e.g. Space
    /// for the result list) keep working right after a click. Tabbed focus still
    /// activates the button with Space/Return.
    in property <bool> keyboard-active: true;
    out property <bool> has-focus: button-focus.has-focus;
    callback clicked;
    min-width: 36px * Theme.ui-scale;
    min-height: 30px * Theme.ui-scale;
    accessible-role: button;
    accessible-label: root.action-label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: button-focus;
    border-radius: 5px * Theme.ui-scale;
    background: root.primary ? (hit.has-hover ? Theme.accent-hover : Theme.accent) : (root.active ? Theme.selected : (hit.has-hover ? Theme.control-hover-surface : (root.subtle || root.navigation ? transparent : Theme.control-surface)));
    border-width: 1px;
    border-color: button-focus.has-focus ? Theme.accent : (root.navigation ? transparent : (root.active ? Theme.accent : (root.subtle ? transparent : Theme.border)));
    opacity: root.enabled ? 1 : 0.42;
    if root.navigation && root.active: Rectangle { x: 0px; width: 2px * Theme.ui-scale; y: 4px * Theme.ui-scale; height: parent.height - 8px * Theme.ui-scale; background: Theme.accent; border-radius: 1px; }
    if root.icon.width > 0: Image { x: 12px * Theme.ui-scale; y: (parent.height - self.height) / 2; width: 17px * Theme.ui-scale; height: self.width; source: root.icon; colorize: root.active ? Theme.accent : Theme.dim; image-fit: contain; accessible-role: none; }
    Text { x: root.icon.width > 0 ? 40px * Theme.ui-scale : (root.navigation ? 12px * Theme.ui-scale : 0px); width: parent.width - self.x - (root.dropdown ? 18px * Theme.ui-scale : (root.navigation ? 8px * Theme.ui-scale : 0px)); text: root.label; color: root.primary ? Theme.on-accent : Theme.ink; horizontal-alignment: root.navigation ? left : center; vertical-alignment: center; font-size: Theme.font(12); font-weight: root.navigation && root.active ? 500 : 400; }
    if root.dropdown: Image { source: @image-url("icons/chevron-down.svg"); colorize: Theme.ink; width: 10px * Theme.ui-scale; height: 6px * Theme.ui-scale; x: parent.width - 16px * Theme.ui-scale; y: (parent.height - self.height) / 2; accessible-role: none; }
    button-focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if root.keyboard-active && (event.text == " " || event.text == Key.Return) { root.clicked(); return accept; }
            reject
        }
    }
    hit := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component StudioIconSegment inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> show-label: false;
    in property <bool> indicator-only: false;
    in property <bool> highlighted: false;
    in property <bool> active: false;
    in property <int> count: 0;
    in property <bool> enabled: true;
    callback clicked;
    // The filter count sits beside the icon in accent, visible even while the icon is grey.
    width: (root.count > 0 ? 46px * Theme.ui-scale : 34px * Theme.ui-scale) + (root.show-label ? segment-label.preferred-width + 5px * Theme.ui-scale : 0px);
    accessible-role: button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.active;
    accessible-description: root.count > 0 ? root.count + "" : "";
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: segment-focus;
    border-radius: 5px * Theme.ui-scale;
    background: root.indicator-only ? (segment-hit.has-hover ? Theme.hover : transparent) : root.active ? Theme.segment : transparent;
    border-width: segment-focus.has-focus ? 1px : 0px;
    border-color: Theme.accent;
    opacity: root.enabled ? 1 : 0.42;
    HorizontalLayout { alignment: center; spacing: 3px * Theme.ui-scale;
        Image {
            y: (parent.height - self.height) / 2; width: 16px * Theme.ui-scale; height: 16px * Theme.ui-scale;
            source: root.icon; image-fit: contain; accessible-role: none;
            colorize: root.active || root.highlighted ? Theme.accent : (segment-hit.has-hover ? Theme.ink : Theme.muted);
        }
        segment-label := Text { visible: root.show-label; text: root.show-label ? root.label : ""; color: root.active ? Theme.ink : Theme.dim; font-size: Theme.font(11); vertical-alignment: center; }
        if root.count > 0: Text { text: root.count; color: Theme.accent; font-size: Theme.font(11); font-weight: 700; vertical-alignment: center; }
    }
    Tooltip { text: @markdown("\{root.label}"); }
    segment-focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return { root.clicked(); return accept; }
            reject
        }
    }
    segment-hit := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } scroll-event(event) => { reject } }
}

component StudioSourceTags inherits Rectangle {
    in property <bool> boxed: true;
    in property <length> text-size: Theme.font(11);
    in property <string> text;
    in property <string> label;
    in property <string> displayed-id;
    changed displayed-id => {
        tags-input.set-selection-offsets(0, 0);
        tags-scroll.viewport-y = 0px;
    }
    background: root.boxed ? Theme.raised : transparent;
    border-radius: 4px * Theme.ui-scale;
    border-width: root.boxed ? 1px : 0px;
    border-color: Theme.border;
    tags-scroll := ScrollView {
        x: 6px * Theme.ui-scale; y: 2px * Theme.ui-scale; width: parent.width - 12px * Theme.ui-scale; height: parent.height - 4px * Theme.ui-scale;
        viewport-width: self.visible-width;
        VerticalLayout { padding: 0px; alignment: start;
            tags-input := TextInput {
                accessible-label: root.label;
                text: root.text; read-only: true; single-line: false; wrap: word-wrap;
                page-height: tags-scroll.visible-height;
                font-size: root.text-size; color: Theme.ink;
                selection-background-color: Theme.accent;
                selection-foreground-color: Theme.on-accent;
                cursor-position-changed(position) => {
                    // Keep keyboard selection visible inside the tag viewport.
                    if position.y + tags-scroll.viewport-y < 0px {
                        tags-scroll.viewport-y = min(0px, max(tags-scroll.visible-height - self.height, -position.y));
                    } else if position.y + tags-scroll.viewport-y > tags-scroll.visible-height - 20px * Theme.ui-scale {
                        tags-scroll.viewport-y = min(0px, max(tags-scroll.visible-height - self.height, tags-scroll.visible-height - position.y - 20px * Theme.ui-scale));
                    }
                }
            }
        }
    }
}

component MenuBarItem inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();
    height: 32px * Theme.ui-scale;
    min-width: 38px * Theme.ui-scale;
    preferred-width: menu-text.preferred-width + 18px * Theme.ui-scale;
    horizontal-stretch: 0;
    border-radius: 4px * Theme.ui-scale;
    background: menu-hit.has-hover ? Theme.hover : transparent;
    border-width: menu-focus.has-focus ? 1px : 0px; border-color: Theme.accent;
    accessible-role: button; accessible-label: root.label; accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: menu-focus;
    menu-text := Text { text: root.label; color: root.enabled ? Theme.ink : Theme.muted; font-size: Theme.font(12); vertical-alignment: center; horizontal-alignment: center; }
    menu-focus := FocusScope { enabled: root.enabled; focus-on-click: false; key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.clicked(); return accept; } reject } }
    menu-hit := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component ExportButton inherits Rectangle {
    in property <string> label;
    in property <string> action-label;
    in property <string> file-id;
    in property <bool> enabled: true;
    callback clicked();
    callback drag-started(string);
    height: 32px * Theme.ui-scale; min-width: 36px * Theme.ui-scale;
    border-radius: 4px * Theme.ui-scale; border-width: 1px;
    border-color: export-focus.has-focus ? Theme.accent : Theme.border;
    background: export-hit.has-hover ? Theme.control-hover-surface : Theme.control-surface;
    opacity: root.enabled ? 1 : 0.42;
    accessible-role: button; accessible-label: root.action-label; accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: export-focus;
    HorizontalLayout { padding-left: 10px * Theme.ui-scale; padding-right: 10px * Theme.ui-scale; spacing: 6px * Theme.ui-scale; alignment: center;
        Image { width: 14px * Theme.ui-scale; source: @image-url("icons/export.svg"); image-fit: contain; colorize: Theme.ink; accessible-role: none; }
        Text { text: root.label; color: Theme.ink; font-size: Theme.font(12); vertical-alignment: center; }
    }
    export-focus := FocusScope { enabled: root.enabled; focus-on-click: false; key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.clicked(); return accept; } reject } }
    export-hit := TouchArea { enabled: root.enabled; mouse-cursor: pointer;
        property <bool> sent;
        property <string> captured-id;
        pointer-event(event) => { if event.button == PointerEventButton.left && event.kind == PointerEventKind.down { self.sent = false; self.captured-id = root.file-id; } }
        moved => { if self.pressed && !self.sent && (abs(self.mouse-x - self.pressed-x) > 6px * Theme.ui-scale || abs(self.mouse-y - self.pressed-y) > 6px * Theme.ui-scale) { self.sent = true; root.drag-started(self.captured-id); } }
        clicked => { if !self.sent { root.clicked(); } }
    }
}

component DisplayTag inherits Rectangle {
    in property <string> text;
    in property <color> ink: Theme.ink;
    in property <length> text-size: Theme.font(12);
