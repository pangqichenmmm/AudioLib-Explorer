                            Rectangle { width: parent.width; height: parent.height; visible: root.sm-local-content;
                                VerticalLayout { spacing: 10px * Theme.ui-scale;
                                    Label { height: 24px * Theme.ui-scale; text: root.library-health; color: Theme.accent; }
                                    if root.library-feedback != "": Text { height: 34px * Theme.ui-scale; text: root.library-feedback; color: Theme.accent; wrap: word-wrap; font-size: Theme.font(11); }
                                    library-scroll := ScrollView { vertical-stretch: 1; min-height: 0px; viewport-width: self.visible-width;
                                        VerticalLayout { spacing: 12px * Theme.ui-scale; padding-right: 8px * Theme.ui-scale; alignment: start;
                                            if !root.sm-server || root.sm-page == 2: VerticalLayout { spacing: 6px * Theme.ui-scale;
                                                Action { height: 28px * Theme.ui-scale; subtle: true; label: (root.chinese ? "当前目录的专辑封面 " : "Album cover in this folder ") + (root.artwork-management-expanded ? "▾" : "▸"); clicked => { root.artwork-management-expanded = !root.artwork-management-expanded; } }
                                                if root.artwork-management-expanded: VerticalLayout { spacing: 6px * Theme.ui-scale;
                                                CheckBox { text: root.chinese ? "显示封面（本地与服务器）" : "Show covers (local and server)"; checked <=> root.artwork-enabled; enabled: !root.artwork-busy && !root.library-busy && !root.ds-applying && !root.closing; toggled => { root.artwork-enabled-requested(self.checked); } }
                                                Label { wrap: word-wrap; font-size: Theme.font(10); color: Theme.muted; text: root.chinese ? "自动及手动封面只作用于当前专辑在所选 WAV 直接父目录中的成员，不影响其他子目录。手动选择仅存于本机；本地和服务器模式规则一致。清理缓存保留手动图片和隐藏选择。" : "Automatic and custom covers apply only to this album in the selected WAV's immediate folder. Other subfolders stay independent. Choices stay on this PC in local and server mode; clearing thumbnails keeps custom images and hidden choices."; }
                                                Label { wrap: word-wrap; font-size: Theme.font(10); color: Theme.muted; text: root.chinese ? "旧的全专辑封面选择可继承，且保持不变。恢复目录默认会忽略旧选择，重新使用该目录的 WAV 内嵌图片，不改变其他目录。" : "Older whole-album choices remain available as inherited defaults. Restoring this folder's default ignores that inheritance and uses its WAV artwork, without changing other folders or the older choice."; }
                                                Text { text: root.has-selection ? (root.chinese ? "当前专辑：" : "Current album: ") + (root.selected-album != "" ? root.selected-album : (root.chinese ? "文件夹专辑" : "Folder album")) + "\n" + (root.chinese ? "直接父目录：" : "Immediate folder: ") + (root.selected-artwork-directory != "" ? root.selected-artwork-directory : (root.chinese ? "未指定 / 相对目录" : "Unassigned / relative folder")) : (root.chinese ? "先在主列表选择音频，再管理该专辑在当前子目录中的封面。" : "Select a sound in the main list to manage its album cover in this folder."); color: Theme.dim; wrap: word-wrap; font-size: Theme.font(11); }
                                                HorizontalLayout { height: 30px * Theme.ui-scale; spacing: 6px * Theme.ui-scale;
                                                    Action { horizontal-stretch: 1; enabled: root.has-selection && root.sm-active && !root.artwork-busy && !root.library-busy && !root.ds-applying && !root.closing; label: root.chinese ? "指定 / 替换本目录图片…" : "Set folder image…"; clicked => { root.artwork-action-requested(2); } }
                                                    Action { horizontal-stretch: 1; enabled: root.has-selection && root.sm-active && !root.artwork-busy && !root.library-busy && !root.ds-applying && !root.closing; label: root.chinese ? "移除本目录封面" : "Remove folder cover"; clicked => { root.artwork-action-requested(3); } }
                                                    Action { horizontal-stretch: 1; enabled: root.has-selection && root.sm-active && !root.artwork-busy && !root.library-busy && !root.ds-applying && !root.closing; label: root.chinese ? "恢复本目录默认" : "Restore folder default"; clicked => { root.artwork-action-requested(4); } }
