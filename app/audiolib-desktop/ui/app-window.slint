                HorizontalLayout { height: 30px * Theme.ui-scale; spacing: 12px * Theme.ui-scale;
                    Label { width: 108px * Theme.ui-scale; text: root.chinese ? "源文件监听对" : "Source pair"; }
                    settings-source := LineEdit { width: 70px * Theme.ui-scale; enabled: root.settings-page == 0 && !root.output-applying; text <=> root.source-pair; }
                    Label { horizontal-stretch: 1; text: root.chinese ? "0 = 源声道 1/2, 1 = 3/4…" : "0 = source channels 1/2, 1 = 3/4…"; }
