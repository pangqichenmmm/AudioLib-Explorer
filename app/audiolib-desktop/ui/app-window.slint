                    settings-first := ComboBox { horizontal-stretch: 1; enabled: root.settings-page == 0 && !root.output-applying; model: root.audio-backend-names; current-index <=> root.backend-index; selected => { if (root.backend-index == 0) { root.rate-index = 0; } root.devices-requested(root.backend-index); } }
                }
                HorizontalLayout { height: 30px * Theme.ui-scale; spacing: 12px * Theme.ui-scale;
                    Label { width: 108px * Theme.ui-scale; text: root.chinese ? "设备" : "Device"; }
                    settings-device := ComboBox { horizontal-stretch: 1; enabled: root.settings-page == 0 && !root.devices-loading && !root.output-applying; model: root.device-names; current-index <=> root.device-index; selected => { root.device-selected(root.device-index); } }
                }
                HorizontalLayout { height: 30px * Theme.ui-scale; spacing: 12px * Theme.ui-scale;
                    Label { width: 108px * Theme.ui-scale; text: root.chinese ? "采样率策略" : "Sample rate policy"; }
                    settings-rate := ComboBox { horizontal-stretch: 1; enabled: root.settings-page == 0 && root.backend-index == 1 && !root.output-applying; model: root.chinese ? ["设备默认 · 自动重采样", "原生 · ASIO 文件采样率"] : ["Device default · resample", "Native · ASIO source rate"]; current-index <=> root.rate-index; }
                }
                HorizontalLayout { height: 30px * Theme.ui-scale; spacing: 12px * Theme.ui-scale;
                    Label { width: 108px * Theme.ui-scale; text: root.chinese ? "缓冲区 / 帧" : "Buffer / frames"; }
