                                                    Action { width: 110px * Theme.ui-scale; enabled: root.scan-controllable && !root.scan-validating; label: root.scan-paused ? (root.chinese ? "继续扫描" : "Resume scan") : (root.chinese ? "暂停扫描" : "Pause scan"); clicked => { root.scan-pause-requested(); } }
                                                    Action { width: 130px * Theme.ui-scale; enabled: root.scan-controllable; label: root.chinese ? "取消当前扫描" : "Cancel current scan"; clicked => { root.scan-cancel-requested(); } }
