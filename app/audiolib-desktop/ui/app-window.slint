                            Action { width: 110px * Theme.ui-scale; enabled: !root.ds-applying && !root.library-busy; label: root.chinese ? "编辑音效库…" : "Edit library…"; clicked => { root.sm-local-edit-requested(); } }
                        }
                        if root.library-visible && root.sm-server: HorizontalLayout { height: 30px * Theme.ui-scale; spacing: 6px * Theme.ui-scale;
                            Action { width: 96px * Theme.ui-scale; active: root.sm-page == 0; enabled: !root.ds-applying; label: root.chinese ? "连接与库信息" : "Connection & library"; clicked => { root.sm-page = 0; root.sm-page-selected(0); } }
                            Action { width: 120px * Theme.ui-scale; active: root.sm-page == 1; enabled: !root.ds-applying && !root.sm-new; label: root.chinese ? "服务器音效库" : "Server library"; clicked => { root.sm-page = 1; root.sm-page-selected(1); } }
                            Action { width: 110px * Theme.ui-scale; active: root.sm-page == 2; enabled: !root.ds-applying && !root.sm-new; label: root.chinese ? "缓存与导出" : "Cache and export"; clicked => { root.sm-page = 2; root.sm-page-selected(2); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        if root.library-visible && root.sm-server && root.sm-page == 2: VerticalLayout { vertical-stretch: 0; spacing: 4px * Theme.ui-scale;
                            // Compact header: one summary line, the elided cache directory, then sync on one row;
