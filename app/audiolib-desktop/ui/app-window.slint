        Text { text: root.label; color: Theme.dim; font-size: Theme.font(12); vertical-alignment: center; }
        Text { horizontal-stretch: 1; text: root.value == "" ? "—" : root.value; color: Theme.ink; font-size: Theme.font(13); horizontal-alignment: right; vertical-alignment: center; }
    }
}

export component AppWindow inherits Window {
    title: "AudioLib Explorer";
    icon: @image-url("../../../resources/icons/AudioLibExplorer.png");
    // Window geometry intentionally stays unscaled: it is the OS window size in logical
    // pixels, and Theme.ui-scale only enlarges the content laid out inside it.
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 1080px;
    min-height: 700px;
    max-width: 32767px;
    max-height: 32767px;
    background: Theme.bg;
    default-font-family: "Segoe UI";
    default-font-size: Theme.ui-font-size;

    in property <string> app-version: "development";
    // Explicit diagnostics only: the compositor observer identifies the exact
    // request and publication phase from pixels, without encoding user text.
    in property <bool> perf-marker-enabled: false;
    in property <[bool]> perf-marker-bits;
    // The diagnostic runner aligns these lengths to whole physical pixels at
    // the observed DPI; fractional display scales must not shift bit centers.
    in property <length> perf-marker-cell-width: 3px * Theme.ui-scale;
    in property <length> perf-marker-cell-height: 6px * Theme.ui-scale;
    in property <length> perf-marker-x: root.width - 196px * Theme.ui-scale;
    in property <length> perf-marker-y: root.height - 16px * Theme.ui-scale;
    out property <length> perf-marker-parent-x: shortcuts.absolute-position.x;
    out property <length> perf-marker-parent-y: shortcuts.absolute-position.y;
    out property <length> perf-marker-actual-client-x;
    out property <length> perf-marker-actual-client-y;
    public function perf-focus-search() {
        if root.perf-marker-enabled { if Theme.modern-style { studio-search-input.focus(); } else { search-input.focus(); } }
    }
    in property <bool> startup-busy: false;
    in property <string> startup-message;
    in property <string> startup-stage;
    in property <string> startup-elapsed;
    in property <bool> startup-closing;
    // Negative means unknown total. Percentages refer only to the current stage.
    in property <float> startup-progress: -1;
    in property <float> startup-motion;
    in-out property <bool> chinese: false;
    in-out property <string> query: "";
    in property <[SearchTaskRow]> search-tasks: [];
    in property <int> active-search-task-index: 0;
    in property <[SavedSearchTaskRow]> saved-search-tasks: [];
    in property <bool> search-workspace-loading: false;
    in property <bool> search-workspace-read-only: false;
    changed search-workspace-read-only => { if root.search-workspace-read-only { root.search-task-rename-visible = false; } }
    in property <string> search-workspace-error: "";
    in-out property <int> max-search-tasks: 30;
    // Per-task navigation presentation; pane widths and appearance remain global.
    in-out property <int> library-sidebar-page: 0;
    in-out property <int> favorites-category: 0;
    in-out property <bool> task-restoring: false;
    // Row change notifications can arrive after the one-shot restore timer.
    // Keep its viewport protected until an ordinary search replaces the range.
    in-out property <bool> preserve-result-scroll: false;
    in-out property <bool> search-task-rename-visible: false;
    in-out property <string> search-task-rename-name: "";
    private property <string> search-task-rename-id: "";
    private property <bool> search-task-rename-saved: false;
    private property <SearchTaskRow> context-search-task;
    private property <SavedSearchTaskRow> context-saved-search;
    private property <bool> task-viewport-pending: false;
    private property <float> task-wanted-result-y: 0;
    private property <float> task-wanted-result-x: 0;
    // Bumps when a restore is armed or discarded. The timer applies only the epoch it armed.
    private property <int> result-scroll-epoch: 0;
    private property <int> result-scroll-apply-epoch: 0;
    // Mode captured when the restore was armed. A server viewport must not land on the local list.
    private property <bool> result-scroll-remote: false;
    private property <float> task-wanted-folder-y: 0;
    private property <float> task-wanted-filter-y: 0;
    private property <float> task-wanted-inspector-y: 0;
    // Bidirectional bridges retain hidden conditional pages without accessing their IDs.
    private property <length> task-filter-viewport-y: 0px;
    private property <length> task-inspector-viewport-y: 0px;
    // Native scrolling replaces one-way viewport bindings. After restoration,
    // tell only the active conditional sidebar owner to apply the saved value.
    private property <int> task-sidebar-restore-revision: 0;
    out property <float> task-result-row-height: root.result-row-height / 1px;
    out property <float> task-result-scroll-y: root.task-viewport-pending ? root.task-wanted-result-y : (Theme.modern-style ? studio-result-list.viewport-y : result-list.viewport-y) / 1px;
    out property <float> task-result-visible-height: (Theme.modern-style ? studio-result-list.visible-height : result-list.visible-height) / 1px;
    out property <float> task-result-scroll-x: root.task-viewport-pending ? root.task-wanted-result-x : root.table-viewport-x / 1px;
    out property <float> task-folder-scroll-y: root.task-viewport-pending ? root.task-wanted-folder-y : (Theme.modern-style ? studio-folder-list.viewport-y : folder-list.viewport-y) / 1px;
