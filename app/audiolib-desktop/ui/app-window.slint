                    Action { width: 160px * Theme.ui-scale; active: root.sm-server; enabled: !root.ds-applying && !root.library-busy; label: root.chinese ? "服务器设置" : "Server settings"; clicked => { if !root.sm-server { root.sm-select-row(root.sm-sources.length > root.sm-local-count ? root.sm-local-count : -1); } } }
