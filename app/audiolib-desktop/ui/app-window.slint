    in-out property <bool> sm-local-form: false;
    in-out property <bool> sm-local-editing: false;
    in-out property <string> sm-local-name: "";
    in-out property <string> sm-local-description-draft: "";
    in-out property <string> sm-local-path-draft: "";
    in-out property <bool> sm-local-existing: false;
    in-out property <bool> sm-local-pregenerate: true;
    in property <string> sm-local-message: "";
    in property <string> local-waveform-progress: "";
    callback sm-local-add-requested();
    callback sm-local-edit-requested();
    callback sm-local-browse-requested();
    callback sm-local-save-requested();
    property <bool> sm-new: root.sm-selected < 0;
    property <bool> sm-server: !root.sm-local-form && (root.sm-new || (root.sm-selected < root.sm-sources.length && root.sm-sources[root.sm-selected].kind == 1));
    property <bool> sm-active: root.sm-selected >= 0 && root.sm-selected < root.sm-sources.length && root.sm-sources[root.sm-selected].active;
    // The local library's management content shows only while local mode is active.
    // The library management content works on the open library: the local one, or in
    // server mode the snapshot (history, missing files, check, backup copy, export) on
    // the active server's 缓存与导出 page.
    property <bool> sm-local-content: !root.sm-local-form && ((!root.sm-server && root.sm-active && !root.remote-mode) || (root.sm-server && root.sm-active && root.remote-mode && root.sm-page == 2));
    property <string> sm-title: root.sm-local-form ? (root.sm-local-editing ? (root.chinese ? "编辑本地音效库" : "Edit local library") : (root.chinese ? "添加本地音效库" : "Add local library")) : root.sm-new ? (root.chinese ? "新服务器（未保存）" : "New server (unsaved)") : ((root.sm-selected < root.sm-sources.length ? root.sm-sources[root.sm-selected].name : "") + (root.sm-active ? (root.chinese ? " · 当前数据源" : " · active") : (root.chinese ? " · 未生效" : " · not active")));
    // Connection page (the old data source dialog's fields, per profile).
