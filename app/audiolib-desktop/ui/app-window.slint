                                            if !root.sm-local-editing: Action { width: 90px * Theme.ui-scale; enabled: !root.library-busy && !root.ds-applying; label: root.chinese ? "浏览…" : "Browse…"; clicked => { root.sm-local-browse-requested(); } }
