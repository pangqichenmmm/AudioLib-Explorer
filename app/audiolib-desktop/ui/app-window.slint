                                    Rectangle { x: root.ds-decompression-progress >= 0 ? 0px : (parent.width - self.width) * root.ds-decompression-motion; width: root.ds-decompression-progress >= 0 ? parent.width * clamp(root.ds-decompression-progress, 0, 1) : parent.width * 0.3; height: parent.height; background: Theme.accent; border-radius: 3px * Theme.ui-scale; }
