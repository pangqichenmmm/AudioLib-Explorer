                            if root.ds-message != "": Label { wrap: word-wrap; font-size: Theme.font(11); color: Theme.warning; text: root.ds-message; }
                            Rectangle { height: 1px; background: Theme.border; }
                        }
                        Rectangle { vertical-stretch: 1;
                            // The library management content (unchanged; hidden, not destroyed,
