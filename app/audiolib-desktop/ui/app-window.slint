        visible: root.about-visible; enabled: root.about-visible;
        focus-on-click: false; focus-on-tab-navigation: false;
        property <bool> reverse-wrap: false;
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.dismiss-modal(); return accept; }
            if (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) && about-first.has-focus {
                self.reverse-wrap = true; about-dialog-end.focus(); self.reverse-wrap = false; return reject;
            }
            reject
        }
        key-pressed(event) => { if event.text == Key.Tab || event.text == Key.Backtab { return reject; } accept }
        key-released(event) => { accept }
        Rectangle {
        background: Theme.overlay;
        TouchArea { }
        Rectangle { width: 520px * Theme.ui-scale; height: min(500px * Theme.ui-scale, parent.height - 32px * Theme.ui-scale); x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; background: Theme.panel; border-radius: 12px * Theme.ui-scale; border-width: 1px; border-color: Theme.border;
            VerticalLayout { padding: 28px * Theme.ui-scale; spacing: 18px * Theme.ui-scale;
