    in property <bool> drag-preparing: false;
    in property <string> drag-progress: "";

    // Data source (local library or read-only server snapshot).
    in property <bool> remote-mode: false;
    // Cached record IDs must not be written after a known server library replacement.
    in property <bool> remote-writes-blocked: false;
    // Appended to write actions that the read-only server snapshot disables.
    property <string> ro-suffix: root.remote-mode ? (root.chinese ? "（服务器模式只读）" : " (read-only in server mode)") : "";
    // Server mode: record removals go to the active server when its /capabilities lets this
    // PC manage; otherwise the items stay greyed with the server's reason.
    in property <bool> server-can-manage: false;
    in property <string> server-manage-note: "";
    property <bool> removal-allowed: !root.remote-writes-blocked && (!root.remote-mode || root.server-can-manage);
    property <string> removal-suffix: root.removal-allowed ? "" : (root.server-manage-note == "" ? root.ro-suffix : (root.chinese ? "（" + root.server-manage-note + "）" : " (" + root.server-manage-note + ")"));
    in property <string> data-source-label: "";
    in-out property <string> ds-server-url: "";
    // Server address entry: 0 full URL, 1 scheme + domain + port (+ optional path prefix).
    in-out property <int> ds-address-form: 0;
    in-out property <int> ds-scheme: 0; // 0 https (default), 1 http
    in-out property <string> ds-host: "";
    in-out property <string> ds-port: "";
    in-out property <string> ds-prefix: "";
    // Normalised API address, or why the input is invalid (ds-address-error).
    in property <string> ds-address-hint: "";
    in property <bool> ds-address-error: false;
    // External address from the server's /health after a connection test (empty = none).
    in property <string> ds-public-url: "";
    in-out property <string> ds-token: "";
    in property <string> ds-report: "";
    in property <string> ds-message: "";
    in property <string> ds-sync-info: "";
    in property <bool> ds-testing: false;
    in property <bool> ds-syncing: false;
    in property <bool> ds-sync-pausing: false;
    in property <bool> ds-sync-paused: false;
    in property <bool> ds-sync-pending: false;
    in property <bool> ds-sync-can-pause: false;
    in property <bool> ds-applying: false;
    // A source selection has been saved and is waiting for its server snapshot.
    // Local escape closes before provider opening or settings rollback begins.
    in property <bool> ds-source-syncing: false;
    private property <bool> sm-local-escape: root.ds-source-syncing && !root.closing;
    in property <float> ds-progress: 0;
    in property <string> ds-decompression-info: "";
    in property <float> ds-decompression-progress: -1;
    private property <float> ds-motion: root.ds-syncing && root.ds-progress < 0 ? (1 - cos(360deg * mod(animation-tick(), 2s) / 2s)) / 2 : 0;
    private property <float> ds-decompression-motion: root.ds-syncing && root.ds-decompression-progress < 0 ? (1 - cos(360deg * mod(animation-tick(), 2s) / 2s)) / 2 : 0;
    private property <duration> ds-started;
    private property <string> ds-elapsed: (root.chinese ? "已用时 " : "Elapsed: ") + floor((animation-tick() - root.ds-started) / 1s) + (root.chinese ? " 秒" : " s");
    changed ds-syncing => { if root.ds-syncing { root.ds-started = animation-tick(); } }
    in-out property <string> ds-poll-interval: "60";
    in-out property <bool> ds-auto-sync: false;
    in-out property <bool> shared-sync-dirty: false;
    in-out property <bool> shared-sync-close-pending: false;
    callback shared-sync-save-requested();
    in-out property <bool> ds-transcode: false;
    // Set once the user clicks the transcode box in this dialog session.
    in-out property <bool> ds-transcode-touched: false;
