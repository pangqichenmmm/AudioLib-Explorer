                HorizontalLayout { height: 34px * Theme.ui-scale; spacing: 8px * Theme.ui-scale;
                    Rectangle { horizontal-stretch: 1; }
                    confirmation-cancel-action := Action { width: 96px * Theme.ui-scale; label: root.chinese ? "取消" : "Cancel"; clicked => { root.confirmation-requested(false); } }
                    confirmation-continue-action := Action { width: 110px * Theme.ui-scale; primary: true; label: root.chinese ? "确认继续" : "Continue"; clicked => { root.confirmation-requested(true); } }
                }
            }
        }
        }
    }
    if root.library-busy && !((root.ds-syncing || root.ds-applying) && root.library-visible): Rectangle { background: Theme.overlay;
        TouchArea { }
        Rectangle { width: 410px * Theme.ui-scale; height: 135px * Theme.ui-scale; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; background: Theme.panel; border-radius: 9px * Theme.ui-scale; border-width: 1px; border-color: Theme.border;
            Text { x: 20px * Theme.ui-scale; width: parent.width - 40px * Theme.ui-scale; height: parent.height; text: root.scan-browse-busy || root.file-choice-busy ? (root.chinese ? "请在弹出的文件窗口中完成选择…" : "Complete your selection in the file picker…") : root.library-operation-stage != "" ? root.library-operation-stage : (root.chinese ? "正在处理音效库操作…\n请稍候。" : "Working on the library…\nPlease wait."); color: Theme.ink; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
        }
    }
    update-dialog := FocusScope {
        visible: root.update-visible; enabled: root.update-visible && !root.closing;
        focus-on-click: false; focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.update-visible = false; return accept; }
            if event.text == Key.Tab || event.text == Key.Backtab {
                if !root.update-supported { update-later.focus(); }
                else if update-later.has-focus { update-check.focus(); }
                else if update-check.has-focus && root.update-available && !root.update-busy { update-install.focus(); }
                else { update-later.focus(); }
                return accept;
            }
            reject
        }
        key-pressed(event) => { accept }
        key-released(event) => { accept }
        Rectangle { background: Theme.overlay;
            TouchArea { }
            Rectangle { width: min(620px * Theme.ui-scale, parent.width - 32px * Theme.ui-scale); height: 300px * Theme.ui-scale; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; background: Theme.panel; border-radius: 10px * Theme.ui-scale; border-width: 1px; border-color: Theme.border;
                VerticalLayout { padding: 24px * Theme.ui-scale; spacing: 14px * Theme.ui-scale;
                    Text { text: root.chinese ? "软件更新" : "Software update"; color: Theme.ink; font-size: Theme.font(22); }
                    Label { text: root.update-available ? root.app-version + " → " + root.update-version : root.app-version; color: Theme.accent; }
                    Label { text: root.update-message; wrap: char-wrap; vertical-stretch: 1; }
                    if root.update-supported: Label { text: root.chinese ? "确认后下载并校验，保存更改后自动安装并重启。音效库与设置会保留。" : "Download and verify, then save changes, install and restart. Your libraries and preferences are retained."; wrap: word-wrap; }
                    HorizontalLayout { height: 34px * Theme.ui-scale; spacing: 8px * Theme.ui-scale;
                        update-later := Action { width: 88px * Theme.ui-scale; label: root.chinese ? "稍后" : "Later"; clicked => { root.update-visible = false; } }
                        update-check := Action { visible: root.update-supported; width: root.update-supported ? 128px * Theme.ui-scale : 0px; enabled: root.update-enabled && !root.update-busy; label: root.chinese ? "重新检查" : "Check again"; clicked => { root.update-check-requested(); } }
                        Rectangle { horizontal-stretch: 1; }
                        update-install := Action { visible: root.update-supported; width: root.update-supported ? 190px * Theme.ui-scale : 0px; primary: true; enabled: root.update-enabled && root.update-available && !root.update-busy && !root.library-busy && !root.closing; label: root.chinese ? "下载、安装并重启" : "Download, install & restart"; clicked => { root.update-install-requested(); } }
                    }
                }
            }
        }
    }
    if root.close-recovery-available && !root.closing: Rectangle {
        x: 16px * Theme.ui-scale; y: root.height - 78px * Theme.ui-scale; width: parent.width - 32px * Theme.ui-scale; height: 58px * Theme.ui-scale;
        background: Theme.panel; border-width: 1px; border-color: Theme.warning; border-radius: 6px * Theme.ui-scale;
        HorizontalLayout { padding: 10px * Theme.ui-scale; spacing: 10px * Theme.ui-scale;
            Label { horizontal-stretch: 1; wrap: word-wrap; text: root.chinese ? "部分标注未能保存。可重试关闭，或将草稿保存到恢复文件后退出。" : "Some annotations could not be saved. Retry closing, or save drafts to a recovery file and exit."; }
            Action { width: root.chinese ? 180px * Theme.ui-scale : 220px * Theme.ui-scale; enabled: !root.library-busy; label: root.chinese ? "保存恢复文件并退出" : "Save recovery file and exit"; clicked => { root.recover-metadata-and-close(); } }
        }
    }
    if root.startup-busy: Rectangle {
        background: Theme.overlay;
        TouchArea { }
        Rectangle { width: 540px * Theme.ui-scale; height: 250px * Theme.ui-scale; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; background: Theme.panel; border-radius: 9px * Theme.ui-scale; border-width: 1px; border-color: Theme.border;
            VerticalLayout { padding: 25px * Theme.ui-scale; spacing: 16px * Theme.ui-scale;
                Text { text: root.startup-closing ? (root.chinese ? "正在安全退出…" : "Closing safely…") : (root.chinese ? "正在打开音效库…" : "Opening your sound library…"); color: Theme.ink; font-size: Theme.font(21); }
                HorizontalLayout { spacing: 12px * Theme.ui-scale;
                    Text { text: root.startup-stage; color: Theme.ink; horizontal-stretch: 1; }
                    Text { text: root.startup-progress >= 0 ? (root.chinese ? "复制 " : "Copy ") + round(root.startup-progress * 100) + "%" : (root.chinese ? "处理中" : "Working"); color: Theme.dim; }
                }
                Rectangle { height: 6px * Theme.ui-scale; background: Theme.raised; border-radius: 3px * Theme.ui-scale;
                    Rectangle {
                        height: parent.height;
                        width: root.startup-progress >= 0 ? parent.width * clamp(root.startup-progress, 0, 1) : parent.width * 0.25;
                        x: root.startup-progress >= 0 ? 0px : (parent.width - self.width) * root.startup-motion;
                        background: Theme.accent; border-radius: 3px * Theme.ui-scale;
                    }
                }
                Text { text: root.startup-message; color: Theme.dim; wrap: word-wrap; vertical-stretch: 1; }
                Text { text: root.startup-elapsed; color: Theme.muted; font-size: Theme.font(12); }
            }
        }
    }
    if root.closing: Rectangle {
        background: Theme.overlay;
        TouchArea { }
        Rectangle { width: 340px * Theme.ui-scale; height: 110px * Theme.ui-scale; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; background: Theme.panel; border-radius: 8px * Theme.ui-scale; border-width: 1px; border-color: Theme.border;
            Text { text: root.chinese ? "正在保存更改…" : "Saving changes…"; color: Theme.ink; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
    if root.perf-marker-enabled && !root.closing && !root.startup-busy: Rectangle {
        x: root.perf-marker-x - shortcuts.absolute-position.x;
        y: root.perf-marker-y - shortcuts.absolute-position.y;
        init => {
            root.perf-marker-actual-client-x = self.absolute-position.x;
            root.perf-marker-actual-client-y = self.absolute-position.y;
        }
        changed absolute-position => {
            root.perf-marker-actual-client-x = self.absolute-position.x;
            root.perf-marker-actual-client-y = self.absolute-position.y;
        }
        width: 64 * root.perf-marker-cell-width;
        height: 2 * root.perf-marker-cell-height; background: #000000;
        for bit[index] in root.perf-marker-bits: Rectangle {
            x: Math.mod(index, 64) * root.perf-marker-cell-width;
            y: floor(index / 64) * root.perf-marker-cell-height;
            width: root.perf-marker-cell-width;
            height: root.perf-marker-cell-height;
            background: bit ? #ffffff : #000000;
        }
    }
    }
}
