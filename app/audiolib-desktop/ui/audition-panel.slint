            transform-controls := HorizontalLayout { width: parent.width; height: max(32px * Theme.ui-scale, Theme.font(20) + 12px * Theme.ui-scale); y: max(0px, min((parent.height - self.height) / 2, parent.height - self.height - 24px * Theme.ui-scale)); spacing: 8px * Theme.ui-scale;
