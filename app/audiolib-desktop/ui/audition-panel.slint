// app/audiolib-desktop/ui/audition-panel.slint
import { ComboBox } from "std-widgets.slint";
import { Theme, ThemedSlider as Slider, ThemedLineEdit as LineEdit } from "theme.slint";

/// One time-ruler tick: its position as a fraction of the visible range and, on
/// major ticks, the time label drawn beside it.
export struct RulerTick { fraction: float, label: string, major: bool }

// Text formats shared by the hover, scrub and remaining-time readouts.
global Clock {
    public pure function pad2(value: int) -> string { return value < 10 ? "0" + value : "" + value; }
    public pure function pad3(value: int) -> string { return value < 10 ? "00" + value : (value < 100 ? "0" + value : "" + value); }
    // mm:ss.mmm, the transport clock format published by the controller.
    public pure function format(seconds: float) -> string {
        let ms = floor(max(0, seconds) * 1000);
        return Clock.pad2(floor(ms / 60000)) + ":" + Clock.pad2(Math.mod(floor(ms / 1000), 60)) + "." + Clock.pad3(Math.mod(ms, 1000));
    }
    // Two fixed decimals, the Pitch / Rate field format published by the controller.
    public pure function fixed2(value: float) -> string {
        let hundredths = Math.round(abs(value) * 100);
        let part = Math.mod(hundredths, 100);
        return (value < 0 && hundredths > 0 ? "-" : "") + floor(hundredths / 100) + "." + (part < 10 ? "0" : "") + part;
    }
}

// A delayed hint beside its anchor. Paint-only: it never takes pointer input.
component Tip inherits Rectangle {
    in property <string> text;
    in property <bool> show;
    in property <length> anchor-width;
    in property <length> anchor-height;
    // -1 aligns with the anchor's left edge, 0 centers, 1 aligns with its right edge.
    in property <int> align: 0;
    in property <bool> below: false;
    property <float> shown: root.show && root.text != "" ? 1 : 0;
    animate shown { duration: Theme.motion-fast; easing: ease-out; }
    visible: self.shown > 0.01;
    opacity: self.shown;
    height: 24px * Theme.ui-scale;
    width: max(40px * Theme.ui-scale, tip-text.preferred-width + 16px * Theme.ui-scale);
    x: root.align < 0 ? 0px : (root.align > 0 ? root.anchor-width - self.width : (root.anchor-width - self.width) / 2);
    y: root.below
        ? root.anchor-height + 6px * Theme.ui-scale - (1 - self.shown) * 3px * Theme.ui-scale
        : -self.height - 6px * Theme.ui-scale + (1 - self.shown) * 3px * Theme.ui-scale;
    background: Theme.tooltip; border-width: 1px; border-color: Theme.strong-border; border-radius: 3px * Theme.ui-scale;
    tip-text := Text { text: root.text; color: Theme.ink; font-size: Theme.font(10); horizontal-alignment: center; vertical-alignment: center; accessible-role: none; }
}

component Tool inherits Rectangle {
    in property <string> symbol;
    in property <image> icon;
    // Shown instead of `icon` while `alt` is true; the two icons cross-fade.
    in property <image> alt-icon;
    in property <bool> alt: false;
    in property <string> label;
    // Appended to the tooltip: a shortcut, or why the button is unavailable.
    in property <string> hint;
    in property <bool> show-tip: true;
    in property <int> tip-align: 0;
    in property <bool> enabled: true;
    in property <bool> active: false;
    in property <bool> primary: false;
    in property <bool> subtle: false;
    in property <length> icon-size: 20px * Theme.ui-scale;
    in property <length> symbol-size: Theme.font(16);
    /// A mouse click must not claim keyboard focus, so transport keys (e.g. Space
    /// for the result list) keep working right after a click. Tabbed focus still
    /// activates the button with Space/Return.
    in property <bool> keyboard-active: true;
    out property <bool> has-focus: focus.has-focus;
    callback clicked();
    width: 32px * Theme.ui-scale; height: 32px * Theme.ui-scale; border-radius: 5px * Theme.ui-scale;
    property <bool> hovered: hit.has-hover && root.enabled;
    property <bool> pressed: hit.pressed && root.enabled;
    property <bool> tip-ready: false;
    property <bool> show-alt: root.alt && root.alt-icon.width > 0;
    property <color> ink: root.primary ? Theme.on-accent : (root.active ? Theme.accent-hover : Theme.ink);
    background: root.primary
        ? (root.pressed ? Theme.accent.darker(0.12) : Theme.accent)
        : root.active
            ? (root.pressed ? Theme.selected : (root.hovered ? Theme.checked.brighter(0.12) : Theme.checked))
            : (root.pressed ? Theme.trough : (root.hovered ? Theme.control-hover-surface : (root.subtle ? transparent : Theme.control-surface)));
    border-width: 1px;
    border-color: focus.has-focus || root.active || root.primary ? Theme.accent : (root.hovered ? Theme.strong-border : (root.subtle ? transparent : Theme.border));
    opacity: root.enabled ? 1 : 0.4;
    animate background, border-color { duration: Theme.motion-fast; easing: ease-out; }
    animate opacity { duration: Theme.motion-base; easing: ease-out; }
    accessible-role: button; accessible-label: root.label; accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    if root.primary: Rectangle {
        x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
        border-radius: max(0px, root.border-radius - 1px); clip: true;
        opacity: root.pressed ? 0.75 : 1;
        Image { width: parent.width; height: parent.height; source: Theme.transport-backdrop; image-fit: fill; accessible-role: none; }
    }
    // The icon sinks slightly while pressed; the frame stays put. Sizes, not
    // transform-scale: the software renderer draws transforms unscaled.
    property <length> pressed-size: root.pressed ? root.icon-size - 3px * Theme.ui-scale : root.icon-size;
    face := Rectangle {
        if root.icon.width > 0: Image {
            source: root.icon; colorize: root.ink;
            width: root.show-alt ? root.icon-size * 0.6 : root.pressed-size; height: self.width;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            opacity: root.show-alt ? 0 : 1;
            animate opacity, width { duration: Theme.motion-base; easing: ease-out; }
            animate colorize { duration: Theme.motion-fast; }
        }
        if root.alt-icon.width > 0: Image {
            source: root.alt-icon; colorize: root.ink;
            width: root.show-alt ? root.pressed-size : root.icon-size * 0.6; height: self.width;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            opacity: root.show-alt ? 1 : 0;
            animate opacity, width { duration: Theme.motion-base; easing: ease-out; }
            animate colorize { duration: Theme.motion-fast; }
        }
        if root.icon.width == 0: Text { text: root.symbol; color: root.ink; font-size: root.symbol-size; horizontal-alignment: center; vertical-alignment: center; animate color { duration: Theme.motion-fast; } }
    }
    focus := FocusScope { enabled: root.enabled; key-pressed(event) => { if root.keyboard-active && (event.text == " " || event.text == Key.Return) { root.clicked(); return accept; } reject } }
    // Hover is tracked while disabled too, so the tooltip can say why.
    hit := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if root.enabled { root.clicked(); } }
        changed has-hover => { if !self.has-hover { root.tip-ready = false; } }
    }
    Timer { interval: Theme.tooltip-delay; running: root.show-tip && hit.has-hover && !root.tip-ready; triggered => { root.tip-ready = true; } }
    Tip {
        z: 10; anchor-width: root.width; anchor-height: root.height; align: root.tip-align;
        text: root.label + (root.hint != "" ? "  ·  " + root.hint : "");
        show: root.tip-ready && !hit.pressed;
    }
}
// Play / Pause. The triangle splits into two bars (and joins back) by moving its
// vertices, so the change reads as one motion; a press sinks the face and a click
// sends a ring outward. Only geometry, color and opacity change: the software
// renderer ignores transform-scale and rotation. Nothing runs while idle.
component PlayToggle inherits Rectangle {
    in property <bool> playing;
    in property <bool> enabled: true;
    in property <string> label;
    in property <string> hint;
    in property <int> tip-align: 0;
    // Corner radius of the face, glyph box size, and the theme's transport
    // backdrop image inside the face (Studio).
    in property <length> radius: 4px * Theme.ui-scale;
    in property <length> glyph: 20px * Theme.ui-scale;
    in property <bool> backdrop: false;
    callback clicked();
    width: 32px * Theme.ui-scale; height: 30px * Theme.ui-scale;
    property <bool> hovered: hit.has-hover && root.enabled;
    property <bool> pressed: hit.pressed && root.enabled;
    property <bool> tip-ready: false;
    // 0 draws Play, 1 draws Pause; values between are the morph.
    property <float> morph: root.playing ? 1 : 0;
    animate morph { duration: 220ms * Theme.motion; easing: cubic-bezier(0.45, 0, 0.2, 1); }
    // Click ring: the frame clock is read only for its 420 ms.
    property <duration> ring-length: 420ms;
    property <bool> ringing: false;
    property <duration> ring-start: 0ms;
    property <float> ring: root.ringing ? clamp((animation-tick() - root.ring-start) / root.ring-length, 0, 1) : 1;
    Timer { interval: root.ring-length; running: root.ringing; triggered => { root.ringing = false; } }
    function activate() {
        if !root.enabled { return; }
        if Theme.motion > 0 { root.ring-start = animation-tick(); root.ringing = true; }
        root.clicked();
    }
    opacity: root.enabled ? 1 : 0.4;
    animate opacity { duration: Theme.motion-base; easing: ease-out; }
    accessible-role: button; accessible-label: root.label; accessible-enabled: root.enabled;
    accessible-action-default => { root.activate(); }
    forward-focus: focus;
    // While playing, a quiet halo marks the live transport.
    Rectangle {
        x: -2px * Theme.ui-scale; y: self.x; width: parent.width - 2 * self.x; height: parent.height - 2 * self.y;
        border-radius: root.radius + 2px * Theme.ui-scale; border-width: 1px;
        border-color: Theme.accent.with-alpha(root.playing && root.enabled ? 0.45 : 0);
        animate border-color { duration: Theme.motion-slow; easing: ease-out; }
    }
    if root.ringing: Rectangle {
        property <float> eased: 1 - Math.pow(1 - root.ring, 3);
        property <length> grow: self.eased * 9px * Theme.ui-scale;
        x: -self.grow; y: -self.grow; width: root.width + 2 * self.grow; height: root.height + 2 * self.grow;
        border-radius: root.radius + self.grow; border-width: 1.5px * Theme.ui-scale;
        border-color: Theme.accent-hover.with-alpha(0.75 * (1 - root.ring));
    }
    face := Rectangle {
        property <length> inset: root.pressed ? 2px * Theme.ui-scale : 0px;
        animate inset { duration: Theme.motion-fast; easing: ease-out; }
        x: self.inset; y: self.inset; width: parent.width - 2 * self.inset; height: parent.height - 2 * self.inset;
        border-radius: root.radius; border-width: 1px;
        background: root.pressed ? Theme.accent.darker(0.18) : (root.hovered ? Theme.accent-hover : Theme.accent);
        border-color: focus.has-focus ? Theme.ink : (root.hovered ? Theme.accent-hover : Theme.accent);
        animate background, border-color { duration: Theme.motion-fast; easing: ease-out; }
        if root.backdrop: Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            border-radius: max(0px, root.radius - 1px); clip: true;
            opacity: root.pressed ? 0.75 : 1;
            Image { width: parent.width; height: parent.height; source: Theme.transport-backdrop; image-fit: fill; accessible-role: none; }
        }
        Path {
            property <length> size: root.pressed ? root.glyph - 4px * Theme.ui-scale : (root.hovered ? root.glyph + 1px * Theme.ui-scale : root.glyph);
            animate size { duration: Theme.motion-fast; easing: ease-out; }
            width: self.size; height: self.size;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            viewbox-width: 24; viewbox-height: 24;
            fill: Theme.on-accent; accessible-role: none;
            // Play is a triangle cut at x 14.05 into a quad and a sliver; Pause is two bars.
            MoveTo { x: 7.8 + (6.5 - 7.8) * root.morph; y: 4.5 + (5 - 4.5) * root.morph; }
            LineTo { x: 14.05 + (10.5 - 14.05) * root.morph; y: 8.25 + (5 - 8.25) * root.morph; }
            LineTo { x: 14.05 + (10.5 - 14.05) * root.morph; y: 15.75 + (19 - 15.75) * root.morph; }
            LineTo { x: 7.8 + (6.5 - 7.8) * root.morph; y: 19.5 + (19 - 19.5) * root.morph; }
            Close { }
            MoveTo { x: 14.05 + (13.5 - 14.05) * root.morph; y: 8.25 + (5 - 8.25) * root.morph; }
            LineTo { x: 20.3 + (17.5 - 20.3) * root.morph; y: 12 + (5 - 12) * root.morph; }
            LineTo { x: 20.3 + (17.5 - 20.3) * root.morph; y: 12 + (19 - 12) * root.morph; }
            LineTo { x: 14.05 + (13.5 - 14.05) * root.morph; y: 15.75 + (19 - 15.75) * root.morph; }
            Close { }
        }
    }
    // A mouse click does not claim focus, so Space keeps serving the result list.
    focus := FocusScope { enabled: root.enabled; key-pressed(event) => { if event.text == " " || event.text == Key.Return { root.activate(); return accept; } reject } }
    hit := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.activate(); }
        changed has-hover => { if !self.has-hover { root.tip-ready = false; } }
    }
    Timer { interval: Theme.tooltip-delay; running: hit.has-hover && !root.tip-ready; triggered => { root.tip-ready = true; } }
    Tip {
        z: 10; anchor-width: root.width; anchor-height: root.height; align: root.tip-align;
        text: root.label + (root.hint != "" ? "  ·  " + root.hint : "");
        show: root.tip-ready && !hit.pressed;
    }
}
component Caption inherits Text { color: Theme.dim; font-size: Theme.font(11); vertical-alignment: center; }

// A Pitch / Rate entry: type a value and press Enter, or step it with the mouse
// wheel or Up / Down (Shift for fine steps). The controller rejects out-of-range
// input and asks the field to shake and show the accepted range.
component NumberField inherits Rectangle {
    in property <string> input-label;
    in property <bool> enabled: true;
    in-out property <string> text;
    in property <float> minimum;
    in property <float> maximum;
    in property <float> default-value;
    in property <float> step;
    in property <float> fine-step;
    in property <string> range-hint;
    out property <bool> modified: root.text.is-float() && abs(root.text.to-float() - root.default-value) > 0.0001;
    out property <bool> has-focus: edit.has-focus;
    callback submit(string);
    property <bool> invalid: false;
    property <bool> shaking: false;
    property <duration> shake-start: 0ms;
    property <length> wheel-travel: 0px;
    public function refuse() {
        root.invalid = true;
        root.shaking = true;
        root.shake-start = animation-tick();
    }
    function step-by(direction: int, fine: bool) {
        if !root.enabled { return; }
        let base = root.text.is-float() ? root.text.to-float() : root.default-value;
        let next = clamp(Math.round((base + direction * (fine ? root.fine-step : root.step)) / root.fine-step) * root.fine-step, root.minimum, root.maximum);
        root.text = Clock.fixed2(next);
        root.submit(root.text);
    }
    // Decaying side-to-side offset after rejected input; reads the frame clock only while shaking.
    property <float> shake-elapsed: root.shaking ? (animation-tick() - root.shake-start) / 1ms : 0;
    property <length> shake-offset: root.shaking ? 4px * Theme.ui-scale * max(0, 1 - root.shake-elapsed / 300) * sin(root.shake-elapsed / 75 * 360deg) : 0px;
    Timer { interval: 320ms; running: root.shaking; triggered => { root.shaking = false; } }
    Timer { interval: 1800ms; running: root.invalid; triggered => { root.invalid = false; } }
    // Up / Down are observed before the text input sees them.
    keys := FocusScope {
        x: root.shake-offset; width: root.width; height: root.height;
        focus-on-click: false; focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if root.enabled && (event.text == Key.UpArrow || event.text == Key.DownArrow) {
                root.step-by(event.text == Key.UpArrow ? 1 : -1, event.modifiers.shift);
                return accept;
            }
            reject
        }
        // The wheel reaches this area because the text input ignores scrolling.
        TouchArea {
            scroll-event(event) => {
                let delta = event.delta-y != 0px ? event.delta-y : event.delta-x;
                if !root.enabled || delta == 0px { return reject; }
                root.wheel-travel += delta;
                // One detent (120px) is one step; precision touchpads accumulate.
                if abs(root.wheel-travel) >= 40px {
                    root.step-by(root.wheel-travel > 0px ? 1 : -1, event.modifiers.shift);
                    root.wheel-travel = 0px;
                }
                return accept;
            }
            edit := LineEdit {
                width: parent.width; height: parent.height;
                text <=> root.text; enabled: root.enabled; input-label: root.input-label;
                changed has-focus => { if !self.has-focus && root.enabled { root.submit(self.text); } }
                accepted => { root.submit(self.text); }
            }
        }
        // A non-default value carries an accent mark.
        Rectangle {
            x: parent.width - 8px * Theme.ui-scale; y: 4px * Theme.ui-scale; width: 4px * Theme.ui-scale; height: self.width; border-radius: self.width / 2;
            background: Theme.accent; opacity: root.modified && root.enabled ? 1 : 0;
            animate opacity { duration: Theme.motion-base; }
        }
        Rectangle {
            border-width: 1px; border-radius: 4px * Theme.ui-scale; border-color: Theme.danger;
            opacity: root.invalid ? 1 : 0;
            animate opacity { duration: Theme.motion-base; }
        }
    }
    Tip { z: 10; anchor-width: root.width; anchor-height: root.height; align: -1; text: root.range-hint; show: root.invalid; }
}

// Monitoring level in dB. Drag or click to set, wheel for 1 dB steps, double-click
// for 0 dB; arrow keys step 1 dB (Shift 0.1 dB).
component VolumeSlider inherits Rectangle {
    in property <float> minimum: -60;
    in property <float> maximum: 0;
    in property <float> reset-value: 0;
    in property <bool> enabled: true;
    in property <string> label;
    in-out property <float> value;
    out property <bool> has-focus: focus.has-focus;
    out property <bool> dragging: touch.pressed;
    callback changed(float);
    min-height: 20px * Theme.ui-scale; min-width: 60px * Theme.ui-scale;
    horizontal-stretch: 1; vertical-stretch: 0;
    accessible-role: slider; accessible-label: root.label; accessible-enabled: root.enabled;
    accessible-value: root.value; accessible-value-minimum: root.minimum; accessible-value-maximum: root.maximum; accessible-value-step: 0.1;
    accessible-action-set-value(v) => { if v.is-float() { root.set(v.to-float()); } }
    accessible-action-increment => { root.set(root.value + 0.1); }
    accessible-action-decrement => { root.set(root.value - 0.1); }
    forward-focus: focus;
    property <length> inset: 8px * Theme.ui-scale;
    property <length> span: max(1px, root.width - 2 * root.inset);
    property <float> fraction: clamp((root.value - root.minimum) / max(0.001, root.maximum - root.minimum), 0, 1);
    property <bool> emphasized: root.enabled && (touch.has-hover || touch.pressed || focus.has-focus);
    function set(v: float) {
        let next = clamp(Math.round(v * 10) / 10, root.minimum, root.maximum);
        if next != root.value {
            root.value = next;
            root.changed(next);
        }
    }
    function set-from(x: length) { root.set(root.minimum + clamp((x - root.inset) / root.span, 0, 1) * (root.maximum - root.minimum)); }
    Rectangle {
        x: root.inset; width: root.span; y: (parent.height - self.height) / 2;
        height: (root.emphasized ? 5px : 4px) * Theme.ui-scale; border-radius: self.height / 2;
        background: Theme.strong-border.with-alpha(root.enabled ? 0.55 : 0.25);
        animate height { duration: Theme.motion-fast; }
        Rectangle { x: 0px; height: parent.height; width: parent.width * root.fraction; border-radius: parent.border-radius; background: Theme.accent; }
    }
    Rectangle {
        width: (root.emphasized ? 14px : 10px) * Theme.ui-scale; height: self.width; border-radius: self.width / 2;
        x: root.inset + root.span * root.fraction - self.width / 2; y: (parent.height - self.height) / 2;
        background: touch.pressed ? Theme.accent : Theme.ink; border-width: 2px * Theme.ui-scale; border-color: Theme.accent;
        opacity: root.enabled ? 1 : 0.45;
        animate width, background { duration: Theme.motion-fast; easing: ease-out; }
    }
    touch := TouchArea {
        enabled: root.enabled; mouse-cursor: pointer;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                focus.focus();
                root.set-from(self.mouse-x);
            }
        }
        moved => { if self.pressed { root.set-from(self.mouse-x); } }
        double-clicked => { root.set(root.reset-value); }
        scroll-event(event) => {
            let delta = event.delta-y != 0px ? event.delta-y : event.delta-x;
            if delta == 0px { return reject; }
            root.set(root.value + (delta > 0px ? 1 : -1));
            return accept;
        }
    }
    focus := FocusScope {
        x: 0px; y: 0px; width: 0px; height: 0px; enabled: root.enabled;
        key-pressed(event) => {
            // Arrows keep the 0.1 dB fine step; Shift moves 1 dB, Page keys 6 dB.
            let stepv = event.modifiers.shift ? 1 : 0.1;
            if event.text == Key.LeftArrow || event.text == Key.DownArrow { root.set(root.value - stepv); return accept; }
            if event.text == Key.RightArrow || event.text == Key.UpArrow { root.set(root.value + stepv); return accept; }
            if event.text == Key.PageDown { root.set(root.value - 6); return accept; }
            if event.text == Key.PageUp { root.set(root.value + 6); return accept; }
            if event.text == Key.Home { root.set(root.minimum); return accept; }
            if event.text == Key.End { root.set(root.maximum); return accept; }
            reject
        }
    }
}

// The audio route at a glance: a colored dot (idle, active, xrun, error), the
// backend and device rate; the full engine summary sits in the tooltip.
component OutputPill inherits Rectangle {
    in property <bool> compact: false;
    in property <bool> chinese;
    in property <string> backend;
    in property <string> rate;
    in property <int> xruns;
    in property <bool> failed;
    in property <string> details;
    callback clicked();
    property <int> seen-xruns: 0;
    property <bool> alarm: false;
    property <bool> tip-ready: false;
    property <bool> idle: root.backend == "";
    changed xruns => {
        if root.xruns > root.seen-xruns { root.alarm = true; }
        root.seen-xruns = root.xruns;
    }
    Timer { interval: 1000ms; running: root.alarm; triggered => { root.alarm = false; } }
    property <color> tone: root.failed ? Theme.danger : (root.alarm ? Theme.warning : (root.idle ? Theme.muted : Theme.accent));
    height: 22px * Theme.ui-scale; border-radius: self.height / 2; horizontal-stretch: 0;
    background: hit.pressed ? Theme.trough : (hit.has-hover ? Theme.hover : (root.compact ? transparent : Theme.raised));
    border-width: 1px; border-color: output-focus.has-focus ? Theme.accent : (root.alarm ? Theme.warning : (hit.has-hover ? Theme.strong-border : (root.compact ? transparent : Theme.border)));
    animate background, border-color { duration: Theme.motion-fast; easing: ease-out; }
    accessible-role: button; accessible-label: root.chinese ? "音频输出状态" : "Audio output status";
    accessible-description: root.details;
    accessible-action-default => { root.clicked(); }
    forward-focus: output-focus;
    output-focus := FocusScope {
        focus-on-click: false;
        key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.clicked(); return accept; } reject }
    }
    HorizontalLayout {
        padding-left: 8px * Theme.ui-scale; padding-right: 10px * Theme.ui-scale; spacing: 6px * Theme.ui-scale;
        VerticalLayout { alignment: center;
            Rectangle {
                width: 7px * Theme.ui-scale; height: self.width; border-radius: self.width / 2; background: root.tone;
                animate background { duration: Theme.motion-base; }
            }
        }
        Text {
            min-width: 0px; overflow: elide; vertical-alignment: center; font-size: Theme.font(10); color: Theme.dim;
            text: root.idle ? (root.chinese ? "输出空闲" : "Output idle") : root.backend + (!root.compact && root.rate != "" ? " · " + root.rate : "");
        }
        if root.xruns > 0: Text { text: root.xruns + " xruns"; color: Theme.warning; font-size: Theme.font(10); vertical-alignment: center; }
    }
    hit := TouchArea {
        mouse-cursor: pointer; clicked => { root.clicked(); }
        changed has-hover => { if !self.has-hover { root.tip-ready = false; } }
    }
    Timer { interval: Theme.tooltip-delay; running: hit.has-hover && !root.tip-ready; triggered => { root.tip-ready = true; } }
    Tip {
        z: 10; anchor-width: root.width; anchor-height: root.height; align: 1;
        text: root.details + (root.chinese ? "  ·  点击打开音频输出设置" : "  ·  Click for audio output settings");
        show: root.tip-ready && !hit.pressed;
    }
}

// Where the visible window sits inside the whole sound. The thumb is as wide as
// the visible share; drag it, click the track to jump, or scroll to pan.
component OverviewBar inherits Rectangle {
    in property <bool> chinese;
    in property <float> zoom: 1;
    in property <bool> enabled: true;
    in-out property <float> scroll;
    callback pan(float);
    forward-focus: focus;
    property <bool> active: root.enabled && root.zoom > 1.0001;
    property <length> thumb-width: max(18px * Theme.ui-scale, root.width / max(1, root.zoom));
    property <length> travel: max(0px, root.width - root.thumb-width);
    property <length> grab-offset: 0px;
    property <float> drag-scroll: 0;
    // While dragging, the thumb follows the pointer rather than the last render.
    property <float> shown-scroll: touch.pressed ? root.drag-scroll : root.scroll;
    accessible-role: slider; accessible-label: root.chinese ? "波形可视范围" : "Visible waveform range";
    accessible-enabled: root.active; accessible-value: root.scroll;
    accessible-value-minimum: 0; accessible-value-maximum: 1; accessible-value-step: 0.05;
    accessible-action-increment => { root.move-to(root.scroll + 0.05); }
    accessible-action-decrement => { root.move-to(root.scroll - 0.05); }
    accessible-action-set-value(v) => { if v.is-float() { root.move-to(v.to-float()); } }
    opacity: root.active ? 1 : 0;
    animate opacity { duration: Theme.motion-base; easing: ease-out; }
    function move-to(value: float) {
        if !root.active { return; }
        let next = clamp(value, 0, 1);
        root.drag-scroll = next;
        if next != root.scroll {
            root.scroll = next;
            root.pan(next);
        }
    }
    Rectangle {
        y: (parent.height - self.height) / 2; height: 6px * Theme.ui-scale; border-radius: self.height / 2;
        background: Theme.trough; border-width: 1px; border-color: Theme.border;
    }
    thumb := Rectangle {
        x: root.travel * root.shown-scroll; width: root.thumb-width;
        y: (parent.height - self.height) / 2; height: (touch.has-hover || touch.pressed ? 10px : 8px) * Theme.ui-scale; border-radius: self.height / 2;
        background: touch.pressed ? Theme.accent : (touch.has-hover ? Theme.accent.mix(Theme.segment, 0.45) : Theme.segment);
        border-width: 1px; border-color: focus.has-focus || touch.has-hover || touch.pressed ? Theme.accent : Theme.strong-border;
        animate height, background, border-color { duration: Theme.motion-fast; easing: ease-out; }
    }
    touch := TouchArea {
        enabled: root.active; mouse-cursor: pointer;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                focus.focus();
                let on-thumb = self.mouse-x >= thumb.x && self.mouse-x <= thumb.x + thumb.width;
                root.grab-offset = on-thumb ? self.mouse-x - thumb.x : root.thumb-width / 2;
                root.drag-scroll = root.scroll;
                if !on-thumb && root.travel > 0px { root.move-to((self.mouse-x - root.grab-offset) / root.travel); }
            }
        }
        moved => { if self.pressed && root.travel > 0px { root.move-to((self.mouse-x - root.grab-offset) / root.travel); } }
        scroll-event(event) => {
            let delta = event.delta-x != 0px ? event.delta-x : event.delta-y;
            if delta == 0px { return reject; }
            // One detent pans a quarter of the visible window.
            root.move-to(root.scroll - delta / 120px * 0.25 / max(1, root.zoom - 1));
            return accept;
        }
    }
    // Keep the native slider's keyboard reachability when painting a custom overview.
    focus := FocusScope {
        enabled: root.active;
        key-pressed(event) => {
            if !root.active { return reject; }
            if event.text == Key.LeftArrow || event.text == Key.DownArrow { root.move-to(root.scroll - 0.05); return accept; }
            if event.text == Key.RightArrow || event.text == Key.UpArrow { root.move-to(root.scroll + 0.05); return accept; }
            if event.text == Key.PageDown { root.move-to(root.scroll - 0.25); return accept; }
            if event.text == Key.PageUp { root.move-to(root.scroll + 0.25); return accept; }
            if event.text == Key.Home { root.move-to(0); return accept; }
            if event.text == Key.End { root.move-to(1); return accept; }
            reject
        }
    }
}

// Played tint and progress bar under the waveform, shared by both player themes.
// Drawn as fixed-width tiles: the partial software renderer repaints the old and
// new bounds of any element whose size changes, so one rectangle growing by a
// pixel per frame would repaint the whole played area on every frame. Here only
// the tile under the playhead changes, and a frame repaints at most two tiles.
export component PlayedRegion {
    in property <float> fraction;
    in property <float> position;
    in property <float> duration;
    in property <bool> chinese;
    in property <color> tint;
    // false keeps only the accessible range (nothing is drawn).
    in property <bool> paint: true;
    // Half strength after playback ended.
    in property <bool> faded: false;
    property <length> head: root.fraction * root.width;
    property <length> tile: 32px;
    // Partial damage floors its left edge, while rectangle drawing rounds it.
    // Keep shared edges a quarter physical pixel inside the same rounding cell:
    // f32 coordinate conversions then cannot erase the preceding tile's last
    // pixel. Raster edges stay unchanged, with no overlapping translucent fill.
    function snapped-x(value: length) -> length {
        return (round((root.absolute-position.x + value) / 1phx) + 0.25) * 1phx - root.absolute-position.x;
    }
    // The played range for assistive technology. It has no fill, so it never
    // repaints anything when it grows.
    Rectangle {
        x: 0px; y: 0px; width: root.head; height: root.height;
        accessible-role: progress-indicator; accessible-label: root.chinese ? "已播放区域" : "Played waveform region";
        accessible-value: root.position; accessible-value-minimum: 0; accessible-value-maximum: root.duration;
    }
    for i in root.paint ? Math.ceil(root.width / root.tile) : 0: Rectangle {
        property <length> start: i == 0 ? 0px : root.snapped-x(i * root.tile);
        property <length> end: (i + 1) * root.tile >= root.width ? root.width : root.snapped-x((i + 1) * root.tile);
        x: self.start; y: 0px; height: root.height;
        width: clamp(root.head - self.start, 0px, max(0px, self.end - self.start));
        background: root.tint;
        opacity: root.faded ? 0.5 : 1;
        animate opacity { duration: Theme.motion-slow; }
        Rectangle { x: 0px; width: parent.width; y: parent.height - 3px * Theme.ui-scale; height: 3px * Theme.ui-scale; background: Theme.accent; }
    }
}

component ClassicTool inherits Rectangle {
    in property <string> symbol;
    in property <image> icon;
    in property <string> label;
    in property <string> hint;
    in property <int> tip-align: 0;
    in property <bool> enabled: true;
    in property <bool> active: false;
    in property <bool> checkable: false;
    in property <bool> primary: false;
    /// A mouse click must not claim keyboard focus, so transport keys (e.g. Space
    /// for the result list) keep working right after a click. Tabbed focus still
    /// activates the button with Space/Return.
    in property <bool> keyboard-active: true;
    out property <bool> has-focus: focus.has-focus;
    callback clicked();
    width: 32px * Theme.ui-scale; height: 30px * Theme.ui-scale;
    property <bool> hovered: hit.has-hover && root.enabled;
    property <string> held-key;
    property <bool> keyboard-held: root.held-key != "";
    property <bool> pointer-armed: false;
    property <bool> pressed: root.enabled && ((hit.pressed && root.pointer-armed) || root.keyboard-held);
    property <bool> tip-ready: false;
    // Only a short, local confirmation runs after activation. No idle clock or
    // animation is tied to the transport position or to a whole player surface.
    property <bool> flashing: false;
    property <duration> flash-start: 0ms;
    property <duration> flash-length: 180ms * Theme.motion;
    property <float> flash: root.flashing && Theme.motion > 0
        ? clamp((animation-tick() - root.flash-start) / root.flash-length, 0, 1) : 1;
    Timer { interval: root.flash-length; running: root.flashing; triggered => { root.flashing = false; } }
    function activate() {
        if !root.enabled { return; }
        if Theme.motion > 0 { root.flash-start = animation-tick(); root.flashing = true; }
        root.clicked();
    }
    changed enabled => { if !root.enabled { root.held-key = ""; root.pointer-armed = false; } }
    changed keyboard-active => { if !root.keyboard-active { root.held-key = ""; } }
    accessible-role: button; accessible-label: root.label; accessible-description: root.hint;
    accessible-enabled: root.enabled; accessible-checkable: root.checkable; accessible-checked: root.active;
    accessible-action-default => { root.activate(); }
    forward-focus: focus;
    Rectangle {
        x: -2px; y: -2px; width: parent.width + 4px; height: parent.height + 4px;
        border-radius: 7px * Theme.ui-scale; border-width: 1px;
        border-color: focus.has-focus ? Theme.accent : transparent;
        animate border-color { duration: Theme.motion-fast; }
    }
    face := Rectangle {
        // Keep the explanatory tooltip fully legible when the face is disabled.
        opacity: root.enabled ? 1 : (root.active ? 0.85 : 0.38);
        animate opacity { duration: Theme.motion-base; easing: ease-out; }
        y: root.pressed ? 1px * Theme.ui-scale : 0px;
        width: root.width; height: root.height;
        border-radius: 5px * Theme.ui-scale;
        background: root.primary
            ? (root.pressed ? Theme.accent.darker(0.18) : (root.hovered ? Theme.accent-hover : Theme.accent))
            : root.active
                ? (root.pressed ? Theme.selected : Theme.checked)
                : (root.pressed ? Theme.trough : (root.hovered ? Theme.hover : Theme.raised.mix(Theme.player, 0.3)));
        border-width: 1px;
        border-color: root.primary || root.active ? Theme.accent : (root.hovered ? Theme.strong-border : Theme.player-border);
        animate background, border-color, y { duration: Theme.motion-fast; easing: ease-out; }
        property <color> ink: root.primary ? Theme.on-accent : (root.active ? Theme.accent-hover : Theme.ink);
        property <length> glyph: min(19px * Theme.ui-scale, max(10px * Theme.ui-scale, root.height - 6px * Theme.ui-scale)) - (root.pressed ? 2px * Theme.ui-scale : 0px);
        if root.icon.width > 0: Image {
            source: root.icon; colorize: face.ink; width: face.glyph; height: self.width;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            animate width, height, colorize { duration: Theme.motion-fast; easing: ease-out; }
        }
        if root.icon.width == 0: Text {
            text: root.symbol; color: face.ink; font-size: Theme.font(14);
            horizontal-alignment: center; vertical-alignment: center;
            animate color { duration: Theme.motion-fast; }
        }
        if root.flashing: Rectangle {
            width: parent.width; height: parent.height; border-radius: 5px * Theme.ui-scale;
            background: Theme.ink.with-alpha(0.18 * (1 - root.flash));
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        changed has-focus => { if !self.has-focus { root.held-key = ""; } }
        key-pressed(event) => {
            if event.text == Key.Escape && root.keyboard-held {
                root.held-key = "";
                return accept;
            }
            if root.keyboard-active && (event.text == " " || event.text == Key.Return) {
                if !root.keyboard-held { root.held-key = event.text; }
                return accept;
            }
            reject
        }
        key-released(event) => {
            if root.keyboard-active && (event.text == " " || event.text == Key.Return) {
                if root.held-key == event.text {
                    root.held-key = "";
                    root.activate();
                }
                return accept;
            }
            reject
        }
    }
    // Disabled controls still explain their state on hover; no disabled path can
    // invoke a command. Mouse clicks deliberately leave result-list focus alone.
    hit := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        // TouchArea emits clicked before the matching Up event. A disabled
        // press must not become actionable if loading/EOF enables us before Up.
        clicked => {
            let activate = root.pointer-armed && root.enabled;
            root.pointer-armed = false;
            if activate { root.activate(); }
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.cancel {
                root.pointer-armed = false;
                return;
            }
            if event.button != PointerEventButton.left { return; }
            if event.kind == PointerEventKind.down {
                root.pointer-armed = root.enabled;
            } else if event.kind == PointerEventKind.up {
                root.pointer-armed = false;
            }
        }
        changed has-hover => { if !self.has-hover { root.tip-ready = false; } }
    }
    Timer { interval: Theme.tooltip-delay; running: hit.has-hover && !root.tip-ready; triggered => { root.tip-ready = true; } }
    Tip {
        z: 10; anchor-width: root.width; anchor-height: root.height; align: root.tip-align;
        text: root.label + (root.hint != "" ? "  ·  " + root.hint : "");
        show: root.tip-ready && !hit.pressed && !root.keyboard-held;
    }
}
// One shared SVG vocabulary is used by the native cursor bridge and the
// paint-only fallback. Cursor size follows system DPI, independently of GUI zoom.
// Hotspots are expressed in unscaled 20x20 source pixels.
component WaveformPointer inherits Image {
    in property <image> cursor-image;
    in property <float> cursor-scale: 1;
    source: root.cursor-image;
    width: 20px * root.cursor-scale; height: 20px * root.cursor-scale;
    image-fit: contain; accessible-role: none;
}

// The plot and its independent feedback row share one gesture owner. The row
// never participates in source-time mapping, even for a very narrow selection.
component WaveSelectionOverlay inherits Rectangle {
    in property <bool> enabled;
    in property <bool> seek-enabled;
    in property <string> seek-clock;
    in property <bool> chinese;
    in property <bool> selection-active;
    in property <float> selection-start;
    in property <float> selection-end;
    in property <float> view-start;
    in property <float> view-end;
    in property <float> duration;
    in property <string> identity;
    in property <bool> preparing;
    // 0 idle, 1 preparing, 2 ready, 3 native drag, 4 cancelled, 5 error.
    in property <int> export-state;
    in property <bool> native-cursor: false;
    in property <string> progress-text;
    in property <bool> shift-held;
    in property <int> cancel-revision;
    callback committed(float,float);
    callback cleared();
    callback drag-requested();
    callback drag-ended();
    callback cancel-requested();
    callback seek-play(float);
    callback zoom-at(float,float);
    callback cursor-changed(MouseCursor);
    callback pointer-feedback-changed();
    out property <length> feedback-height: 26px * Theme.ui-scale;
    out property <length> plot-height: max(1px, root.height - root.feedback-height);
    out property <bool> gesture: root.mode != 0;
    out property <bool> hovered: hit.has-hover;
    out property <length> pointer-x: clamp(hit.mouse-x, 0px, root.width);
    out property <float> captured-start;
    out property <float> captured-end;
    // 0 unowned, 1 crosshair, 2/3 left/right marquee, 4/5 start/end resize,
    // 6 export hover, 7 export held, 8 waiting, 9 seek, 10 unavailable, 11 native.
    out property <int> pointer-kind: root.export-state == 3 ? 11 : !root.pointer-owned ? 0
        : root.mode == 1 ? (hit.mouse-x < root.down-x ? 2 : 3)
        : root.mode == 2 ? (root.draft-start <= root.draft-end ? 4 : 5)
        : root.mode == 3 ? (root.draft-end >= root.draft-start ? 5 : 4)
        : root.mode == 5 || root.mode == 7 ? (root.is-preparing ? 8 : 7)
        : root.mode == 4 || root.mode == 6 ? 7 : root.mode == 8 ? 9
        : !root.enabled ? (root.seek-enabled ? 9 : 10)
        : grip.has-hover ? 6 : root.shift-held ? 1
        : root.near-left || root.near-right ? (root.left-wins ? 4 : 5)
        : root.inside ? 6 : 1;
    property <image> empty-image;
    out property <image> pointer-image: root.pointer-kind == 1 ? @image-url("icons/wave-cursor-crosshair.svg")
        : root.pointer-kind == 2 ? @image-url("icons/wave-cursor-select-left.svg")
        : root.pointer-kind == 3 ? @image-url("icons/wave-cursor-select-right.svg")
        : root.pointer-kind == 4 ? @image-url("icons/wave-cursor-resize-start.svg")
        : root.pointer-kind == 5 ? @image-url("icons/wave-cursor-resize-end.svg")
        : root.pointer-kind == 6 ? @image-url("icons/wave-cursor-hand-open.svg")
        : root.pointer-kind == 7 ? @image-url("icons/wave-cursor-hand-closed.svg")
        : root.pointer-kind == 8 ? @image-url("icons/wave-cursor-hand-wait.svg")
        : root.pointer-kind == 9 ? @image-url("icons/wave-cursor-seek.svg")
        : root.pointer-kind == 10 ? @image-url("icons/wave-cursor-unavailable.svg") : root.empty-image;
    out property <float> pointer-hotspot-x: root.pointer-kind == 9 || root.pointer-kind == 10 ? 3 : 10;
    out property <float> pointer-hotspot-y: root.pointer-kind == 9 || root.pointer-kind == 10 ? 2 : 10;
    out property <float> pointer-scale: 1;
    // The backend sees a stable stock cursor in native mode, so leaving the
    // owner restores the stock cursor rather than a hidden-cursor state.
    out property <MouseCursor> cursor: root.pointer-kind == 0 || root.pointer-kind == 11 ? default : root.native-cursor ? crosshair : none;
    init => { root.cursor-changed(root.cursor); root.pointer-feedback-changed(); }
    changed cursor => { root.cursor-changed(root.cursor); }
    changed pointer-kind => { root.pointer-feedback-changed(); }
    changed pointer-image => { root.pointer-feedback-changed(); }
    changed pointer-hotspot-x => { root.pointer-feedback-changed(); }
    changed pointer-hotspot-y => { root.pointer-feedback-changed(); }
    changed pointer-scale => { root.pointer-feedback-changed(); }
    changed native-cursor => { root.pointer-feedback-changed(); }
    // 1 draw, 2/3 resize, 4/5 interior pending/requested, 6/7 grip, 8 seek-only.
    property <int> mode: 0;
    property <length> down-x;
    property <length> down-y;
    property <length> down-width;
    property <float> captured-limit;
    property <float> anchor;
    property <float> draft-start;
    property <float> draft-end;
    property <bool> travelled: false;
    property <bool> is-preparing: root.preparing || root.export-state == 1;
    property <bool> editing: root.mode > 0 && root.mode < 4;
    property <float> shown-start: root.editing && (root.mode != 1 || root.travelled) ? min(root.draft-start, root.draft-end) : root.selection-start;
    property <float> shown-end: root.editing && (root.mode != 1 || root.travelled) ? max(root.draft-start, root.draft-end) : root.selection-end;
    property <bool> shown-active: root.selection-active || (root.editing && root.travelled);
    property <float> span: max(0.000001, root.view-end - root.view-start);
    property <length> left-x: (root.shown-start - root.view-start) / root.span * root.width;
    property <length> right-x: (root.shown-end - root.view-start) / root.span * root.width;
    property <bool> near-left: root.selection-active && root.selection-start >= root.view-start && root.selection-start <= root.view-end && abs(hit.mouse-x - root.left-x) <= 5px * Theme.ui-scale;
    property <bool> near-right: root.selection-active && root.selection-end >= root.view-start && root.selection-end <= root.view-end && abs(hit.mouse-x - root.right-x) <= 5px * Theme.ui-scale;
    property <bool> left-wins: root.near-left && (!root.near-right || abs(hit.mouse-x - root.left-x) <= abs(hit.mouse-x - root.right-x));
    property <bool> inside: root.selection-active && hit.mouse-x > root.left-x && hit.mouse-x < root.right-x;
    property <bool> grip-gesture: root.mode == 6 || root.mode == 7;
    property <length> paint-x: root.grip-gesture || (root.mode == 0 && grip.has-hover) ? grip-frame.x + grip.mouse-x : hit.mouse-x;
    property <length> paint-y: root.grip-gesture || (root.mode == 0 && grip.has-hover) ? feedback.y + grip-frame.y + grip.mouse-y : hit.mouse-y;
    // Ownership never reads paint geometry: the feedback text depends on the
    // pointer kind and can change its row's layout. Snapshot the grip origin at
    // Down, then use only input-local coordinates and that value while captured.
    property <length> grip-origin-x;
    property <length> grip-origin-y;
    property <bool> hit-in-frame: hit.mouse-x >= 0px && hit.mouse-x <= root.width && hit.mouse-y >= 0px && hit.mouse-y <= root.height;
    property <bool> grip-in-frame: root.grip-origin-x + grip.mouse-x >= 0px && root.grip-origin-x + grip.mouse-x <= root.width && root.grip-origin-y + grip.mouse-y >= 0px && root.grip-origin-y + grip.mouse-y <= root.height;
    property <bool> pointer-owned: root.grip-gesture ? root.grip-in-frame
        : root.mode != 0 ? root.hit-in-frame
        : grip.has-hover || (hit.has-hover && hit.mouse-y >= 0px && hit.mouse-y <= root.plot-height);
    property <string> hint: root.pointer-kind == 2 || root.pointer-kind == 3 ? (root.chinese ? "松开试听选区 · Esc 取消本次框选" : "Release to audition · Esc cancels this selection")
        : root.pointer-kind == 4 ? (root.chinese ? "拖动调整起点 · 松开试听" : "Drag to adjust start · Release to audition")
        : root.pointer-kind == 5 ? (root.chinese ? "拖动调整终点 · 松开试听" : "Drag to adjust end · Release to audition")
        : root.pointer-kind == 8 ? (root.chinese ? "保持按住，正在准备 WAV · 松开后可再次拖出" : "Keep holding; preparing WAV · Release and drag again later")
        : root.pointer-kind == 7 ? (root.chinese ? "拖出窗口导出 WAV · Esc 取消拖出" : "Drag out as WAV · Esc cancels the drag")
        : root.pointer-kind == 6 ? (grip.has-hover
            ? (root.chinese ? "拖动此手柄导出选区 WAV" : "Drag this handle to export the selection as WAV")
            : (root.chinese ? "单击定位播放 · 拖动导出 WAV · Shift 拖动重选" : "Click to seek and play · Drag out as WAV · Shift-drag to reselect"))
        : root.pointer-kind == 9 ? (root.chinese ? "单击定位播放 · 波形完成后可框选" : "Click to seek and play · Select when Waveform is ready")
        : root.pointer-kind == 10 ? (root.chinese ? "波形暂不可操作" : "Waveform is currently unavailable")
        : root.pointer-kind == 11 ? (root.chinese ? "拖到目标应用 · Esc 取消" : "Drop in the target application · Esc cancels")
        : root.shift-held ? (root.chinese ? "拖动重新框选 · 松开自动试听" : "Drag a new range · Release to audition")
        : (root.chinese ? "拖动框选并试听 · 单击定位播放" : "Drag to select and audition · Click to seek and play");
    property <string> export-label: root.is-preparing ? (root.progress-text != "" ? root.progress-text : (root.chinese ? "正在准备 WAV…" : "Preparing WAV…"))
        : root.export-state == 2 ? (root.chinese ? "WAV 已就绪，拖出导出" : "WAV ready; drag out to export")
        : root.export-state == 3 ? (root.chinese ? "正在拖出 WAV" : "Dragging WAV")
        : root.export-state == 4 ? (root.chinese ? "已取消 · 再次拖出可重试" : "Cancelled · Drag again to retry")
        : root.export-state == 5 ? (root.progress-text != "" ? root.progress-text : (root.chinese ? "准备失败 · 再次拖出重试" : "Preparation failed · Drag again to retry"))
        : root.hint;
    function cancel-gesture() { let was-drag = root.mode >= 4 && root.mode <= 7; root.mode = 0; root.travelled = false; if was-drag { root.drag-ended(); } }
    changed identity => { root.cancel-gesture(); }
    changed cancel-revision => { root.cancel-gesture(); }
    changed enabled => { if !root.enabled && root.mode != 8 { root.cancel-gesture(); } }
    changed seek-enabled => { if !root.seek-enabled && root.mode == 8 { root.cancel-gesture(); } }
    changed seek-clock => { if root.mode == 8 { root.cancel-gesture(); } }
    function source-time(x: length) -> float {
        return clamp(root.captured-start + clamp(x / max(1px, root.down-width), 0, 1) * (root.captured-end - root.captured-start), 0, root.captured-limit);
    }
    function move-pointer() {
        if root.mode == 0 || root.mode >= 5 { return; }
        if abs(hit.mouse-x - root.down-x) >= 6px || abs(hit.mouse-y - root.down-y) >= 6px { root.travelled = true; }
        if root.mode == 4 {
            if root.travelled { root.mode = 5; root.drag-requested(); }
        } else if root.mode == 2 { root.draft-start = root.source-time(hit.mouse-x); }
        else { root.draft-end = root.source-time(hit.mouse-x); }
    }
    accessible-role: groupbox;
    accessible-label: root.chinese ? "波形选区" : "Waveform selection";
    accessible-description: root.hint;
    if root.shown-active && root.shown-end > root.view-start && root.shown-start < root.view-end: Rectangle {
        x: max(0px, root.left-x); y: 0px; width: max(0px, min(root.width, root.right-x) - self.x); height: root.plot-height;
        background: Theme.accent.with-alpha(0.24);
        accessible-role: text; accessible-label: root.chinese ? "选中的波形区域" : "Selected waveform region";
    }
    if root.shown-active && root.shown-start >= root.view-start && root.shown-start <= root.view-end: Rectangle {
        x: clamp(round(root.left-x / 1px) * 1px, 0px, max(0px, root.width - 1px)); y: 0px; width: 1px; height: root.plot-height;
        background: root.pointer-kind == 4 ? Theme.accent-hover : Theme.ink.with-alpha(0.82);
        Rectangle { x: 0px; y: 0px; width: 5px * Theme.ui-scale; height: 1px; background: parent.background; accessible-role: none; }
        Rectangle { x: 0px; y: parent.height - 1px; width: 5px * Theme.ui-scale; height: 1px; background: parent.background; accessible-role: none; }
    }
    if root.shown-active && root.shown-end >= root.view-start && root.shown-end <= root.view-end: Rectangle {
        x: clamp(round(root.right-x / 1px) * 1px - 1px, 0px, max(0px, root.width - 1px)); y: 0px; width: 1px; height: root.plot-height;
        background: root.pointer-kind == 5 ? Theme.accent-hover : Theme.ink.with-alpha(0.82);
        Rectangle { x: 1px - self.width; y: 0px; width: 5px * Theme.ui-scale; height: 1px; background: parent.background; accessible-role: none; }
        Rectangle { x: 1px - self.width; y: parent.height - 1px; width: 5px * Theme.ui-scale; height: 1px; background: parent.background; accessible-role: none; }
    }
    hit := TouchArea {
        x: 0px; y: 0px; width: parent.width; height: root.plot-height;
        // Always track hover, including unavailable/seek-only plots. Every
        // mutation below separately checks the actual operation's availability.
        mouse-cursor: root.native-cursor ? crosshair : (root.pointer-kind > 0 && root.pointer-kind < 11 ? none : default);
        pointer-event(event) => {
            if event.kind == PointerEventKind.cancel { root.cancel-gesture(); return; }
            if event.button != PointerEventButton.left { return; }
            if event.kind == PointerEventKind.down {
                if (!root.enabled && !root.seek-enabled) || root.export-state == 3 { return; }
                root.captured-start = root.view-start; root.captured-end = root.view-end;
                root.captured-limit = max(0, root.enabled ? root.captured-end : root.duration);
                root.down-width = root.width; root.down-x = self.mouse-x; root.down-y = self.mouse-y;
                root.anchor = root.source-time(self.mouse-x);
                root.draft-start = root.selection-start; root.draft-end = root.selection-end;
                root.travelled = false;
                if !root.enabled { root.mode = 8; }
                else if event.modifiers.shift { root.mode = 1; }
                else if root.near-left || root.near-right { root.mode = root.left-wins ? 2 : 3; }
                else { root.mode = root.inside ? 4 : 1; }
                if root.mode == 1 { root.draft-start = root.anchor; root.draft-end = root.anchor; }
            } else if event.kind == PointerEventKind.up && root.mode != 0 {
                root.move-pointer();
                let mode = root.mode;
                let moved = root.travelled;
                let start = min(root.draft-start, root.draft-end);
                let end = max(root.draft-start, root.draft-end);
                let resized = (mode == 2 || mode == 3) && (root.draft-start != root.selection-start || root.draft-end != root.selection-end);
                let time = root.source-time(self.mouse-x);
                root.cancel-gesture();
                if ((mode == 1 && moved) || resized) && end > start { root.committed(start, end); }
                else if mode == 8 || ((mode == 1 || mode == 4) && !moved) { root.seek-play(time); }
            }
        }
        moved => { root.move-pointer(); }
        scroll-event(event) => {
            if root.gesture || root.export-state == 3 { return accept; }
            if ((root.enabled && root.view-end > root.view-start) || (root.seek-enabled && root.duration > 0)) && event.delta-y != 0px {
                root.zoom-at(Math.pow(2, clamp(event.delta-y / 120px, -2, 2)), clamp(self.mouse-x / max(1px, self.width), 0, 1));
                return accept;
            }
            reject
        }
    }
    feedback := Rectangle {
        y: root.plot-height; width: parent.width; height: root.feedback-height;
        background: Theme.player;
        accessible-role: groupbox; accessible-label: root.chinese ? "波形选区操作" : "Waveform selection controls"; accessible-description: root.hint;
        Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.player-border; accessible-role: none; }
        HorizontalLayout {
            padding-left: 4px * Theme.ui-scale; padding-right: 2px * Theme.ui-scale; padding-top: 1px; spacing: 5px * Theme.ui-scale;
            grip-frame := Rectangle {
                visible: root.shown-active;
                width: !root.shown-active ? 0px : (root.width < 460px * Theme.ui-scale ? 26px : 92px) * Theme.ui-scale;
                height: 24px * Theme.ui-scale; background: grip.has-hover ? Theme.control-hover-surface : transparent; border-radius: 3px * Theme.ui-scale;
                property <bool> tip-ready: false;
                accessible-role: button; accessible-label: root.chinese ? "拖出选区 WAV" : "Drag selection as WAV";
                accessible-enabled: root.enabled && root.selection-active && root.export-state != 3;
                accessible-description: root.chinese ? "按住并拖出，导出当前选区；短选区也可使用此手柄" : "Press and drag to export the current selection; this handle also works for narrow ranges";
                Image { source: @image-url("icons/export.svg"); colorize: Theme.accent-hover; width: 15px * Theme.ui-scale; height: self.width; x: 5px * Theme.ui-scale; y: (parent.height - self.height) / 2; }
                if root.width >= 460px * Theme.ui-scale: Text { x: 25px * Theme.ui-scale; width: parent.width - self.x; height: parent.height; text: root.chinese ? "拖出 WAV" : "Drag WAV"; color: Theme.ink; font-size: Theme.font(10); vertical-alignment: center; accessible-role: none; }
                grip := TouchArea {
                    changed has-hover => { if !self.has-hover { grip-frame.tip-ready = false; } }
                    mouse-cursor: root.native-cursor ? crosshair : (root.pointer-kind > 0 && root.pointer-kind < 11 ? none : default);
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.cancel { if root.mode >= 6 { root.cancel-gesture(); } return; }
                        if event.button != PointerEventButton.left { return; }
                        if event.kind == PointerEventKind.down {
                            if !root.enabled || !root.selection-active || root.export-state == 3 || root.mode != 0 { return; }
                            root.captured-start = root.view-start; root.captured-end = root.view-end;
                            root.captured-limit = max(0, root.captured-end);
                            root.grip-origin-x = grip-frame.x;
                            root.grip-origin-y = feedback.y + grip-frame.y;
