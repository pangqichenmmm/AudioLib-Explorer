// app/audiolib-desktop/ui/audition-panel.slint
import { ComboBox } from "std-widgets.slint";
import { Theme, ThemedSlider as Slider, ThemedLineEdit as LineEdit } from "theme.slint";

component Tool inherits Rectangle {
    in property <string> symbol;
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> active: false;
    in property <bool> primary: false;
    /// A mouse click must not claim keyboard focus, so transport keys (e.g. Space
    /// for the result list) keep working right after a click. Tabbed focus still
    /// activates the button with Space/Return.
    in property <bool> keyboard-active: true;
    out property <bool> has-focus: focus.has-focus;
    callback clicked();
    width: 32px * Theme.ui-scale; height: 30px * Theme.ui-scale; border-radius: 4px * Theme.ui-scale;
    background: root.primary ? (hit.has-hover ? Theme.accent-hover : Theme.accent) : (root.active ? Theme.selected : (hit.has-hover ? Theme.hover : Theme.raised));
    border-width: 1px; border-color: focus.has-focus || root.active ? Theme.accent : Theme.border;
    opacity: root.enabled ? 1 : 0.4;
    accessible-role: button; accessible-label: root.label; accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    if root.icon.width > 0: Image { source: root.icon; colorize: root.primary ? Theme.on-accent : Theme.ink; width: 20px * Theme.ui-scale; height: 20px * Theme.ui-scale; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
    if root.icon.width == 0: Text { text: root.symbol; color: root.primary ? Theme.on-accent : Theme.ink; font-size: Theme.font(16); horizontal-alignment: center; vertical-alignment: center; }
    focus := FocusScope { enabled: root.enabled; key-pressed(event) => { if root.keyboard-active && (event.text == " " || event.text == Key.Return) { root.clicked(); return accept; } reject } }
    hit := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
    if hit.has-hover: Rectangle { z: 10; y: -28px * Theme.ui-scale; height: 24px * Theme.ui-scale; width: max(86px * Theme.ui-scale, tip.preferred-width + 16px * Theme.ui-scale); background: Theme.tooltip; border-width: 1px; border-color: Theme.strong-border; border-radius: 3px * Theme.ui-scale;
        tip := Text { text: root.label; color: Theme.ink; font-size: Theme.font(10); horizontal-alignment: center; vertical-alignment: center; }
    }
}
component Caption inherits Text { color: Theme.dim; font-size: Theme.font(11); vertical-alignment: center; }

export component AuditionPanel inherits Rectangle {
    in property <bool> compact: false;
    in property <bool> spectral: true;
    in property <bool> chinese;
    in property <bool> play-on-single-click: false;
    in property <bool> ready;
    in property <bool> playing;
    in property <bool> smooth-progress: false;
    in property <string> progress-clock;
    in property <float> playback-rate: 1;
    in property <image> waveform;
    in property <bool> waveform-ready;
    in property <string> name;
    in property <string> info;
    in property <string> output;
    in property <float> position;
    in property <float> duration;
    in property <string> time;
    in property <string> end-time;
    in property <float> view-start;
    in property <float> view-end;
    in property <float> zoom: 1;
    in property <[string]> ruler-labels;
    in-out property <float> scroll: 0;
    in-out property <float> volume-db: -1.9;
    out property <bool> volume-adjusting: volume-control.has-focus;
    in property <string> volume-label;
    in-out property <string> pitch-text: "0.00";
    in-out property <string> rate-text: "1.00";
    in-out property <bool> mono: false;
    in-out property <bool> repeat: false;
    callback play(); callback pause(); callback stop(); callback seek(float); callback seek-play(float);
    callback transform(string,string,bool,bool); callback volume(float);
    callback resize(int,int); callback zoom-change(float); callback zoom-at(float,float); callback pan(float);
    callback peaks(); callback output-settings();
    // The frame clock fills gaps between engine snapshots, with bounded prediction.
    // Repeated positions do not restart the clock; stalled output stops after 100ms.
    property <float> anchor-position: 0;
    property <duration> anchor-tick: 0ms;
    property <float> correction: 0;
    property <duration> progress-elapsed: root.ready && root.playing && root.smooth-progress ? clamp(animation-tick() - root.anchor-tick, 0ms, 100ms) : 0ms;
    property <float> visual-position: clamp(root.anchor-position + root.progress-elapsed / 1s * root.playback-rate + root.correction * (1 - root.progress-elapsed / 100ms), 0, root.duration);
    function sync-progress(allow-correction: bool) {
        let previous = root.visual-position;
        let continuous = allow-correction && root.ready && root.playing && root.smooth-progress && abs(previous - root.position) < 0.1 * root.playback-rate;
        root.anchor-position = root.position;
        root.anchor-tick = animation-tick();
        root.correction = continuous ? previous - root.position : 0;
    }
    init => { root.sync-progress(false); }
    changed position => { root.sync-progress(true); }
    changed playing => { root.sync-progress(false); }
    changed smooth-progress => { root.sync-progress(false); }
    changed playback-rate => { root.sync-progress(false); }
    // A clock identity survives deferred coalescing of smooth false -> true.
    changed progress-clock => { root.sync-progress(false); }
    function wheel-zoom(delta: length, fraction: float) -> EventResult {
        if root.ready && root.duration > 0 && delta != 0px {
            // Pixel deltas support both mouse detents and precision touchpads.
            root.zoom-at(Math.pow(2, clamp(delta / 120px, -2, 2)), clamp(fraction, 0, 1));
            return accept;
        }
        return reject;
    }
    height: root.compact ? 190px * Theme.ui-scale : 222px * Theme.ui-scale; background: Theme.player; border-width: 1px; border-color: Theme.player-border; border-radius: 7px * Theme.ui-scale;
    VerticalLayout { padding: 9px * Theme.ui-scale; spacing: 5px * Theme.ui-scale;
        HorizontalLayout { height: 32px * Theme.ui-scale; spacing: 6px * Theme.ui-scale;
            Tool { icon: @image-url("icons/start.svg"); label: root.chinese ? "回到开头" : "Go to start"; enabled: root.ready; clicked => { root.seek(0); } }
            Tool { icon: @image-url("icons/play.svg"); label: root.chinese ? "播放" : "Play"; primary: true; active: root.playing; enabled: root.ready; clicked => { root.play(); } }
            Tool { icon: @image-url("icons/pause.svg"); label: root.chinese ? "暂停" : "Pause"; active: root.ready && !root.playing && root.position > 0; enabled: root.ready; clicked => { root.pause(); } }
            Tool { icon: @image-url("icons/stop.svg"); label: root.chinese ? "停止" : "Stop"; enabled: root.ready; clicked => { root.stop(); } }
            Tool { icon: @image-url("icons/repeat.svg"); label: root.chinese ? "循环整个声音" : "Repeat sound"; active: root.repeat; clicked => { root.repeat = !root.repeat; root.transform(root.pitch-text, root.rate-text, root.mono, root.repeat); } }
            Rectangle { width: 1px; background: Theme.player-border; }
            Caption { text: root.chinese ? "音高" : "Pitch"; }
            LineEdit { width: 62px * Theme.ui-scale; text <=> root.pitch-text; enabled: root.ready; input-label: root.chinese ? "变调半音，回车或离开时应用" : "Pitch semitones, applied on Enter or focus loss"; changed has-focus => { if !self.has-focus && root.ready { root.transform(self.text, root.rate-text, root.mono, root.repeat); } } accepted => { root.transform(self.text, root.rate-text, root.mono, root.repeat); } }
            Caption { text: root.chinese ? "半音" : "st"; }
            Caption { text: root.chinese ? "速度" : "Rate"; }
            LineEdit { width: 57px * Theme.ui-scale; text <=> root.rate-text; enabled: root.ready; input-label: root.chinese ? "保持音高的播放速度，回车或离开时应用" : "Pitch-preserving speed, applied on Enter or focus loss"; changed has-focus => { if !self.has-focus && root.ready { root.transform(root.pitch-text, self.text, root.mono, root.repeat); } } accepted => { root.transform(root.pitch-text, self.text, root.mono, root.repeat); } }
            Caption { text: "×"; }
            Tool { icon: @image-url("icons/reset.svg"); label: root.chinese ? "重置变调与速度" : "Reset Pitch / Rate"; clicked => { root.pitch-text = "0.00"; root.rate-text = "1.00"; root.transform(root.pitch-text, root.rate-text, root.mono, root.repeat); } }
            Rectangle { width: 1px; background: Theme.player-border; }
            Caption { text: root.chinese ? "音量" : "Volume"; }
            volume-control := Slider { min-width: 76px * Theme.ui-scale; max-width: 160px * Theme.ui-scale; horizontal-stretch: 1; minimum: -60; maximum: 0; step: 0.1; value <=> root.volume-db; changed => { root.volume(self.value); } }
            Caption { width: 66px * Theme.ui-scale; text: root.volume-label; horizontal-alignment: right; }
            Tool { width: 54px * Theme.ui-scale; symbol: root.chinese ? "单声道" : "Mono"; label: root.chinese ? "单声道监听" : "Mono monitoring"; active: root.mono; clicked => { root.mono = !root.mono; root.transform(root.pitch-text, root.rate-text, root.mono, root.repeat); } }
            Caption { horizontal-stretch: 1; min-width: 0px; text: root.output; overflow: elide; horizontal-alignment: right; font-size: Theme.font(9); }
            Tool { icon: @image-url("icons/peaks.svg"); label: root.chinese ? "波形显示设置" : "Peak display settings"; clicked => { root.peaks(); } }
            Tool { icon: @image-url("icons/settings.svg"); label: root.chinese ? "音频输出" : "Audio output"; clicked => { root.output-settings(); } }
        }
        wave := Rectangle { horizontal-stretch: 1; vertical-stretch: 1; min-height: root.compact ? 45px * Theme.ui-scale : 70px * Theme.ui-scale; background: root.spectral ? Theme.spectral-canvas : Theme.normal-canvas; border-color: Theme.player-border; border-width: 1px; clip: true;
            accessible-role: groupbox; accessible-label: root.chinese ? "波形时间轴" : "Waveform timeline";
            property <float> played-fraction: root.duration > 0 ? clamp((root.visual-position - root.view-start) / max(0.001, root.view-end - root.view-start), 0, 1) : 0;
            changed width => { root.resize(self.width / 1px, self.height / 1px); }
            changed height => { root.resize(self.width / 1px, self.height / 1px); }
            Image { source: root.waveform; width: parent.width; height: parent.height; image-fit: fill; }
            if !root.waveform-ready: Text { text: root.ready ? (root.chinese ? "正在分析频谱峰值…" : "Analyzing spectral peaks…") : (root.play-on-single-click ? (root.chinese ? "单击声音即可试听" : "Click a sound to audition") : (root.chinese ? "选择声音查看波形 · 双击试听" : "Select a sound to view its waveform · Double-click to audition")); color: root.spectral ? #263238 : Theme.dim; horizontal-alignment: center; vertical-alignment: center; font-size: Theme.font(11); }
            // These overlays are paint-only, leaving click/scroll ownership to scrub.
            if root.ready && root.duration > 0: Rectangle {
                x: 0px; y: 0px; height: parent.height; width: wave.played-fraction * parent.width;
                background: root.spectral ? #183c3428 : #8faea622;
                accessible-role: progress-indicator; accessible-label: root.chinese ? "已播放区域" : "Played waveform region";
                accessible-value: root.position; accessible-value-minimum: 0; accessible-value-maximum: root.duration;
                Rectangle { x: 0px; width: parent.width; y: parent.height - 3px * Theme.ui-scale; height: 3px * Theme.ui-scale; background: Theme.accent; }
            }
            if root.ready && root.duration > 0 && root.visual-position >= root.view-start && root.visual-position <= root.view-end: Rectangle {
                x: wave.played-fraction * (parent.width - 1px); width: 1px;
                background: root.spectral ? #f4faf7 : Theme.accent-hover;
            }
            if scrub.has-hover && root.ready: Rectangle { x: scrub.mouse-x; width: 1px; background: #ffffff30; }
            scrub := TouchArea { enabled: root.ready; mouse-cursor: pointer;
                clicked => { root.seek-play(root.view-start + clamp(self.mouse-x/self.width,0,1)*(root.view-end - root.view-start)); }
                scroll-event(event) => { return root.wheel-zoom(event.delta-y, self.mouse-x / max(1px,self.width)); }
            }
        }
        Rectangle { height: 24px * Theme.ui-scale; accessible-role: groupbox; accessible-label: root.chinese ? "波形时间尺" : "Waveform time ruler";
            for tick in 51: Rectangle { x: tick * (parent.width - 1px) / 50; width: 1px; height: Math.mod(tick,5) == 0 ? 9px * Theme.ui-scale : 4px * Theme.ui-scale; background: Theme.muted; }
            for label[index] in root.ruler-labels: Text { x: clamp(index * (parent.width - 1px)/10,0px,parent.width - self.width); y: 10px * Theme.ui-scale; width: 55px * Theme.ui-scale; height: 13px * Theme.ui-scale; text: label; color: Theme.dim; font-size: Theme.font(9); horizontal-alignment: index == 10 ? right : left; }
            TouchArea { enabled: root.ready; mouse-cursor: pointer;
                clicked => { root.seek-play(root.view-start + clamp(self.mouse-x/self.width,0,1)*(root.view-end - root.view-start)); }
                scroll-event(event) => { return root.wheel-zoom(event.delta-y, self.mouse-x / max(1px,self.width)); }
            }
        }
        HorizontalLayout { height: 16px * Theme.ui-scale; spacing: 7px * Theme.ui-scale;
            Caption { width: 42px * Theme.ui-scale; text: Math.round(root.zoom * 10) / 10 + "×"; font-size: Theme.font(10); }
            if root.ready: Caption { text: root.chinese ? "滚轮缩放" : "Scroll to zoom"; font-size: Theme.font(9); }
            Slider { horizontal-stretch: 1; minimum: 0; maximum: 1; step: 0.005; enabled: root.zoom > 1; value <=> root.scroll; changed => { root.pan(self.value); } }
            Tool { width: 24px * Theme.ui-scale; height: 18px * Theme.ui-scale; symbol: "−"; label: root.chinese ? "缩小波形" : "Zoom out"; enabled: root.ready && root.zoom > 1; clicked => { root.zoom-change(0.5); } }
            Tool { width: 24px * Theme.ui-scale; height: 18px * Theme.ui-scale; symbol: "+"; label: root.chinese ? "放大波形" : "Zoom in"; enabled: root.ready && root.zoom < 128; clicked => { root.zoom-change(2); } }
            Tool { width: 38px * Theme.ui-scale; height: 18px * Theme.ui-scale; icon: @image-url("icons/fit.svg"); label: root.chinese ? "显示完整声音" : "Fit entire sound"; enabled: root.ready; clicked => { root.zoom-change(0); } }
        }
        HorizontalLayout { height: 25px * Theme.ui-scale; spacing: 12px * Theme.ui-scale;
            Text { accessible-role: text; accessible-label: root.chinese ? "试听时间" : "Audition time"; width: 208px * Theme.ui-scale; text: root.time + "  /  " + root.end-time; color: Theme.ink; font-family: "Consolas"; font-size: Theme.font(14); vertical-alignment: center; }
            Rectangle { width: 1px; background: Theme.player-border; }
            Text { horizontal-stretch: 1; min-width: 0px; text: root.name == "" ? (root.chinese ? "未加载声音" : "No sound loaded") : root.name; overflow: elide; color: Theme.ink; font-size: Theme.font(11); vertical-alignment: center; }
            Caption { text: root.info; font-size: Theme.font(10); }
        }
    }
}

export component PeakSettings inherits FocusScope {
    forward-focus: peaks-close;
    focus-on-click: false; focus-on-tab-navigation: false;
    property <bool> reverse-wrap: false;
    capture-key-pressed(event) => {
        if event.text == Key.Escape { root.close(); return accept; }
        if (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) && peaks-close.has-focus {
            root.reverse-wrap = true; peaks-tab-end.focus(); root.reverse-wrap = false; return reject;
        }
        reject
    }
    key-pressed(event) => { if event.text == Key.Tab || event.text == Key.Backtab { return reject; } accept }
    key-released(event) => { accept }
    in property <bool> chinese;
    in-out property <int> mode: 1;
    in-out property <float> gain-db: 0;
    in-out property <float> opacity-value: 0.85;
    in-out property <float> noise: 1;
    in-out property <float> variance: 0.38;
    callback changed(); callback close();
    Rectangle { background: Theme.overlay;
    TouchArea { }
    Rectangle { width: 480px * Theme.ui-scale; height: 384px * Theme.ui-scale; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; background: Theme.panel; border-radius: 8px * Theme.ui-scale; border-width: 1px; border-color: Theme.strong-border;
        VerticalLayout { padding: 20px * Theme.ui-scale; spacing: 12px * Theme.ui-scale;
            HorizontalLayout { height: 30px * Theme.ui-scale;
                Text { horizontal-stretch: 1; text: root.chinese ? "波形显示设置" : "Peak display settings"; color: Theme.ink; font-size: Theme.font(17); font-weight: 600; vertical-alignment: center; }
                peaks-close := Tool { symbol: "×"; label: root.chinese ? "关闭" : "Close"; clicked => { root.close(); } }
            }
            HorizontalLayout { height: 30px * Theme.ui-scale; spacing: 12px * Theme.ui-scale;
                Caption { width: 90px * Theme.ui-scale; text: root.chinese ? "显示增益" : "Display gain"; }
                Slider { surface: Theme.panel; horizontal-stretch: 1; minimum: -12; maximum: 36; step: 1; value <=> root.gain-db; changed => { root.changed(); } }
                Caption { width: 60px * Theme.ui-scale; text: root.gain-db + " dB"; horizontal-alignment: right; }
            }
            HorizontalLayout { height: 30px * Theme.ui-scale; spacing: 12px * Theme.ui-scale;
                Caption { width: 90px * Theme.ui-scale; text: root.chinese ? "显示模式" : "Display"; }
                ComboBox { horizontal-stretch: 1; model: root.chinese ? ["普通波形", "彩色频谱峰值"] : ["Normal peaks", "Spectral peaks"]; current-index <=> root.mode; selected => { root.changed(); } }
            }
            HorizontalLayout { height: 26px * Theme.ui-scale; spacing: 12px * Theme.ui-scale;
                Caption { width: 90px * Theme.ui-scale; text: root.chinese ? "色彩强度" : "Color opacity"; }
                Slider { surface: Theme.panel; horizontal-stretch: 1; minimum: 0; maximum: 1; step: 0.01; value <=> root.opacity-value; changed => { root.changed(); } }
                Caption { width: 60px * Theme.ui-scale; text: Math.round(root.opacity-value * 100) + "%"; horizontal-alignment: right; }
            }
            // REAPER-reference frequency anchors from audiolib-audio/src/spectral.rs.
            Rectangle { height: 92px * Theme.ui-scale; background: @linear-gradient(90deg, #fb00ff, #ff0018, #ffd300, #3dff00, #00ffac, #0064ff, #8600ff, #ff0094); border-radius: 3px * Theme.ui-scale;
                Rectangle { x: 0px; y: 0px; background: @linear-gradient(180deg, #0e0e0eff, #0e0e0e00); height: 65px * Theme.ui-scale; }
                for frequency[index] in ["14 Hz", "36 Hz", "93 Hz", "241 Hz", "628 Hz", "1632 Hz", "4241 Hz"]: Text { x: 4px * Theme.ui-scale + index * (parent.width - 8px * Theme.ui-scale) / 7; y: 69px * Theme.ui-scale; height: 20px * Theme.ui-scale; text: frequency; color: #101820; font-size: Theme.font(10); font-weight: 600; vertical-alignment: center; }
            }
            HorizontalLayout { height: 26px * Theme.ui-scale; spacing: 8px * Theme.ui-scale;
                Caption { text: root.chinese ? "噪声阈值" : "Noise threshold"; width: 80px * Theme.ui-scale; }
                Slider { surface: Theme.panel; horizontal-stretch: 1; minimum: 0.1; maximum: 2; step: 0.05; value <=> root.noise; changed => { root.changed(); } }
                Caption { width: 36px * Theme.ui-scale; text: Math.round(root.noise*100)/100; }
                Caption { text: root.chinese ? "频率分散" : "Variance"; width: 68px * Theme.ui-scale; }
                Slider { surface: Theme.panel; horizontal-stretch: 1; minimum: 0.05; maximum: 1; step: 0.01; value <=> root.variance; changed => { root.changed(); } }
                Caption { width: 36px * Theme.ui-scale; text: Math.round(root.variance*100)/100; }
            }
            Caption { text: root.chinese ? "黑色表示非音调内容；颜色随主频变化。显示增益不改变音量。" : "Noise fades to black; tones show frequency. Display gain is visual only."; font-size: Theme.font(10); }
        }
    }
    }
    peaks-tab-end := FocusScope { width: 0px; height: 0px; focus-on-click: false; focus-gained(reason) => { if !root.reverse-wrap { peaks-close.focus(); } } }
}
