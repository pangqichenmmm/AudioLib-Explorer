                            root.mode = 6;
                        } else if event.kind == PointerEventKind.up && root.mode >= 6 { root.cancel-gesture(); }
                    }
                    moved => {
                        if root.mode == 6 && (abs(self.mouse-x - root.down-x) >= 6px || abs(self.mouse-y - root.down-y) >= 6px) {
                            root.mode = 7; root.drag-requested();
                        }
                    }
                }
                Timer { interval: Theme.tooltip-delay; running: grip.has-hover && !root.gesture && !grip-frame.tip-ready; triggered => { grip-frame.tip-ready = true; } }
                Tip { z: 10; anchor-width: parent.width; anchor-height: parent.height; align: -1; text: root.hint; show: grip-frame.tip-ready && grip.has-hover && !root.gesture; }
            }
            if root.shown-active: Text {
                width: (root.width >= 650px * Theme.ui-scale ? 245px : root.width >= 420px * Theme.ui-scale ? 190px : 82px) * Theme.ui-scale;
                text: root.width >= 420px * Theme.ui-scale ? Clock.format(root.shown-start) + " – " + Clock.format(root.shown-end) + "  ·  " + Clock.format(root.shown-end - root.shown-start) : "Δ " + Clock.format(root.shown-end - root.shown-start);
                color: Theme.ink; font-size: Theme.font(9); vertical-alignment: center; overflow: elide;
                accessible-role: text; accessible-label: root.chinese ? "选区起点、终点和时长" : "Selection start, end and duration";
                accessible-description: Clock.format(root.shown-start) + " – " + Clock.format(root.shown-end) + " · " + Clock.format(root.shown-end - root.shown-start);
            }
            Text {
                horizontal-stretch: 1; min-width: 0px; text: root.editing || root.mode >= 4 ? root.hint : root.export-label;
                color: root.export-state == 5 && !root.gesture ? Theme.danger : root.export-state == 2 && !root.gesture ? Theme.accent-hover : Theme.dim;
                font-size: Theme.font(9); vertical-alignment: center; overflow: elide;
                accessible-role: text; accessible-label: root.chinese ? "波形导出状态" : "Waveform export status";
                accessible-description: root.export-label;
            }
            if root.is-preparing: Tool {
                width: (root.chinese ? 42px : 52px) * Theme.ui-scale; height: 24px * Theme.ui-scale;
                symbol: root.chinese ? "取消" : "Cancel"; symbol-size: Theme.font(10); subtle: true;
                label: root.chinese ? "取消切片准备" : "Cancel slice preparation"; hint: "Esc"; tip-align: 1;
                clicked => { root.cancel-gesture(); root.cancel-requested(); }
            }
            if root.shown-active: Tool {
                width: 24px * Theme.ui-scale; height: 24px * Theme.ui-scale; symbol: "×"; symbol-size: Theme.font(14); subtle: true;
                label: root.chinese ? "清除波形选区" : "Clear waveform selection"; hint: "Esc"; tip-align: 1;
                clicked => { root.cancel-gesture(); root.cleared(); }
            }
        }
    }
    // Paint-only final layer follows the owning input, including active gestures
    // passing over the row. Native OLE feedback always takes ownership in phase 3.
    if !root.native-cursor && root.pointer-kind > 0 && root.pointer-kind < 11: WaveformPointer {
        x: round(root.paint-x / 1px) * 1px - root.pointer-hotspot-x * 1px * root.pointer-scale;
        y: round(root.paint-y / 1px) * 1px - root.pointer-hotspot-y * 1px * root.pointer-scale;
        cursor-image: root.pointer-image; cursor-scale: root.pointer-scale;
    }
}

component ClassicAuditionPanel inherits Rectangle {
    in property <bool> compact: false;
    in property <bool> spectral: true;
    in property <bool> chinese;
    in property <bool> selection-active;
    in property <float> selection-start;
    in property <float> selection-end;
    in property <string> selection-identity;
    in property <bool> selection-preparing;
    in property <int> selection-export-state;
    in property <bool> selection-native-cursor: false;
    in property <string> selection-progress;
    in property <bool> selection-shift-held;
    in property <int> selection-cancel-revision;
    callback selection-committed(float,float);
    callback selection-cleared();
    callback selection-drag-requested();
    callback selection-drag-ended();
    callback selection-cancel-requested();
    callback selection-cursor-changed(MouseCursor);
    callback selection-pointer-feedback-changed();
    out property <bool> selection-gesture: scrub.gesture;
    out property <MouseCursor> selection-cursor: scrub.cursor;
    out property <int> selection-pointer-kind: scrub.pointer-kind;
    out property <image> selection-pointer-image: scrub.pointer-image;
    out property <float> selection-pointer-hotspot-x: scrub.pointer-hotspot-x;
    out property <float> selection-pointer-hotspot-y: scrub.pointer-hotspot-y;
    out property <float> selection-pointer-scale: scrub.pointer-scale;

    in property <bool> play-on-single-click: false;
    in property <bool> ready;
    in property <int> state: 0;
    in property <bool> missing: false;
    in property <bool> busy: false;
    in property <bool> buffering: false;
    in property <bool> playing;
    in property <bool> smooth-progress: false;
    in property <string> progress-clock;
    in property <float> playback-rate: 1;
    in property <image> waveform;
    in property <bool> waveform-ready;
    in property <string> name;
    in property <string> info;
    in property <string> output;
    in property <float> position;
    in property <float> duration;
    in property <string> time;
    in property <string> end-time;
    in property <float> view-start;
    in property <float> view-end;
    in property <float> target-start;
    in property <float> target-end;
    in property <float> zoom: 1;
    in-out property <float> scroll: 0;
    in-out property <float> volume-db: -1.9;
    out property <bool> volume-adjusting: volume-control.has-focus;
    callback volume-focus-changed(bool);
    changed volume-adjusting => { root.volume-focus-changed(root.volume-adjusting); }
    in property <string> volume-label;
    in-out property <string> pitch-text: "0.00";
    in-out property <string> rate-text: "1.00";
    in-out property <bool> mono: false;
    in-out property <bool> repeat: false;
    callback play(); callback pause(); callback stop(); callback seek(float); callback seek-play(float);
    callback transform(string,string,bool,bool); callback volume(float);
    callback resize(int,int); callback zoom-change(float); callback zoom-at(float,float); callback pan(float);
    callback peaks(); callback output-settings();
    property <bool> transport-ready: root.ready && !root.missing && !root.busy && root.state != 1 && root.state != 7;
    property <string> unavailable: root.busy ? (root.chinese ? "素材库操作中，请稍候" : "Library operation in progress")
        : root.missing ? (root.chinese ? "源文件不可用，请重新链接" : "Source file unavailable; relink it first")
        : root.state == 1 ? (root.chinese ? "正在加载声音，请稍候" : "Sound is loading")
        : root.state == 7 ? (root.chinese ? "播放不可用，请重新选择声音或检查音频输出" : "Playback unavailable; reselect the sound or check audio output")
        : (root.chinese ? "请先选择并加载声音" : "Select and load a sound first");
    property <string> state-label: root.busy ? (root.chinese ? "处理中" : "Busy")
        : root.missing ? (root.chinese ? "文件缺失" : "Missing")
        : root.state == 1 ? (root.chinese ? "加载中" : "Loading")
        : root.state == 3 ? (root.buffering ? (root.chinese ? "缓冲中" : "Buffering") : (root.chinese ? "播放中" : "Playing"))
        : root.state == 4 ? (root.chinese ? "已暂停" : "Paused")
        : root.state == 5 ? (root.chinese ? "已停止" : "Stopped")
        : root.state == 6 ? (root.chinese ? "播放完毕" : "Ended")
        : root.state == 7 ? (root.chinese ? "出错" : "Error")
        : (root.chinese ? "就绪" : "Ready");
    // Share the current requested range while the renderer finishes its image.
    // Labels, seeks and the transformed old image must describe the same timeline.
    property <bool> has-target: root.target-end > root.target-start;
    property <float> shown-start: scrub.gesture ? scrub.captured-start : (root.has-target ? root.target-start : root.view-start);
    property <float> shown-end: scrub.gesture ? scrub.captured-end : (root.has-target ? root.target-end : root.view-end);
    property <float> shown-span: max(0.001, root.shown-end - root.shown-start);
    // Keep the original eleven evenly spaced labels without changing the shared
    // renderer's modern, round-tick model.
    function ruler-label(index: int) -> string {
        let seconds = root.shown-start + (root.shown-end - root.shown-start) * index / 10;
        let span = root.shown-end - root.shown-start;
        let scale = span < 0.1 ? 1000 : (span < 1 ? 100 : (span < 10 ? 10 : 1));
        // Round the whole timestamp before splitting minutes so a rounded
        // 59.96 seconds carries into 1:00.0 rather than producing 0:60.0.
        let units = round(max(0, seconds) * scale);
        let whole = floor(units / scale);
        let text = floor(whole / 60) + ":" + Clock.pad2(Math.mod(whole, 60));
        if scale == 1000 { return text + "." + Clock.pad3(Math.mod(units, scale)); }
        if scale == 100 { return text + "." + Clock.pad2(Math.mod(units, scale)); }
        if scale == 10 { return text + "." + Math.mod(units, scale); }
        return text;
    }
    // The frame clock fills gaps between engine snapshots, with bounded prediction.
    // Repeated positions do not restart the clock; stalled output stops after 100ms.
    property <float> anchor-position: 0;
    property <duration> anchor-tick: 0ms;
    property <float> correction: 0;
    // Do not bind button opacity/animation directly to the ticking position.
    // Slint propagates a dirty dependency even while position > 0 stays true;
    // together with the clock this can repaint a whole strip of the player.
    property <bool> at-start: true;
    property <duration> progress-elapsed: root.ready && root.playing && root.smooth-progress ? clamp(animation-tick() - root.anchor-tick, 0ms, 100ms) : 0ms;
    property <float> visual-position: clamp(root.anchor-position + root.progress-elapsed / 1s * root.playback-rate + root.correction * (1 - root.progress-elapsed / 100ms), 0,
        root.selection-active && root.selection-end > root.selection-start && root.position >= root.selection-start && root.position <= root.selection-end ? min(root.duration, root.selection-end) : root.duration);
    function sync-progress(allow-correction: bool) {
        let at-start = root.position <= 0;
        if root.at-start != at-start { root.at-start = at-start; }
        let previous = root.visual-position;
        let continuous = allow-correction && root.ready && root.playing && root.smooth-progress && abs(previous - root.position) < 0.1 * root.playback-rate;
        root.anchor-position = root.position;
        root.anchor-tick = animation-tick();
        root.correction = continuous ? previous - root.position : 0;
    }
    init => { root.sync-progress(false); }
    changed position => { root.sync-progress(true); }
    changed playing => { root.sync-progress(false); }
    changed smooth-progress => { root.sync-progress(false); }
    changed playback-rate => { root.sync-progress(false); }
    // A clock identity survives deferred coalescing of smooth false -> true.
    changed progress-clock => { root.sync-progress(false); }
    function wheel-zoom(delta: length, fraction: float) -> EventResult {
        if root.selection-gesture { return accept; }
        if root.ready && root.duration > 0 && delta != 0px {
            // Pixel deltas support both mouse detents and precision touchpads.
            root.zoom-at(Math.pow(2, clamp(delta / 120px, -2, 2)), clamp(fraction, 0, 1));
            return accept;
        }
        return reject;
    }
    height: root.compact ? 216px * Theme.ui-scale : 248px * Theme.ui-scale; background: Theme.player; border-width: 1px; border-color: Theme.player-border; border-radius: 7px * Theme.ui-scale;
    VerticalLayout { padding: 9px * Theme.ui-scale; spacing: 5px * Theme.ui-scale;
        HorizontalLayout { height: 32px * Theme.ui-scale; spacing: 6px * Theme.ui-scale;
            Rectangle {
                width: 141px * Theme.ui-scale; height: 32px * Theme.ui-scale;
                background: Theme.trough; border-width: 1px; border-color: Theme.player-border; border-radius: 7px * Theme.ui-scale;
                HorizontalLayout { padding: 2px * Theme.ui-scale; spacing: 3px * Theme.ui-scale;
                    ClassicTool {
                        height: 28px * Theme.ui-scale; icon: @image-url("icons/start.svg");
                        label: root.chinese ? "回到开头" : "Go to start"; tip-align: -1;
                        enabled: root.transport-ready && !root.at-start;
                        hint: !root.transport-ready ? root.unavailable : (root.at-start ? (root.chinese ? "已在开头" : "Already at the beginning") : (root.chinese ? "回到声音开头" : "Return to the beginning"));
                        clicked => { root.seek(0); }
                    }
                    ClassicTool {
                        height: 28px * Theme.ui-scale; icon: @image-url("icons/play.svg");
                        label: root.chinese ? "播放" : "Play"; tip-align: -1; checkable: true;
                        active: root.transport-ready && root.state == 3;
                        enabled: root.transport-ready && root.state != 3;
                        hint: !root.transport-ready ? root.unavailable
                            : root.state == 6 ? (root.chinese ? "从头重播" : "Replay from beginning")
                            : root.state == 4 ? (root.chinese ? "继续播放" : "Resume playback")
                            : root.state == 3 ? (root.chinese ? "正在播放" : "Already playing")
                            : (root.chinese ? "开始播放" : "Start playback");
                        clicked => { root.play(); }
                    }
                    ClassicTool {
                        height: 28px * Theme.ui-scale; icon: @image-url("icons/pause.svg");
                        label: root.chinese ? "暂停" : "Pause"; tip-align: -1; checkable: true;
                        active: root.transport-ready && root.state == 4;
                        enabled: root.transport-ready && root.state == 3;
                        hint: !root.transport-ready ? root.unavailable
                            : root.state == 4 ? (root.chinese ? "已暂停，点击播放继续" : "Paused; press Play to resume")
                            : root.state == 6 ? (root.chinese ? "播放完毕，点击播放重播" : "Playback ended; press Play to replay")
                            : root.state == 3 ? (root.chinese ? "在当前位置暂停" : "Pause at the current position")
                            : (root.chinese ? "当前未播放" : "Not playing");
                        clicked => { root.pause(); }
                    }
                    ClassicTool {
                        height: 28px * Theme.ui-scale; icon: @image-url("icons/stop.svg");
                        label: root.chinese ? "停止" : "Stop"; tip-align: -1; checkable: true;
                        active: root.transport-ready && root.state == 5;
                        enabled: root.transport-ready && (root.state == 3 || root.state == 4 || !root.at-start);
                        hint: !root.transport-ready ? root.unavailable
                            : root.state == 5 && root.at-start ? (root.chinese ? "已停止并回到开头" : "Stopped at the beginning")
                            : (root.chinese ? "停止并回到开头" : "Stop and return to the beginning");
                        clicked => { root.stop(); }
                    }
                }
            }
            ClassicTool {
                icon: @image-url("icons/repeat.svg"); label: root.chinese ? "循环整个声音" : "Repeat sound";
                active: root.repeat; checkable: true;
                hint: root.repeat ? (root.chinese ? "循环已开启，点击关闭" : "Repeat is on; click to turn off") : (root.chinese ? "循环已关闭，点击开启" : "Repeat is off; click to turn on");
                clicked => { root.repeat = !root.repeat; root.transform(root.pitch-text, root.rate-text, root.mono, root.repeat); }
            }
            Rectangle { width: 1px; background: Theme.player-border; }
            Caption { text: root.chinese ? "音高" : "Pitch"; }
            LineEdit { width: 62px * Theme.ui-scale; text <=> root.pitch-text; enabled: root.ready; input-label: root.chinese ? "变调半音，回车或离开时应用" : "Pitch semitones, applied on Enter or focus loss"; changed has-focus => { if !self.has-focus && root.ready { root.transform(self.text, root.rate-text, root.mono, root.repeat); } } accepted => { root.transform(self.text, root.rate-text, root.mono, root.repeat); } }
            Caption { text: root.chinese ? "半音" : "st"; }
            Caption { text: root.chinese ? "速度" : "Rate"; }
            LineEdit { width: 57px * Theme.ui-scale; text <=> root.rate-text; enabled: root.ready; input-label: root.chinese ? "保持音高的播放速度，回车或离开时应用" : "Pitch-preserving speed, applied on Enter or focus loss"; changed has-focus => { if !self.has-focus && root.ready { root.transform(root.pitch-text, self.text, root.mono, root.repeat); } } accepted => { root.transform(root.pitch-text, self.text, root.mono, root.repeat); } }
            Caption { text: "×"; }
            ClassicTool { icon: @image-url("icons/reset.svg"); label: root.chinese ? "重置变调与速度" : "Reset Pitch / Rate"; hint: root.chinese ? "恢复 0 半音与 1× 速度" : "Restore 0 semitones and 1× speed"; clicked => { root.pitch-text = "0.00"; root.rate-text = "1.00"; root.transform(root.pitch-text, root.rate-text, root.mono, root.repeat); } }
            Rectangle { width: 1px; background: Theme.player-border; }
            Caption { text: root.chinese ? "音量" : "Volume"; }
            volume-control := Slider { input-label: root.chinese ? "音量" : "Volume"; min-width: 76px * Theme.ui-scale; max-width: 160px * Theme.ui-scale; horizontal-stretch: 1; minimum: -60; maximum: 0; step: 0.1; value <=> root.volume-db; changed => { root.volume(self.value); } }
            Caption { width: 66px * Theme.ui-scale; text: root.volume-label; horizontal-alignment: right; }
            ClassicTool { width: 54px * Theme.ui-scale; symbol: root.chinese ? "单声道" : "Mono"; label: root.chinese ? "单声道监听" : "Mono monitoring"; active: root.mono; checkable: true; hint: root.mono ? (root.chinese ? "单声道监听已开启，点击关闭" : "Mono monitoring is on; click to turn off") : (root.chinese ? "单声道监听已关闭，点击开启" : "Mono monitoring is off; click to turn on"); clicked => { root.mono = !root.mono; root.transform(root.pitch-text, root.rate-text, root.mono, root.repeat); } }
            Caption { horizontal-stretch: 1; min-width: 0px; text: root.output; overflow: elide; horizontal-alignment: right; font-size: Theme.font(9); }
            ClassicTool { icon: @image-url("icons/peaks.svg"); label: root.chinese ? "波形显示设置" : "Peak display settings"; tip-align: 1; clicked => { root.peaks(); } }
            ClassicTool { icon: @image-url("icons/settings.svg"); label: root.chinese ? "音频输出" : "Audio output"; tip-align: 1; clicked => { root.output-settings(); } }
        }
        wave-frame := Rectangle { horizontal-stretch: 1; vertical-stretch: 1; min-height: (root.compact ? 45px : 70px) * Theme.ui-scale + 26px * Theme.ui-scale;
            wave := Rectangle { x: 0px; y: 0px; width: parent.width; height: max(1px, parent.height - scrub.feedback-height); background: root.spectral ? Theme.spectral-canvas : Theme.normal-canvas; border-color: Theme.player-border; border-width: 1px; clip: true;
                accessible-role: groupbox; accessible-label: root.chinese ? "波形时间轴" : "Waveform timeline";
                property <float> played-fraction: root.duration > 0 ? clamp((root.visual-position - root.shown-start) / max(0.001, root.shown-end - root.shown-start), 0, 1) : 0;
                changed width => { root.resize(self.width / 1px, self.height / 1px); }
                changed height => { root.resize(self.width / 1px, self.height / 1px); }
                Image {
                    source: root.waveform; height: parent.height; image-fit: fill;
                    x: (root.view-start - root.shown-start) / root.shown-span * parent.width;
                    width: max(0px, (root.view-end - root.view-start) / root.shown-span * parent.width);
                }
                if !root.waveform-ready: Text { text: root.busy || root.missing || root.state == 1 || root.state == 7 ? root.unavailable : root.ready ? (root.spectral ? (root.chinese ? "正在分析频谱峰值…" : "Analyzing spectral peaks…") : (root.chinese ? "正在分析波形…" : "Analyzing waveform…")) : (root.play-on-single-click ? (root.chinese ? "单击声音即可试听" : "Click a sound to audition") : (root.chinese ? "选择声音查看波形 · 双击试听" : "Select a sound to view its waveform · Double-click to audition")); color: root.spectral ? #263238 : Theme.dim; horizontal-alignment: center; vertical-alignment: center; font-size: Theme.font(11); }
                // These overlays are paint-only, leaving click/scroll ownership to scrub.
                if root.ready && root.duration > 0: PlayedRegion {
                    x: 0px; y: 0px; width: parent.width; height: parent.height;
                    fraction: wave.played-fraction; position: root.position; duration: root.duration; chinese: root.chinese;
                    tint: root.spectral ? #183c3428 : #8faea622;
                }
                if root.ready && root.duration > 0 && root.visual-position >= root.shown-start && root.visual-position <= root.shown-end: Rectangle {
                    x: wave.played-fraction * (parent.width - 1px); width: 1px;
                    background: root.spectral ? #f4faf7 : Theme.accent-hover;
                }
                if scrub.hovered && root.ready && root.selection-identity == "": Rectangle { x: scrub.pointer-x; width: 1px; background: #ffffff30; }
                // Preserve current keyboard transport without changing the classic layout.

            }
            wave-keys := FocusScope {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                focus-on-tab-navigation: root.ready || (root.waveform-ready && root.selection-identity != "" && !root.busy); focus-on-click: false;
                key-pressed(event) => {
                    if !root.ready { return reject; }
                    if event.text == Key.Escape { if root.selection-gesture { root.selection-cancel-requested(); } else if root.selection-preparing { root.selection-cancel-requested(); } else { root.selection-cleared(); } return accept; }
                    if root.selection-gesture { return accept; }
                    if event.text == " " { if root.playing { root.pause(); } else { root.play(); } return accept; }
                    if event.text == Key.LeftArrow || event.text == Key.RightArrow {
                        let nudge = (event.modifiers.shift ? 0.25 : 0.05) * (root.shown-end - root.shown-start);
                        root.seek(clamp(root.visual-position + (event.text == Key.LeftArrow ? -nudge : nudge), 0, root.duration));
                        return accept;
                    }
                    if event.text == Key.Home { root.seek(0); return accept; }
                    if event.text == "+" || event.text == "=" { root.zoom-change(2); return accept; }
                    if event.text == "-" && root.zoom > 1 { root.zoom-change(0.5); return accept; }
                    if event.text == "0" { root.zoom-change(0); return accept; }
                    reject
                }
                scrub := WaveSelectionOverlay {
                        width: parent.width; height: parent.height;
                        enabled: root.waveform-ready && root.selection-identity != "" && !root.busy;
                        seek-enabled: root.ready && !root.busy && !root.missing;
                        seek-clock: root.progress-clock;
                        chinese: root.chinese; duration: root.duration;
                        view-start: root.shown-start; view-end: root.shown-end;
                        selection-active: root.selection-active; selection-start: root.selection-start; selection-end: root.selection-end;
                        identity: root.selection-identity; preparing: root.selection-preparing; progress-text: root.selection-progress;
                        export-state: root.selection-export-state; native-cursor: root.selection-native-cursor;
                        shift-held: root.selection-shift-held; cancel-revision: root.selection-cancel-revision;
                        committed(start, end) => { root.selection-committed(start, end); }
                        cleared => { root.selection-cleared(); }
                        drag-requested => { root.selection-drag-requested(); }
                        drag-ended => { root.selection-drag-ended(); }
                        cancel-requested => { root.selection-cancel-requested(); }
                        seek-play(time) => { root.seek-play(time); }
                        zoom-at(factor, fraction) => { root.zoom-at(factor, fraction); }
                        cursor-changed(value) => { root.selection-cursor-changed(value); }
                        pointer-feedback-changed => { root.selection-pointer-feedback-changed(); }
                    }
            }
        }
        Rectangle { height: 24px * Theme.ui-scale; accessible-role: groupbox; accessible-label: root.chinese ? "波形时间尺" : "Waveform time ruler";
            for tick in 51: Rectangle { x: tick * (parent.width - 1px) / 50; width: 1px; height: Math.mod(tick,5) == 0 ? 9px * Theme.ui-scale : 4px * Theme.ui-scale; background: Theme.muted; }
            for index in 11: Text { x: clamp(index * (parent.width - 1px)/10,0px,parent.width - self.width); y: 10px * Theme.ui-scale; width: 55px * Theme.ui-scale; height: 13px * Theme.ui-scale; text: root.ruler-label(index); color: Theme.dim; font-size: Theme.font(9); horizontal-alignment: index == 10 ? right : left; }
            TouchArea { enabled: root.ready; mouse-cursor: pointer;
                clicked => { root.seek-play(root.shown-start + clamp(self.mouse-x/self.width,0,1)*(root.shown-end - root.shown-start)); }
                scroll-event(event) => { return root.wheel-zoom(event.delta-y, self.mouse-x / max(1px,self.width)); }
            }
        }
        HorizontalLayout { height: 16px * Theme.ui-scale; spacing: 7px * Theme.ui-scale;
            Caption { width: 42px * Theme.ui-scale; text: Math.round(root.zoom * 10) / 10 + "×"; font-size: Theme.font(10); }
            if root.ready: Caption { text: root.chinese ? "滚轮缩放" : "Scroll to zoom"; font-size: Theme.font(9); }
            Slider { input-label: root.chinese ? "波形可视范围" : "Visible waveform range"; horizontal-stretch: 1; minimum: 0; maximum: 1; step: 0.005; enabled: root.ready && root.zoom > 1; value <=> root.scroll; changed => { root.pan(self.value); } }
            ClassicTool { width: 24px * Theme.ui-scale; height: 18px * Theme.ui-scale; symbol: "−"; label: root.chinese ? "缩小波形" : "Zoom out"; enabled: root.ready && root.zoom > 1; clicked => { root.zoom-change(0.5); } }
            ClassicTool { width: 24px * Theme.ui-scale; height: 18px * Theme.ui-scale; symbol: "+"; label: root.chinese ? "放大波形" : "Zoom in"; enabled: root.ready && root.zoom < 128; clicked => { root.zoom-change(2); } }
            ClassicTool { width: 38px * Theme.ui-scale; height: 18px * Theme.ui-scale; icon: @image-url("icons/fit.svg"); label: root.chinese ? "显示完整声音" : "Fit entire sound"; enabled: root.ready; clicked => { root.zoom-change(0); } }
        }
        HorizontalLayout { height: 25px * Theme.ui-scale; spacing: 12px * Theme.ui-scale;
            Text { accessible-role: text; accessible-label: root.chinese ? "试听时间" : "Audition time"; width: 208px * Theme.ui-scale; text: root.time + "  /  " + root.end-time; color: Theme.ink; font-family: "Consolas"; font-size: Theme.font(14); vertical-alignment: center; }
            Rectangle { width: 1px; background: Theme.player-border; }
            if root.state != 0 || root.missing || root.busy: Rectangle {
                width: phase.preferred-width + 14px * Theme.ui-scale; height: 20px * Theme.ui-scale;
                background: Theme.raised; border-radius: 4px * Theme.ui-scale;
                accessible-role: text; accessible-label: root.chinese ? "播放状态" : "Playback status"; accessible-description: root.state-label;
                phase := Text { text: root.state-label; color: root.state == 7 || root.missing ? Theme.danger : (root.state == 3 ? Theme.accent-hover : Theme.dim); font-size: Theme.font(10); horizontal-alignment: center; vertical-alignment: center; }
            }
            Text { horizontal-stretch: 1; min-width: 0px; text: root.name == "" ? (root.chinese ? "未加载声音" : "No sound loaded") : root.name; overflow: elide; color: Theme.ink; font-size: Theme.font(11); vertical-alignment: center; }
            Caption { text: root.info; font-size: Theme.font(10); }
        }
    }
}

// Stable audition contract. Only the selected presentation is instantiated;
// shared control values survive a theme switch and the renderer stays external.
// Studio compact dock, imported from PR185 without its default-theme overwrite.
component WorkbenchAuditionPanel inherits Rectangle {
    in property <bool> compact: false;
    in property <bool> narrow: false;
    in property <bool> spectral: true;
    in property <bool> chinese;
    in property <bool> selection-active;
    in property <float> selection-start;
    in property <float> selection-end;
    in property <string> selection-identity;
    in property <bool> selection-preparing;
    in property <int> selection-export-state;
    in property <bool> selection-native-cursor: false;
    in property <string> selection-progress;
    in property <bool> selection-shift-held;
    in property <int> selection-cancel-revision;
    callback selection-committed(float,float);
    callback selection-cleared();
    callback selection-drag-requested();
    callback selection-drag-ended();
    callback selection-cancel-requested();
    callback selection-cursor-changed(MouseCursor);
    callback selection-pointer-feedback-changed();
    out property <bool> selection-gesture: scrub.gesture;
    out property <MouseCursor> selection-cursor: scrub.cursor;
    out property <int> selection-pointer-kind: scrub.pointer-kind;
    out property <image> selection-pointer-image: scrub.pointer-image;
    out property <float> selection-pointer-hotspot-x: scrub.pointer-hotspot-x;
    out property <float> selection-pointer-hotspot-y: scrub.pointer-hotspot-y;
    out property <float> selection-pointer-scale: scrub.pointer-scale;

    in property <bool> play-on-single-click: false;
    in property <bool> ready;
    // Why the transport may be unavailable: a missing source or library maintenance.
    in property <bool> missing: false;
    in property <bool> busy: false;
    // Engine transport phase: 0 empty, 1 loading, 2 ready, 3 playing, 4 paused,
    // 5 stopped, 6 ended, 7 error.
    in property <int> state: 0;
    in property <string> error-text;
    // A network stream has run dry for a moment while playing.
    in property <bool> buffering: false;
    in property <bool> playing;
    in property <bool> smooth-progress: false;
    in property <string> progress-clock;
    in property <float> playback-rate: 1;
    in property <image> waveform;
    in property <bool> waveform-ready;
    // Share of the current Waveform render that has arrived (1 when complete).
    in property <float> waveform-progress: 1;
    in property <string> name;
    in property <string> info;
    // Full engine output summary (tooltip of the output status).
    in property <string> output;
    // Active backend ("" while idle) and device rate for the output status.
    in property <string> output-backend;
    in property <string> output-rate;
    in property <int> output-xruns;
    in property <float> position;
    in property <float> duration;
    in property <string> time;
    in property <string> end-time;
    // Source range of the displayed Waveform image.
    in property <float> view-start;
    in property <float> view-end;
    // Requested range while its render is pending; equals view-* once the image lands.
    // An empty range (end <= start) means no request is pending.
    in property <float> target-start;
    in property <float> target-end;
    in property <float> zoom: 1;
    in property <[RulerTick]> ruler-ticks;
    in property <bool> relink-enabled: true;
    in-out property <float> scroll: 0;
    in-out property <float> volume-db: -1.9;
    out property <bool> volume-adjusting: volume-control.has-focus;
    callback volume-focus-changed(bool);
    changed volume-adjusting => { root.volume-focus-changed(root.volume-adjusting); }
    in property <string> volume-label;
    in-out property <string> pitch-text: "0.00";
    in-out property <string> rate-text: "1.00";
    in-out property <bool> mono: false;
    in-out property <bool> repeat: false;
    callback play(); callback pause(); callback stop(); callback seek(float); callback seek-play(float);
    callback transform(string,string,bool,bool); callback volume(float);
    callback resize(int,int); callback zoom-change(float); callback zoom-at(float,float); callback pan(float);
    callback peaks(); callback output-settings();
    callback retry(); callback relink();
    /// The controller rejected typed transform input: bit 1 Pitch, bit 2 Rate.
    public function reject-input(fields: int) {
        if Math.mod(fields, 2) == 1 { pitch-field.refuse(); }
        if fields >= 2 { rate-field.refuse(); }
    }
    in property <int> rejection-fields;
    in property <int> rejection-revision;
    changed rejection-revision => { root.reject-input(root.rejection-fields); }
    // The frame clock fills gaps between engine snapshots, with bounded prediction.
    // Repeated positions do not restart the clock; stalled output stops after 100ms.
    property <float> anchor-position: 0;
    property <duration> anchor-tick: 0ms;
    property <float> correction: 0;
    property <duration> progress-elapsed: root.ready && root.playing && root.smooth-progress ? clamp(animation-tick() - root.anchor-tick, 0ms, 100ms) : 0ms;
    property <float> visual-position: clamp(root.anchor-position + root.progress-elapsed / 1s * root.playback-rate + root.correction * (1 - root.progress-elapsed / 100ms), 0,
        root.selection-active && root.selection-end > root.selection-start && root.position >= root.selection-start && root.position <= root.selection-end ? min(root.duration, root.selection-end) : root.duration);
    function sync-progress(allow-correction: bool) {
        let previous = root.visual-position;
        let continuous = allow-correction && root.ready && root.playing && root.smooth-progress && abs(previous - root.position) < 0.1 * root.playback-rate;
        root.anchor-position = root.position;
        root.anchor-tick = animation-tick();
        root.correction = continuous ? previous - root.position : 0;
    }
    init => { root.sync-progress(false); }
    changed position => { root.sync-progress(true); }
    changed playing => { root.sync-progress(false); }
    changed smooth-progress => { root.sync-progress(false); }
    changed playback-rate => { root.sync-progress(false); }
    // Transport revisions reset animation; only selection-identity cancels a
    // range gesture, so an automatic preview cannot invalidate its own range.
    changed progress-clock => { root.sync-progress(false); }
    function wheel-zoom(delta: length, fraction: float) -> EventResult {
        if root.selection-gesture { return accept; }
        if root.ready && root.duration > 0 && delta != 0px {
            // Pixel deltas support both mouse detents and precision touchpads.
            root.zoom-at(Math.pow(2, clamp(delta / 120px, -2, 2)), clamp(fraction, 0, 1));
            return accept;
        }
        return reject;
    }
    function toggle() { if root.playing { root.pause(); } else { root.play(); } }
    // Layout width of the gradient bands: kept while it covers the playhead with a
    // little room and is not much wider (after a seek back or zoom); otherwise the
    // next 1/16 step above the playhead, capped at the timeline width.
    pure function band-span(head: length, width: length, current: length) -> length {
        let limit = max(32px, width);
        if head + 2px <= current && head * 1.13 >= current && current <= limit { return current; }
        return min(limit, 32px * Math.pow(1.0625, Math.ceil(Math.log(max(32px, head + 6px) / 32px, 1.0625))));
    }

    // The range the timeline draws: a pending request wins over the last image.
    property <bool> has-target: root.target-end > root.target-start;
    property <float> shown-start: scrub.gesture ? scrub.captured-start : (root.has-target ? root.target-start : root.view-start);
    property <float> shown-end: scrub.gesture ? scrub.captured-end : (root.has-target ? root.target-end : root.view-end);
    property <float> shown-span: max(0.001, root.shown-end - root.shown-start);
    function time-at(fraction: float) -> float { return root.shown-start + clamp(fraction, 0, 1) * (root.shown-end - root.shown-start); }
    function seek-to(fraction: float) { root.seek-play(root.time-at(fraction)); }

    // What the timeline shows: 0 nothing loaded, 1 loading / analysing, 2 Waveform,
    // 3 load error, 4 missing source, 5 library maintenance.
    property <int> phase: root.busy ? 5 : (root.missing ? 4 : (root.state == 7 ? 3 : ((root.state == 1 || (root.ready && !root.waveform-ready)) ? 1 : (root.waveform-ready ? 2 : 0))));
    // Why transport buttons are disabled, for their tooltips.
    property <string> unavailable: root.busy ? (root.chinese ? "音效库维护中" : "Library maintenance in progress")
        : root.missing ? (root.chinese ? "文件缺失" : "File missing")
        : root.state == 7 ? (root.chinese ? "加载失败" : "Load failed")
        : root.state == 1 ? (root.chinese ? "正在加载" : "Loading")
        : (root.chinese ? "未加载声音" : "No sound loaded");
    property <string> transport-hint: root.ready ? "" : root.unavailable;

    // Pointer scrubbing: the playhead preview follows the drag; release seeks.
    property <bool> scrubbing: scrub.gesture;
    property <length> scrub-x: scrub.pointer-x;

    in-out property <float> premute-db: -12;
    property <bool> muted: root.volume-db <= -59.95;
    function toggle-mute() {
        if root.muted {
            let restore = root.premute-db > -59.95 ? root.premute-db : -12;
            root.volume-db = restore;
            root.volume(restore);
        } else {
            root.premute-db = root.volume-db;
            root.volume-db = -60;
            root.volume(-60);
        }
    }

    in-out property <bool> show-remaining: false;
    property <bool> zoom-pulse: false;
    changed zoom => { root.zoom-pulse = true; }
    Timer { interval: 220ms; running: root.zoom-pulse; triggered => { root.zoom-pulse = false; } }
    property <bool> name-fresh: false;
    changed name => { root.name-fresh = true; }
    Timer { interval: 40ms; running: root.name-fresh; triggered => { root.name-fresh = false; } }

    // A compact horizontal dock gives the central result list the remaining height.
    in-out property <bool> expanded: false;
    in property <image> waveform-mask;
    callback expanded-requested(bool);
    private property <bool> show-spectral: root.expanded && root.spectral;
    height: 114px * Theme.ui-scale;
    background: Theme.player-surface;
    Image { x: 0px; y: 0px; width: parent.width; height: parent.height; source: Theme.player-backdrop; image-fit: fill; accessible-role: none; }
    Rectangle { x: 0px; y: 0px; height: 1px; background: Theme.player-border; }
    private property <float> font-factor: max(1, Theme.ui-font-px / 13.0);
    GridLayout { padding-left: 12px * Theme.ui-scale; padding-right: 10px * Theme.ui-scale; padding-top: 6px * Theme.ui-scale; padding-bottom: 6px * Theme.ui-scale; spacing: 10px * Theme.ui-scale;
        VerticalLayout { row: 0; col: 0; width: 180px * Theme.ui-scale; alignment: center;
            HorizontalLayout { spacing: 8px * Theme.ui-scale; alignment: start;
                PlayToggle {
                    width: 48px * Theme.ui-scale; height: 48px * Theme.ui-scale; radius: 6px * Theme.ui-scale; glyph: 22px * Theme.ui-scale; backdrop: true; tip-align: -1;
                    playing: root.playing; enabled: root.ready;
                    label: root.playing ? (root.chinese ? "暂停" : "Pause") : (root.chinese ? "播放" : "Play");
                    hint: root.ready ? (root.chinese ? "空格" : "Space") : root.unavailable;
                    clicked => { root.toggle(); }
                }
                Tool { width: 32px * Theme.ui-scale; height: 32px * Theme.ui-scale; y: (parent.height - self.height) / 2; subtle: true; icon: @image-url("icons/start.svg"); label: root.chinese ? "回到开头" : "Go to start"; hint: root.transport-hint; enabled: root.ready; clicked => { root.seek(0); } }
                Tool { width: 32px * Theme.ui-scale; height: 32px * Theme.ui-scale; y: (parent.height - self.height) / 2; subtle: true; icon: @image-url("icons/stop.svg"); label: root.chinese ? "停止" : "Stop"; hint: root.transport-hint; enabled: root.ready; clicked => { root.stop(); } }
                Tool { width: 32px * Theme.ui-scale; height: 32px * Theme.ui-scale; y: (parent.height - self.height) / 2; subtle: true; icon: @image-url("icons/repeat.svg"); label: root.chinese ? "循环整个声音" : "Repeat sound"; hint: root.repeat ? (root.chinese ? "已开启" : "On") : ""; active: root.repeat; clicked => { root.repeat = !root.repeat; root.transform(root.pitch-text, root.rate-text, root.mono, root.repeat); } }
            }
        }
        VerticalLayout { row: 0; col: 1; width: (root.narrow ? 192px : 240px) * Theme.ui-scale * root.font-factor; alignment: center; spacing: 2px * Theme.ui-scale;
            Rectangle {
                height: max(20px * Theme.ui-scale, Theme.font(14)); min-width: 0px; horizontal-stretch: 1;
                name-text := Text {
                    x: 0px; width: max(0px, parent.width - status-badge.width - (status-badge.badge != "" ? 8px * Theme.ui-scale : 0px)); height: parent.height;
                    text: root.name == "" ? (root.chinese ? "未加载声音" : "No sound loaded") : root.name;
                    overflow: elide; color: Theme.ink; font-size: Theme.font(12); horizontal-alignment: left; vertical-alignment: center;
                    states [
                    fresh when root.name-fresh: {
                        opacity: 0;
                        in { animate opacity { duration: 0ms; } }
                        out { animate opacity { duration: Theme.motion-slow; easing: ease-out; } }
                    }
                    ]
