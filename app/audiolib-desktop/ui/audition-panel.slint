            HorizontalLayout { width: parent.width; height: 24px * Theme.ui-scale; y: min(parent.height - self.height, transform-controls.y + transform-controls.height + 2px * Theme.ui-scale); spacing: 3px * Theme.ui-scale;
                OutputPill {
                    compact: true;
                    chinese: root.chinese; backend: root.output-backend; rate: root.output-rate; xruns: root.output-xruns;
                    failed: root.state == 7; details: root.output;
                    clicked => { root.output-settings(); }
                }
                Caption { text: root.volume-label; font-size: Theme.font(9); }
                Rectangle { horizontal-stretch: 1; }
                Tool { width: 24px * Theme.ui-scale; height: 24px * Theme.ui-scale; subtle: true; icon-size: 16px * Theme.ui-scale; icon: @image-url("icons/reset.svg"); label: root.chinese ? "重置变调与速度" : "Reset Pitch / Rate"; enabled: pitch-field.modified || rate-field.modified; clicked => { root.pitch-text = "0.00"; root.rate-text = "1.00"; root.transform(root.pitch-text, root.rate-text, root.mono, root.repeat); } }
                Tool { width: 44px * Theme.ui-scale * root.font-factor; height: 24px * Theme.ui-scale; subtle: true; symbol: root.chinese ? "单声道" : "Mono"; symbol-size: Theme.font(10); label: root.chinese ? "单声道监听" : "Mono monitoring"; hint: root.mono ? (root.chinese ? "已开启" : "On") : ""; active: root.mono; clicked => { root.mono = !root.mono; root.transform(root.pitch-text, root.rate-text, root.mono, root.repeat); } }
                Rectangle { width: 1px; height: 14px * Theme.ui-scale; y: (parent.height - self.height) / 2; background: Theme.border; }
                Tool { width: 22px * Theme.ui-scale; height: 24px * Theme.ui-scale; subtle: true; symbol: "−"; symbol-size: Theme.font(14); label: root.chinese ? "缩小波形" : "Zoom out"; enabled: root.ready && root.zoom > 1; clicked => { root.zoom-change(0.5); } }
                Tool { width: 22px * Theme.ui-scale; height: 24px * Theme.ui-scale; subtle: true; symbol: "+"; symbol-size: Theme.font(14); label: root.chinese ? "放大波形" : "Zoom in"; enabled: root.ready && root.zoom < 128; clicked => { root.zoom-change(2); } }
                Tool { width: 24px * Theme.ui-scale; height: 24px * Theme.ui-scale; subtle: true; icon: @image-url("icons/fit.svg"); icon-size: 16px * Theme.ui-scale; label: root.chinese ? "显示完整声音" : "Fit entire sound"; enabled: root.ready; clicked => { root.zoom-change(0); } }
                Rectangle { width: 1px; height: 14px * Theme.ui-scale; y: (parent.height - self.height) / 2; background: Theme.border; }
                Tool { width: 24px * Theme.ui-scale; height: 24px * Theme.ui-scale; subtle: true; icon-size: 17px * Theme.ui-scale; icon: @image-url("icons/peaks.svg"); label: root.chinese ? "波形显示设置" : "Peak display settings"; tip-align: 1; clicked => { root.peaks(); } }
                Tool { width: 24px * Theme.ui-scale; height: 24px * Theme.ui-scale; subtle: true; icon-size: 17px * Theme.ui-scale; icon: root.expanded ? @image-url("icons/chevron-down.svg") : @image-url("icons/chevron-up.svg"); label: root.expanded ? (root.chinese ? "收起试听波形" : "Compact audition waveform") : (root.chinese ? "展开试听波形" : "Expand audition waveform"); tip-align: 1; active: root.expanded; clicked => { root.expanded-requested(!root.expanded); } }
            }
        }
        VerticalLayout { row: 0; col: 2; horizontal-stretch: 1; min-width: 220px * Theme.ui-scale; spacing: 0px;
            wave-frame := Rectangle { horizontal-stretch: 1; vertical-stretch: 1; min-height: (root.zoom > 1 ? 44px : 54px) * Theme.ui-scale + 26px * Theme.ui-scale;
                wave := Rectangle { x: 0px; y: 0px; width: parent.width; height: max(1px, parent.height - scrub.feedback-height); background: root.show-spectral && root.waveform-ready ? Theme.spectral-canvas : Theme.normal-canvas;
                    border-color: wave-keys.has-focus ? Theme.accent : (root.show-spectral ? Theme.player-border : transparent); border-width: 1px; clip: true;
                    animate border-color { duration: Theme.motion-fast; }
