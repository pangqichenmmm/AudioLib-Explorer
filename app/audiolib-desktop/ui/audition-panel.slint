                for tick in root.ruler-ticks: Rectangle {
                    x: clamp(tick.fraction * (ruler.width - 1px), 0px, ruler.width - 1px); width: 1px;
                    Rectangle { y: 0px; width: 1px; height: tick.major ? 9px * Theme.ui-scale : 4px * Theme.ui-scale; background: tick.major ? Theme.muted : Theme.muted.with-alpha(0.55); }
                    // Labels sit right of their tick so the line never crosses a digit.
                    if tick.label != "": Text {
                        x: min(3px * Theme.ui-scale, ruler.width - parent.x - self.width); y: 7px * Theme.ui-scale; height: 13px * Theme.ui-scale;
                        text: tick.label; color: Theme.dim; font-size: Theme.font(9);
                    }
                }
                ruler-touch := TouchArea { enabled: root.ready; mouse-cursor: pointer;
                    clicked => { root.seek-to(self.mouse-x / max(1px, self.width)); }
                    scroll-event(event) => { return root.wheel-zoom(event.delta-y, self.mouse-x / max(1px,self.width)); }
                }
            }
            HorizontalLayout { visible: root.zoom > 1; height: root.zoom > 1 ? 10px * Theme.ui-scale : 0px; spacing: 7px * Theme.ui-scale;
                Text {
                    width: 42px * Theme.ui-scale; vertical-alignment: center; font-size: Theme.font(9);
                    text: Math.round(root.zoom * 10) / 10 + "×"; color: root.zoom-pulse ? Theme.accent-hover : Theme.dim;
                    animate color { duration: Theme.motion-slow; easing: ease-out; }
                }
                Rectangle { horizontal-stretch: 1;
                    OverviewBar {
                        width: parent.width; height: parent.height;
                        chinese: root.chinese; zoom: root.zoom; enabled: root.ready; scroll <=> root.scroll;
                        pan(value) => { root.pan(value); }
                    }
                }
            }
        }
    }
}

export component AuditionPanel inherits Rectangle {
    // Inactive facades keep their shared bindings without creating input owners.
    in property <bool> active: true;
    in property <bool> compact: false;
    in property <bool> narrow: false;
    in property <image> waveform-mask;
    in-out property <bool> expanded: false;
    callback expanded-requested(bool);
    in property <bool> spectral: true;
    in property <bool> chinese;
    in property <bool> selection-active;
    in property <float> selection-start;
    in property <float> selection-end;
    in property <string> selection-identity;
    in property <bool> selection-preparing;
    in property <int> selection-export-state;
    in property <bool> selection-native-cursor: false;
    in property <string> selection-progress;
    in property <bool> selection-shift-held;
    callback selection-committed(float,float);
    callback selection-cleared();
    callback selection-drag-requested();
    callback selection-drag-ended();
    callback selection-cancel-requested();
    out property <bool> selection-gesture: root.presenter-selection-gesture;
    out property <MouseCursor> selection-cursor: root.presenter-selection-cursor;
    callback selection-pointer-feedback-changed();
    out property <int> selection-pointer-kind: root.presenter-pointer-kind;
    out property <image> selection-pointer-image: root.presenter-pointer-image;
    out property <float> selection-pointer-hotspot-x: root.presenter-pointer-hotspot-x;
    out property <float> selection-pointer-hotspot-y: root.presenter-pointer-hotspot-y;
    out property <float> selection-pointer-scale: root.presenter-pointer-scale;
    property <int> presenter-pointer-kind: 0;
    property <image> presenter-pointer-image;
    property <image> empty-pointer-image;
    property <float> presenter-pointer-hotspot-x: 10;
    property <float> presenter-pointer-hotspot-y: 10;
    property <float> presenter-pointer-scale: 1;
    function reset-pointer-feedback() {
        root.presenter-pointer-kind = 0; root.presenter-pointer-image = root.empty-pointer-image;
        root.selection-pointer-feedback-changed();
    }
    property <bool> presenter-selection-gesture: false;
    property <MouseCursor> presenter-selection-cursor: default;
    property <int> selection-cancel-revision: 0;
    public function cancel-selection-gesture() {
        // Reflect cancellation immediately to callers; the revision also reaches
        // the current presenter's input owner at the next change boundary.
        root.presenter-selection-gesture = false;
        root.selection-cancel-revision += 1;
    }

    in property <bool> play-on-single-click: false;
    in property <bool> ready;
    // Why the transport may be unavailable: a missing source or library maintenance.
    in property <bool> missing: false;
    in property <bool> busy: false;
    // Engine transport phase: 0 empty, 1 loading, 2 ready, 3 playing, 4 paused,
    // 5 stopped, 6 ended, 7 error.
    in property <int> state: 0;
    in property <string> error-text;
    // A network stream has run dry for a moment while playing.
    in property <bool> buffering: false;
    in property <bool> playing;
    in property <bool> smooth-progress: false;
    in property <string> progress-clock;
    in property <float> playback-rate: 1;
    in property <image> waveform;
    in property <bool> waveform-ready;
    // Share of the current Waveform render that has arrived (1 when complete).
    in property <float> waveform-progress: 1;
    in property <string> name;
    in property <string> info;
    // Full engine output summary (tooltip of the output status).
    in property <string> output;
    // Active backend ("" while idle) and device rate for the output status.
    in property <string> output-backend;
    in property <string> output-rate;
    in property <int> output-xruns;
    in property <float> position;
    in property <float> duration;
    in property <string> time;
    in property <string> end-time;
    // Source range of the displayed Waveform image.
    in property <float> view-start;
    in property <float> view-end;
    // Requested range while its render is pending; equals view-* once the image lands.
    // An empty range (end <= start) means no request is pending.
    in property <float> target-start;
    in property <float> target-end;
    in property <float> zoom: 1;
    in property <[RulerTick]> ruler-ticks;
    in property <bool> relink-enabled: true;
    in-out property <float> scroll: 0;
    in-out property <float> volume-db: -1.9;
    out property <bool> volume-adjusting: root.presenter-volume-adjusting;
    property <bool> presenter-volume-adjusting: false;
    in property <string> volume-label;
    in-out property <string> pitch-text: "0.00";
    in-out property <string> rate-text: "1.00";
    in-out property <bool> mono: false;
    in-out property <bool> repeat: false;
    callback play(); callback pause(); callback stop(); callback seek(float); callback seek-play(float);
    callback transform(string,string,bool,bool); callback volume(float);
    callback resize(int,int); callback zoom-change(float); callback zoom-at(float,float); callback pan(float);
    callback peaks(); callback output-settings();
    callback retry(); callback relink();
    /// The controller rejected typed transform input: bit 1 Pitch, bit 2 Rate.
    public function reject-input(fields: int) {
        root.rejection-fields = fields;
        root.rejection-revision += 1;
    }
    // Rejection revisions deliver events to the current presenter. They are not
    // persistent view state: a newly created Studio must not replay an old event.
    public function clear-input-feedback() {
        root.rejection-fields = 0;
        root.rejection-revision = 0;
    }
    property <int> rejection-fields: 0;
    property <int> rejection-revision: 0;
    // Keep view-only modern state when switching presentations during playback.
    in-out property <float> premute-db: -12;
    in-out property <bool> show-remaining: false;
    property <bool> modern-player: Theme.modern-player;
    changed modern-player => { root.presenter-volume-adjusting = false; root.presenter-selection-gesture = false; root.reset-pointer-feedback(); }
    changed active => { if !root.active { root.presenter-volume-adjusting = false; root.presenter-selection-gesture = false; root.reset-pointer-feedback(); } }
    height: Theme.modern-player ? (root.expanded ? 286px : 114px) * Theme.ui-scale
        : (root.compact ? 216px : 248px) * Theme.ui-scale;
    if root.active && !Theme.modern-player: ClassicAuditionPanel {
        width: parent.width; height: parent.height;
        compact: root.compact;
        spectral: root.spectral;
        chinese: root.chinese;
        selection-active: root.selection-active; selection-start: root.selection-start; selection-end: root.selection-end;
        selection-identity: root.selection-identity; selection-preparing: root.selection-preparing; selection-progress: root.selection-progress;
        selection-export-state: root.selection-export-state; selection-native-cursor: root.selection-native-cursor;
        selection-shift-held: root.selection-shift-held; selection-cancel-revision: root.selection-cancel-revision;
        changed selection-gesture => { root.presenter-selection-gesture = self.selection-gesture; }
        changed selection-cursor => { root.presenter-selection-cursor = self.selection-cursor; }
        selection-cursor-changed(value) => { root.presenter-selection-cursor = value; }
        selection-pointer-feedback-changed => {
            root.presenter-pointer-kind = self.selection-pointer-kind;
            root.presenter-pointer-image = self.selection-pointer-image;
            root.presenter-pointer-hotspot-x = self.selection-pointer-hotspot-x;
            root.presenter-pointer-hotspot-y = self.selection-pointer-hotspot-y;
            root.presenter-pointer-scale = self.selection-pointer-scale;
            root.selection-pointer-feedback-changed();
        }
        selection-committed(start, end) => { root.selection-committed(start, end); }
        selection-cleared => { root.selection-cleared(); }
        selection-drag-requested => { root.selection-drag-requested(); }
        selection-drag-ended => { root.selection-drag-ended(); }
        selection-cancel-requested => { root.cancel-selection-gesture(); root.selection-cancel-requested(); }

        play-on-single-click: root.play-on-single-click;
        ready: root.ready;
        state: root.state; missing: root.missing; busy: root.busy;
        buffering: root.buffering;
        playing: root.playing;
        smooth-progress: root.smooth-progress;
        progress-clock: root.progress-clock;
        playback-rate: root.playback-rate;
        waveform: root.waveform;
        waveform-ready: root.waveform-ready;
        name: root.name;
        info: root.info;
        output: root.output;
        position: root.position;
        duration: root.duration;
        time: root.time;
        end-time: root.end-time;
        view-start: root.view-start;
        view-end: root.view-end;
        target-start: root.target-start; target-end: root.target-end;
        zoom: root.zoom;
        volume-label: root.volume-label;
        scroll <=> root.scroll;
        volume-db <=> root.volume-db;
        pitch-text <=> root.pitch-text;
        rate-text <=> root.rate-text;
        mono <=> root.mono;
        repeat <=> root.repeat;
        volume-focus-changed(adjusting) => { root.presenter-volume-adjusting = adjusting; }
        play => { root.play(); }
        pause => { root.pause(); }
        stop => { root.stop(); }
        seek(value) => { root.seek(value); }
        seek-play(value) => { root.seek-play(value); }
        transform(pitch, rate, mono, repeat) => { root.transform(pitch, rate, mono, repeat); }
        volume(value) => { root.volume(value); }
        resize(width, height) => { root.resize(width, height); }
        zoom-change(value) => { root.zoom-change(value); }
        zoom-at(factor, fraction) => { root.zoom-at(factor, fraction); }
        pan(value) => { root.pan(value); }
        peaks => { root.peaks(); }
        output-settings => { root.output-settings(); }
    }
    if root.active && Theme.modern-player: WorkbenchAuditionPanel {
        width: parent.width; height: parent.height;
        narrow: root.narrow; waveform-mask: root.waveform-mask;
        expanded <=> root.expanded;
        expanded-requested(value) => { root.expanded-requested(value); }
        compact: root.compact;
        spectral: root.spectral;
        chinese: root.chinese;
        selection-active: root.selection-active; selection-start: root.selection-start; selection-end: root.selection-end;
        selection-identity: root.selection-identity; selection-preparing: root.selection-preparing; selection-progress: root.selection-progress;
        selection-export-state: root.selection-export-state; selection-native-cursor: root.selection-native-cursor;
        selection-shift-held: root.selection-shift-held; selection-cancel-revision: root.selection-cancel-revision;
        changed selection-gesture => { root.presenter-selection-gesture = self.selection-gesture; }
        changed selection-cursor => { root.presenter-selection-cursor = self.selection-cursor; }
        selection-cursor-changed(value) => { root.presenter-selection-cursor = value; }
        selection-pointer-feedback-changed => {
            root.presenter-pointer-kind = self.selection-pointer-kind;
            root.presenter-pointer-image = self.selection-pointer-image;
            root.presenter-pointer-hotspot-x = self.selection-pointer-hotspot-x;
            root.presenter-pointer-hotspot-y = self.selection-pointer-hotspot-y;
            root.presenter-pointer-scale = self.selection-pointer-scale;
            root.selection-pointer-feedback-changed();
        }
        selection-committed(start, end) => { root.selection-committed(start, end); }
        selection-cleared => { root.selection-cleared(); }
        selection-drag-requested => { root.selection-drag-requested(); }
        selection-drag-ended => { root.selection-drag-ended(); }
        selection-cancel-requested => { root.cancel-selection-gesture(); root.selection-cancel-requested(); }

        play-on-single-click: root.play-on-single-click;
        ready: root.ready;
        playing: root.playing;
        smooth-progress: root.smooth-progress;
        progress-clock: root.progress-clock;
        playback-rate: root.playback-rate;
        waveform: root.waveform;
        waveform-ready: root.waveform-ready;
        name: root.name;
        info: root.info;
        output: root.output;
        position: root.position;
        duration: root.duration;
        time: root.time;
        end-time: root.end-time;
        view-start: root.view-start;
        view-end: root.view-end;
        zoom: root.zoom;
        volume-label: root.volume-label;
        missing: root.missing;
        busy: root.busy;
        state: root.state;
        error-text: root.error-text;
        buffering: root.buffering;
        waveform-progress: root.waveform-progress;
        output-backend: root.output-backend;
        output-rate: root.output-rate;
        output-xruns: root.output-xruns;
        target-start: root.target-start;
        target-end: root.target-end;
        ruler-ticks: root.ruler-ticks;
        relink-enabled: root.relink-enabled;
        scroll <=> root.scroll;
        volume-db <=> root.volume-db;
        pitch-text <=> root.pitch-text;
        rate-text <=> root.rate-text;
        mono <=> root.mono;
        repeat <=> root.repeat;
        volume-focus-changed(adjusting) => { root.presenter-volume-adjusting = adjusting; }
        premute-db <=> root.premute-db;
        show-remaining <=> root.show-remaining;
        rejection-fields: root.rejection-fields; rejection-revision: root.rejection-revision;
        play => { root.play(); }
        pause => { root.pause(); }
        stop => { root.stop(); }
        seek(value) => { root.seek(value); }
        seek-play(value) => { root.seek-play(value); }
        transform(pitch, rate, mono, repeat) => { root.transform(pitch, rate, mono, repeat); }
        volume(value) => { root.volume(value); }
        resize(width, height) => { root.resize(width, height); }
        zoom-change(value) => { root.zoom-change(value); }
        zoom-at(factor, fraction) => { root.zoom-at(factor, fraction); }
        pan(value) => { root.pan(value); }
        peaks => { root.peaks(); }
        output-settings => { root.output-settings(); }
        retry => { root.retry(); }
        relink => { root.relink(); }
    }
}

export component PeakSettings inherits FocusScope {
    forward-focus: peaks-close;
    focus-on-click: false; focus-on-tab-navigation: false;
    property <bool> reverse-wrap: false;
    property <bool> modern-style: Theme.modern-style;
    function focus-close() {
        if Theme.modern-style { peaks-close-modern.focus(); }
        else { peaks-close-classic.focus(); }
    }
    changed modern-style => { if root.visible && root.enabled { root.focus-close(); } }
    capture-key-pressed(event) => {
        if event.text == Key.Escape { root.close(); return accept; }
        if (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) && (peaks-close-classic.has-focus || peaks-close-modern.has-focus) {
            root.reverse-wrap = true; peaks-tab-end.focus(); root.reverse-wrap = false; return reject;
        }
        reject
    }
    key-pressed(event) => { if event.text == Key.Tab || event.text == Key.Backtab { return reject; } accept }
    key-released(event) => { accept }
    in property <bool> chinese;
    in-out property <int> mode: 1;
    in-out property <float> gain-db: 0;
    in-out property <float> opacity-value: 0.85;
    in-out property <float> noise: 1;
    in-out property <float> variance: 0.38;
    callback changed(); callback close();
    Rectangle { background: Theme.overlay;
    TouchArea { }
    Rectangle { width: 480px * Theme.ui-scale; height: 384px * Theme.ui-scale; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; background: Theme.panel; border-radius: 8px * Theme.ui-scale; border-width: 1px; border-color: Theme.strong-border;
        VerticalLayout { padding: 20px * Theme.ui-scale; spacing: 12px * Theme.ui-scale;
            HorizontalLayout { height: 30px * Theme.ui-scale;
                Text { horizontal-stretch: 1; text: root.chinese ? "波形显示设置" : "Peak display settings"; color: Theme.ink; font-size: Theme.font(17); font-weight: 600; vertical-alignment: center; }
                // A fixed focus proxy preserves the modal's forward/reverse wrap,
                // while only the selected close control can receive keyboard input.
                peaks-close := FocusScope {
                    width: 32px * Theme.ui-scale; height: 30px * Theme.ui-scale;
                    focus-on-click: false; focus-on-tab-navigation: false;
                    focus-gained(reason) => { root.focus-close(); }
                    peaks-close-classic := ClassicTool {
                        visible: !Theme.modern-style; enabled: !Theme.modern-style;
                        symbol: "×"; label: !Theme.modern-style ? (root.chinese ? "关闭" : "Close") : "";
                        clicked => { root.close(); }
                    }
                    peaks-close-modern := Tool {
                        visible: Theme.modern-style; enabled: Theme.modern-style;
                        symbol: "×"; label: Theme.modern-style ? (root.chinese ? "关闭" : "Close") : "";
                        clicked => { root.close(); }
                    }
                }
            }
            HorizontalLayout { height: 30px * Theme.ui-scale; spacing: 12px * Theme.ui-scale;
                Caption { width: 90px * Theme.ui-scale; text: root.chinese ? "显示增益" : "Display gain"; }
                Slider { surface: Theme.panel; horizontal-stretch: 1; minimum: -12; maximum: 36; step: 1; value <=> root.gain-db; changed => { root.changed(); } }
                Caption { width: 60px * Theme.ui-scale; text: root.gain-db + " dB"; horizontal-alignment: right; }
            }
            HorizontalLayout { height: 30px * Theme.ui-scale; spacing: 12px * Theme.ui-scale;
                Caption { width: 90px * Theme.ui-scale; text: root.chinese ? "显示模式" : "Display"; }
                ComboBox { horizontal-stretch: 1; model: root.chinese ? ["普通波形", "彩色频谱峰值"] : ["Normal peaks", "Spectral peaks"]; current-index <=> root.mode; selected => { root.changed(); } }
            }
            HorizontalLayout { height: 26px * Theme.ui-scale; spacing: 12px * Theme.ui-scale;
                Caption { width: 90px * Theme.ui-scale; text: root.chinese ? "色彩强度" : "Color opacity"; }
                Slider { surface: Theme.panel; horizontal-stretch: 1; minimum: 0; maximum: 1; step: 0.01; value <=> root.opacity-value; changed => { root.changed(); } }
                Caption { width: 60px * Theme.ui-scale; text: Math.round(root.opacity-value * 100) + "%"; horizontal-alignment: right; }
            }
            // REAPER-reference frequency anchors from audiolib-audio/src/spectral.rs.
            Rectangle { height: 92px * Theme.ui-scale; background: @linear-gradient(90deg, #fb00ff, #ff0018, #ffd300, #3dff00, #00ffac, #0064ff, #8600ff, #ff0094); border-radius: 3px * Theme.ui-scale;
                Rectangle { x: 0px; y: 0px; background: @linear-gradient(180deg, #0e0e0eff, #0e0e0e00); height: 65px * Theme.ui-scale; }
                for frequency[index] in ["14 Hz", "36 Hz", "93 Hz", "241 Hz", "628 Hz", "1632 Hz", "4241 Hz"]: Text { x: 4px * Theme.ui-scale + index * (parent.width - 8px * Theme.ui-scale) / 7; y: 69px * Theme.ui-scale; height: 20px * Theme.ui-scale; text: frequency; color: #101820; font-size: Theme.font(10); font-weight: 600; vertical-alignment: center; }
            }
            HorizontalLayout { height: 26px * Theme.ui-scale; spacing: 8px * Theme.ui-scale;
                Caption { text: root.chinese ? "噪声阈值" : "Noise threshold"; width: 80px * Theme.ui-scale; }
                Slider { surface: Theme.panel; horizontal-stretch: 1; minimum: 0.1; maximum: 2; step: 0.05; value <=> root.noise; changed => { root.changed(); } }
                Caption { width: 36px * Theme.ui-scale; text: Math.round(root.noise*100)/100; }
                Caption { text: root.chinese ? "频率分散" : "Variance"; width: 68px * Theme.ui-scale; }
                Slider { surface: Theme.panel; horizontal-stretch: 1; minimum: 0.05; maximum: 1; step: 0.01; value <=> root.variance; changed => { root.changed(); } }
                Caption { width: 36px * Theme.ui-scale; text: Math.round(root.variance*100)/100; }
            }
            Caption { text: root.chinese ? "黑色表示非音调内容；颜色随主频变化。显示增益不改变音量。" : "Noise fades to black; tones show frequency. Display gain is visual only."; font-size: Theme.font(10); }
        }
    }
    }
    peaks-tab-end := FocusScope { width: 0px; height: 0px; focus-on-click: false; focus-gained(reason) => { if !root.reverse-wrap { root.focus-close(); } } }
}
