// app/audiolib-desktop/ui/search-task-tabs.slint
import { Theme } from "theme.slint";

component TaskTabIcon inherits Rectangle {
    in property <string> text;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> lit: false;
    callback clicked();
    width: 26px * Theme.ui-scale; height: 28px * Theme.ui-scale;
    border-radius: 4px * Theme.ui-scale; background: hit.has-hover ? Theme.hover : transparent;
    border-width: icon-focus.has-focus ? 1px : 0px; border-color: Theme.accent;
    accessible-role: button; accessible-label: root.label; accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: icon-focus;
    Text { text: root.text; color: root.lit ? Theme.accent : Theme.dim; font-size: Theme.font(16); horizontal-alignment: center; vertical-alignment: center; }
    icon-focus := FocusScope {
        enabled: root.enabled; focus-on-click: false;
        key-pressed(event) => { if event.text == " " || event.text == Key.Return { root.clicked(); return accept; } reject }
    }
    hit := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Read-only search terms use subtle keyword/directory tints without boxes.
component SearchTaskTag inherits Rectangle {
    in property <string> text;
    in property <bool> directory: false;
    height: 100%;
    min-width: 24px * Theme.ui-scale;
    preferred-width: min(96px * Theme.ui-scale, tag-label.preferred-width + 4px * Theme.ui-scale);
    max-width: 96px * Theme.ui-scale;
    horizontal-stretch: 0;
    background: transparent;
    tag-label := Text {
        width: max(0px, parent.width - 4px * Theme.ui-scale); height: parent.height;
        text: root.text; color: root.directory ? Theme.warning : Theme.accent-hover;
        font-size: Theme.font(11); horizontal-alignment: left; vertical-alignment: center; overflow: elide;
    }
}

// Document-shaped tabs are distinct from the recessed list-header switches.
// Closing a background task never selects it; starring lives above the sound list.
export component SearchTaskTab inherits Rectangle {
    in property <string> name;
    in property <[string]> keywords;
    in property <string> folder;
    in property <string> summary;
    in property <bool> searched: false;
    in property <bool> active: false;
    in property <bool> favorite: false;
    in property <bool> modified: false;
    in property <bool> chinese: false;
    in property <bool> compact: false;
    in property <bool> enabled: true;
    in property <bool> editable: true;
    in property <length> tooltip-width: 560px * Theme.ui-scale;
    private property <string> tooltip-text: (root.summary != "" ? root.summary : root.name) + (root.modified ? (root.chinese ? "\n当前条件尚未更新到收藏" : "\nCurrent conditions have not been saved to the favorite") : "");
    callback selected();
    callback closed();
    callback rename-requested();
    callback context-requested(Point);
    height: (root.compact ? 32px : 36px) * Theme.ui-scale;
    min-width: 144px * Theme.ui-scale;
    preferred-width: 200px * Theme.ui-scale;
    accessible-role: tab;
    accessible-label: (root.chinese ? "搜索任务：" : "Search task: ") + root.name;
    accessible-item-selectable: true;
    accessible-item-selected: root.active;
    accessible-description: root.summary + (root.modified ? (root.chinese ? "\n当前搜索已修改，尚未更新任务收藏" : "\nThe search differs from its saved favorite") : (root.favorite ? (root.chinese ? "\n已收藏搜索任务" : "\nSaved search task") : ""));
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.selected(); } }
    forward-focus: task-focus;
    background: Theme.modern-style
        ? (root.active ? Theme.tab-surface : (task-hit.has-hover ? Theme.control-surface : Theme.trough))
        : (root.active ? Theme.panel : (task-hit.has-hover ? Theme.raised : Theme.trough));
    border-top-left-radius: (Theme.modern-style ? 5px : 7px) * Theme.ui-scale;
    border-top-right-radius: (Theme.modern-style ? 5px : 7px) * Theme.ui-scale;
    border-width: task-focus.has-focus ? 1px : 0px;
    border-color: Theme.accent;
    opacity: root.enabled ? 1 : 0.45;
    Rectangle {
        height: Theme.modern-style ? (root.active ? 3px * Theme.ui-scale : 1px) : 2px * Theme.ui-scale;
        y: parent.height - self.height;
        background: Theme.modern-style ? (root.active ? transparent : Theme.border) : (root.active ? Theme.accent : Theme.border);
        if Theme.modern-style && root.active: Image {
            width: parent.width; height: parent.height; source: Theme.tab-indicator;
            image-fit: fill; accessible-role: none;
        }
    }
    if !root.searched: Text {
        x: 12px * Theme.ui-scale; width: max(0px, parent.width - 52px * Theme.ui-scale); height: parent.height;
        text: root.name; color: root.active ? Theme.ink : Theme.dim; font-size: Theme.font(12);
        font-weight: root.active ? 600 : 400; vertical-alignment: center; overflow: elide;
    }
    if root.searched: Rectangle {
        x: 12px * Theme.ui-scale; y: 3px * Theme.ui-scale;
        width: max(0px, parent.width - 52px * Theme.ui-scale); height: parent.height - 6px * Theme.ui-scale;
        clip: true;
        HorizontalLayout { spacing: 4px * Theme.ui-scale; alignment: start;
            Text { text: root.chinese ? "搜索:" : "Search:"; font-size: Theme.font(11); color: root.active ? Theme.ink : Theme.dim; horizontal-alignment: left; vertical-alignment: center; }
            if root.keywords.length > 0: SearchTaskTag { text: root.keywords[0]; }
            if root.keywords.length > 1: SearchTaskTag { text: root.keywords[1]; }
            if root.keywords.length > 2: Text { text: "…"; color: Theme.dim; font-size: Theme.font(11); vertical-alignment: center; }
            if root.folder != "": SearchTaskTag { text: root.folder; directory: true; }
            if root.folder == "" && root.keywords.length > 0: SearchTaskTag { text: root.chinese ? "全部目录" : "All folders"; directory: true; }
            if root.keywords.length == 0 && root.folder == "": SearchTaskTag { text: root.chinese ? "筛选" : "Filters"; }
        }
    }
    if root.modified: Rectangle {
        x: parent.width - 38px * Theme.ui-scale; y: (parent.height - self.height) / 2;
        width: 4px * Theme.ui-scale; height: 4px * Theme.ui-scale; border-radius: 2px * Theme.ui-scale; background: Theme.accent;
    }
    task-focus := FocusScope {
        enabled: root.enabled; focus-on-click: false;
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return { root.selected(); return accept; }
            if root.editable && event.text == Key.F2 { root.rename-requested(); return accept; }
            reject
        }
    }
    task-hit := TouchArea {
        width: max(0px, parent.width - 32px * Theme.ui-scale); enabled: root.enabled; mouse-cursor: pointer;
        clicked => { root.selected(); }
        double-clicked => { if root.editable { root.rename-requested(); } }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.context-requested({x: self.absolute-position.x + self.mouse-x, y: self.absolute-position.y + self.mouse-y});
            }
        }
    }
    Tooltip {
        Rectangle {
            width: root.tooltip-width;
            background: Theme.tooltip; border-radius: 5px * Theme.ui-scale;
            border-width: 1px; border-color: Theme.strong-border;
            VerticalLayout { padding: 10px * Theme.ui-scale;
                Text {
                    text: root.tooltip-text; color: Theme.ink; font-size: Theme.font(11); wrap: word-wrap;
                    accessible-role: text; accessible-label: root.tooltip-text;
                }
            }
        }
    }
    TaskTabIcon {
        x: parent.width - 30px * Theme.ui-scale; y: (parent.height - self.height) / 2;
        text: "×"; enabled: root.enabled && root.editable;
        label: (root.chinese ? "关闭搜索任务：" : "Close search task: ") + root.name;
        clicked => { root.closed(); }
    }
}
