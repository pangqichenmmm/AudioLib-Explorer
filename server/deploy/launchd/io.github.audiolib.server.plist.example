<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Example LaunchAgent for audiolib-server on macOS.

  Install:
    cp io.github.audiolib.server.plist.example ~/Library/LaunchAgents/io.github.audiolib.server.plist
    # edit the paths below (this example uses /usr/local/var/audiolib and /opt/audiolib)
    launchctl bootstrap "gui/$(id -u)" ~/Library/LaunchAgents/io.github.audiolib.server.plist
  Restart after a binary swap (redeploy-server.sh does this and waits in between):
    launchctl bootout "gui/$(id -u)/io.github.audiolib.server"
    # wait for the process to exit and the port to be released, then
    launchctl bootstrap "gui/$(id -u)" ~/Library/LaunchAgents/io.github.audiolib.server.plist

  The token: do NOT put it in this file. /opt/audiolib/run.sh is a tiny wrapper such as
      #!/bin/sh
      AUDIOLIB_SERVER_TOKEN="$(cat /usr/local/var/audiolib/token)"; export AUDIOLIB_SERVER_TOKEN
      exec /opt/audiolib/audiolib-server --config /usr/local/var/audiolib/config.toml
  (chmod 600 the token file). It starts through the launcher in server/launcher/
  (build it there; avoids repeated volume-access prompts). Self-update exits with
  code 75 under launchd so KeepAlive (must restart on nonzero exit) relaunches via
  this chain; with KeepAlive false the server stays stopped after an update.
  The exit path is used only when AUDIOLIB_LAUNCHD_LABEL (EnvironmentVariables below)
  equals launchd's XPC_SERVICE_NAME, so keep it identical to Label; otherwise the
  server execs in place.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.github.audiolib.server</string>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- Must equal Label: marks this process as launchd-managed for self-update. -->
        <key>AUDIOLIB_LAUNCHD_LABEL</key>
        <string>io.github.audiolib.server</string>
    </dict>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/audiolib/audiolib-launcher</string>
        <string>/bin/sh</string>
        <string>/opt/audiolib/run.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/usr/local/var/audiolib</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <!-- Interactive: Background makes launchd throttle disk I/O, which noticeably slows
         list waveform pre-generation reads from network shares (switching to Interactive
         together with 3 workers measured a ~1.9x speedup). -->
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/usr/local/var/audiolib/log/server.out.log</string>
    <key>StandardErrorPath</key>
    <string>/usr/local/var/audiolib/log/server.err.log</string>
</dict>
</plist>
