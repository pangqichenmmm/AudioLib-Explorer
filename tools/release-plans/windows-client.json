{
  "schema_version": 1,
  "name": "windows-client",
  "host": "windows",
  "require_tag": true,
  "environment_tools": ["rustc", "cargo"],
  "variables": {"WithoutAsio": false},
  "stages": [
    {"id": "preflight", "script": "tools/check-release.ps1", "parameters": {"Tag": "${Tag}"}},
    {"id": "build", "needs": ["preflight"], "script": "tools/build-release.ps1", "parameters": {"WithoutAsio": "${WithoutAsio}"}, "outputs": ["${TargetDirectory}/x86_64-pc-windows-msvc/release/AudioLibExplorer.exe", "${TargetDirectory}/x86_64-pc-windows-msvc/release/AudioLibCli.exe"]},
    {"id": "package", "needs": ["build"], "script": "tools/package-portable.ps1", "parameters": {"Tag": "${Tag}", "SkipBuild": true, "WithoutAsio": "${WithoutAsio}"}, "outputs": ["dist/latest/portable", "dist/latest/AudioLibExplorer-latest-win-x64-portable.zip", "dist/latest/AudioLibExplorer-latest-win-x64-portable.zip.sha256"]},
    {"id": "accept", "needs": ["package"], "script": "tools/validate-portable.ps1", "parameters": {"BinaryDirectory": "dist/latest/portable", "WithoutAsio": "${WithoutAsio}"}},
    {"id": "install", "needs": ["accept", "package"], "script": "tools/install-local-release.ps1", "parameters": {"Source": "dist/latest/portable"}, "outputs": ["local_release"]}
  ]
}
